							// Add MissColSize to Main or Last Col
							if ($hasMainBox) {
								if ($sectionBoxIsMain) {
									$sectionBoxSize += $sectionColMissing;
								}
							} else {
								if (count($sectionBoxs) == $colIdx) {
									$sectionBoxSize += $sectionColMissing;
								}
							}
						
							// Coloumn/Box
							echo "<div id='d2ms-section-" . str_replace(" ", "-", strtolower($sectionName)) . "-" . str_replace(" ", "-", strtolower($sectionBoxPosition)) . "' class='col-md-" . $sectionBoxSize . " " . ($sectionBoxIsMain ? "d2ms-section-ismainbox" : "") . "'>";
							
							// Box Inner
							echo "<div class='d2ms-box" . ($sectionBoxIsMain ? " d2ms-box-main" : "") . "'>";
							
							if ($sectionBoxIsMain) : // Main/Compoment Box
								echo $this->layout()->content;
							else : 
								if ($sectionBoxPosition == 'logo') : // Logo Box
									echo "<a href='" . $this->baseUrl("") . "' class='logo-brand'>";
									echo "<img src='" . $appLogoPath . "' class='logo-brand-img' alt='Logo' />"; // Default 
									echo "</a>";
								elseif ($sectionBoxPosition == 'menu') : // Menu Box
									if ($templateData->DisplayMenuGroupType == 'menu') :
										$menus = $this->MenuData($templateData->MenuGroupID, $lang);										
										echo '<div class="d2ms-widget-menu-wrapper">';
										echo '	<a id="toggleCanvas" href="#offCanvas" data-offcanvas-trigger="offCanvas" class="visible-xs"><em class="fa fa-bars"></em></a>';
										displayMenu($menus, "main", $menuID, $parentMenuIds);
										echo '</div>';
									elseif ($templateData->DisplayMenuGroupType == 'offcanvas') :
										echo '<div class="d2ms-widget-menu-wrapper">';
										echo '	<a id="toggleCanvas" href="#offCanvas" data-offcanvas-trigger="offCanvas"><em class="fa fa-bars"></em></a>';
										echo '</div>';
									else :
										$menus = $this->MenuData($templateData->MenuGroupID, $lang);
										echo '<div class="d2ms-widget-menu-wrapper with-offcanvas">';
										echo '	<a id="toggleCanvas" href="#offCanvas" data-offcanvas-trigger="offCanvas"><em class="fa fa-bars"></em></a>';
										displayMenu($menus, "main", $menuID, $parentMenuIds);
										echo '</div>';									
									endif;
								else : // Other / Widget Box
								
								endif;
								
								// TODO: Widget
								// Loop Widget in this position
								if (!empty($sectionBoxPosition) && isset($widgets[$sectionBoxPosition]) && (count($widgets[$sectionBoxPosition]) > 0)) :
									foreach ($widgets[$sectionBoxPosition] as $widget) :
										// Check
										$widgetPrefix = "Widget";
										$widgetType = ucfirst($widget["Widget"]);
										$widgetParams = $widget["Params"];
										$widgetClass = "{$widgetPrefix}_{$widgetType}_{$widgetType}";
										
										echo "<div class='d2ms-widget'> ";
										
										if ($widget["ShowTitle"] == 'Y') :
											echo "<div class='d2ms-widget-title'>" . $widget["Title"] . "</div>";
										endif;
										
										echo "<div class='d2ms-widget-body'>";
										$widgetObj = $this->$widgetClass($widgetParams);
										if ($widgetObj != null && method_exists($widgetObj, "display")) :
											$widgetObj->display();
										endif;
										echo "</div>";
										
										echo "</div>";
									endforeach;
								endif;
								
							endif;
							
							// End Box Inner
							echo "</div>";
							
							// End Column/Box
							echo "</div>";
						endforeach;
					endif;
					
					// End Row
					echo "</div>";
					
					// End Container (if)
					if ($hasMainBox) :
						if (!$isPageManage) :
							echo "</div>";
						endif;
					else :
						if (!$sectionIsFluid) :
							echo "</div>";
						endif;
					endif;
					
					// End Section
					echo "</section>";
				endforeach;
			endif;
			
			?>		
		</div>
		<aside id="offCanvas" class="js-offcanvas" data-offcanvas-options='{"modifiers":"right,fixed,overlay"}' role="complementary">
			<a href="javascript:void(0)" class="close-offcanvas js-offcanvas-close" data-button-options='{"modifiers":"m1,m2"}' title="">
				<em class="fa fa-remove"></em>
			</a>
			<div class="offcanvas-inner">			
				<?php 
				$sectionBoxPosition = 'offcanvas';
				if (!empty($sectionBoxPosition) && isset($widgets[$sectionBoxPosition]) && (count($widgets[$sectionBoxPosition]) > 0)) :
					foreach ($widgets[$sectionBoxPosition] as $widget) :
						// Check
						$widgetPrefix = "Widget";
						$widgetType = ucfirst($widget["Widget"]);
						$widgetParams = $widget["Params"];
						$widgetClass = "{$widgetPrefix}_{$widgetType}_{$widgetType}";
						
						echo "<div class='d2ms-widget'> ";
						
						if ($widget["ShowTitle"] == 'Y') :
							echo "<div class='d2ms-widget-title'>" . $widget["Title"] . "</div>";
						endif;
						
						echo "<div class='d2ms-widget-body'>";
						$widgetObj = $this->$widgetClass($widgetParams);
						if ($widgetObj != null && method_exists($widgetObj, "display")) :
							$widgetObj->display();
						endif;
						echo "</div>";
						
						echo "</div>";
					endforeach;
				endif;
				?>
			</div>
		</aside>
		<script type="text/javascript">
		$( function(){
			$( document ).trigger( "enhance" );
		});
		</script>
	</body>
</html>
