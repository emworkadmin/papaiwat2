<?php 
function displayMenu($datas, $parentID, $selectedMenuID, $selectedParentMenuID) {
	
	$isUseLanguageCode = false;
	$langCode = '';
	if (Zend_Registry::isRegistered("IsUseLanguageCode")) {
		$isUseLanguageCode = Zend_Registry::get("IsUseLanguageCode");
		if($isUseLanguageCode) {
			if (Zend_Registry::isRegistered('lang')) {
				$langCode = Zend_Registry::get('lang');
			} else {
				$defaultLanguage = System_Model_Setting::getDefaultLanguage();
				$langCode = $defaultLanguage["Code"];
			}
		}
	}
	
	if ($parentID == 'main') {
		echo '<div class="d2ms-widget-menu hidden-xs">';
		echo '			<a id="d2ms-menu-toggle" class="button dark" href="#"><em class="icon-reorder"></em></a>';
		echo '			<nav>';
		echo '				<ul class="nav navbar-nav" id="d2ms-main-menu">';
	} else {
		echo '<ul class="sub-menu">';
	}
	
	if ($datas[$parentID] > 0) {
		foreach ($datas[$parentID] as $data) {
			$menuID = $data["ID"];
			$menuName = $data["Name"];
			$menuUrl = $data["Url"];
			$menuTarget = '_self';
			if ($data["Type"] == "component") { 
				if ($isUseLanguageCode) {
					$menuUrl = '/' . $langCode . $menuUrl;
				}
			} elseif ($data["Type"] == "url") {
				$menuUrl = $data["Url"];
				$menuSetting = empty($data["Params"]) ? array() : json_decode($data["Params"], true);
				$menuTarget = empty($menuSetting["Target"]) ? "_blank" : $menuSetting["Target"]; 
			} else {
				$menuUrl = '#';
			}
			$hasChild =  isset($datas[$menuID]) && count($datas[$menuID]) > 0;
			
			echo '<li class="' . ($menuID == $selectedMenuID || in_array($menuID, $selectedParentMenuID) ? 'active' : '') . '">';
			
			echo '<a href="' . $menuUrl . '" target="' . $menuTarget . '">' . $menuName . ($hasChild ? ' <span class="caret"></span>' : '') . '</a>';
			
			if ($hasChild) {
				displayMenu($datas, $menuID, $selectedMenuID, $selectedParentMenuID);	
			}
			
			echo '</li>';
		}
	}
	
	if ($parentID == 'main') {
		echo '				</ul>';
		echo '			</nav>';
		echo '			<div class="clear"></div>';
		echo '		</div>';
	} else {
		echo '</ul>';
	}
}
