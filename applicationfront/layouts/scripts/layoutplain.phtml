<!DOCTYPE html>
<?php 

$config = new Zend_Config_Ini(APPLICATION_PATH . '/configs/application.ini', 'init');
$appFaviconPath = $this->baseUrl($config->app->faviconpath);
$appLogoPath = $this->baseUrl($config->app->logopath);

$appSystemName = $config->app->name;
$appStartYear = $config->app->copyrightstartyear;
$appEndYear = date('Y');
$appCompanyName = $config->app->brand;
$appCompanyUrl = $config->app->brandUrl;

$appSystemName = empty(System_Model_Setting::getValue("SiteName", "Site")) ? $appSystemName : System_Model_Setting::getValue("SiteName", "Site");

// Get MenuID
$menuID = null;
if (Zend_Registry::isRegistered("MenuID")) :
	$menuID = Zend_Registry::get("MenuID");
endif;
	
// File Model
$fileModel = new System_Model_Fileinfo();

// Set Template
$templateModel = new System_Model_Template();
$templateID = $templateModel->getIDByMenu($menuID);
if (empty($templateID)) {
	$templateID = $templateModel->getDefault();
}
$templateData = $templateModel->getInfoByID($templateID);

// Favicon & Logo
if (!empty($templateData->FaviconImageHashName)) { 
	$appFaviconPath = $this->url(array("module" => "default", "controller" => "file", "action" => "get", "file" => $templateData->FaviconImageHashName), 'default', true);
} else {
	if (!empty(System_Model_Setting::getValue("Favicon", "Site"))) {
		$faviconFileInfoID = System_Model_Setting::getValue("Favicon", "Site");
		$fileData = $fileModel->item($faviconFileInfoID);
		if ($fileData->ID) {
			$appFaviconPath = $this->url(array("module" => "default", "controller" => "file", "action" => "get", "file" => $fileData->HashName), null, true);
		}
	}
}
if (!empty($templateData->LogoImageHashName)) {
	$appLogoPath = $this->url(array("module" => "default", "controller" => "file", "action" => "get", "file" => $templateData->LogoImageHashName), 'default', true);
} else {
	if (!empty(System_Model_Setting::getValue("Logo", "Site"))) {
		$logoFileInfoID = System_Model_Setting::getValue("Logo", "Site");
		$fileData = $fileModel->item($logoFileInfoID);
		if ($fileData->ID) {
			$appLogoPath = $this->url(array("module" => "default", "controller" => "file", "action" => "get", "file" => $fileData->HashName), null, true);
		}
	}
}

?>
