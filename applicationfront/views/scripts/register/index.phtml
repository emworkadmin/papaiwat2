<script>
	jQuery(function(){

		<?php if ($this->isiOS) : ?>
		$('#txtBirthday').removeAttr("readonly");
		<?php endif;?>
		$('#txtBirthday').datepicker({autoclose: true, format: 'dd/mm/yyyy'<?php if($this->lang == 'zh'){ echo ", language: 'zh-CN'"; } ?>});
		
		$("#formRegister").validate({
			errorElement: "em",
			errorPlacement: function(error, element) {
				error.addClass( "help-block" );
		        error.appendTo( element.parents("div.divControl"));
	        }
	    });

    	$("#btnSave").click(function(){
        	
			var valid = $("#formRegister").valid();
			if (valid) {
				// $("#btnSave").attr("disabled", "disabled");
				$.post("<?php echo $this->url(array('module' => 'default', 'controller' => 'register', 'action' => 'save'), null, true);?>", $("#formRegister").serializeArray(), function(data){
					if (data.result) {
						DialogComplete();
						setTimeout(function(){
							window.location = "<?php echo $this->url(array('module' => 'default', 'controller' => 'register', 'action' => 'finish'), null, true); ?>";
						}, 500);
					} else {
						DialogWarning(data.message, '<?php echo Emwork_Translate::text($this->lang, 'general', 'dialog_warning_title'); ?>', '<?php echo Emwork_Translate::text($this->lang, 'general', 'dialog_warning_close'); ?>');
						$("#btnSave").removeAttr("disabled");
					}
				}, 'json');
			}
		});
		
		$("#btnCancel").click(function(){
			window.location = "<?php echo $this->url(array('module' => 'default', 'controller' => 'auth', 'action' => 'login'), null, true); ?>";
		});

