	<script src="<?php echo $this->baseUrl('plugins/jQueryValidation/localization/messages_th.min.js'); ?>"></script>
	<?php } ?>
	<script>
	jQuery(function(){
		
		$("#formRegister").validate({
			errorElement: "em",
			errorPlacement: function(error, element) {
				error.addClass( "help-block" );
		        error.appendTo( element.parents("div.divControl"));
	        }
	    });

		$('#divIsSeller').show();
		$('#divSellerDetail').hide();

	    // iCheck
    	$('#formRegister input[type=checkbox], #formRegister input[type=radio]').iCheck({checkboxClass: 'icheckbox_minimal-orange',radioClass: 'iradio_minimal-orange'});

		$("#btnSave").click(function(){
			
			var valid = $("#formRegister").valid();
			if (valid) {
				$("#btnSave").attr("disabled", "disabled");

				var isSeller = $("#isSeller").is(':checked');
				var isAccept = $("#isAccept").is(':checked');
				if(isSeller){
					if(!isAccept){
						DialogWarning('<?php echo $this->Translate('register', $this->lang, 'register_warning_accept'); ?>', '<?php if($this->lang != 'th'){ echo 'Warning'; } ?>');
						$("#btnSave").removeAttr("disabled");
						return;
					}
				}

				$.post("<?php echo $this->url(array('module' => 'default', 'controller' => 'register', 'action' => 'savefacebook'), null, true);?>", $("#formRegister").serializeArray(), function(data){
					if (data.result) {
						DialogComplete();
						setTimeout(function(){
							window.location = "<?php echo $this->url(array('module' => 'default', 'controller' => 'register', 'action' => 'facebookfinish'), null, true); ?>";
						}, 500);
					} else {
						DialogWarning(data.message, '<?php if($this->lang != 'th'){ echo 'Warning'; } ?>');
						$("#btnSave").removeAttr("disabled");
					}
				}, 'json');
			}
		});
		
		$("#btnCancel").click(function(){
			window.location = "<?php echo $this->url(array('module' => 'default', 'controller' => 'auth', 'action' => 'login'), null, true); ?>";
		});

		// Remove Facebook URL
		if (window.location.hash && window.location.hash == '#_=_') {
	        if (window.history && history.pushState) {
	            window.history.pushState("", document.title, window.location.pathname);
	        } else {
	            // Prevent scrolling by storing the page's current scroll offset
	            var scroll = {
	                top: document.body.scrollTop,
	                left: document.body.scrollLeft
	            };
	            window.location.hash = '';
	            // Restore the scroll offset, should be flicker free
	            document.body.scrollTop = scroll.top;
	            document.body.scrollLeft = scroll.left;
	        }
	    }

		// --------------------------------------- Function is-Seller ----------------------------------------- //
		$('#formRegister').on('ifChanged', '#isSeller', function(e){
			if(e.target.checked){
				$(this).val('Y');
				$('#divSellerDetail').show();
			}else{
				$(this).val('N');
				$('#divSellerDetail').hide();
			}
		});	

		// ---------------------------------- Function toogle seller type ------------------------------------- //
		$('#formRegister').on('ifClicked', 'input[name=txtSellerType]', function(e){
			toogleSellertype($(this).val());
		});
		toogleSellertype('P');
		function toogleSellertype(val){
			if(val == 'J'){
				$('.juristic-detail').show();
				$('#txtJuristicNameEN').addClass('required');
				$('#txtJuristicNameTH').addClass('required');
				$('#identification_person').hide();
				$('#identification_juristic').show();
			}else{
				$('.juristic-detail').hide();
				$('#txtJuristicNameEN').removeClass('required');
				$('#txtJuristicNameTH').removeClass('required');
				$('#identification_person').show();
				$('#identification_juristic').hide();
			}
		}

		// ---------------------------------------- Shareholder List ----------------------------------------- //
		$("#lnkAddShareholder").click(function(){
			var index =  $("#divShareholder div.row").length ; 
			var html = "";
			html += '<div class="row">' + '\n';
			html += '	<div class="col-md-12 divControl" style="margin-bottom: 10px;">' + '\n';
			html += '		<label class="shareholderNo" style="width: 10px; float: left; margin-right: 15px;"">' + (index+1) + '.</label>' + '\n';
			html += '		<input type="text" name="shareholder[' + index + '][titlename]" id="shareholder-' + index + '-titlename" value="" alt="titleName" class=" form-control" maxlength="50" style="width: 16%; float: left; margin-right: 5px;">' + '\n';
			html += '		<input type="text" name="shareholder[' + index + '][firstname]" id="shareholder-' + index + '-firstname" value="" alt="firstName" class=" form-control" maxlength="50" style="width: 37%; float: left; margin-right: 5px;">' + '\n';
			html += '		<input type="text" name="shareholder[' + index + '][lastname]" id="shareholder-' + index + '-lastname" value="" alt="lastName" class=" form-control" maxlength="50" style="width: 37%; float: left; margin-right: 5px;">' + '\n';
			html += '		<em class="fa fa-trash-o lnkDeleteShareholder pointer"></em>' + '\n';
			html += '	</div>' + '\n';
			html += '</div>' + '\n';

			$("#divShareholder").append(html); 
		});

		$("#divShareholder").bind('click', function(e){
			var target = $(e.target);
			if (target.hasClass("lnkDeleteShareholder")) { 
				target.parent("div.divControl").parent("div.row").fadeOut('fast', function(){
					$(this).remove();
					// reindex
					$("#divShareholder div.row div.divControl").each(function(i, e){ 
						$(e).find('label.shareholderNo').html((i+1) + '.');   
						$(e).find('input[alt=titleName]').attr("name", "shareholder[" + i + "][titlename]").attr("id", "shareholder-" + i + "-titlename"); 
						$(e).find('input[alt=firstName]').attr("name", "shareholder[" + i + "][firstname]").attr("id", "shareholder-" + i + "-firstname"); 
						$(e).find('input[alt=lastName]').attr("name", "shareholder[" + i + "][lastname]").attr("id", "shareholder-" + i + "-lastname"); 
					});  
				});  
			} 
		});

	});
	</script>
