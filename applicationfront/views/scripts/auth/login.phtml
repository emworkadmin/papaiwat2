@media screen and (max-width: 500px) {
	#login-panel .panel { width: calc(100% - 50px); }
}

@media screen and (max-width: 420px) {
	#login-panel .set-checkbox { width: 100%; }
	#login-panel .txt-right { width: 100%; text-align: left; }
}

#login-panel .set-checkbox {
    position: relative;
	padding-right: 0px; 
}

#login-panel .set-checkbox input {
    position: absolute;
    opacity: 0;
    z-index: 1;
    bottom: 52%;
	margin: 0;
    left: 0;
    transform: translateY(50%);
    cursor: pointer;
    height: 15px;
    width: 15px;
}

#login-panel .checkmark {
    position: absolute;
	bottom: 52%;
    left: 0px;
    transform: translateY(50%);
    height: 15px;
    width: 15px;
    background-color: white;
    border: 0.55px solid #333;
}

#login-panel .set-checkbox input:checked ~ .checkmark {
    background-color: white;
}

#login-panel .checkmark:after {
    content: "";
    position: absolute;
    display: none;
}

#login-panel .set-checkbox input:checked ~ .checkmark:after {
    display: block;
}

#login-panel .set-checkbox .checkmark:after {
    left: 6px;
    top: 3px;
    width: 4px;
    height: 9px;
    border: solid #333;
    border-width: 0 2px 2px 0;
    -webkit-transform: rotate(45deg);
    -ms-transform: rotate(45deg);
    transform: rotate(45deg);
}

#login-panel #reCaptcha div {
	margin: auto;
}

