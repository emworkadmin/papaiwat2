<section class="intropage-button">
	<div class="row">
		<div class="col-md-12 text-center" style="padding: 15px;">
			<?php
			foreach($button as $k => $v) :

				if($v['ShowButton'] == 'Y') :
					$btColor = '';
					if($v['btColor']) {
						$btColor = 'background: '. $v['btColor'] . ';';
					}
					$bttxtColor  = '';
					if($v['bttxtColor']) {
						$bttxtColor = 'color: ' . $v['bttxtColor'] . ';';
					}
					$Image = '';
					if(count($v['Image'])>0) {
						$imgUrl = $this->url(array("module" => "default", "controller" => "file", "action" => "get", "file" => $v['Image'][0]['hash_name']), "default", true);
						$Image = 'background-image: url('. $imgUrl .')'.';';
						$Image .= 'background-size: cover;';
					}
					
					if($v['URL']) {
						$url = $v['URL'];
						?>

							<a class="btn btn-default" href="<?php echo $url; ?>" style="<?php echo $btColor . $bttxtColor . $Image; ?>"><?php echo $v['btText']; ?></a>

						<?php
					} else {
						if ($this->isUseLanguageCode) :
							foreach ($this->languages as $language) :
								
								if (!empty($v["btText"])) :
									$buttonText = $v["btText"];
									$url = '/' . $language["Code"] . $this->menuDefault->Url;
									?>

										<a class="btn btn-default" href="<?php echo $url; ?>" style="<?php echo $btColor . $bttxtColor . $Image; ?>"><?php echo $v['btText']; ?></a>

									<?php
								endif;
							endforeach;
						else :
							$url = $v['URL'];
							?>

								<a class="btn btn-default" href="<?php echo $url; ?>" style="<?php echo $btColor . $bttxtColor . $Image; ?>"><?php echo $v['btText']; ?></a>

							<?php
						endif;
					}

				endif;
			endforeach;
			?>

		</div>
	</div>
</section>

