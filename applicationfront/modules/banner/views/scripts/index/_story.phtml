	// Function Adjust Picture Size
	adjustHeight();
	function adjustHeight() {
    	var myWidth = jQuery('.effect-box .item-img').width();
    	var myString = myWidth + 'px';
    	jQuery('.effect-box .item-img').css('height', myString);
    }
	jQuery(window).resize(function() {
		adjustHeight();
	});

});
</script>

<?php if (!empty($this->data->Latitude) && !empty($this->data->Longitude)) : ?>
<script type="text/javascript">
var map;
var marker;
function initMap() {		
	// Set Map
	map = new google.maps.Map(document.getElementById('mapCanvas'), {
	    zoom: 15,
	    center: new google.maps.LatLng(<?php echo $this->data->Latitude; ?>, <?php echo $this->data->Longitude; ?>), 
	    mapTypeId: google.maps.MapTypeId.ROADMAP,
	    draggable: true,
	    fullscreenControl : false,
	    mapTypeControl: true,
	    mapTypeControlOptions: {
	        style: google.maps.MapTypeControlStyle.HORIZONTAL_BAR,
	        position: google.maps.ControlPosition.TOP_RIGHT
	    }
	});
	marker = new google.maps.Marker({
		position: {lat: <?php echo $this->data->Latitude;?>, lng: <?php echo $this->data->Longitude; ?>},
		map: map
	});
}
</script>
<script async defer src="https://maps.googleapis.com/maps/api/js?key=AIzaSyCh2SYeAPs7Sfkv_FfupXHDiqti27WMWj4&callback=initMap&language=<?php echo $this->lang; ?>"></script>
