<script src="<?php echo $this->baseUrl('plugins/jQueryValidation/jquery.validate.min.js'); ?>"></script>
<script src="<?php echo $this->baseUrl('plugins/jQueryValidation/localization/messages_th.min.js'); ?>"></script>

<script>
jQuery(function(){

	$("#formRegister").validate({
		errorElement: "em",
		errorPlacement: function(error, element) {
			error.addClass( "help-block" );
			error.appendTo( element.parents("div.divControl"));
		}
	});

	function buttonZoneDisabled() {
		$(".button-panel-zone button").attr("disabled", "disabled");
		$(".button-panel-zone").append('<em class="fa fa-refresh fa-spin"></em>');
	}
	function buttonZoneActive() {
		$(".button-panel-zone button").removeAttr("disabled");
		$(".button-panel-zone > em").remove();
	}

	$("#btnSave").click(function(){
		buttonZoneDisabled();
		var valid = $("#formRegister").valid();
		if (valid && alphabetcheck) {
			$.post("<?php echo $this->url(array('module' => 'webboard', 'controller' => 'register', 'action' => 'save'), null, true);?>", $("#formRegister").serializeArray(), function(data){
				if (data.result) {
					DialogComplete();
					setTimeout(function(){
						window.location = "<?php echo $this->url(array('module' => 'webboard', 'controller' => 'register', 'action' => 'finish'), null, true); ?>";
					}, 500);
				} else {
					DialogWarning(data.message, '<?php echo Emwork_Translate::text($this->lang, 'general', 'dialog_warning_title'); ?>', '<?php echo Emwork_Translate::text($this->lang, 'general', 'dialog_warning_close'); ?>');
					buttonZoneActive();
				}
			}, 'json');
		} else {
			buttonZoneActive();
		}
	});
	
	$("#btnCancel").click(function(){
		window.location = "<?php echo $this->url(array('module' => 'webboard', 'controller' => 'home', 'action' => 'login'), null, true); ?>";
	});

	var alphabetcheck = true;
	$.fn.alphabetonly = function(options) {
		var opts = $.extend( {}, $.fn.alphabetonly.defaults, options );
		msg = opts.message;
		color = opts.color;
		size = opts.size;
		fontstyle = opts.fontstyle;
		
		var letters = /^[A-Za-z]+$/;

		$.each($(this), function(i,e) {
			var id = $(e).attr("id");
			$(e).parent().append("<span class='pattern-validate-txt' id='"+id+"' style='display:none;color:"+color+";font-size:"+size+";font-style:"+fontstyle+";'>" + msg + "</span>");
			$(this).keyup(function() {
				if($(this).val().length>0) {
					if( letters.test($(this).val()) ) {
						$("span#"+id).css({"display":"none"});
                        alphabetcheck = true;
					} else {
						$("span#"+id).css({"display":"block"});
                        alphabetcheck = false;
					}
				} else {
					$("span#"+id).css({"display":"none"});
                    alphabetcheck = true;
				}
			});
		});
	}
	$.fn.alphabetonly.defaults = {
		message: "<?php echo Emwork_Translate::text($this->lang, 'webboard', 'register_validate_eng_text'); ?>",
		color: "red",
		size: '12px',
        fontstyle: 'italic'
	};

	$('.alpha').alphabetonly();


});
</script>