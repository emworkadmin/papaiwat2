<div class="result-list1 webboard" id="result-list1" style="border: 1px solid;margin: 0px 0px 20px 0px;padding: 10px 10px 10px 10px;"></div>
<div class="result-paging1" style="display: none;">
  <p class="paging1 text-right"></p>
</div>


<script>
jQuery(function(){

	reloadResultList1(1);

	function reloadResultList1(pageIndex) {

		var sendData = {};
		sendData.pageIndex = pageIndex;
		
			$.post("<?php echo $this->url(array('module' => 'webboard', 'controller' => 'profile', 'action' => 'listpost','userid'=>$this->userid), null, true); ?>", sendData, function(data){
		
			if (data.total > 0) {
				$("#result-list1").html(data.html);
				$('.result-paging1').css('display', '');
				$('.paging1').bootpag({
					total : data.totalPage,
					page : data.pageIndex,
					maxVisible: 5,
					leaps: false,
					firstLastUse: true,
					first: '<<',
					last: '>>',
					next: '>',
					prev: '<',
					wrapClass: 'pagination',
					activeClass: 'active',
					disabledClass: 'disabled',
					nextClass: 'next',
					prevClass: 'prev',
					lastClass: 'last',
					firstClass: 'first'
				});

			} else {
				$('#result-paging1').css('display', 'none');
				$('.result-list1').html("");
				$('.paging1').bootpag({total : 0});

			}
		}, 'json');
	}

				$('.paging1').bootpag({
					
					total: 0,
					maxVisible: 5,
					leaps: false,
					firstLastUse: true,
					first: '<<',
					last: '>>',
					next: '>',
					prev: '<',
					wrapClass: 'pagination',
					activeClass: 'active',
					disabledClass: 'disabled',
					nextClass: 'next',
					prevClass: 'prev',
					lastClass: 'last',
					firstClass: 'first'
				}).on("page", function(event, num){
					
					reloadResultList1(num);

				}); 

});
</script>