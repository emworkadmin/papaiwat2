<script src="<?php echo $this->baseUrl('plugins/jQueryValidation/jquery.validate.min.js'); ?>"></script>
<script src="<?php echo $this->baseUrl('plugins/jQueryValidation/localization/messages_th.min.js'); ?>"></script>

<script>
jQuery(function(){

	$("#formEdit").validate({
		errorElement: "em",
		errorPlacement: function(error, element) {
			error.addClass( "help-block" );
			error.appendTo( element.parents("div.divControl"));
		}
	});

	$("#btnSave").click(function(){
		var valid = $("#formEdit").valid();
		if (valid) {
			$.post("<?php echo $this->url(array('module' => 'webboard', 'controller' => 'profile', 'action' => 'update'), null, true);?>", $("#formEdit").serializeArray(), function(data){
				if (data.result) {
					DialogComplete();
					setTimeout(function(){
						window.location = "<?php echo $this->url(array('module' => 'webboard', 'controller' => 'profile', 'action' => 'profile'), null, true); ?>" ;
					}, 500);
				} else {
					DialogWarning(data.message, '<?php echo Emwork_Translate::text($this->lang, 'general', 'dialog_warning_title'); ?>', '<?php echo Emwork_Translate::text($this->lang, 'general', 'dialog_warning_close'); ?>');
				}
			}, 'json');
		}
	});
	
	$("#btnCancel").click(function(){
		window.location = "<?php echo $this->url(array('module' => 'webboard', 'controller' => 'home', 'action' => 'index'), null, true); ?>";
	});

	$("#btnDelete").click(function(){
		DialogConfirm("<?php echo Emwork_Translate::text($this->lang, 'general', 'dialog_warning_delete'); ?>", "<?php echo Emwork_Translate::text($this->lang, 'general', 'dialog_warning_title'); ?>", function() {
			$.post("<?php echo $this->url(array("module" => 'webboard', "controller" => 'profile', 'action' => 'delete'), null, true); ?>", {'id' : '<?php echo $this->userid?>'}, function(data){
				if (data.result) {
					DialogComplete('<?php echo Emwork_Translate::text($this->lang, 'general', 'dialog_delete_title'); ?>');
					setTimeout(function(){
						window.location = "<?php echo $this->url(array('module' => 'webboard', 'controller' => 'home', 'action' => 'index'), null, true); ?>";
					}, 500);
				} else {
					DialogWarning(data.message, '<?php echo Emwork_Translate::text($this->lang, 'general', 'dialog_warning_title'); ?>', '<?php echo Emwork_Translate::text($this->lang, 'general', 'dialog_warning_close'); ?>');
				}
			}, 'json');
		});
	});

});
</script>