<script>
jQuery(function(){

	reloadResultList1(1);

	function reloadResultList1(pageIndex) {

		var sendData = {};
		sendData.pageIndex = pageIndex;
		
			$.post("<?php echo $this->url(array('module' => 'webboard', 'controller' => 'home', 'action' => 'getlist'), null, true); ?>", sendData, function(data){
		
			$("span#total").html(data.total);
			
			// $("#result-list1")
			var res = data.html.replace('<?php echo $this->text; ?>' , "<span style='background: yellow;'><?php echo $this->text; ?></span>");
			var res = data.html.replace('<?php echo $this->text; ?>' , "<span style='background: yellow;'><?php echo $this->text; ?></span>");
			
			if (data.total > 0) {
				$("#result-list1").html(res);
				$('.result-paging1').css('display', '');
				$('.paging1').bootpag({
					total : data.totalPage,
					page : data.pageIndex,
					maxVisible: 5,
					leaps: false,
					firstLastUse: true,
					first: '<<',
					last: '>>',
					next: '>',
					prev: '<',
					wrapClass: 'pagination',
					activeClass: 'active',
					disabledClass: 'disabled',
					nextClass: 'next',
					prevClass: 'prev',
					lastClass: 'last',
					firstClass: 'first'
				});

			} else {
				
				$('#result-paging1').css('display', 'none');
				$('.result-list1').html(data.html);
				$('.paging1').bootpag({total : 0});
			}
		}, 'json');
	}

				$('.paging1').bootpag({
					
					total: 0,
					maxVisible: 5,
					leaps: false,
					firstLastUse: true,
					first: '<<',
					last: '>>',
					next: '>',
					prev: '<',
					wrapClass: 'pagination',
					activeClass: 'active',
					disabledClass: 'disabled',
					nextClass: 'next',
					prevClass: 'prev',
					lastClass: 'last',
					firstClass: 'first'
				}).on("page", function(event, num){
					
					reloadResultList1(num);

				}); 

});
</script>