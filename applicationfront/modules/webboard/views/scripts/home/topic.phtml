<script src="<?php echo $this->baseUrl('plugins/jQueryValidation/jquery.validate.min.js'); ?>"></script>
<script src="<?php echo $this->baseUrl('plugins/jQueryValidation/localization/messages_th.min.js'); ?>"></script>

<script>
jQuery(function(){

	$("#reply").validate({
		errorElement: "em",
		errorPlacement: function(error, element) {
			error.addClass( "help-block" );
			error.appendTo( element.parents("div.divControl"));
		}
	});

	reloadResultList1(1);


	$("#btnSave").click(function(){
		var valid = $("#reply").valid();
		if (valid) {
			$.post("<?php echo $this->url(array('module' => 'webboard', 'controller' => 'home', 'action' => 'savereply','id'=>$this->id,'iid'=>$this->iid), null, true);?>", $("#reply").serializeArray(), function(data){
				if (data.result) {
					DialogComplete();
					setTimeout(function(){
						window.location = "<?php echo $this->url(array('module' => 'webboard', 'controller' => 'home', 'action' => 'topic','id'=>$this->id,'iid'=>$this->iid), null, true); ?>";
					}, 500);
				} else {
					DialogWarning(data.message, '<?php echo Emwork_Translate::text($this->lang, 'general', 'dialog_warning_title'); ?>', '<?php echo Emwork_Translate::text($this->lang, 'general', 'dialog_warning_close'); ?>');
					$("#btnSave").removeAttr("disabled");
				}
				$("#btnSave").attr("disabled", false);
			}, 'json');
		} else {
			$("#btnSave").attr("disabled", false);
		}
	});

	function reloadResultList1(pageIndex) {

		var sendData = {};
		sendData.pageIndex = pageIndex;
		
			$.post("<?php echo $this->url(array('module' => 'webboard', 'controller' => 'home', 'action' => 'listreply','iid'=>$this->iid), null, true); ?>", sendData, function(data){
		
			// $("span#total").html(data.total);
			
			// $("#result-list1")
			var res = data.html.replace('<?php echo $this->text; ?>' , "<span style='background: yellow;'><?php echo $this->text; ?></span>");
			var res = data.html.replace('<?php echo $this->text; ?>' , "<span style='background: yellow;'><?php echo $this->text; ?></span>");
			
            console.log(data.html);

			if (data.total > 0) {
				$("#result-list1").html(res);
				$('.result-paging1').css('display', '');
				$('.paging1').bootpag({
					total : data.totalPage,
					page : data.pageIndex,
					maxVisible: 5,
					leaps: false,
					firstLastUse: true,
					first: '<<',
					last: '>>',
					next: '>',
					prev: '<',
					wrapClass: 'pagination',
					activeClass: 'active',
					disabledClass: 'disabled',
					nextClass: 'next',
					prevClass: 'prev',
					lastClass: 'last',
					firstClass: 'first'
				});

			} else {
				
				$('#result-paging1').css('display', 'none');
				$('.result-list1').html(data.html);
				$('.paging1').bootpag({total : 0});
			}
		}, 'json');
	}

				$('.paging1').bootpag({
					
					total: 0,
					maxVisible: 5,
					leaps: false,
					firstLastUse: true,
					first: '<<',
					last: '>>',
					next: '>',
					prev: '<',
					wrapClass: 'pagination',
					activeClass: 'active',
					disabledClass: 'disabled',
					nextClass: 'next',
					prevClass: 'prev',
					lastClass: 'last',
					firstClass: 'first'
				}).on("page", function(event, num){
					
					reloadResultList1(num);

				}); 

});
</script>


