<div class="info infopage calendar-article calendar-article-<?php echo $this->id; ?>">

	 <div>
    	<div class="article-title title-panel">
			<span class="title">
				<?php echo empty($this->pageTitle) ? 'หมวดหมู่กิจกรรม' : $this->pageTitle; ?>
			</span>
			<hr />
		</div>
    </div>

    <div class="result-list-panel">
    	<div class="result-list" id="result-list"></div>
    </div>

	  <div class="article-title-zone">
    	<div class="article-title title-panel">
			<span class="title"><?php echo Emwork_translate::text($this->lang, 'calendar', 'calendar_list'); ?>
			</span>
			<hr />
		</div>
    </div>

	<div class="result-list-panel">
    	<div class="result-list" id="result-list-art"></div>
    	<div class="result-paging-art" style="display: none;">
    		<p class="paging text-right"></p>
    	</div>
	</div>

</div>
<script>
jQuery(function(){

	reloadResultList(1);
	reloadResultListCategory(1);

	function reloadResultListCategory(pageIndex) {
		var sendData = {};
		sendData.pageIndex = pageIndex;
		$.post("<?php echo $this->url(array('module' => 'calendar', 'controller' => 'category', 'action' => 'getlist', 'id' => $this->id), null, true); ?>", sendData, function(data){
			if (data.total > 0) {
				$("#result-list").html(data.html);
			} else {
				$('#result-list').html('');
				$("#result-list").parent().css("display", "none");
			}
		}, 'json');
	}	

	function reloadResultList(pageIndex) {
		var sendData = {};
		sendData.pageIndex = pageIndex;
		$.post("<?php echo $this->url(array('module' => 'calendar', 'controller' => 'category', 'action' => 'getarticles', 'id' => $this->id, 'cid' => $this->cid), null, true); ?>", sendData, function(data){
			
			if (data.total > 0) {
				$("#result-list-art").html(data.html);
				$('.result-paging-art').css('display', '');
				$('.paging').bootpag({
					total : data.totalPage,
					page : data.pageIndex,
					maxVisible: 5,
			        leaps: false,
			        firstLastUse: true,
			        first: '<<',
			        last: '>>',
			        next: '>',
			        prev: '<',
			        wrapClass: 'pagination',
			        activeClass: 'active',
			        disabledClass: 'disabled',	
			        nextClass: 'next',
			        prevClass: 'prev',
			        lastClass: 'last',
			        firstClass: 'first'
				});
			} else {
				$('.result-paging-art').css('display', 'none');
				$('.paging').bootpag({total : 0});
			}
		}, 'json');
	}

	$('.paging').bootpag({
        total: 0,
        maxVisible: 5,
        leaps: false,
        firstLastUse: true,
        first: '<<',
        last: '>>',
        next: '>',
        prev: '<',
        wrapClass: 'pagination',
        activeClass: 'active',
        disabledClass: 'disabled',
        nextClass: 'next',
        prevClass: 'prev',
        lastClass: 'last',
        firstClass: 'first'
    }).on("page", function(event, num){
    	reloadResultList(num);
    }); 	
});
</script>