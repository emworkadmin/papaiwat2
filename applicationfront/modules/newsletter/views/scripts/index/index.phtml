<script src="<?php echo $this->baseUrl('plugins/ckeditor/ckeditor.js'); ?>"></script>
<script src="<?php echo $this->baseUrl('plugins/ckeditor/adapters/jquery.js'); ?>"></script>
<script>

$(function () {

$('#formNewsletter').submit(function(){
	alert($(this["options"]).val());
    return false;
});

	
	$("#formNewsletter").validate({
		errorElement: "em",
		errorPlacement: function(error, element) {
			error.addClass( "help-block" );
	        error.appendTo( element.parents("div.divControl"));
        }
    });
    
	// $("#formNewsletter input[type=checkbox], #formNewsletter input[type=radio]").iCheck({checkboxClass: 'icheckbox_minimal-blue',radioClass: 'iradio_minimal-blue'});

    // Save
	$("#btnSaveNewsletter").click(function(){
		var valid = $("#formNewsletter").valid();
		if (valid) {
			$.post("<?php echo $this->url(array('module' => 'newsletter', 'controller' => 'index', 'action' => 'save'), null, true);?>", $("#formNewsletter").serializeArray(), function(data){
				if (data.result) {
					DialogComplete();
					setTimeout(function(){
						location.reload();
					}, 500);
				} else {
					DialogWarning(data.message, '<?php echo Emwork_Translate::text($this->lang, 'general', 'dialog_warning_title'); ?>', '<?php echo Emwork_Translate::text($this->lang, 'general', 'dialog_warning_close'); ?>');
				}
			}, 'json');
		}
	});


});
</script>