<!-- jQueryFiler -->
<link rel="stylesheet" type="text/css" media="screen" href="<?php echo $this->baseUrl("plugins/jQueryFiler/css/themes/jquery.filer-dragdropbox-theme.css"); ?>" />
<link rel="stylesheet" type="text/css" media="screen" href="<?php echo $this->baseUrl("plugins/jQueryFiler/css/jquery.filer.css"); ?>" />
<script type="text/javascript" src='<?php echo $this->baseUrl("plugins/jQueryFiler/js/jquery.filer.js"); ?>'></script>

<style>
/* ---------------- Override jQuery Filer ---------------- */
.jFiler-theme-default { width: 200px; margin: 0 auto; }
.jFiler-theme-default .jFiler-input { width: 100%; margin: 0px;  box-shadow: none; border: none; }
.jFiler-theme-default .jFiler-input .jFiler-input-caption { text-align: center; width: 100%; padding-top: 8px; padding-left: 0px; color: #0c3a82; }
.jFiler-theme-default .jFiler-input .jFiler-input-caption:hover { }
.jFiler-theme-default .jFiler-input .jFiler-input-button { display: none !important; }
.jFiler-theme-default .jFiler-items.jFiler-row { display: none !important; }
</style>

<input type="file" name="profile_picture[]" id="profile_picture" multiple="multiple" style="position: absolute; left: -9999px; top: -9999px; z-index: -9999;">

<script>
jQuery(function(){

	$('#profile_picture').filer({
		showThumbs: true,
		limit: 1,
		maxSize: 10,
		extensions: ['png','jpg','jpeg','gif'],
		templates: {
			box: '<div class="jFiler-items-list jFiler-items-grid"></div>',
			item: '<div class="jFiler-items"><a  class="jFiler-item-title" style="color: #2c93c7;" download><b title="{{fi-name}}">{{fi-name | limitTo: 25}}&nbsp;</b></a>  <span class="profile_picture-lightgallery"><em class="fa fa-search-plus" data-src="/file/get/file/{{fi-fid}}" style="cursor: pointer;"></em></span>  <a class="icon-jfi-trash jFiler-item-trash-action"></a><div class="jFiler-jProgressBar" style="width: 200px;"></div></div>',
			itemAppend: '<div class="jFiler-items"><a class="jFiler-item-title" style="color: #2c93c7;"  href="/file/get/file/{{fi-fid}}" download><b title="{{fi-name}}">{{fi-name | limitTo: 25}}&nbsp;</b></a>  <span class="profile_picture-lightgallery ext-{{fi-extension}}" data-ext="ext-{{fi-extension}}"><em class="fa fa-search-plus" data-src="/file/get/file/{{fi-fid}}" style="cursor: pointer;"></em></span>  <a class="icon-jfi-trash jFiler-item-trash-action"></a><input type="hidden" name="hdfprofile_picture[]" value="{{fi-fid}}" /></div>',
			progressBar: '<div class="bar"></div>',
			itemAppendToEnd: false,
			removeConfirmation: true,
			_selectors: {
				list: '.jFiler-items-list',
				item: '.jFiler-items',
				progressBar: '.bar',
				remove: '.jFiler-item-trash-action'
			}
		},
		uploadFile: {
			url: "/th/file/upload",
			type: 'POST',
			enctype: 'multipart/form-data',
			beforeSend: function(){},
			success: function(data, el){
				updateProfilePicture(data);
				$('.jFiler-input-caption span').html('<?php echo '<em class="fa fa-pencil" style="margin-right: 5px;"></em> '. Emwork_Translate::text($this->lang, 'profile', 'detail_change_profile_picture'); ?>');
			},
			error: function(el){
				updateProfilePictureErr();
			},
			statusCode: null,
			onProgress: null,
			onComplete: null
		},
		onRemove: function(itemEl, file, id, listEl, boxEl, newInputEl, inputEl){
			// Nothing ...
		},
		addMore: true,
		files: []
	});

	function updateProfilePicture(data) {
		var HashName = data['metas'][0]['name'];
		$.post("<?php echo $this->url(array('module' => 'profile', 'controller' => 'index', 'action' => 'updateprofilepicture'), null, true);?>", {"HashName":HashName}, function(data) {
			if (data.result) {
				DialogComplete(data.message);
				setTimeout(function(){
					window.location = "<?php echo $this->url(array('module' => 'profile', 'controller' => 'index', 'action' => 'index'), null, true);?>";
				}, 500);
			} else {
				DialogWarning(data.message, '<?php echo Emwork_Translate::text($this->lang, 'general', 'dialog_warning_title'); ?>', '<?php echo Emwork_Translate::text($this->lang, 'general', 'dialog_warning_close'); ?>');
			}
		}, 'json');
	}
	function updateProfilePictureErr() {
		DialogWarning("<?php echo Emwork_Translate::text($this->lang, 'profile', 'detail_change_profile_picture_error'); ?>", '<?php echo Emwork_Translate::text($this->lang, 'general', 'dialog_warning_title'); ?>', '<?php echo Emwork_Translate::text($this->lang, 'general', 'dialog_warning_close'); ?>');
	}

	$('.jFiler-input-caption span').html('<?php echo '<em class="fa fa-pencil" style="margin-right: 5px;"></em> ' . Emwork_Translate::text($this->lang, 'profile', 'detail_change_profile_picture'); ?>');
});
</script>

<div id="divprofile_picture">

</div>