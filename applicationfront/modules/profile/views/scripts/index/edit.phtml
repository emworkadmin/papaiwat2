<script src="<?php echo $this->baseUrl('plugins/jQueryValidation/jquery.validate.min.js'); ?>"></script>
<script src="<?php echo $this->baseUrl('plugins/jQueryValidation/localization/messages_th.min.js'); ?>"></script>
<script>
$(function () {

	<?php if ($this->isiOS) : ?>
	$('#txtBirthDate').removeAttr("readonly");
	<?php endif;?>

	$('#txtBirthDate').datepicker({autoclose: true, format: 'dd/mm/yyyy'});
    
	$("#formAdd").validate({
		errorElement: "em",
		errorPlacement: function(error, element) {
			error.addClass( "help-block" );
	        error.appendTo( element.parents("div.divControl"));
        }
    });

	$("#formAdd input[type=checkbox], #formAdd input[type=radio]").iCheck({checkboxClass: 'icheckbox_minimal-blue',radioClass: 'iradio_minimal-blue'});
	
	// Save
	$("#btnSave").click(function() {
    		var OldPassword = $('#txtOldPassword').val();
    		var NewPasswordFirst = $('#txtNewPasswordFirst').val();
    		var NewPasswordSecond = $('#txtNewPasswordSecond').val();
    		if(OldPassword) {
        		if(NewPasswordFirst.length < 8){
					DialogWarning('<?php echo Emwork_Translate::text($this->lang, 'profile', 'dialog_new_password_length'); ?>', '<?php echo Emwork_Translate::text($this->lang, 'general', 'dialog_warning_title'); ?>', '<?php echo Emwork_Translate::text($this->lang, 'general', 'dialog_warning_close'); ?>');
        			return;
        		}
        		if(NewPasswordFirst != NewPasswordSecond) {
					DialogWarning('<?php echo Emwork_Translate::text($this->lang, 'profile', 'dialog_duplication_password'); ?>', '<?php echo Emwork_Translate::text($this->lang, 'general', 'dialog_warning_title'); ?>', '<?php echo Emwork_Translate::text($this->lang, 'general', 'dialog_warning_close'); ?>');
            		return;
        		}
    			$.post("<?php echo $this->url(array('module' => 'profile', 'controller' => 'index', 'action' => 'updatepassword'), null, true);?>", $("#formPassword").serializeArray(), function(data) {
    				if (data.result) {
    					save();
    				} else {
    					DialogWarning(data.message, '<?php echo Emwork_Translate::text($this->lang, 'general', 'dialog_warning_title'); ?>', '<?php echo Emwork_Translate::text($this->lang, 'general', 'dialog_warning_close'); ?>');
    					return;
    				}
    			}, 'json');
    		} else {
    			save();
    		}
	});
	function save() {
		var valid = $("#formAdd").valid();
		if (valid) {
			$.post("<?php echo $this->url(array('module' => 'profile', 'controller' => 'index', 'action' => 'update'), null, true);?>", $("#formAdd").serializeArray(), function(data){
				if (data.result) {
					DialogComplete();
					setTimeout(function(){
						window.location = "<?php echo $this->url(array('module' => 'profile', 'controller' => 'index', 'action' => 'index'), null, true); ?>";
					}, 500);
				} else {
					DialogWarning(data.message, '<?php echo Emwork_Translate::text($this->lang, 'general', 'dialog_warning_title'); ?>', '<?php echo Emwork_Translate::text($this->lang, 'general', 'dialog_warning_close'); ?>');
				}
			}, 'json');
		}
	}

	// Cancel
	$("#btnCancel").click(function() {
		window.location = "<?php echo $this->url(array("module" => "profile" , "controller" => "index", "action" => "index"), null, true); ?>";
	});

});
</script>