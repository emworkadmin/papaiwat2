<script src="<?php echo $this->baseUrl('plugins/jQueryValidation/localization/messages_th.min.js'); ?>"></script>
<script>
jQuery(function() {

	$("#formSave").validate({
		errorElement: "em",
		errorPlacement: function(error, element) {
			error.addClass( "help-block" );
			error.appendTo( element.closest("div.divControl"));
		}, 
		ignore: []
	});

	$("#Instantmessage").change(function() {
		$("#Detail").val($(this).find('option:selected').text());
	});

	$("#TitleName").keyup(function() {
		$(this).parent().find("sub").html($(this).val().length+'/50');
	});

	$("#FirstName").keyup(function() {
		$(this).parent().find("sub").html($(this).val().length+'/50');
	});

	$("#LastName").keyup(function() {
		$(this).parent().find("sub").html($(this).val().length+'/50');
	});

	$("#Detail").keyup(function() {
		$(this).parent().find("sub").html($(this).val().length+'/500');
	});

	$("#DepartmentName").keyup(function() {
		$(this).parent().find("sub").html($(this).val().length+'/50');
	});

		// Save
	$("#btnSave").click(function(){
		var valid = $("#formSave").valid();
		if (valid) {
			$.post("<?php echo $this->url(array('module' => 'guestbook', 'controller' => 'guestbook', 'action' => 'save','id'=>$this->id), null, true);?>", $("#formSave").serializeArray(), function(data){
				if (data.result) {
					DialogComplete();
					setTimeout(function(){
						window.location = "<?php echo $this->url(array('module' => 'guestbook', 'controller' => 'guestbook', 'action' => 'index','id'=>$this->id), null, true); ?>";
					}, 500);
				} else {
					DialogWarning(data.message, '<?php echo Emwork_Translate::text($this->lang, 'general', 'dialog_warning_title'); ?>', '<?php echo Emwork_Translate::text($this->lang, 'general', 'dialog_warning_close'); ?>');
				}
			}, 'json');
		}
	});

	reloadResultList1(1);

	function reloadResultList1(pageIndex) {

		var sendData = {};
		sendData.pageIndex = pageIndex;
		
			$.post("<?php echo $this->url(array('module' => 'guestbook', 'controller' => 'guestbook', 'action' => 'getlist','id'=>$this->id), null, true); ?>", sendData, function(data){
		
			$("span#total").html(data.total);
			
			// $("#result-list1")
			var res = data.html.replace('<?php echo $this->text; ?>' , "<span style='background: yellow;'><?php echo $this->text; ?></span>");
			var res = data.html.replace('<?php echo $this->text; ?>' , "<span style='background: yellow;'><?php echo $this->text; ?></span>");
			
			if (data.total > 0) {
				$("#result-list1").html(res);
				$('.result-paging1').css('display', '');
				$('.paging1').bootpag({
					total : data.totalPage,
					page : data.pageIndex,
					maxVisible: 5,
					leaps: false,
					firstLastUse: true,
					first: '<<',
					last: '>>',
					next: '>',
					prev: '<',
					wrapClass: 'pagination',
					activeClass: 'active',
					disabledClass: 'disabled',
					nextClass: 'next',
					prevClass: 'prev',
					lastClass: 'last',
					firstClass: 'first'
				});

			} else {
				
				$('#result-paging1').css('display', 'none');
				$('.result-list1').html(data.html);
				$('.paging1').bootpag({total : 0});
			}
		}, 'json');
	}

				$('.paging1').bootpag({
					
					total: 0,
					maxVisible: 5,
					leaps: false,
					firstLastUse: true,
					first: '<<',
					last: '>>',
					next: '>',
					prev: '<',
					wrapClass: 'pagination',
					activeClass: 'active',
					disabledClass: 'disabled',
					nextClass: 'next',
					prevClass: 'prev',
					lastClass: 'last',
					firstClass: 'first'
				}).on("page", function(event, num){
					
					reloadResultList1(num);

				}); 

});
</script>
