<div class="">
	<div class="">
		<?php 
        if (count($this->items) > 0) :
			foreach ($this->items as $item) :

            	$id = $item["ID"];
            	$title = $item["Title"];
            	$introText = $item["IntroText"];
            	$address = $item["DistrictName"];
            	$address .= (empty($address) ? "" : ", ") . $item["ProvinceName"];
            	
				$imageUrl = $this->defaultImageUrl; 
				$status=$item["new"];
				if($item['Created']){
					if($this->lang == 'th') {
						$date = $item["Created"] == null ? '' : Emwork_Utility_DateTime::MSSqlToDateThai($item["Created"]);
					} else {
						$date = $item["Created"] == null ? '' : Emwork_Utility_DateTime::MSSqlToDateEng($item["Created"]);
					}
				}
				if($item['Modified']){
					$Modified = $item['Modified']->format("Y-m-d H:i");
				}
            	if (!empty($item["IntroImageHashName"])) : 
            		$imageUrl = $this->url(array("module" => "default", "controller" => "file", "action" => "get", "type" => "thumbnail", "file" => $item["IntroImageHashName"]), null, true);
            	endif;

            	$viewAmount = number_format($item["ViewAmount"]);
            	$controllerName = empty($this->controllerName) ? "category" :  $this->controllerName;
            	$url = $this->url(array("module" => "wat", "controller" => $controllerName, "action" => "detail", "id" => (empty($this->id) ? null : $this->id), "cid" => empty($this->cid) ? null : $this->cid, "iid" => $id), null, true);
				
		?>		

		<div class="inforow<?php echo $this->watSettingItemShowImage ? "" : " noimgae"; ?>">
			<?php if ($this->watSettingItemShowImage) : ?>
			<div class="image">
				<div class="image-inner">
					<a href="<?php echo $url; ?>">
						<img alt="image" src="<?php echo $imageUrl; ?>" />
					</a>
					<div class="image-date">
						<?php echo $this->lang == 'th' ? Emwork_Utility_DateTime::MSSqlToDateThai($item['Created'],"DT_F") : Emwork_Utility_DateTime::MSSqlToDateEng($item['Created'],"DT_F"); ?>
					</div>
				</div>
			</div>
			<?php endif; ?>
			<div class="detail">
				<div class="detail-title">
					<a href="<?php echo $url; ?>"><?php echo $title; ?></a>
				</div>	
				<?php if ($this->watSettingItemShowAddress) : ?>
				<div class="detail-address" >
					<?php echo $address; ?>
				</div>
				<?php endif; ?>
				<?php if ($this->watSettingItemShowIntroText) : ?>
				<div class="detail-intro" >
					<?php echo nl2br($introText); ?>
				</div>
				<?php endif; ?>	
				<div class="detail-date">
					<em class="fa fa-calendar"></em> <span class="date"><?php echo $date; ?></span>
					<span class="line">| </span>
					<em class="fa fa-eye"></em> <span class="viewamount"><?php echo $viewAmount; ?></span>
					<span class="line">| </span>
					<div class="detailbt"><a href="<?php echo $url; ?>" class="btn btn-info"><?php echo Emwork_Translate::text($this->lang, 'wat', 'detail') ?></a></div>
				</div>
			</div>
			<div class="clearfix"></div>
		</div>
		<?php 
        	endforeach;
        endif;
        ?>
	</div>
</div>