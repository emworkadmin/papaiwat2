<div class="">
	<div class="row">
        <?php 
        $col = "col-md-4 col-sm-6 col-xs-12";
        if ($this->contentSettingCategoryAmountColumn == 2) : 
        	$col = "col-md-6 col-sm-6 col-xs-12";
        elseif ($this->contentSettingCategoryAmountColumn == 3) :
        	$col = "col-md-4 col-sm-6 col-xs-12";
        else :
        	$col = "col-md-3 col-sm-6 col-xs-12";
        endif;
        
        
        if (count($this->items) > 0) :
	        foreach ($this->items as $item) :
	        
	        $id = $item["ID"];
	        $title = $item["Title"];
	        $introText = $item["IntroText"];
	        $imageUrl = $this->defaultImageUrl;
	        if (!empty($item["IntroImageHashName"])) :
	        	$imageUrl = $this->url(array("module" => "default", "controller" => "file", "action" => "get", "type" => "thumbnail", "file" => $item["IntroImageHashName"]), null, true);
				endif;
				if($this->lang == 'th') {
					$date = $item["Created"] == null ? '' : Emwork_Utility_DateTime::MSSqlToDateThai($item["Created"]);
				} else {
					$date = $item["Created"] == null ? '' : Emwork_Utility_DateTime::MSSqlToDateEng($item["Created"]);
				}
				if($this->id==0) {
					$url = $this->url(array("module" => "content", "controller" => "category", "action" => "index", "id" => $id), null, true);
				} else {
					$url = $this->url(array("module" => "content", "controller" => "category", "action" => "articles", "id" => $this->id, "cid" => $id), null, true);
				}
				if($item['Created']){
					// $date = $item['Created']->format("Y-m-d H:i");
					if($this->lang == 'th') {
						$date = $item["Created"] == null ? '' : Emwork_Utility_DateTime::MSSqlToDateThai($item["Created"]);
					} else {
						$date = $item["Created"] == null ? '' : Emwork_Utility_DateTime::MSSqlToDateEng($item["Created"]);
					}

				}
				if($item['Modified']){
					$Modified = $item['Modified']->format("Y-m-d H:i");
				}
				if($this->setting->contentSettingNewdistancedate){
					$datenow = new Datetime($now);
					$datenow->sub(new DateInterval('P'.$this->setting->contentSettingNewdistancedate.'D'));	
					$now = date("Y-m-d H:i");
					$dataperiodnew = $datenow->format('Y-m-d H:i');
					if($this->lang == 'th') {
						$dataperiodnew =Emwork_Utility_DateTime::MySqlToDateThai($dataperiodnew);
					} else {
						$dataperiodnew =Emwork_Utility_DateTime::MySqlToDateEng($dataperiodnew);
					}
					
				}

				if($this->setting->contentSettingUpdatedistancedate){
					$datenowupdate = new Datetime($now);
					$datenowupdate->sub(new DateInterval('P'.$this->setting->contentSettingUpdatedistancedate.'D'));	
					$now = date("Y-m-d H:i");
					$dataperiodupdate = $datenowupdate->format('Y-m-d H:i');
					if($this->lang == 'th') {
						$dataperiodupdate =Emwork_Utility_DateTime::MySqlToDateThai($dataperiodupdate);
					} else {
						$dataperiodupdate =Emwork_Utility_DateTime::MySqlToDateEng($dataperiodupdate);
					}
				}
        ?>
		<div class="<?php echo $col; ?>">
			<div class="infocard">
				<?php if ($this->contentSettingCategoryShowImage) : ?>
				<div class="image">
					<div class="image-inner">
						<a href="<?php echo $url; ?>">
							<img alt="image" src="<?php echo $imageUrl; ?>" />
						</a>
					</div>
				</div>
				<?php endif; ?>
				<div class="detail">
					<div class="detail-title">
						<a href="<?php echo $url; ?>"><?php echo $title; ?></a>
						<?php if($this->setting->contentSettingNewdistancedate){ ?>
							<?php foreach ($this->datanewforicon as $new) {?>
								<?php if($id==$new['ID']){ ?>
									<?php if($date > $dataperiodnew ){ ?>
										<span class="imgnew">
										<img alt="image" src="<?php echo $this->baseUrl('/assets/content/icon/new.gif'); ?>" />
										
										</span>
									<?php } ?>
								<?php } ?>
							<?php } ?>
						<?php } ?>

						<?php if($this->setting->contentSettingUpdatedistancedate){ ?>
							<?php foreach ($this->dataupdateforicon as $update) {?>
								<?php if($id==$update['ID']){ ?>			
									<?php if($Modified > $dataperiodupdate ){ ?>
										<span class="imgupdate">
										<img alt="image" src="<?php echo $this->baseUrl('/assets/content/icon/update.gif'); ?>" />
										</span>
									<?php } ?>
								<?php } ?>
							<?php } ?>
						<?php } ?>	
					</div>				
					<?php if ($this->contentSettingCategoryShowIntroText) : ?>
					<div class="detail-intro" >
						<?php echo nl2br($introText); ?>
					</div>
					<?php endif; ?>
					<div class="detail-date">
				
						<div class="detailbt"><a href="<?php echo $url; ?>" class="btn btn-info"><?php echo Emwork_Translate::text($this->lang, 'content', 'detail'); ?></a> </div>
						<em class="fa fa-calendar"></em> <?php echo $date; ?>
					</div>
				</div>
			</div>
		</div>
        <?php 
        	endforeach;
        endif;
        ?>
	</div>
</div>