 <?php 
 if($this->setting->ItemCustomCss){
	echo '<style>'.$this->setting->ItemCustomCss.'</style>';
 } else {
	echo '<style>.weblink-box { display: inline-block; padding: 15px; }</style>';
 }
 ?>
 
<div class="info infopage weblink-cards">
 	<div class="item-title title-panel">
		<span class="title">
			<?php echo $this->pageTitle; ?>
		</span>
		<hr />
	</div>
 
    <div class="result-list-panel">
		<?php 
		if(count($this->dataList)>0){
			$imgWidth = empty($this->setting->ItemWeblinkSizeWidth) ? 150 : $this->setting->ItemWeblinkSizeWidth;
			$imgHeight = empty($this->setting->ItemWeblinkSizeHeight) ? 80 : $this->setting->ItemWeblinkSizeHeight;
			foreach($this->dataList as $k=>$v){
				$imgPath = $this->url(array('module' => 'default', 'controller' => 'file', 'action' => 'get', 'file' => $v["IntroImageHashName"]), null, true);

				echo "<div class='weblink-box' id=".$v['ID'].">";
				echo "	<a href='".$v['Url']."' target='".$v['LinkTarget']."'>"; 
				echo "		<img alt=\"image\" src='".$imgPath."' width='".$imgWidth."' height='".$imgHeight."'>"; 
				echo "	</a>"; 
				if($this->setting->ItemShowTitle == 'Y'){
					echo "	<div class='weblink-title'>";
					echo "		<a href='".$v['Url']."' target='".$v['LinkTarget']."'>";
					echo "			".$v['Title'];
					echo "		</a>";
					echo "	</div>";
				}
				if($this->setting->ItemShowIntroText == 'Y'){
					echo "	<div class='weblink-intro-text'>";
					echo "		<a href='".$v['Url']."' target='".$v['LinkTarget']."'>";
					echo "			".nl2br($v['IntroText']);
					echo "		</a>";
					echo "	</div>";
				}
				if($this->setting->ItemShowButton == 'Y') {
					echo "	<a class='btn btn-info weblink-button' href='".$v['Url']."'>".Emwork_Translate::text($this->lang, 'weblink', 'view_detail')."</a>";
				}
				echo "</div>";

				echo  "
					<script>
						$('.weblink-box#".$v['ID']."').click(function() {
							$.post('".$this->url(array('module' => 'weblink', 'controller' => 'item', 'action' => 'click'), null, true)."', { id: ".$v['ID']." });
						});
					</script>
				";
			}
		}
		?>
    </div>
</div>