<script>

	$("a").click(function() {
		var Kind = $(this).data("kind");
		var Type  = $(this).data("type");
		var MainTypeCode = $(this).data("maintypecode");
		if(Kind) {
			window.location = "<?php echo $this->url(array('module' => 'info', 'controller' => 'index', 'action' => 'search'), null, true); ?>" + "/maintype/" + MainTypeCode + "/type/K" + Kind;
		} else if (Type) {
			window.location = "<?php echo $this->url(array('module' => 'info', 'controller' => 'index', 'action' => 'search'), null, true); ?>" + "/maintype/" + MainTypeCode + "/type/" + Type;
		}
	})
	
</script>