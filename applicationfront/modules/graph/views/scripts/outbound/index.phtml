                $("#ExportBudget").val('export');
            } else if(val == 'pdf') {
                let canvas = $("#previewImage canvas")[0];
                let imgData = canvas.toDataURL("image/jpeg");
                let pdf = new jsPDF("l", "mm", "a4");
                pdf.addImage(imgData, 'JPEG', 0, 0);
                pdf.save("รายจ่ายนักท่องเที่ยวชาวไทยขาออกรายปี.pdf");
                $("#ExportBudget").val('export');
            }
        });
    }
    $("#ExportBudget").change(function() {
        setCanvas_ExportBudgetZone($(this).val());
    });
	function setCanvas_ExportOutboundZone(val) {
        html2canvas(document.querySelector("#chart3")).then(function(canvas) {
            $("#previewImage").html(canvas);
            if(val == 'image') {
                let imgageData = canvas.toDataURL("image/png");
                let newData = imgageData.replace(/^data:image\/png/, "data:application/octet-stream");
                $("#downloadImage").attr("download", "จำนวนนักท่องเที่ยวชาวไทยขาออกรายปี.png").attr("href", newData);
                $("#downloadImage")[0].click();
                $("#ExportOutbound").val('export');
            } else if(val == 'pdf') {
                let canvas = $("#previewImage canvas")[0];
                let imgData = canvas.toDataURL("image/jpeg");
                let pdf = new jsPDF("l", "mm", "a4");
                pdf.addImage(imgData, 'JPEG', 0, 0);
                pdf.save("จำนวนนักท่องเที่ยวชาวไทยขาออกรายปี.pdf");
                $("#ExportOutbound").val('export');
            }
        });
    }
    $("#ExportOutbound").change(function() {
        setCanvas_ExportOutboundZone($(this).val());
    });

});
