<script>

    function setCanvas_ExchangeExportZone(val) {
        html2canvas(document.querySelector("#ExchangeExportZone")).then(function(canvas) {
            $("#previewImage_Exchange").html(canvas);
            if(val == 'image') {
                let imgageData = canvas.toDataURL("image/png");
                let newData = imgageData.replace(/^data:image\/png/, "data:application/octet-stream");
                $("#downloadImage_Exchange").attr("download", "อัตราแลกเปลี่ยนเงินตราต่างประเทศ.png").attr("href", newData);
                $("#downloadImage_Exchange")[0].click();
                $("#Exchange_Export").val('export');
            } else if(val == 'pdf') {
                let canvas = $("#previewImage_Exchange canvas")[0];
                let imgData = canvas.toDataURL("image/jpeg");
                let pdf = new jsPDF("l", "mm", "a4");
                pdf.addImage(imgData, 'JPEG', 0, 0);
                pdf.save("อัตราแลกเปลี่ยนเงินตราต่างประเทศ.pdf");
                $("#Exchange_Export").val('export');
            }
        });
    }
    $("#Exchange_Export").change(function() {
        setCanvas_ExchangeExportZone($(this).val());
    });

    $("#Exchange_Year").change(function() {
        var situationYear = $('#Situation_Year').val();
        var exchangeYear = $('#Exchange_Year').val();
        window.location = "<?php echo $this->url(array('module' => 'graph', 'controller' => 'investment', 'action' => 'search'), null, true); ?>/situationYear/"+situationYear+"/exchangeYear/"+exchangeYear;
    });
</script>