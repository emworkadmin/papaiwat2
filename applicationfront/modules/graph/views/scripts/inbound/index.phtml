function setCanvas_InboundZone(val) {
	html2canvas(document.querySelector("#chart1")).then(function(canvas) {
		$("#previewImage").html(canvas);
		if(val == 'image') {
			let imgageData = canvas.toDataURL("image/png");
			let newData = imgageData.replace(/^data:image\/png/, "data:application/octet-stream");
			$("#downloadImage").attr("download", "จำนวนนักท่องเที่ยวต่างชาติที่เดินทางมาประเทศไทย (Inbound).png").attr("href", newData);
			$("#downloadImage")[0].click();
			$("#ExportInbound").val('export');
		} else if(val == 'pdf') {
			let canvas = $("#previewImage canvas")[0];
			let imgData = canvas.toDataURL("image/jpeg");
			let pdf = new jsPDF("l", "mm", "a4");
			pdf.addImage(imgData, 'JPEG', 0, 0);
			pdf.save("จำนวนนักท่องเที่ยวต่างชาติที่เดินทางมาประเทศไทย (Inbound).pdf");
			$("#ExportInbound").val('export');
		}
	});
}
$("#ExportInbound").change(function() {
	setCanvas_InboundZone($(this).val());
});

