							endforeach;
						// else :
						// 	echo "58.08, 0, 0, 0";
						endif;
						?>],
				backgroundColor: "#FF7875",
				borderWidth: 1
			}]	
		},
		options: {
            hover: {
                animationDuration: 0
            },
            animation: {
                duration: 0,
                onComplete: function () {
                    var chartInstance = this.chart,ctx = chartInstance.ctx;                    
                    ctx.textAlign = 'center';
                    ctx.textBaseline = 'bottom';
                    ctx.font = Chart.helpers.fontString(14, 'normal', 'Tahoma');
                    this.data.datasets.forEach(function (dataset, i) {
                        var meta = chartInstance.controller.getDatasetMeta(i);
                        meta.data.forEach(function (bar, index) {
                            var data = dataset.data[index];
							data = data.toString().replace(/(\d)(?=(\d{3})+(?!\d))/g, "$1,");
							data = parseFloat(data).toFixed(2);
							var y = 0;
							if(data<0) {
								y = 16;
							}
                            ctx.fillText(data + "%", bar._model.x, bar._model.y + y);
                        });
                    });
                }
            },
			scales: {
                yAxes: [{
                    ticks: {
                        beginAtZero:true,
						fontSize: 14,
						max: 100,
						// min: 0,
						stepSize: 25,
						callback: function(value, index, values) {
							return value+'%';
						}
                    }
                }],
				xAxes: [{
					ticks: {
						fontSize:14
					},
                    barPercentage: 0.5
                }]
			},
			tooltips: {
				enabled: true,
				backgroundColor : "rgb(234, 234, 234)",
				titleFontColor : "black",
				bodyFontColor : "black",
				callbacks: {
					label: function(tooltipItems, data) {
						return "อัตราการเติบโตของรายได้ : "+parseFloat(tooltipItems.yLabel).toFixed(2) + "%";
					}
				}
			},
			legend: {
				display: false,
				
			},
			responsive: true		
		}
	});
    function setCanvas_SituationExportZoneplaceNation(val) {
        html2canvas(document.querySelector("#placeNation")).then(function(canvas) {
            $("#previewImage").html(canvas);
            if(val == 'image') {
                let imgageData = canvas.toDataURL("image/png");
                let newData = imgageData.replace(/^data:image\/png/, "data:application/octet-stream");
                $("#downloadImage").attr("download", "ข้อมูลการท่องเที่ยวในพื้นที่อนุรักษ์.png").attr("href", newData);
                $("#downloadImage")[0].click();
                $("#ExportNation").val('export');
            } else if(val == 'pdf') {
                let canvas = $("#previewImage canvas")[0];
                let imgData = canvas.toDataURL("image/jpeg");
                let pdf = new jsPDF("l", "mm", "a4");
                pdf.addImage(imgData, 'JPEG', 0, 0);
                pdf.save("ข้อมูลการท่องเที่ยวในพื้นที่อนุรักษ์.pdf");
                $("#ExportNation").val('export');
            }
        });
    }
    $("#ExportNation").change(function() {
        setCanvas_SituationExportZoneplaceNation($(this).val());
	});
	
