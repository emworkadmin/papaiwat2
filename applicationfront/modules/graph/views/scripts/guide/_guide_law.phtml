<script>
jQuery(function(){

    var ctx1 = document.getElementById('myChart3');
    var myBarChart  = new Chart(ctx1, {
        type: 'horizontalBar',
        data: {
            labels: [
                <?php
                if(count($this->topicguidearrest)>0) {
                    foreach($this->topicguidearrest as $k => $v) {
                        echo "'" . $v['AllegationDetailTH'] . "'";
                        if($k != count($this->topicguidearrest) -1)
                            echo ",";
                    }
                } else {
                }
                ?>
            ],
            datasets: [{
                label: "",
                backgroundColor: '#fea1a2',
                data: [
                    <?php
                    if(count($this->topicguidearrest)>0) {
                        foreach($this->topicguidearrest as $k => $v) {
                            echo $v['Amount'];
                            if($k != count($this->topicguidearrest) -1)
                                echo ",";
                        }
                    } else {
                    }
                    ?>
                ],
            }]
        },
        options: {
            hover: {
                animationDuration: 0
            },
            animation: {
                duration: 1,
                onComplete: function () {
                    var chartInstance = this.chart,
                        ctx = chartInstance.ctx;
                    
                    ctx.textAlign = 'center';
                    ctx.font = Chart.helpers.fontString(14, 'normal', 'Tahoma');
                    ctx.textBaseline = 'bottom';
                    this.data.datasets.forEach(function (dataset, i) {
                        var meta = chartInstance.controller.getDatasetMeta(i);
                        meta.data.forEach(function (bar, index) {
                            var data = dataset.data[index];
                            data = data.toString().replace(/(\d)(?=(\d{3})+(?!\d))/g, "$1,")
                            ctx.fillText(data, bar._model.x - data.length * 4, bar._model.y + 7);
                        });
                    });
                }
            },
                legend: {
                display: false
            },
            tooltips: {
                enabled: true,
                backgroundColor : "rgb(234, 234, 234)",
                titleFontColor : "black",
                bodyFontColor : "black"
            },
            scales: {
                yAxes: [{
                    // display: false,
                    gridLines: {
                        display : false
                    },
                    ticks: {
                        // display: false,
                        beginAtZero:true,
                        fontSize: 14
                    }
                }],
                xAxes: [{
                    gridLines: {
                        // display : false
                    },
                    ticks: {
                        beginAtZero:true,
                        fontSize: 14
                    }
                }]
            },
            responsive: true
        }
    });

    function setCanvas_law_travel(val) {
        html2canvas(document.querySelector("#Law_travel")).then(function(canvas) {
            $("#previewImage_guide_law").html(canvas);
            if(val == 'image') {
                let imgageData = canvas.toDataURL("image/png");
                let newData = imgageData.replace(/^data:image\/png/, "data:application/octet-stream");
                $("#downloadImage_guide_law").attr("download", "จำนวนมัคคุเทศก์ที่ถูกจับกุม.png").attr("href", newData);
                $("#downloadImage_guide_law")[0].click();
                $("#guide_law_Export").val('export');
            } else if(val == 'pdf') {
                let canvas = $("#previewImage_guide_law canvas")[0];
                let imgData = canvas.toDataURL("image/jpeg");
                let pdf = new jsPDF("l", "mm", "a4");
                pdf.addImage(imgData, 'JPEG', 0, 0);
                pdf.save("จำนวนมัคคุเทศก์ที่ถูกจับกุม.pdf");
                $("#guide_law_Export").val('export');
            }
        });
    }

    $("#guide_law_Export").change(function() {
        setCanvas_law_travel($(this).val());
    });


});
</script>



































































