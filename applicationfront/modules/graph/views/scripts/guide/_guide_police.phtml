function setCanvas_PoliceExportZone(val) {
    html2canvas(document.querySelector("#PoliceExportZone")).then(function(canvas) {
        $("#previewImage_guide_police").html(canvas);
        if(val == 'image') {
            let imgageData = canvas.toDataURL("image/png");
            let newData = imgageData.replace(/^data:image\/png/, "data:application/octet-stream");
            $("#downloadImage_guide_police").attr("download", "จำนวนตำรวจท่องเที่ยวและอาสาสมัครตำรวจท่องเที่ยว.png").attr("href", newData);
            $("#downloadImage_guide_police")[0].click();
            $("#guide_police_Export").val('export');
        } else if(val == 'pdf') {
            let canvas = $("#previewImage_guide_police canvas")[0];
            let imgData = canvas.toDataURL("image/jpeg");
            let pdf = new jsPDF("l", "mm", "a4");
            pdf.addImage(imgData, 'JPEG', 0, 0);
            pdf.save("จำนวนตำรวจท่องเที่ยวและอาสาสมัครตำรวจท่องเที่ยว.pdf");
            $("#guide_police_Export").val('export');
        }
    });
}

$("#guide_police_Export").change(function() {
    setCanvas_PoliceExportZone($(this).val());
});

