    function setCanvas_InOutExportZone(val) {
        html2canvas(document.querySelector("#InOutExportZone")).then(function(canvas) {
            $("#previewImage_InOut").html(canvas);
            if(val == 'image') {
                let imgageData = canvas.toDataURL("image/png");
                let newData = imgageData.replace(/^data:image\/png/, "data:application/octet-stream");
                $("#downloadImage_InOut").attr("download", "จำนวนผู้เดินทางเข้าและออกประเทศไทย.png").attr("href", newData);
                $("#downloadImage_InOut")[0].click();
                $("#InOut_Export").val('export');
            } else if(val == 'pdf') {
                let canvas = $("#previewImage_InOut canvas")[0];
                let imgData = canvas.toDataURL("image/jpeg");
                let pdf = new jsPDF("l", "mm", "a4");
                pdf.addImage(imgData, 'JPEG', 0, 0);
                pdf.save("จำนวนผู้เดินทางเข้าและออกประเทศไทย.pdf");
                $("#InOut_Export").val('export');
            }
        });
    }

    $("#InOut_Export").change(function() {
        setCanvas_InOutExportZone($(this).val());
    });

    $("#InOut_Year").change(function() {
        var checkPointYear = $('#CheckPoint_Year').val();
        var inOutYear = $('#InOut_Year').val();
        var numberTouristsYear = $('#NumberTourists_Year').val();
        window.location = "<?php echo $this->url(array('module' => 'graph', 'controller' => 'travelstatistics', 'action' => 'search'), null, true); ?>/checkPointYear/"+checkPointYear+"/inOutYear/"+inOutYear+"/numberTouristsYear/"+numberTouristsYear;
