    function setCanvas_CheckPointExportZone(val) {
        html2canvas(document.querySelector("#CheckPointExportZone")).then(function(canvas) {
            $("#previewImage_CheckPoint").html(canvas);
            if(val == 'image') {
                let imgageData = canvas.toDataURL("image/png");
                let newData = imgageData.replace(/^data:image\/png/, "data:application/octet-stream");
                $("#downloadImage_CheckPoint").attr("download", "จำนวนผู้เดินทางเข้าและออกประเทศไทย.png").attr("href", newData);
                $("#downloadImage_CheckPoint")[0].click();
                $("#CheckPoint_Export").val('export');
            } else if(val == 'pdf') {
                let canvas = $("#previewImage_CheckPoint canvas")[0];
                let imgData = canvas.toDataURL("image/jpeg");
                let pdf = new jsPDF("l", "mm", "a4");
                pdf.addImage(imgData, 'JPEG', 0, 0);
                pdf.save("จำนวนผู้เดินทางเข้าและออกประเทศไทย.pdf");
                $("#CheckPoint_Export").val('export');
            }
        });
    }
    $("#CheckPoint_Export").change(function() {
        setCanvas_CheckPointExportZone($(this).val());
    });

