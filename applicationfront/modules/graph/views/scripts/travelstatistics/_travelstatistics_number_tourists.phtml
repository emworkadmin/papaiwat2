    function setCanvas_NumberTouristsExportZone(val) {
        html2canvas(document.querySelector("#NumberTouristsExportZone")).then(function(canvas) {
            $("#previewImage_NumberTourists").html(canvas);
            if(val == 'image') {
                let imgageData = canvas.toDataURL("image/png");
                let newData = imgageData.replace(/^data:image\/png/, "data:application/octet-stream");
                $("#downloadImage_NumberTourists").attr("download", "จำนวนผู้เดินทางเข้าและออกประเทศไทย.png").attr("href", newData);
                $("#downloadImage_NumberTourists")[0].click();
                $("#NumberTourists_Export").val('export');
            } else if(val == 'pdf') {
                let canvas = $("#previewImage_NumberTourists canvas")[0];
                let imgData = canvas.toDataURL("image/jpeg");
                let pdf = new jsPDF("l", "mm", "a4");
                pdf.addImage(imgData, 'JPEG', 0, 0);
                pdf.save("จำนวนผู้เดินทางเข้าและออกประเทศไทย.pdf");
                $("#NumberTourists_Export").val('export');
            }
        });
    }
    $("#NumberTourists_Export").change(function() {
        setCanvas_NumberTouristsExportZone($(this).val());
    });    

    $("#NumberTourists_Year").change(function() {
        var checkPointYear = $('#CheckPoint_Year').val();
