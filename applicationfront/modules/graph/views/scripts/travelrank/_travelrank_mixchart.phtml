<script>

jQuery(function() {

    var ctxmix = document.getElementById('myChartMixchart');
    var mixedChart = new Chart(ctxmix, {
        type: 'bar',
        data: {
            datasets: [{
                label: 'จำนวนผู้เข้าพัก',
                data: [
                    <?php
                    if(count($this->guestByQuarter)>0) {
                    	foreach ($this->guestByQuarter as $k => $v) {
                            echo number_format($v['Amount']/1000000, 1) . ",";
                        }
                    }
                    ?>
                ],
                backgroundColor: 'rgba(2, 184, 171, 0.6)',
                borderColor: 'rgb(2, 184, 171)',
                yAxisID: 'y-axis-1',
            },{
                label: 'อัตราเข้าพักเฉลี่ย',
                data: [
                    <?php
                    if(count($this->orByQuarter)>0) {
                    	foreach ($this->orByQuarter as $k => $v) {
                            echo number_format($v['Amount'], 1) . ",";
                        }
                    }
                    ?>
                ],
                backgroundColor: 'rgba(0,0,0,0)',
                borderColor: '#000000',
                type: 'line',
                lineTension : 0,
                yAxisID: 'y-axis-2',
            }],
            labels: [
                "<?php echo ($this->MixchartYear + 543); ?>/Q1",
                "<?php echo ($this->MixchartYear + 543); ?>/Q2",
                "<?php echo ($this->MixchartYear + 543); ?>/Q3",
                "<?php echo ($this->MixchartYear + 543); ?>/Q4",
            ]
        },
        options: {
            scales: {
                yAxes: [{
                    display: true,
                    position: 'left',
                    id: 'y-axis-1',
                    ticks: {
                        fontSize : 14,
                        beginAtZero: true,
                        callback: function(value, index, values) {
                            return value + 'M';
                        }
                    }
                }, {
                    display: true,
                    position: 'right',
                    id: 'y-axis-2',
                    gridLines: {
                        drawOnChartArea: false,
                    },
                }],
                xAxes: [{
                    gridLines: {
                        display : false
                    },
                    ticks: {
                        fontSize: 14,
                        beginAtZero:true
                    }
                }]
            },
            hover: {
                animationDuration: 0
            },
            animation: {
                duration: 1,
                onComplete: function() {
                    var chartInstance = this.chart,
                    ctx = chartInstance.ctx;
                    ctx.font = "14px ",
                    ctx.textAlign = 'center';
                    ctx.textBaseline = 'bottom';
                    ctx.fillStyle = '#666';
                    ctx.font = Chart.helpers.fontString(14, 'normal', 'Tahoma');
                    this.data.datasets.forEach(function(dataset, i) {
                        var meta = chartInstance.controller.getDatasetMeta(i);
                        meta.data.forEach(function(bar, index) {
                            var data = dataset.data[index];
                            // var tmp_data = data.toFixed(2).toString().split(".");
							// data = tmp_data[0].replace(/(\d)(?=(\d{3})+(?!\d))/g, "$1,") + '.' + tmp_data[1];
                            data = data.toString().replace(/(\d)(?=(\d{3})+(?!\d))/g, "$1,")
                            ctx.fillText(data, bar._model.x, bar._model.y - data.length);
                        });
                    });
                }
            },
			tooltips: {
                enabled: true,
                backgroundColor : "rgb(234, 234, 234)",
                titleFontColor : "black",
                bodyFontColor : "black"
            },
            responsive: true
        }
    });

});

function setCanvas_MixchartExportZone(val) {
    html2canvas(document.querySelector("#MixchartExportZone")).then(function(canvas) {
        $("#previewImage_mix_chart").html(canvas);
        if(val == 'image') {
            let imgageData = canvas.toDataURL("image/png");
            let newData = imgageData.replace(/^data:image\/png/, "data:application/octet-stream");
            $("#downloadImage_mix_chart").attr("download", "จำนวนผู้เดินทางเข้าและออกประเทศไทย.png").attr("href", newData);
            $("#downloadImage_mix_chart")[0].click();
            $("#mix_chart_Export").val('export');
        } else if(val == 'pdf') {
            let canvas = $("#previewImage_mix_chart canvas")[0];
            let imgData = canvas.toDataURL("image/jpeg");
            let pdf = new jsPDF("l", "mm", "a4");
            pdf.addImage(imgData, 'JPEG', 0, 0);
            pdf.save("จำนวนผู้เดินทางเข้าและออกประเทศไทย.pdf");
            $("#mix_chart_Export").val('export');
        }
    });
}

$("#MixchartExport").change(function() {
    setCanvas_MixchartExportZone($(this).val());
});

</script>