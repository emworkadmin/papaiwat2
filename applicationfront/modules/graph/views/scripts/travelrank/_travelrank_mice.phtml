    function setCanvas_MiceExportZone(val) {
        html2canvas(document.querySelector("#MiceExportZone")).then(function(canvas) {
            $("#previewImage_mice").html(canvas);
            if(val == 'image') {
                let imgageData = canvas.toDataURL("image/png");
                let newData = imgageData.replace(/^data:image\/png/, "data:application/octet-stream");
                $("#downloadImage_mice").attr("download", "จำนวนผู้เดินทางเข้าและออกประเทศไทย.png").attr("href", newData);
                $("#downloadImage_mice")[0].click();
                $("#mix_chart_Export").val('export');
            } else if(val == 'pdf') {
                let canvas = $("#previewImage_mice canvas")[0];
                let imgData = canvas.toDataURL("image/jpeg");
                let pdf = new jsPDF("l", "mm", "a4");
                pdf.addImage(imgData, 'JPEG', 0, 0);
                pdf.save("จำนวนผู้เดินทางเข้าและออกประเทศไทย.pdf");
                $("#mix_chart_Export").val('export');
            }
        });
    }

