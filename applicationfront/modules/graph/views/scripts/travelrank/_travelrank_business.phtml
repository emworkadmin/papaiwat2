function setCanvas_BusinessZone(val) {
    html2canvas(document.querySelector("#BusinessZone")).then(function(canvas) {
        $("#previewImage_business").html(canvas);
        if(val == 'image') {
            let imgageData = canvas.toDataURL("image/png");
            let newData = imgageData.replace(/^data:image\/png/, "data:application/octet-stream");
            $("#downloadImage_business").attr("download", "ข้อมูลผู้ประกอบการธุรกิจนำเที่ยวและผู้นำเที่ยว.png").attr("href", newData);
            $("#downloadImage_business")[0].click();
            $("#business_Export").val('export');
        } else if(val == 'pdf') {
            let canvas = $("#previewImage_business canvas")[0];
            let imgData = canvas.toDataURL("image/jpeg");
            let pdf = new jsPDF("l", "mm", "a4");
            pdf.addImage(imgData, 'JPEG', 0, 0);
            pdf.save("ข้อมูลผู้ประกอบการธุรกิจนำเที่ยวและผู้นำเที่ยว.pdf");
            $("#business_Export").val('export');
        }
    });
}

$("#businessExport").change(function() {
    setCanvas_BusinessZone($(this).val());
});

</script>