function setCanvas_TravelExportZone(val) {
    html2canvas(document.querySelector("#TravelExportZone")).then(function(canvas) {
        $("#previewImage_travel").html(canvas);
        if(val == 'image') {
            let imgageData = canvas.toDataURL("image/png");
            let newData = imgageData.replace(/^data:image\/png/, "data:application/octet-stream");
            $("#downloadImage_travel").attr("download", "จำนวนผู้เดินทางเข้าและออกประเทศไทย.png").attr("href", newData);
            $("#downloadImage_travel")[0].click();
            $("#mix_chart_Export").val('export');
        } else if(val == 'pdf') {
            let canvas = $("#previewImage_travel canvas")[0];
            let imgData = canvas.toDataURL("image/jpeg");
            let pdf = new jsPDF("l", "mm", "a4");
            pdf.addImage(imgData, 'JPEG', 0, 0);
            pdf.save("จำนวนผู้เดินทางเข้าและออกประเทศไทย.pdf");
            $("#mix_chart_Export").val('export');
        }
    });
}

$("#travelExport").change(function() {
    setCanvas_TravelExportZone($(this).val());
});

</script>