<script>

jQuery(function(){

var ctx1 = document.getElementById('myChart3').getContext('2d');

var myBarChart  = new Chart(ctx1, {
    // The type of chart we want to create
    type: 'horizontalBar',

    // The data for our dataset
    data: {
        labels: ["ประกอบอาชีพมัคคุเทศก์โดยมิได้รับอนุญาต", "ประกอบอาชีพธุรกิจนำเที่ยวโดยไม่ได้รับอนุญาตจากนายทะเบียน", "ไม่ติดบัตรประจำตัวมัคคุเทศก์ขณะปฏิบัติหน้าที่", "เป็นมัคคุเทศก์ไม่ปฏิบัติตามระเบียบกำหนด(แต่งกายไม่สุภาพ)", "ไม่แสดงใบอนุญาตประะกอบธุรกิจนำเที่ยวไว้ในที่เปิดเผย", "มัคคุเทศก์แต่ไม่ปฏิบัติตามระเบียบที่คณะกรรมการกำหนด", "ไม่รับผิดชอบงานในหน้าที่มัคคุเทศก์","เป็นบุคคลต่างด้าวประกอบอาชีพมัคคุเทศก์โดยไม่ได้รับอนุญาต"],
        datasets: [{
            label: "My First dataset",
            backgroundColor: '#fea1a2',
            // borderColor: '#fea1a2',
            data: [91, 33, 29, 13, 10, 7, 6, 4],
        }]
    },

        options: {
            hover: {
                animationDuration: 0
            },
            animation: {
                duration: 1,
                onComplete: function () {
                    var chartInstance = this.chart,
                        ctx = chartInstance.ctx;
                    
                    ctx.font = Chart.helpers.fontString(Chart.defaults.global.defaultFontSize, Chart.defaults.global.defaultFontStyle, Chart.defaults.global.defaultFontFamily);
                    ctx.textAlign = 'center';
                    ctx.textBaseline = 'bottom';
                    this.data.datasets.forEach(function (dataset, i) {
                        var meta = chartInstance.controller.getDatasetMeta(i);
                        meta.data.forEach(function (bar, index) {
                            var data = dataset.data[index];
                            var x = -10;
                            if(data < 0) {
                                x = +10;
                            }                                                
                            ctx.fillText(data, bar._model.x + x, bar._model.y + 7);
                        });
                    });
                }
            },
                legend: {
                display: false
            },
            tooltips: {
                enabled: true,
                backgroundColor : "rgb(234, 234, 234)",
                titleFontColor : "black",
                bodyFontColor : "black"
            },
            scales: {
                yAxes: [{
                    // display: false,
                    gridLines: {
                        display : false
                    },
                    ticks: {
                        // display: false,
                        beginAtZero:true
                    }
                }],
                xAxes: [{
                    gridLines: {
                        // display : false
                    },
                    ticks: {
                        beginAtZero:true
                    }
                }]
            },
            responsive: true
        }

});

    function setCanvas_law_travel(val) {
        html2canvas(document.querySelector("#law_travel")).then(function(canvas) {
            $("#previewImage_guide_law").html(canvas);
            if(val == 'image') {
                let imgageData = canvas.toDataURL("image/png");
                let newData = imgageData.replace(/^data:image\/png/, "data:application/octet-stream");
                $("#downloadImage_guide_law").attr("download", "จำนวนผู้เดินทางเข้าและออกประเทศไทย.png").attr("href", newData);
                $("#downloadImage_guide_law")[0].click();
                $("#guide_law_Export").val('export');
            } else if(val == 'pdf') {
                let canvas = $("#previewImage_guide_law canvas")[0];
                let imgData = canvas.toDataURL("image/jpeg");
                let pdf = new jsPDF("l", "mm", "a4");
                pdf.addImage(imgData, 'JPEG', 0, 0);
                pdf.save("จำนวนผู้เดินทางเข้าและออกประเทศไทย.pdf");
                $("#guide_law_Export").val('export');
            }
        });
    }

    $("#guide_law_Export").change(function() {
        setCanvas_law_travel($(this).val());
    });


});
</script>