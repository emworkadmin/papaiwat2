<script>

jQuery(function(){

    var ctxdoughnut1 = document.getElementById('mydoughnut1').getContext('2d');
var myBarChart  = new Chart(ctxdoughnut1, {
    // The type of chart we want to create
    type: 'doughnut',

    // The data for our dataset
    data: {
        labels: ["บุคคล","นิติบุคคล",],
        datasets: [{
            label: "My First dataset",
            backgroundColor: ['#02b8ab','#354749'],
            borderColor: ['#02b8ab','#354749'],
            data: [810 , 500],
        }]
    },

    // Configuration options go here
    options: {
                showTooltips: {
                    showLabel: true,
                    showValue: true,
                },
                responsive: true,
                legend : {
                    display: false
                }
            }

    });

    var ctxdoughnut2 = document.getElementById('mydoughnut2').getContext('2d');
    var myBarChart  = new Chart(ctxdoughnut2, {
        // The type of chart we want to create
        type: 'doughnut',

        // The data for our dataset
        data: {
            labels: ["บุคคล","นิติบุคคล",],
            datasets: [{
                label: "My First dataset",
                backgroundColor: ['#fc8281','#dce01d'],
                borderColor: ['#fc8281','#dce01d'],
                data: [300 , 500],
            }]
        },

            options: {
                showTooltips: {
                    showLabel: true,
                    showValue: true,
                },
                responsive: true,
                legend : {
                    display: false
                }
            }

    });

        function setCanvas_BussinateExportZone(val) {
        html2canvas(document.querySelector("#BussinateExportZone")).then(function(canvas) {
            $("#previewImage_business").html(canvas);
            if(val == 'image') {
                let imgageData = canvas.toDataURL("image/png");
                let newData = imgageData.replace(/^data:image\/png/, "data:application/octet-stream");
                $("#downloadImage_business").attr("download", "จำนวนผู้เดินทางเข้าและออกประเทศไทย.png").attr("href", newData);
                $("#downloadImage_business")[0].click();
                $("#business_Export").val('export');
            } else if(val == 'pdf') {
                let canvas = $("#previewImage_business canvas")[0];
                let imgData = canvas.toDataURL("image/jpeg");
                let pdf = new jsPDF("l", "mm", "a4");
                pdf.addImage(imgData, 'JPEG', 0, 0);
                pdf.save("จำนวนผู้เดินทางเข้าและออกประเทศไทย.pdf");
                $("#business_Export").val('export');
            }
        });
    }

    $("#bussinateExport").change(function() {
        setCanvas_BussinateExportZone($(this).val());
    });
});

</script>