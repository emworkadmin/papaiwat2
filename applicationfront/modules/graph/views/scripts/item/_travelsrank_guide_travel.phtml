<script>

jQuery(function(){

        

        function setCanvas_TravelExportZone(val) {
        html2canvas(document.querySelector("#TravelExportZone")).then(function(canvas) {
            $("#previewImage_travel").html(canvas);
            if(val == 'image') {
                let imgageData = canvas.toDataURL("image/png");
                let newData = imgageData.replace(/^data:image\/png/, "data:application/octet-stream");
                $("#downloadImage_travel").attr("download", "จำนวนผู้เดินทางเข้าและออกประเทศไทย.png").attr("href", newData);
                $("#downloadImage_travel")[0].click();
                $("#mix_chart_Export").val('export');
            } else if(val == 'pdf') {
                let canvas = $("#previewImage_travel canvas")[0];
                let imgData = canvas.toDataURL("image/jpeg");
                let pdf = new jsPDF("l", "mm", "a4");
                pdf.addImage(imgData, 'JPEG', 0, 0);
                pdf.save("จำนวนผู้เดินทางเข้าและออกประเทศไทย.pdf");
                $("#mix_chart_Export").val('export');
            }
        });
    }

    $("#travelExport").change(function() {
        setCanvas_TravelExportZone($(this).val());
    });


    var ctxfood = document.getElementById('myChartGuideTravelBar').getContext('2d');
var myBarChart  = new Chart(ctxfood, {
    // The type of chart we want to create
    type: 'horizontalBar',

    // The data for our dataset
    data: {
        labels: ["จีน","ญี่ปุ่น","ฝรั่งเศส","เยอรมัน","เกาหลี"],
        datasets: [{
            backgroundColor: ['#8cc63e','#2188b3','#2188b3','#8cc63e','#8cc63e'],
            borderColor: ['#8cc63e','#2188b3','#2188b3','#8cc63e','#8cc63e'],
            data: [500000 , 300000, 450000, 200000, 320000  ],
        }]
    },
    

    // Configuration options go here
    options: {
            hover: {
                animationDuration: 0
            },
            animation: {
                duration: 1,
                onComplete: function () {
                    var chartInstance = this.chart,
                        ctx = chartInstance.ctx;
                    
                    ctx.font = Chart.helpers.fontString(Chart.defaults.global.defaultFontSize, Chart.defaults.global.defaultFontStyle, Chart.defaults.global.defaultFontFamily);
                    ctx.textAlign = 'center';
                    ctx.textBaseline = 'bottom';
                    this.data.datasets.forEach(function (dataset, i) {
                        var meta = chartInstance.controller.getDatasetMeta(i);
                        meta.data.forEach(function (bar, index) {
                            var data = dataset.data[index];
                            var x = -20;
                            if(data < 0) {
                                x = +20;
                            }                                                
                            ctx.fillText(data, bar._model.x + x, bar._model.y + 7);
                        });
                    });
                }
            },
                legend: {
                display: false
            },
            // showTooltips: {
            //     // showValue: false,
            // },
            tooltips: {
                enabled: true,
                backgroundColor : "rgb(234, 234, 234)",
                titleFontColor : "black",
                bodyFontColor : "black"
            },
            scales: {
                yAxes: [{
                    // display: false,
                    gridLines: {
                        display : false
                    },
                    ticks: {
                        // display: false,
                        beginAtZero:true
                    }
                }],
                xAxes: [{
                    gridLines: {
                        display : false
                    },
                    ticks: {
                        beginAtZero:true
                    }
                }]
            },
            responsive: true
        }

});




var ctxGuideTravel = document.getElementById('myChartGuideTravel').getContext('2d');
var myBarChart  = new Chart(ctxGuideTravel, {
    // The type of chart we want to create
    type: 'doughnut',

    // The data for our dataset
    data: {
        labels: ["ทั่วไป","พิเศษ","ทางการ","เร่งด่วน","บุคคลพิเศษ",],
        datasets: [{
            label: "My First dataset",
            backgroundColor: ['#45af11','#181a1b','#ff615e','#0ab3aa','#f2c510'],
            borderColor:['#45af11','#181a1b','#ff615e','#0ab3aa','#f2c510'],
            data: [300,500,200,50,150],
        }]
    },

    // Configuration options go here
    options: {
            showTooltips: {
                showLabel: true,
                showValue: true,
            },
            responsive: true,
            legend : {
                display: false
            }
        }

});

});

</script>