    function setCanvas_SituationExportZone(val) {
        html2canvas(document.querySelector("#SituationExportZone")).then(function(canvas) {
            $("#previewImage_Situation").html(canvas);
            if(val == 'image') {
                let imgageData = canvas.toDataURL("image/png");
                let newData = imgageData.replace(/^data:image\/png/, "data:application/octet-stream");
                $("#downloadImage_Situation").attr("download", "จำนวนผู้เดินทางเข้าและออกประเทศไทย.png").attr("href", newData);
                $("#downloadImage_Situation")[0].click();
                $("#Situation_Export").val('export');
            } else if(val == 'pdf') {
                let canvas = $("#previewImage_Situation canvas")[0];
                let imgData = canvas.toDataURL("image/jpeg");
                let pdf = new jsPDF("l", "mm", "a4");
                pdf.addImage(imgData, 'JPEG', 0, 0);
                pdf.save("จำนวนผู้เดินทางเข้าและออกประเทศไทย.pdf");
                $("#Situation_Export").val('export');
            }
        });
    }
    $("#Situation_Export").change(function() {
        setCanvas_SituationExportZone($(this).val());
    });
