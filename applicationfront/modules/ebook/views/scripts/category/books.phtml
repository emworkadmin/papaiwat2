<div class="info infopage">
 	
	 <div class="book-title title-panel">
		 <span class="title">
			 <?php echo $this->pageTitle; ?>
		 </span>
		 <hr />
	 </div>
  
	 <div class="result-list-panel">
		 <div class="result-list" id="result-list"></div>
		 <div class="result-paging" style="display: none;">
			 <p class="paging text-right"></p>
		 </div>
	 </div>

	<div class="book-title title-panel" id="book">
		 <span class="title">
			 <?php echo Emwork_Translate::text($this->lang, 'ebook', 'book_list'); ?>
		 </span>
	</div>
 
	 <div class="result-list1-panel">
		 <div class="result-list1" id="result-list1"></div>
		 <div class="result-paging1" style="display: none;">
			 <p class="paging1 text-right"></p>
		 </div>
	 </div>
	 
 </div>

 <script>
 jQuery(function(){
 
	 reloadResultList(1);
 
	 function reloadResultList(pageIndex) {
		 var sendData = {};
		 sendData.pageIndex = pageIndex;
		 $.post("<?php echo $this->url(array('module' => 'ebook', 'controller' => 'category', 'action' => 'getlist', 'id' => $this->id, 'cid' => $this->cid), null, true); ?>", sendData, function(data){

			 if (data.total > 0) {
				console.log(data.html);
				 $("#result-list").html(data.html);
				 $('.result-paging').css('display', '');
				 $('.paging').bootpag({
				 });
 
			 } else {
				 var html = '';
				 $('#result-paging').css('display', 'none');
				 $('.result-list').html(html);
				 $('.paging').bootpag({total : 0});
			 }
		 }, 'json');
	 }
 
	 $('.paging').bootpag({
 
	 }).on("page", function(event, num){
		 reloadResultList(num);
	 }); 
	 
	 reloadResultList1(1);
 
	 function reloadResultList1(pageIndex) {
		 var sendData = {};
		 sendData.pageIndex = pageIndex;
		 $.post("<?php echo $this->url(array('module' => 'ebook', 'controller' => 'book', 'action' => 'getlist', "id" => $this->id, 'cid' => $this->cid), null, true); ?>", sendData, function(data){
			 
			 if (data.total > 0) {
				 
				 $("#result-list1").html(data.html);
				 $('.result-paging1').css('display', '');
				 $('.paging1').bootpag({
					total : data.totalPage,
					page : data.pageIndex,
					maxVisible: 5,
			        leaps: false,
			        firstLastUse: true,
			        first: '<<',
			        last: '>>',
			        next: '>',
			        prev: '<',
			        wrapClass: 'pagination',
			        activeClass: 'active',
			        disabledClass: 'disabled',
			        nextClass: 'next',
			        prevClass: 'prev',
			        lastClass: 'last',
			        firstClass: 'first'
				 });
 
			 } else {
				var html = '';
				console.log(html);
				 $('#result-paging1').css('display', 'none');
				 $('.result-list1').html(html);
				 $('.paging1').bootpag({total : 0});
			 }
		 }, 'json');
	 }
 
	 $('.paging1').bootpag({
		total: 0,
        maxVisible: 5,
        leaps: false,
        firstLastUse: true,
        first: '<<',
        last: '>>',
        next: '>',
        prev: '<',
        wrapClass: 'pagination',
        activeClass: 'active',
        disabledClass: 'disabled',
        nextClass: 'next',
        prevClass: 'prev',
        lastClass: 'last',
        firstClass: 'first'
 
	 }).on("page", function(event, num){
		 reloadResultList1(num);
	 }); 
	 
 });
 
 
 </script>