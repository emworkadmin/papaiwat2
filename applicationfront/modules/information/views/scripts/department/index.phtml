	<div class="form-group" id="formSearch">
		<div class="col-md-5">
			<?php echo $this->formText("Title",  $this->Title, array('class' => 'form-control', 'placeholder' => Emwork_Translate::text($this->lang, 'information', 'list_search_placeholder'), 'maxlength' => '500')); ?>
		</div>
		<div class="col-md-5">
			<?php echo $this->formSelect("Category", $this->CategoryID, array('class' => 'form-control', 'placeholder' => Emwork_Translate::text($this->lang, 'information', 'list_search_placeholder')), $this->informationCategoryOption); ?>
		</div>
		<div class="col-md-2">
			<button type="button" class="btn btn-primary" id="btnInfomationSearch"><em class="fa fa-search"></em> <?php echo Emwork_Translate::text($this->lang, 'general', 'button_search'); ?></button>
		</div>
	</div>
	<div class="result-list-panel">
    	<div class="result-list" id="result-sublist"></div>
    	<div class="result-paging" style="display: none;">
    		<p class="paging text-right"></p>
    	</div>
    </div>
</div>
<script>
jQuery(function(){
	$("#infopage").validate({
		errorElement: "em",
		errorPlacement: function(error, element) {
			error.addClass( "help-block" );
	        error.appendTo( element.closest("div.divControl"));
        }, 
        ignore: []
    });
	reloadResultList(1);

	$('#btnInfomationSearch').click(function(){
		reloadResultList(1);
	});
	function reloadResultList(pageIndex) {
		var sendData = {};
		sendData.pageIndex = pageIndex;
		sendData.Category = $("#formSearch #Category").val();
		sendData.Title = $("#formSearch #Title").val();
		$.post("<?php echo $this->url(array('module' => 'information', 'controller' => 'department', 'action' => 'getlist', "id" => $this->id), null, true); ?>", sendData, function(data){
			
			if (data.total > 0) {
				$("#result-sublist").html(data.html);
				$('.result-paging').css('display', '');
				$('.paging').bootpag({
					total : data.totalPage,
					page : data.pageIndex,
					maxVisible: 5,
			        leaps: false,
			        firstLastUse: true,
			        first: '<<',
			        last: '>>',
			        next: '>',
			        prev: '<',
			        wrapClass: 'pagination',
			        activeClass: 'active',
			        disabledClass: 'disabled',
			        nextClass: 'next',
			        prevClass: 'prev',
			        lastClass: 'last',
			        firstClass: 'first'
				});

			} else {
				var html = '';
				
				$('#result-paging').css('display', 'none');
				$('.result-list').html(html);
				$('.paging').bootpag({total : 0});
			}
		}, 'json');
	}

	$('.paging').bootpag({
        total: 0,
        maxVisible: 5,
        leaps: false,
        firstLastUse: true,
        first: '<<',
        last: '>>',
        next: '>',
        prev: '<',
        wrapClass: 'pagination',
        activeClass: 'active',
        disabledClass: 'disabled',
        nextClass: 'next',
        prevClass: 'prev',
        lastClass: 'last',
        firstClass: 'first'
    }).on("page", function(event, num){
    	reloadResultList(num);
    }); 
});
</script>