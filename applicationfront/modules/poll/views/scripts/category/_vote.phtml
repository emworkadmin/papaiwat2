<style>
/* ---------------------- Poll Style -------------------- */
.poll-question { position: relative; padding: 10px 0px 10px 50px; font-weight: bold; background: #a6def5; border-radius: 5px; }
.poll-question .question-index { position: absolute; left: 15px; }
.poll-question .question-title { }
.poll-question-desc { padding: 10px 0px 10px 50px; font-size: 18px; background: #f2f2f2; border-bottom-left-radius: 5px; border-bottom-right-radius: 5px; }
.poll-option { padding: 10px 0px 10px 50px; }
.error.help-block { padding: 10px 0px 10px 50px; }
.button-panel-zone { margin-bottom: 30px; }
</style>

<div class="info infopage poll-item-vote">

 	<div class="item-title title-panel">
		<span class="title">
			<?php echo $this->pageTitle; ?>
		</span>
		<hr />
	</div>

	<div class="result-list-panel">
		<div class="row">

			<form class="form-horizontal" id="formQuestion" name="formQuestion">
			<input type="hidden" name="hdfID" value="<?php echo $this->iid; ?>">
		
			<?php 
			if(count($this->dataQuestion)>0){
				$index = 1;
				foreach($this->dataQuestion as $k1=>$v1){
			?>

			<div class="col-md-12" data-id="<?php echo $v1['ID']; ?>">
			
				<div class="poll-question col-md-12">
					<span class="question-index"><?php echo $index . ". "; ?></span>
					<span class="question-title"><?php echo $v1['Question']; ?></span>
				</div>

				<?php if($this->ShowIntroText && $v1['Description']){ ?>
				<div class="poll-question-desc col-md-12">
					<?php echo nl2br($v1['Description']); ?>
				</div>
				<?php } ?>

				<div class="divControl">

					<?php 
					if(count($v1['OptionList'])>0){
						foreach($v1['OptionList'] as $k2=>$v2){
					?>

						<div class="poll-option col-md-12">
							<input type="radio" name="Answers[<?php echo $v1['ID']; ?>]" id="Answers-<?php echo $v1['ID']; ?>-<?php echo $v2['ID']; ?>" value="<?php echo $v2['ID']; ?>" class="required"> &nbsp;&nbsp; <?php echo $v2['Name']; ?>
						</div>

					<?php
						}
					}
					?>

				</div>

			</div>

			<?php
				$index++;
				}
			}
			?>

			</form>

		</div>
	</div>

	<div class="form-group text-center">
		<div class="col-md-12 button-panel-zone">
			<button type="button" class="btn btn-warning" id="btnSend"><em class="fa fa-paper-plane"></em> <?php echo Emwork_Translate::text($this->lang, 'poll', 'send_poll'); ?></button>
			<button type="button" class="btn btn-primary" id="btnReport"><em class="fa fa-pie-chart"></em> <?php echo Emwork_Translate::text($this->lang, 'poll', 'view_score'); ?></button>
		</div>
	</div>
	
</div>

<script src="<?php echo $this->baseUrl('plugins/jQueryValidation/jquery.validate.min.js'); ?>"></script>
<?php if($this->lang=='th'){ ?>
<script src="<?php echo $this->baseUrl('plugins/jQueryValidation/localization/messages_th.min.js'); ?>"></script>
<?php } ?>
<script>
jQuery(function(){


	$("#formQuestion").validate({
		errorElement: "em",
		errorPlacement: function(error, element) {
			error.addClass( "help-block" );
	        error.appendTo( element.parents("div.divControl"));
        }, 
        ignore: []
    });

	$('#formQuestion input[type=radio]').iCheck({checkboxClass: 'icheckbox_minimal-blue',radioClass: 'iradio_minimal-blue'});

	$('#btnSend').click(function(){
		buttonZoneDisabled();
		var valid = $("#formQuestion").valid();
		if (valid) {
			$.post("<?php echo $this->url(array('module' => 'poll', 'controller' => 'item', 'action' => 'save'), null, true);?>", $("#formQuestion").serializeArray(), function(data){
				if (data.result) {
					DialogComplete();
					setTimeout(function(){
						window.location = "<?php echo $this->url(array('module' => 'poll', 'controller' => 'category', 'action' => 'finish', 'id' => $this->id, 'iid' => $this->iid), null, true); ?>";
					}, 1000);
				} else {
					DialogWarning(data.message, '<?php echo Emwork_Translate::text($this->lang, 'general', 'dialog_warning_title'); ?>', '<?php echo Emwork_Translate::text($this->lang, 'general', 'dialog_warning_close'); ?>');
				}
				buttonZoneActive();
			}, 'json');
		} else {
			buttonZoneActive();
		}
	});

	$('#btnReport').click(function(){
		window.location = "<?php echo $this->url(array('module' => 'poll', 'controller' => 'category', 'action' => 'report', 'id' => $this->id, 'iid' => $this->iid), null, true); ?>";
	});

	function buttonZoneDisabled() {
		$(".button-panel-zone button").attr("disabled", "disabled");
		$(".button-panel-zone").append('<em class="fa fa-refresh fa-spin"></em>');
	}
	function buttonZoneActive() {
		$(".button-panel-zone button").removeAttr("disabled");
		$(".button-panel-zone > em").remove();
	}
});
</script>