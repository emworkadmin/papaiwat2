	<style>
		.inforow-search {
			padding-bottom: 30px;
		}

		.detail-title-search {
			font-size: 25px;
			padding-bottom: 15px;
		}

		.detail-intro-search {
			font-size: 20px;
		}

		a.title {
			color: black;
		}
