<script>
jQuery(function(){

	$("#btnfind").click(function(e) {
		// if ($("#formSearch #textsearch").val() || $("#formSearch #lstPeriod").val() || $("#formSearch #txtSendDateTo").val() || $("#formSearch #txtSendDateFrom").val()){ 
		// 	window.location = "<?php echo $this->url(array('module' => 'search', 'controller' => 'search', 'action' => 'index'), null, true); ?>?text="+$("#formSearch #textsearch").val()+"&period="+$("#formSearch #lstPeriod").val()+"&start="+$("#formSearch #txtSendDateFrom").val()+"&end="+$("#formSearch #txtSendDateTo").val()+"&type="+$("#formSearch #lstType").val();
		// }
		reloadResultList1(1);
	});


	// --------------- Toogle Advance Search ---------------
	$("#AdvanceSearch").slideUp(0, "swing");
	$("#btnAdvance").click(function(e) {
		var val = $('#hdfAdvanceSearch').val();
		if(val == 'S') {
			$("#AdvanceSearch").slideUp(600, "swing");
			$("#hdfAdvanceSearch").val('H');
		} else {
			$("#AdvanceSearch").slideDown(600, "swing");
			$("#hdfAdvanceSearch").val('S');
		}
	});
	 $('#txtSendDateFrom').datepicker({autoclose: true, format: 'dd/mm/yyyy'});
	 $('#txtSendDateTo').datepicker({autoclose: true, format: 'dd/mm/yyyy'});

	reloadResultList1(1);

	function reloadResultList1(pageIndex) {

		var sendData = {};
		sendData.pageIndex = pageIndex;
		sendData.text = $("#formSearch #textsearch").val();
		sendData.type = $("#formSearch #lstType").val();
		sendData.period = $("#formSearch #lstPeriod").val();
		sendData.start = $("#formSearch #txtSendDateFrom").val();
		sendData.end = $("#formSearch #txtSendDateTo").val();
		
			$.post("<?php echo $this->url(array('module' => 'search', 'controller' => 'search', 'action' => 'getlist'), null, true); ?>", sendData, function(data){
			$("span#total").html(data.total);
			if (data.total > 0) {
				$("#result-list1").html(data.html);
				$('.result-paging1').css('display', '');
				$('.paging1').bootpag({
					total : data.totalPage,
					page : data.pageIndex,
					maxVisible: 5,
					leaps: false,
					firstLastUse: true,
					first: '<<',
					last: '>>',
					next: '>',
					prev: '<',
					wrapClass: 'pagination',
					activeClass: 'active',
					disabledClass: 'disabled',
					nextClass: 'next',
					prevClass: 'prev',
					lastClass: 'last',
					firstClass: 'first'
				});

			} else {
				
				$('#result-paging1').css('display', 'none');
				$('.result-list1').html(data.html);
				$('.paging1').bootpag({total : 0});
			}
		}, 'json');
	}

	$('.paging1').bootpag({
		
		total: 0,
		maxVisible: 5,
		leaps: false,
		firstLastUse: true,
		first: '<<',
		last: '>>',
		next: '>',
		prev: '<',
		wrapClass: 'pagination',
		activeClass: 'active',
		disabledClass: 'disabled',
		nextClass: 'next',
		prevClass: 'prev',
		lastClass: 'last',
		firstClass: 'first'
	}).on("page", function(event, num){
		
		reloadResultList1(num);

	}); 

});
</script>
