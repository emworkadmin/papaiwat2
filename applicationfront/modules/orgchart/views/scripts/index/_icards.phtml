<style>.detail-intro { height : 85px; word-wrap: break-word; overflow: hidden; }</style>
<div class="">
	<div class="row">
        <?php 
        $col = "col-md-4 col-sm-6 col-xs-12";
        if ($this->ChartAmountColumn == 2) : 
        	$col = "col-md-6 col-sm-6 col-xs-12";
        elseif ($this->ChartAmountColumn == 3) :
        	$col = "col-md-4 col-sm-6 col-xs-12";
        else :
        	$col = "col-md-3 col-sm-6 col-xs-12";
        endif;
        
        
        if (count($this->items) > 0) :
	        foreach ($this->items as $item) :
	        
            	$id = $item["ID"];
            	$title = $item["Title"];
            	$introText = $item["IntroText"];
            	$imageUrl = $this->defaultImageUrl; 
            	if (!empty($item["IntroImageHashName"])) : 
            		$imageUrl = $this->url(array("module" => "default", "controller" => "file", "action" => "get", "type" => "thumbnail", "file" => $item["IntroImageHashName"]), null, true);
            	endif;

				if($this->lang == 'th') {
					$date = $item["Created"] == null ? '' : Emwork_Utility_DateTime::MSSqlToDateThai($item["Created"]);
				} else {
					$date = $item["Created"] == null ? '' : Emwork_Utility_DateTime::MSSqlToDateEng($item["Created"]);
				}

				$url = $this->url(array("module" => "orgchart", "controller" => "index", "action" => "indexchart", "id" => $id), null, true);
        ?>
		<h1><?php  ?></h1>
		<div class="<?php echo $col; ?>">
			<div class="infocard">
				<?php if ($this->ChartShowImage) : ?>
				<div class="image">
					<div class="image-inner">
						<a href="<?php echo $url; ?>">
							<img alt="image" src="<?php echo $imageUrl; ?>" />
						</a>
					</div>
				</div>
				<?php endif; ?>
				<div class="detail">

					<?php if($this->ChartShowTitle): ?>
					<div class="detail-title">
						<a href="<?php echo $url; ?>"><?php echo $title; ?></a>
					</div>
					<?php endif; ?>

					<?php if ($this->ChartShowIntroText) : ?>
					<div class="detail-intro">
						<?php echo nl2br($introText); ?>
					</div>
					<?php endif; ?>
					<div class="btShowDetail">
						<a href="<?php echo $url; ?>" class="btn btn-info"><?php echo Emwork_Translate::text($this->lang, 'orgchart', 'list_detail'); ?></a>
					</div>
					<div class="detail-date">
						<em class="fa fa-calendar"></em> <?php echo $date; ?>
					</div>

				</div>
			</div>
		</div>
        <?php 
        	endforeach;
        endif;
        ?>
	</div>
</div>