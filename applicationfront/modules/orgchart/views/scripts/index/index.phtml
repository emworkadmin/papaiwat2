<?php echo '<style>' . $this->CSS . '</style>'; ?>

<div class="info infopage orgchart-list">
 	
 	<div>
    	<div class="orgchart-title title-panel">
			<span class="title">
				<?php echo $this->pageTitle; ?>
			</span>
			<hr />
		</div>
    </div>
 
    <div class="result-list-panel">
    	<div class="result-list" id="result-list"></div>
    	<div class="result-paging" style="display: none;">
    		<p class="paging text-right"></p>
    	</div>
    </div>

</div>

<script>
jQuery(function(){

	reloadResultList(1);

	function reloadResultList(pageIndex) {
		var sendData = {};
		sendData.pageIndex = pageIndex;
		$.post("<?php echo $this->url(array('module' => 'orgchart', 'controller' => 'index', 'action' => 'getlist'), null, true); ?>", sendData, function(data) {
			
			if (data.total > 0) {
				$("#result-list").html(data.html);
				$('.result-paging').css('display', '');
				$('.paging').bootpag({
					total : data.totalPage,
					page : data.pageIndex,
					maxVisible: 5,
			        leaps: false,
			        firstLastUse: true,
			        first: '<<',
			        last: '>>',
			        next: '>',
			        prev: '<',
			        wrapClass: 'pagination',
			        activeClass: 'active',
			        disabledClass: 'disabled',
			        nextClass: 'next',
			        prevClass: 'prev',
			        lastClass: 'last',
			        firstClass: 'first'
				});

			} else {
				var html = '';
				
				$('#result-paging').css('display', 'none');
				$('.result-list').html(html);
				$('.paging').bootpag({total : 0});
			}
		}, 'json');
	}

	$('.paging').bootpag({
        total: 0,
        maxVisible: 5,
        leaps: false,
        firstLastUse: true,
        first: '<<',
        last: '>>',
        next: '>',
        prev: '<',
        wrapClass: 'pagination',
        activeClass: 'active',
        disabledClass: 'disabled',
        nextClass: 'next',
        prevClass: 'prev',
        lastClass: 'last',
        firstClass: 'first'
    }).on("page", function(event, num){
    	reloadResultList(num);
    }); 
});
</script>