
<div class="info infopage">
	 <div>
    	<div class="article-title-main-search title-panel">
			<span class="title">
				<?php echo $this->pageTitle; ?>
			</span>
			<hr />
		</div>
    </div>

	<?php echo $this->partial("article/_partSearch.phtml", $this); ?>


    <div class="result-list-panel">
    	<div class="result-list" id="result-list"></div>
    </div>

	<div class="result-list-panel">
    	<div class="result-list" id="result-list-art"></div>
    	<div class="result-paging-art" style="display: none;">
    		<p class="paging text-right"></p>
    	</div>
	</div>
</div>
<script>
jQuery(function(){

	reloadResultList(1);
	function reloadResultList(pageIndex) {
		var sendData = {};
		sendData.id = '<?php echo $this->id; ?>';
		sendData.pageIndex = pageIndex;
		sendData.search = '<?php echo $this->search; ?>';
		$.post("<?php echo $this->url(array('module' => 'gallery', 'controller' => 'article', 'action' => 'getarticlessearch'), null, true); ?>", sendData, function(data){
			if (data.total > 0) {
				$("#result-list-art").html(data.html);
				$('.result-paging-art').css('display', '');
				$('.paging').bootpag({
					total : data.totalPage,
					page : data.pageIndex,
					maxVisible: 5,
			        leaps: false,
			        firstLastUse: true,
			        first: '<<',
			        last: '>>',
			        next: '>',
			        prev: '<',
			        wrapClass: 'pagination',
			        activeClass: 'active',
			        disabledClass: 'disabled',	
			        nextClass: 'next',
			        prevClass: 'prev',
			        lastClass: 'last',
			        firstClass: 'first'
				});
			} else {
				var html = '';
				$('#result-list-art').html(html);
				$('.result-paging-art').css('display', 'none');
				$('.paging').bootpag({total : 0});
			}
		}, 'json');
	}

	$('.paging').bootpag({
        total: 0,
        maxVisible: 5,
        leaps: false,
        firstLastUse: true,
        first: '<<',
        last: '>>',
        next: '>',
        prev: '<',
        wrapClass: 'pagination',
        activeClass: 'active',
        disabledClass: 'disabled',
        nextClass: 'next',
        prevClass: 'prev',
        lastClass: 'last',
        firstClass: 'first'
    }).on("page", function(event, num){
    	reloadResultList(num);
    }); 	
});
</script>