<script>
$(function () {

	$("#btnSendComment").click(function() {

		$("#btnSendComment").attr("disabled",true);
		$("#btnSendComment em").removeClass("fa-paper-plane");
		$("#btnSendComment em").addClass("fa-refresh fa-spin");

		var userID = '<?php echo $this->UserID; ?>';
		if(userID == '' || isNaN(userID)){
			DialogWarning(
				"<?php echo $comment_warning_login_first; ?>",
				"<?php echo $comment_warning_title; ?>",
				"<?php echo $comment_btn_close; ?>"
			);
			$("#btnSendComment").attr("disabled",false);
			$("#btnSendComment em").removeClass("fa-refresh fa-spin fa-spin");
			$("#btnSendComment em").addClass("fa-paper-plane");
			return;
		}

		var msg = $('#txtMessage').val();
		if(msg.length>=10){
			$.post("<?php echo $this->url(array('module' => 'gallery', 'controller' => 'article', 'action' => 'savecommentimage'), null, true);?>", $("#formComment").serializeArray(), function(data){
				if (data.result) {
					<?php if($this->ArticlePublicComment=='N'){ ?>
						$('.approveWarning').css("display","");
					<?php }else{ ?>
						DialogComplete(
							"<?php echo $comment_warning_send_success; ?>"
						);
						setTimeout(function(){
							<?php if($this->ControllerName=="category") { ?>
								window.location = "<?php echo $this->url(array('module' => 'gallery', 'controller' => 'category', 'action' => 'viewimage', "id" => $this->dataParam->id, "cid" => $this->dataParam->cid, "iid" => $this->dataParam->iid, "img" => $this->dataFile->FileInfoID), null, true); ?>";
							<?php } else { ?>
								window.location = "<?php echo $this->url(array('module' => 'gallery', 'controller' => 'article', 'action' => 'viewimage', "id" => $this->data->GalleryCategoryID, "iid" => $this->data->ID, "img" => $this->dataFile->FileInfoID), null, true); ?>";
							<?php } ?>
						}, 500);

					<?php } ?>
				} else {
					DialogWarning(
						data.message,
						"<?php echo $comment_warning_title; ?>",
						"<?php echo $comment_btn_close; ?>"
					);
				}
				
				$("#btnSendComment").attr("disabled",false);
				$("#btnSendComment em").removeClass("fa-refresh fa-spin fa-spin");
				$("#btnSendComment em").addClass("fa-paper-plane");
			}, 'json');
		}else{
			DialogWarning(
				"<?php echo $comment_warning_message_length; ?>",
				"<?php echo $comment_warning_title; ?>",
				"<?php echo $comment_btn_close; ?>"
			);

			$("#btnSendComment").attr("disabled",false);
			$("#btnSendComment em").removeClass("fa-refresh fa-spin fa-spin");
			$("#btnSendComment em").addClass("fa-paper-plane");
		}
	});

	var pageIndex = 1;
	$("#btnLoadMore").click(function(){
		reloadResultList(pageIndex);
		pageIndex++;
	});

	function reloadResultList(page) {
		
		$("#btnLoadMore").attr("disabled",true);
		$("#btnLoadMore em").addClass("fa-spin");

		var sendData = {};
		sendData.pageIndex = page;
		sendData.id = '<?php echo $this->dataFile->FileInfoID; ?>';
		$.post("<?php echo $this->url(array('module' => 'gallery', 'controller' => "article", 'action' => 'getcommentimagelist'), null, true); ?>", sendData, function(data){
			$(".AmountComment .Num").html(data.recordsTotal);
			if (data.data.length>0) {
				var html = '';
				$(data.data).each(function(i,e) {
					html += '<div class="col-md-12 review-item review-item-list">';
					html += '	<div class="row">';
					html += '		<div class="review-img">';
					html += '			<img alt="image" src="'+e.ProfileImageUrl+'">';
					html += '		</div>';
					html += '		<div class="review-detail">';
					html += '			<div class="review-name">'+e.ActionFullname+'<span class="pull-right review-date">'+e.ActionDate+'</span></div>';
					html += '			<div class="review-msg">'+e.Message+'</div>';
					html += '		</div>';
					html += '	</div>';
					html += '</div>';
				});
				$("#result-list-comment").append(html);
				if(data.recordsFiltered<=0){
					$('#btnLoadMore').css('display', 'none');
				}
			} else {
				$('.article-comment-list-title').css('display', 'none');
				$('#btnLoadMore').css('display', 'none');
			}

			$("#btnLoadMore").attr("disabled",false);
			$("#btnLoadMore em").removeClass("fa-spin");

		}, 'json');
	}

	$("#btnLoadMore").click();

});
</script>