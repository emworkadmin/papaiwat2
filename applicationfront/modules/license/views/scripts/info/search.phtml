<link rel="stylesheet" href="<?php echo $this->baseUrl('assets/license/css/license.css'); ?>">
<div class="info infopage license-licenses-page">
	 <div>
    	<div class="license-title title-panel">
			<span class="title">
				<?php echo Emwork_Translate::text($this->lang, "license", "info_search_title_label"); ?>
			</span>
			<hr />
		</div>
    </div>
	     
    <div>
    	<div class="license-search">
    		<form class="form-horizontal" method="get" action="<?php echo $this->url(array("module" => "license", "controller" => "info", "action" => "search"), null, true); ?>">
    			<div class="form-group">
    				<div class="col-md-2">
    					<?php echo $this->formSelect("category", $this->searchCategory, array("class" => "form-control", "title" => Emwork_Translate::text($this->lang, 'license', 'search_category_placeholder')), $this->categoryOption); ?>
    				</div>
    				<div class="col-md-2">
    					<?php echo $this->formSelect("issue", null, array("class" => "form-control", "title" => Emwork_Translate::text($this->lang, 'license', 'search_issue_placeholder')), array()); ?>
    				</div>
    				<div class="col-md-2">
    					<?php echo $this->formSelect("department", $this->searchDepartment, array("class" => "form-control", "title" => Emwork_Translate::text($this->lang, 'license', 'search_department_placeholder')), Emwork_Utility::addEmptyOption($this->departmentOption, Emwork_Translate::text($this->lang, 'license', 'search_department_placeholder'))); ?>
    				</div>
    				<div class="col-md-2">
    					<?php echo $this->formText("license", $this->searchLicense, array("class" => "form-control", "placeholder" => Emwork_Translate::text($this->lang, "license", "search_license_placeholder"), "title" => Emwork_Translate::text($this->lang, "license", "search_license_placeholder"))); ?>
    				</div>
    				<div class="col-md-3">
    					<?php echo $this->formText("procedure", $this->searchProcedure, array("class" => "form-control", "placeholder" => Emwork_Translate::text($this->lang, "license", "search_procedure_placeholder"), "title" => Emwork_Translate::text($this->lang, "license", "search_procedure_placeholder"))); ?>
    				</div>
    				<div class="col-md-1">
    					<button class="btn btn-block btn-default" type="submit"><?php echo Emwork_Translate::text($this->lang, "license", "search_search_button_label"); ?></button>
    				</div>
    			</div>
    		</form>
    	</div>
    </div>

	<div class="result-list-panel">
		<div class="result-amount-text">-</div>
    	<div class="result-list" id="result-list-info"></div>
    	<div class="result-paging-info" style="display: none;">
    		<p class="paging text-right"></p>
    	</div>
	</div>

</div>
<script>
jQuery(function(){

	var clickIssueState = 'init';
	var clickLicenseState = 'init';

	getData("<?php echo $this->url(array("module" => "license", "controller" => "info", "action" => "issuelist"), null, true); ?>" + "?id=" + "<?php echo $this->searchCategory; ?>", "#issue", "<?php echo Emwork_Translate::text($this->lang, 'license', 'search_issue_placeholder')?>", "name", "id", "<?php echo $this->searchIssue; ?>"); 
	$("#category").change(function(){
		var selectValue = $(this).val();
		if(selectValue == ''){selectValue = '-1';}
		getData("<?php echo $this->url(array("module" => "license", "controller" => "info", "action" => "issuelist"), null, true); ?>" + "?id=" + selectValue, "#issue", "<?php echo Emwork_Translate::text($this->lang, 'license', 'search_issue_placeholder')?>", "name", "id", ""); 
	});

	reloadResultList(1);

	$("#result-list-info").on("click", function(e){
		var target = $(e.target);
		if (target.hasClass("license-fa-chevron-down")) {
			$("#result-list-info .license-body").removeClass("license-body-show");
			$("#result-list-info .license-fa-chevron-up").hide();
			$("#result-list-info .license-fa-chevron-down").show();
			target.hide();
			target.parent().find(".license-fa-chevron-up").show();
			target.parents(".license-box").find(".license-body").addClass("license-body-show");

			if (clickLicenseState == '') {
				$('html, body').animate({
		            scrollTop: target.parents(".license-box").offset().top
		        }, 500);
			}
			
			clickLicenseState = '';
		}
		if (target.hasClass("license-fa-chevron-up")) {
			target.hide();
			target.parent().find(".license-fa-chevron-down").show();
			target.parents(".license-box").find(".license-body").removeClass("license-body-show");
		}
		if (target.hasClass("issue-fa-chevron-down")) {
			$("#result-list-info .issue-body").removeClass("issue-body-show");
			$("#result-list-info .issue-fa-chevron-up").hide();
			$("#result-list-info .issue-fa-chevron-down").show();
			target.hide();
			target.parent().find(".issue-fa-chevron-up").show();
			target.parents(".issue-box").find(".issue-body").addClass("issue-body-show");

			clickLicenseState = 'issue';

			$(".license-fa-chevron-down", target.parents(".issue-box")).first().click();

			if (clickIssueState == '') {
				$('html, body').animate({
		            scrollTop: target.parents(".issue-box").offset().top
		        }, 500);
			}

			clickIssueState = '';
		}
		if (target.hasClass("issue-fa-chevron-up")) {
			target.hide();
			target.parent().find(".issue-fa-chevron-down").show();
			target.parents(".issue-box").find(".issue-body").removeClass("issue-body-show");
		}
	});

	function reloadResultList(pageIndex) {
		var sendData = {};
		sendData.pageIndex = pageIndex;
		sendData.category = "<?php echo $this->searchCategory; ?>";
		sendData.issue = "<?php echo $this->searchIssue; ?>";
		sendData.department = "<?php echo $this->searchDepartment; ?>";
		sendData.license = "<?php echo $this->searchLicense; ?>";
		sendData.procedure = "<?php echo $this->searchProcedure; ?>";
		$.post("<?php echo $this->url(array('module' => 'license', 'controller' => 'info', 'action' => 'getsearchlist'), null, true); ?>", sendData, function(data){
			
			if (data.total > 0) {
				$("#result-list-info").html(data.html);
				$('.result-paging-info').css('display', '');
				$("#result-list-info .issue-fa-chevron-down").first().click();
				$(".result-amount-text").html(data.resultText);
				$('.paging').bootpag({
					total : data.totalPage,
					page : data.pageIndex,
					maxVisible: 5,
			        leaps: false,
			        firstLastUse: true,
			        first: '<<',
			        last: '>>',
			        next: '>',
			        prev: '<',
			        wrapClass: 'pagination',
			        activeClass: 'active',
			        disabledClass: 'disabled',	
			        nextClass: 'next',
			        prevClass: 'prev',
			        lastClass: 'last',
			        firstClass: 'first'
				});
			} else {
				$(".result-amount-text").html(data.resultText);
				$('.result-paging-info').css('display', 'none');
				$('.paging').bootpag({total : 0});
			}
		}, 'json');
	}

	$('.paging').bootpag({
        total: 0,
        maxVisible: 5,
        leaps: false,
        firstLastUse: true,
        first: '<<',
        last: '>>',
        next: '>',
        prev: '<',
        wrapClass: 'pagination',
        activeClass: 'active',
        disabledClass: 'disabled',
        nextClass: 'next',
        prevClass: 'prev',
        lastClass: 'last',
        firstClass: 'first'
    }).on("page", function(event, num){
    	reloadResultList(num);
    }); 	
});
</script>