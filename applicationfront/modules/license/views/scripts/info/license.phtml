													<span class="visible-xs span-comment"><a href="<?php echo empty($procedureUrl) ? $this->commentUrl : $procedureUrl; ?>" target="_blank"><?php echo Emwork_Translate::text($this->lang, "license", "info_comment_text_label"); ?></a></span>
													<?php }else{ ?>
													<span class="visible-xs span-comment"><?php echo Emwork_Translate::text($this->lang, "license", "info_comment_text_label"); ?></span>
													<?php } ?>
													<span class="visible-xs span-period"><?php echo Emwork_Translate::text($this->lang, "license", "procedure_table_header_period"); ?> : <?php echo $procedureDate; ?></span>
												</td>
												<td class="comment hidden-xs">
													<?php if (!empty($this->commentUrl) || !empty($procedureUrlComment)) { ?>
													<a href="<?php echo empty($procedureUrlComment) ? $this->commentUrl : $procedureUrlComment; ?>" target="_blank"><?php echo Emwork_Translate::text($this->lang, "license", "info_comment_text_label"); ?></a>
