<div class="">
	<div class="row">
        <?php 
        $col = "col-md-4 col-sm-6 col-xs-12";
        if ($this->categoryColumn == 2) : 
        	$col = "col-md-6 col-sm-6 col-xs-12";
        	elseif ($this->categoryColumn == 3) :
        	$col = "col-md-4 col-sm-6 col-xs-12";
        else :
        	$col = "col-md-3 col-sm-6 col-xs-12";
        endif;
        
        
        if (count($this->items) > 0) :
	        foreach ($this->items as $item) :
	        
	        $id = $item["ID"];
	        $title = $item["Title"];
	        $url = $this->url(array("module" => "license", "controller" => "info", "action" => "licenses", "id" => $id), null, true);
	        $imageUrl = $this->defaultImageUrl;
	        if (!empty($item["IntroImageHashName"])) :
	        	$imageUrl = $this->url(array("module" => "default", "controller" => "file", "action" => "get", "type" => "thumbnail", "file" => $item["IntroImageHashName"]), null, true);
			endif;
        ?>
		<div class="box-item <?php echo $col; ?>">
			<div class="box-box">
				<img src="<?php echo $imageUrl; ?>" alt="<?php echo $title; ?>">
				<div class="box-link">
					<a href="<?php echo $url; ?>">
						<span><?php echo $title; ?></span>
					</a>
				</div>
			</div>
		</div>
        <?php 
        	endforeach;
        endif;
        ?>
	</div>
</div>