// <!---------------------------------------- รูปภาพแกลอรี่ ----------------------------------------------->
if (count ( $this->dataFileImages ) > 0) :
?>
<div class="article-gallery">
	<hr />
	<div class="title-label">
		<img src="<?php echo substr($this->baseUrl("images/icons/icon_gallery.png"), $this->subStringAdminLen); ?>" /> รูปแกลอรี่
	</div>
	<div class="row" id="lightGallery">
		<?php 
		foreach ( $this->dataFileImages as $img ) :
			$imgUrl = $this->url(array("module" => "default", "controller" => "file", "action" => "get", "file" => $img["hash_name"]), null, true);
			$imgThumbnailUrl = $this->url(array("module" => "default", "controller" => "file", "action" => "get", "type" => "thumbnail", "file" => $img["hash_name"]), null, true);
		?>
