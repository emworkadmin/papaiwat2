			<div class="img-container">
				<div class="img-inner">
					<img src="<?php echo $imgThumbnailUrl; ?>" />
				</div>
			</div>
		</div>
    	<?php
		endforeach;
		?>
	    </div>
    </div>
    <script type="text/javascript">
	jQuery(function(){
		$("#lightGallery").lightGallery();	
	});
	</script>
<?php 
endif;
