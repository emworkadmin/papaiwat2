		errorElement: "em",
		errorPlacement: function(error, element) {
			error.addClass( "help-block" );
	        error.appendTo( element.closest("div.divControl"));
        }, 
        ignore: []
    });
    
	<?php if($this->isiOS) : ?>
	$("input[type=text][id$=PublishDate],input[type=text][id$=PublishDown]").removeAttr("readonly");
	<?php endif; ?>
	$("input[type=text][id$=PublishDateTime]").wickedpicker({twentyFour: true, title : 'เวลา', now : '<?php echo $this->data->PublishDate != null ? $this->data->PublishDate->format("H:i") : "0:00"; ?>'});
	$("input[type=text][id$=PublishDownTime]").wickedpicker({twentyFour: true, title : 'เวลา', now : '<?php echo $this->data->PublishDown != null ? $this->data->PublishDown->format("H:i") : "0:00"; ?>'});

	$('select[name^=CategoryIds]').select2();
	$("#formData input[type=checkbox], #formData input[type=radio]:not([name=TemplateType])").iCheck({checkboxClass: 'icheckbox_minimal-blue',radioClass: 'iradio_minimal-blue'});

	var roxyFileman = '<?php echo $this->baseUrl('/fileman/index.html'); ?>';	
	$( '.txtDetail' ).ckeditor({
		language: 'th',
		height: 400,
		toolbar: [
		          {name : 'basicstyles', items : ['Bold', 'Italic', 'Strike', '-', 'RemoveFormat']},
		          {name: 'colors', items: [ 'FontSize', 'TextColor', 'BGColor' ] },
		          {name : 'paragraph', items : ['NumberedList', 'BulletedList', '-', 'Outdent', 'Indent', '-', 'Blockquote', '-', 'JustifyLeft', 'JustifyCenter', 'JustifyRight', 'JustifyBlock']},
		          {name : 'links', items : ['Link', 'Unlink', 'Anchor']},
		          {name : 'inserts', items : ['Image', 'Table', 'HorizontalRule']},
		          {name: 'document', items: ['Source']},
				  {name: 'video', items: ['Video']},
				  {name: 'html5audio', items: ['Html5audio']}
		],
		extraPlugins : 'uploadimage,justify,video,font,panelbutton,colorbutton,html5audio',
		filebrowserBrowseUrl: roxyFileman+'?integration=ckeditor',
		filebrowserImageBrowseUrl:roxyFileman+'?integration=ckeditor&type=image',
		filebrowserVideoBrowseUrl:roxyFileman+'?integration=ckeditor&type=video',
		filebrowserHtml5audioBrowseUrl:roxyFileman+'?integration=ckeditor&type=html5audio',
		extraAllowedContent : 'video [*]{*}(*);source [*]{*}(*);iframe [*]{*}(*);'
	});

	function toggleCanComment(val) {
		if (val == 'C') {
			$("#canComment").css("display", "");
		} else {
			$("#canComment").css("display", "none");
		}
	}
	$("input[id^=canCommentType]").on('ifChecked' , function(event){
		toggleCanComment($(this).val());
	});
	
	<?php if ($this->canEdit) : ?> 
	// Save
	$("#btnSave").click(function(){
		<?php foreach ($this->languages as $lang) :?>
		$("li[data-tab-lang=<?php echo $lang["Code"]; ?>]").removeClass("warning");
		<?php endforeach;?>
		var valid = $("#formData").valid();
		if (valid) {
			$.post("<?php echo $this->url(array('module' => 'content', 'controller' => 'article', 'action' => 'update'), null, true);?>", $("#formData").serializeArray(), function(data){
				if (data.result) {
					DialogComplete();
					setTimeout(function(){
						window.location = "<?php echo $this->url(array('module' => 'content', 'controller' => 'article', 'action' => 'edit', "itemid" => $this->data->ID), null, true); ?>";
					}, 500);
				} else {
					DialogWarning(data.message);
				}
			}, 'json');
		} else {
			<?php foreach ($this->languages as $lang) :?>
			if ($("#detail-<?php echo $lang["Code"]; ?>").find("input.error,select.error,textarea.error").length > 0) {$("li[data-tab-lang=<?php echo $lang["Code"]; ?>]").addClass("warning");}
			<?php endforeach;?>
		}
	});
	// Preview
	$("#btnPreview").click(function(){
		<?php foreach ($this->languages as $lang) :?>
		$("li[data-tab-lang=<?php echo $lang["Code"]; ?>]").removeClass("warning");
		<?php endforeach;?>
		var valid = $("#formData").valid();
		if (valid) {
			var dialogPreview = BootstrapDialog.show({
				title: 'ตัวอย่างข้อมูล',
				message: $('<div id="dialogdialogPreview"></div>').load("<?php echo $this->url(array('module' => 'content', 'controller' => 'article', 'action' => 'preview'), null, true); ?>", $("#formData").serializeArray()),
				closable: true,
	            closeByBackdrop: false,
	            closeByKeyboard: false,
	            autodestroy: true,
	            size: BootstrapDialog.SIZE_WIDE,
	            cssClass: "divPreview",
				buttons : [{
					label: ' ปิด',
					icon: 'fa fa-times',
					action: function(dialog) {
						dialog.close();
					}
				}]
			});
			dialogPreview.open();
		} else {
			<?php foreach ($this->languages as $lang) :?>
			if ($("#detail-<?php echo $lang["Code"]; ?>").find("input.error,select.error,textarea.error").length > 0) {$("li[data-tab-lang=<?php echo $lang["Code"]; ?>]").addClass("warning");}
			<?php endforeach;?>
		}
	});
	<?php endif; ?>
	<?php if ($this->canDelete) : ?>
	// Delete
	$("#btnDelete").click(function(){
		DialogConfirm("คุณแน่ใจหรือไม่?", "แจ้งเตือนการลบ", function() {
			$.post("<?php echo $this->url(array("module" => 'content', "controller" => 'article', 'action' => 'delete'), null, true); ?>", {'id' : '<?php echo $this->data->ID?>'}, function(data){
				if (data.result) {
					DialogComplete('ลบสำเร็จ');
					setTimeout(function(){
						window.location = "<?php echo $this->url(array('module' => 'content', 'controller' => 'article', 'action' => 'index'), null, true); ?>";
					}, 500);
				} else {
					DialogWarning(data.message);
				}
			}, 'json');
		});
	});
	<?php endif ; ?>

	// Back
	$("#btnBack").click(function(){
		window.location = "<?php echo $this->url(array('module' => 'content', 'controller' => 'article', 'action' => 'index'), null, true); ?>";
	});

	// --------------------------- Tag Zone -------------------------- //
	$("#btnAddTag").click(function(){
		var txtTag = $("#txtTag").val();
		if (txtTag == "") {
			DialogWarning("<?php echo "กรุณากรอกข้อมูล"; ?>");
		} else {
			var isDup = false;
			$.each($('input[name^=hdfTag]'), function(i, e){
				var hiddenVal = $(e).val();
				if (hiddenVal == txtTag) {
					isDup = true;
				}
			});
			if (isDup) {
				DialogWarning("<?php echo "กำหนด Tag นี้ให้บทความนี้แล้ว"; ?>");
			} else {
				var html = '<div class="tagbox"><input type="hidden" name="hdfTag[]" value="' + txtTag + '" /><span class="taglabel">' + txtTag + '</span><em class="fa fa-times tagclose"></em></div>';
				$("#tagszone").append(html);
				$("#txtTag").val('');
			}
		}
	});
	$("#tagszone").on('click', ".tagclose", function(){
		$(this).parent().remove();
	});
	$('#txtTag').autocomplete({
		serviceUrl: '<?php echo $this->url(array("module" => "content", "controller" => "article", "action" => "getkeywordautocomplete"), null, true); ?>',
		params: {
			'searchType': function() {
				return $('#txtTag').val();
			}
		},
		onSelect: function(suggestion) {
			// Nothing ...
		},
		onHint: function (hint) {
			$('#txtTag-x').val(hint);
		},
		onInvalidateSelection: function() {
			// Nothing ...
		}
	});

});
//--------------------------- Date picker -------------------------- //
<?php 
if (count($this->languages) > 0) :
$i = 0;
	foreach ($this->languages as $lang) :
	$langCode = $lang['Code'];
	?>
    $('#<?php echo  "params-{$langCode}-PublishDate" ?>').datepicker({autoclose: true, format: 'dd/mm/yyyy'});
    $('#<?php echo  "params-{$langCode}-PublishDown" ?>').datepicker({autoclose: true, format: 'dd/mm/yyyy'});
    $('#<?php echo  "params-{$langCode}-PublishDown" ?>').change(function(){
		if ($(this).val() != "") {
			$("#<?php  echo "params-{$langCode}-PublishDownClose"; ?>").css("display", "block");
		}
	});
    $("#<?php  echo "params-{$langCode}-PublishDownClose"; ?>").click(function(){
    	$('#<?php echo  "params-{$langCode}-PublishDown" ?>').val('');
    	$("#<?php  echo "params-{$langCode}-PublishDownClose"; ?>").css("display", "none");
    });
<?php 
	endforeach;
endif;
?>
</script>