<script src="<?php echo $this->baseUrl('plugins/jQueryValidation/jquery.validate.min.js'); ?>"></script>
<script src="<?php echo $this->baseUrl('plugins/jQueryValidation/localization/messages_th.min.js'); ?>"></script>
<script>
$(function () {
	
	$("#formEdit").validate({
		errorElement: "em",
		errorPlacement: function(error, element) {
			error.addClass( "help-block" );
	        error.appendTo( element.parents("div.divControl"));
        }
    });

	$("#formEdit input[type=checkbox], #formEdit input[type=radio]").iCheck({checkboxClass: 'icheckbox_minimal-blue',radioClass: 'iradio_minimal-blue'});
	$('#formEdit input[type=radio][name$=Setting]').on('ifClicked', function(event){
		var val = $(this).val();
		var name = $(this).attr("name");
		if (val == 'D') {
			$(".custom" + name).css("display", "none");
		} else {
			$(".custom" + name).css("display", "");
		}
	});

	<?php if($this->canEdit): ?>
	// Save
	$("#btnSave").click(function(){
		var valid = $("#formEdit").valid();
		if (valid) {
			
			$.post("<?php echo $this->url(array('module' => 'banner', 'controller' => 'category', 'action' => 'settingsave'), null, true);?>", $("#formEdit").serializeArray(), function(data){
				if (data.result) {
					DialogComplete();
					setTimeout(function(){
						window.location = "<?php echo $this->url(array('module' => 'banner', 'controller' => 'category', 'action' => 'setting', "itemid" => $this->dataInfo->ID), null, true); ?>" ;
					}, 500);
				} else {
					DialogWarning(data.message);
				}
			}, 'json');
		}
	});
	<?php endif; ?>
});
</script>
