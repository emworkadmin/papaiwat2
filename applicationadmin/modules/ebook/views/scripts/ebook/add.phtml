	function toggleCanComment(val) {
		if (val == 'C') {
			$("#canComment").css("display", "");
		} else {
			$("#canComment").css("display", "none");
		}
	}
	$("input[id^=canCommentType]").on('ifChecked' , function(event){
		toggleCanComment($(this).val());
	});
	
	// Save
	$("#btnSave").click(function(){
		<?php foreach ($this->languages as $lang) :?>
		$("li[data-tab-lang=<?php echo $lang["Code"]; ?>]").removeClass("warning");
		<?php endforeach;?>
		var valid = $("#formData").valid();
		if (valid) {
			$.post("<?php echo $this->url(array('module' => 'ebook', 'controller' => 'ebook', 'action' => 'save'), null, true);?>", $("#formData").serializeArray(), function(data){
				if (data.result) {
					DialogComplete();
					setTimeout(function(){
						window.location = "<?php echo $this->url(array('module' => 'ebook', 'controller' => 'ebook', 'action' => 'edit'), null, true); ?>" + "/itemid/" + data.id;
					}, 500);
				} else {
					DialogWarning(data.message);
				}
			}, 'json');
		} else {
			<?php foreach ($this->languages as $lang) :?>
			if ($("#detail-<?php echo $lang["Code"]; ?>").find("input.error,select.error,textarea.error").length > 0) {$("li[data-tab-lang=<?php echo $lang["Code"]; ?>]").addClass("warning");}
			<?php endforeach;?>
		}
	});

	// Preview
	$("#btnPreview").click(function(){
		<?php foreach ($this->languages as $lang) :?>
		$("li[data-tab-lang=<?php echo $lang["Code"]; ?>]").removeClass("warning");
		<?php endforeach;?>
		var valid = $("#formData").valid();
		if (valid) {
			var dialogPreview = BootstrapDialog.show({
				title: 'ตัวอย่างข้อมูล',
				message: $('<div id="dialogdialogPreview"></div>').load("<?php echo $this->url(array('module' => 'ebook', 'controller' => 'ebook', 'action' => 'preview'), null, true); ?>", $("#formData").serializeArray()),
				closable: true,
	            closeByBackdrop: false,
	            closeByKeyboard: false,
	            autodestroy: true,
	            size: BootstrapDialog.SIZE_WIDE,
	            cssClass: "divPreview",
				buttons : [{
					label: ' ปิด',
					icon: 'fa fa-times',
					action: function(dialog) {
						dialog.close();
					}
				}]
			});
			dialogPreview.open();
		} else {
			<?php foreach ($this->languages as $lang) :?>
			if ($("#detail-<?php echo $lang["Code"]; ?>").find("input.error,select.error,textarea.error").length > 0) {$("li[data-tab-lang=<?php echo $lang["Code"]; ?>]").addClass("warning");}
			<?php endforeach;?>
		}
	});

