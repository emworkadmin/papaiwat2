    			obj.Lang[i].PublishDateTime = e.ProcedurePublishDateTime;
    			obj.Lang[i].PublishDown = e.ProcedurePublishDown;
    			obj.Lang[i].PublishDownTime = e.ProcedurePublishDownTime;
    			obj.Lang[i].StartDate = e.ProcedureStartDate;
    			obj.Lang[i].EndDate = e.ProcedureEndDate;
    			obj.Lang[i].Enable = e.ProcedureIsEnable;
    			if (i == dataObj.hdfDialogDefaultLanguage) {
    				title = e.ProcedureTitle;
					department = '-';
					$(departmentOption).each(function(index,value) {
						if(value.id == e.ProcedureDepartment){
							department = value.name;
						}
					});
    	    		url = e.ProcedureUrl == '' ? '-' : e.ProcedureUrl;
    	    		urlComment = e.ProcedureUrlType == 'E' ? ( e.ProcedureUrlComment == '' ? defaultCommentUrl : e.ProcedureUrlComment ) : defaultCommentUrl;
    	    		startDate = e.ProcedureStartDate == '' ? '-' : e.ProcedureStartDate;
    	    		endDate = e.ProcedureEndDate == '' ? '-' : e.ProcedureEndDate;
    	    		publishDate = e.ProcedurePublishDate + ' ' + e.ProcedurePublishDateTime.replace(/ /g, '');
    	    		publishDown = e.ProcedurePublishDown == '' ? '-' : e.ProcedurePublishDown + ' ' + e.ProcedurePublishDownTime.replace(/ /g, '');
    	    		enable = e.ProcedureIsEnable == 'Y' ? '<?php echo $this->publishOption['Y']?>' : '<?php echo $this->publishOption['N']?>';
    			}
    		});

    		var tempId = uuidv4();
    		if (obj.ID == '') {
    			obj.ID = tempId;
    		}
    		
    		var dataStr = JSON.stringify(obj);

    		var html = '';
    		html += '<tr data-id="' + (dataId == "" ? tempId : dataId) + '">';
    		html += '<td class="">';
    		html += '	<em class="fa fa-bars handle"></em> &nbsp;&nbsp;';
    		html += '	<span alt="dataIndex" ></span>';
    		html += '</td>';
    		html += '<td>';
			html += '<div class="title">' + title + '</div>'; 
			html += '<div class="detail-row"><div class="row"><div class="col-md-12"><span class="detail-label">หน่วยงาน: </span>' + department + '</div></div></div>'; 
			html += '<div class="detail-row"><div class="row"><div class="col-md-6"><span class="detail-label">วันที่เปิดรับ: </span>' + startDate + '</div><div class="col-md-6"><span class="detail-label">วันที่สิ้นสุด: </span>' + endDate + '</div></div></div>'; 
			html += '<div class="detail-row"><div class="row"><div class="col-md-6"><span class="detail-label">วันที่ประกาศ: </span>' + publishDate + '</div><div class="col-md-6"><span class="detail-label">วันที่ปิดประกาศ: </span>' + publishDown + '</div></div></div>'; 
			html += '<div class="detail-row"><div class="row"><div class="col-md-12"><span class="detail-label">Url: </span><a target="_blank" href="' + url + '">' + url + '</a></div></div></div>';
			html += '<div class="detail-row"><div class="row"><div class="col-md-12"><span class="detail-label">Url ความคิดเห็น: </span><a target="_blank" href="' + urlComment + '">' + urlComment + '</a></div></div></div>'; 
			html += '<div class="detail-row"><div class="row"><div class="col-md-12"><span class="detail-label">สถานะ: </span>' + enable + '</div></div></div>'; 
    		html += '</td>';
    		html += '<td class="">';
    		html += '	<button type="button" class="btn btn-primary edit"><em class="fa fa-pencil-square-o edit"></em></button>';
    		html += '	<button type="button" class="btn btn-danger remove"><em class="fa fa-trash remove"></em></button>';
    		html += '	<input type="hidden" id="params-<?php echo $this->defaultLanguage;?>-Procedure-' + (dataId == "" ? tempId : dataId) + '" name="params[<?php echo $this->defaultLanguage;?>][Procedure][' + (dataId == "" ? tempId : dataId) + ']" value="' + '' + '">';
    		html += '</td>';
    		html += '</tr>';

    		if (dataId == "") {
    			dataId = tempId;
    			$("#tblProcedure tbody").append(html); 
    		} else {
    			$("#tblProcedure tbody tr[data-id=" + dataId + "]").replaceWith(html); 
    		}
    		$("#tblProcedure tbody tr[data-id=" + dataId + "] input[type=hidden]").val(dataStr);

    		return true;
    	}
    	function reindexProcedure() {
    		var idx = 0;
    		$("#tblProcedure tbody tr").each(function(i, e) {
    			idx ++;
    			$(e).find('span[alt=dataIndex]').text(idx);
    		});
    	}
    	$('#tblProcedure tbody').sortable({
    		handle: '.handle',
    		cursor: 'move',
    		update: function ( event, ui ){ reindexProcedure(); }, 
    		start: function ( event, ui ){ 
    		}, 
    		stop: function ( event, ui ){ 
    		}
    	}).disableSelection();

        <?php if($this->isiOS) : ?>
        $("input[type=text][id$=PublishDate],input[type=text][id$=PublishDown]").removeAttr("readonly");
        <?php endif; ?>
        $("input[type=text][id$=PublishDateTime]").wickedpicker({twentyFour: true, title : 'เวลา', now : '<?php echo date('H:i');?>'});
        $("input[type=text][id$=PublishDownTime]").wickedpicker({twentyFour: true, title : 'เวลา', now : '0:00'});

        $("#formData input[type=checkbox], #formData input[type=radio]:not([name=TemplateType])").iCheck({checkboxClass: 'icheckbox_minimal-blue',radioClass: 'iradio_minimal-blue'});

		<?php if ($this->canEdit) : ?> 
        // Save
        $("#btnSave").click(function(){
            <?php foreach ($this->languages as $lang) :?>
            $("li[data-tab-lang=<?php echo $lang["Code"]; ?>]").removeClass("warning");
            <?php endforeach;?>
            var valid = $("#formData").valid();
            if (valid) {
                $.post("<?php echo $this->url(array('module' => 'license', 'controller' => 'item', 'action' => 'update'), null, true);?>", $("#formData").serializeArray(), function(data){
                    if (data.result) {
                        DialogComplete();
                        setTimeout(function(){
                            window.location = "<?php echo $this->url(array('module' => 'license', 'controller' => 'item', 'action' => 'edit', "itemid" => $this->data->ID), null, true); ?>";
                        }, 500);
                    } else {
                        DialogWarning(data.message);
                    }
                }, 'json');
            } else {
                <?php foreach ($this->languages as $lang) :?>
                if ($("#detail-<?php echo $lang["Code"]; ?>").find("input.error,select.error,textarea.error").length > 0) {$("li[data-tab-lang=<?php echo $lang["Code"]; ?>]").addClass("warning");}
                <?php endforeach;?>
            }
        });
		<?php endif ; ?>

		<?php if ($this->canDelete) : ?>
		// Delete
		$("#btnDelete").click(function(){
			DialogConfirm("คุณแน่ใจหรือไม่?", "แจ้งเตือนการลบ", function() {
				$.post("<?php echo $this->url(array("module" => 'license', "controller" => 'item', 'action' => 'delete'), null, true); ?>", {'id' : '<?php echo $this->data->ID?>'}, function(data){
					if (data.result) {
						DialogComplete('ลบสำเร็จ');
						setTimeout(function(){
							window.location = "<?php echo $this->url(array('module' => 'license', 'controller' => 'item', 'action' => 'index'), null, true); ?>";
						}, 500);
					} else {
						DialogWarning(data.message);
					}
				}, 'json');
			});
		});
		<?php endif ; ?>

        // Cancel
        $("#btnCancel").click(function(){
            window.location = "<?php echo $this->url(array('module' => 'license', 'controller' => 'item', 'action' => 'index'), null, true); ?>";
        });

    });

	
	// --------------------------- Date picker -------------------------- //
    <?php 
    if (count($this->languages) > 0) :
    $i = 0;
    foreach ($this->languages as $lang) :
    $langCode = $lang['Code'];
    ?>
	    $('#<?php echo  "params-{$langCode}-PublishDate" ?>').datepicker({autoclose: true, format: 'dd/mm/yyyy'});
	    $('#<?php echo  "params-{$langCode}-PublishDown" ?>').datepicker({autoclose: true, format: 'dd/mm/yyyy'});
	    $('#<?php echo  "params-{$langCode}-PublishDown" ?>').change(function(){
			if ($(this).val() != "") {
				$("#<?php  echo "params-{$langCode}-PublishDownClose"; ?>").css("display", "block");
			}
		});
	    $("#<?php  echo "params-{$langCode}-PublishDownClose"; ?>").click(function(){
	    	$('#<?php echo  "params-{$langCode}-PublishDown" ?>').val('');
	    	$("#<?php  echo "params-{$langCode}-PublishDownClose"; ?>").css("display", "none");
	    });
    <?php 
    	endforeach;
    endif;
    ?>	
</script>