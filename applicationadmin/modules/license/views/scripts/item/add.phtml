        // Save
        $("#btnSave").click(function(){
            <?php foreach ($this->languages as $lang) :?>
            $("li[data-tab-lang=<?php echo $lang["Code"]; ?>]").removeClass("warning");
            <?php endforeach;?>
            var valid = $("#formData").valid();
            if (valid) {
                $.post("<?php echo $this->url(array('module' => 'license', 'controller' => 'item', 'action' => 'save'), null, true);?>", $("#formData").serializeArray(), function(data){
                    if (data.result) {
                        DialogComplete();
                        setTimeout(function(){
                            window.location = "<?php echo $this->url(array('module' => 'license', 'controller' => 'item', 'action' => 'edit'), null, true); ?>" + "/itemid/" + data.id;
                        }, 500);
                    } else {
                        DialogWarning(data.message);
                    }
                }, 'json');
            } else {
                <?php foreach ($this->languages as $lang) :?>
                if ($("#detail-<?php echo $lang["Code"]; ?>").find("input.error,select.error,textarea.error").length > 0) {$("li[data-tab-lang=<?php echo $lang["Code"]; ?>]").addClass("warning");}
                <?php endforeach;?>
            }
        });

        // Cancel
        $("#btnCancel").click(function(){
            window.location = "<?php echo $this->url(array('module' => 'license', 'controller' => 'item', 'action' => 'index'), null, true); ?>";
        });

    });

	
