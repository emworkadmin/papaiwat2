        });

		// Get Ajax Option
		getData("<?php echo $this->url(array("module" => "license", "controller" => "issue", "action" => "ajaxlist"), null, true); ?>" + "?id=" + "", "#Issue", "-- โปรดเลือก --", "Name", "ID", ""); 
