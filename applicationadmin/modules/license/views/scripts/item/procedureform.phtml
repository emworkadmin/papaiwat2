<script type="text/javascript">
$(function () {

	$("#formDialog").validate({
		errorElement: "em",
		errorPlacement: function(error, element) {
			error.addClass( "help-block" );
	        error.appendTo( element.parents("div.divControl"));
        }
    });

    <?php if($this->isiOS) : ?>
    $("input[type=text][id$=ProcedureStartDate],input[type=text][id$=ProcedureEndDate],input[type=text][id$=ProcedurePublishDate],input[type=text][id$=ProcedurePublishDown]").removeAttr("readonly");
    <?php endif; ?>

    $('input[type=text][id$=ProcedureStartDate]').datepicker({autoclose: true, format: 'dd/mm/yyyy'});
    $('input[type=text][id$=ProcedureStartDate]').change(function(){
		if ($(this).val() != "") {
			$("span[id$=ProcedureStartDateClose]").css("display", "block");
		}
	});
    $("span[id$=ProcedureStartDateClose]").click(function(){
    	$('input[type=text][id$=ProcedureStartDate]').val('');
    	$("span[id$=ProcedureStartDateClose]").css("display", "none");
    });
    $('input[type=text][id$=ProcedureEndDate]').datepicker({autoclose: true, format: 'dd/mm/yyyy'});
    $('input[type=text][id$=ProcedureEndDate]').change(function(){
		if ($(this).val() != "") {
			$("span[id$=ProcedureEndDateClose]").css("display", "block");
		}
	});
    $("span[id$=ProcedureEndDateClose]").click(function(){
    	$('input[type=text][id$=ProcedureEndDate]').val('');
    	$("span[id$=ProcedureEndDateClose]").css("display", "none");
    });
    $('input[type=text][id$=ProcedurePublishDate]').datepicker({autoclose: true, format: 'dd/mm/yyyy'});
    $('input[type=text][id$=ProcedurePublishDown]').datepicker({autoclose: true, format: 'dd/mm/yyyy'});
    $('input[type=text][id$=ProcedurePublishDown]').change(function(){
		if ($(this).val() != "") {
			$("span[id$=ProcedurePublishDownClose]").css("display", "block");
		}
	});
    $("span[id$=ProcedurePublishDownClose]").click(function(){
    	$('input[type=text][id$=ProcedurePublishDown]').val('');
    	$("span[id$=ProcedurePublishDownClose]").css("display", "none");
    });
    
    $("input[type=text][id$=ProcedurePublishDateTime]").wickedpicker({twentyFour: true, title : 'เวลา', now : '<?php echo $this->publishDateTime;?>'});
    $("input[type=text][id$=ProcedurePublishDownTime]").wickedpicker({twentyFour: true, title : 'เวลา', now : '<?php echo $this->publishDownTime;?>'});

    $("#formDialog input[type=radio]:not([name=TemplateType])").iCheck({checkboxClass: 'icheckbox_minimal-blue',radioClass: 'iradio_minimal-blue'});

	$("#formDialog").on("ifClicked", "input[name='dialogParams[<?php echo $this->defaultLanguage; ?>][ProcedureUrlType]']", function(){	
		toggleVdoType($(this).val());
	});
	toggleVdoType($("input[name='dialogParams[<?php echo $this->defaultLanguage; ?>][ProcedureUrlType]']:checked").val());
	function toggleVdoType(val) {
		$("#divProcedureUrlComment").css('display', 'none');
		$('#dialogParams-<?php echo $this->defaultLanguage; ?>-ProcedureUrlComment').removeClass('required');
		$('#dialogParams-<?php echo $this->defaultLanguage; ?>-ProcedureUrlComment').prop('disabled', true);
		if(val == 'E'){
			$("#divProcedureUrlComment").css('display', '');
			$('#dialogParams-<?php echo $this->defaultLanguage; ?>-ProcedureUrlComment').prop('disabled', false);
		}else{
			$("#divProcedureUrlComment").css('display', 'none');
			$('#dialogParams-<?php echo $this->defaultLanguage; ?>-ProcedureUrlComment').prop('disabled', true);
		}
	}
});
</script>