<!-- DataTables -->
<script src="<?php echo $this->baseUrl('plugins/datatables/jquery.dataTables.min.js'); ?>"></script>
<script src="<?php echo $this->baseUrl('plugins/datatables/dataTables.bootstrap.min.js'); ?>"></script>
<script type="text/javascript">
    jQuery(function() {

        <?php if($this->canAdd) : ?>
    	$("#btnGoAdd").click(function(e) {
    		window.location = "<?php echo $this->url(array('module' => 'license', 'controller' => 'item', 'action' => 'add'), null, true); ?>";
		});
		<?php endif; ?>

        // Get Ajax Option
		getData("<?php echo $this->url(array("module" => "license", "controller" => "issue", "action" => "ajaxlist"), null, true); ?>" + "?id=<?php echo $this->InfoSearch->category; ?>" + "", "#isIssue", "-- โปรดเลือก --", "Name", "ID", "<?php echo $this->InfoSearch->issue; ?>"); 
		$("#isCat").change(function(){
			var selectValue = $(this).val();
			getData("<?php echo $this->url(array("module" => "license", "controller" => "issue", "action" => "ajaxlist"), null, true); ?>" + "?id=" + selectValue, "#isIssue", "-- โปรดเลือก --", "Name", "ID", "");
		});

		// --------------- Begin: Table & Search Zone -------------------------    	
    	function renderColumn ( data, type, row, meta ) {
    		return data;
    	}
    	function renderColumnLink ( data, type, row, meta ) {
    		return '<a href="<?php echo $this->url(array('module' => 'license', 'controller' => 'item', 'action' => 'edit'), null, true);?>/itemid/' + row.DT_RowId + '">' + data + '</a>';
    	}
    	function renderColumnStatus ( data, type, row, meta ) {
        	if (row.IsEnableCode == 'Y') {
				return '<span class="label label-success">' + data + '</span>';
        	} else {
				return '<span class="label label-danger">' + data + '</span>';
        	}
    	}
		function renderColumnCheckbox ( data, type, row, meta ) {
        	return '<input type="checkbox" name="ids[]" value="' + row.DT_RowId + '" />';
    	}
    	var rows_selected = [];

    	var tblData = $('#tblData').DataTable({
    		processing: true,
    		serverSide: true,
    		responsive: true,
    		<?php
			if ($this->InfoSearch->tblPage) {
				echo 'displayStart: ' . $this->InfoSearch->tblPage . ',';
			}
			if ($this->InfoSearch->tblRow) {
				echo 'pageLength: ' . $this->InfoSearch->tblRow . ',';
			}
			if ($this->InfoSearch->tblOrderCol && $this->InfoSearch->tblOrderDir) {
				echo 'order: [[ ' . $this->InfoSearch->tblOrderCol . ', "' . $this->InfoSearch->tblOrderDir . '" ]],';
			} else {
				echo 'order: [[ 5, "desc" ]],';
			}
			?>
    		ajax: {
    	        url: '<?php echo $this->url(array('module' => 'license', 'controller' => 'item', 'action' => 'getlist'), null, true); ?>',
    	        type: 'POST',
    	        data: function(d) {
        	        d.textstr = $("#formSearch #textsearch").val();
        	        d.isEnable = $("#formSearch #is_enable").val();
        	        d.isCat = $("#formSearch #isCat").val();
        	        d.isIssue = $("#formSearch #isIssue").val();
        	        // d.isDepartment = $("#formSearch #isDepartment").val();
    	        }
    	    },
    	    language : {
				url : '<?php echo $this->baseUrl('plugins/datatables/localization/jquery.dataTables.thai.json'); ?>'
    	    },
    		"dom": '<"dataTable"rt<"bottom"ilp<"clear">>>',
    		"columns": [
						{ "width": "10px", 'orderable': false, 'data' : 'NO', 'render' : renderColumnCheckbox, "class" : "text-center"},
    		            { "width": "40px", 'orderable': false, 'data' : 'NO', "class" : "text-center"},
    		            { 'data' : 'Title' , 'render' : renderColumnLink, "class" : "ratio"},
    		            { "width": "15%", 'data' : 'CategoryTitle' , 'render' : renderColumnLink, "class" : "ratio"},
    		            { "width": "15%", 'data' : 'IssueName' , 'render' : renderColumnLink, "class" : "ratio"},
    		            // { "width": "13%", 'data' : 'DepartmentName' , 'render' : renderColumnLink, "class" : "ratio"},
    		            { "width": "15%", 'data' : 'Created' , 'render' : renderColumnLink, "class" : "ratio"},
    		            { "width": "10%", 'data' : 'IsEnable' , 'render' : renderColumnStatus, "class" : "ratio"}
    		          ]
        });

		$('#btnSearch').click(function(){
			tblData.ajax.reload();
		});

		$('#btnReset').click(function(){
            getData("<?php echo $this->url(array("module" => "license", "controller" => "issue", "action" => "ajaxlist"), null, true); ?>" + "?id=" + "", "#isIssue", "-- โปรดเลือก --", "Name", "ID", ""); 

			$(".searchPanel input[type=text]").val('');
			$(".searchPanel select").val('');
			tblData.ajax.reload();
		});
		
		// --------------- Toogle Advance Search ---------------
		$("#btnAdvance").click(function(e) {
			var val = $('#hdfAdvanceSearch').val();
			if(val == 'H'){
				$("#AdvanceSearch").slideDown(600, "swing");
				$("#hdfAdvanceSearch").val('S');
			}else{
				$("#AdvanceSearch").slideUp(600, "swing");
				$("#hdfAdvanceSearch").val('H');
			}
		});  

		<?php if($this->canAdd) : ?>
		$('#btnPublish').click(function(){
            var ids = [];
            $.each($('#tblData input[type=checkbox]:not([name=chkAll]):checked'), function(i, e){
                ids.push($(e).val());
            });
            if (ids.length > 0) {
                DialogConfirm("คุณแน่ใจหรือไม่?", "แจ้งเตือนการเผยแพร่", function() {
                    $.post("<?php echo $this->url(array("module" => 'license', "controller" => 'item', 'action' => 'listpublish'), null, true); ?>", {"ids" : ids, "status": "Y"}, function(data){
                        if (data.result) {
                            tblData.ajax.reload();
                            DialogComplete("ปรับปรุงสถานะสำเร็จ");
                        } else {
                            DialogWarning(data.message);
                        }
                    }, 'json');
                });
            } else {
                DialogWarning("โปรดเลือกอย่างน้อยหนึ่งรายการ");
            }
            $('#chkAll').prop('checked',false);
        });
    
        $('#btnUnpublish').click(function(){
            var ids = [];
            $.each($('#tblData input[type=checkbox]:not([name=chkAll]):checked'), function(i, e){
                ids.push($(e).val());
            });
            if (ids.length > 0) {
                DialogConfirm("คุณแน่ใจหรือไม่?", "แจ้งเตือนการไม่เผยแพร่", function() {
                    $.post("<?php echo $this->url(array("module" => 'license', "controller" => 'item', 'action' => 'listpublish'), null, true); ?>", {"ids" : ids, "status": "N"}, function(data){
                        if (data.result) {
                            tblData.ajax.reload();
                            DialogComplete("ปรับปรุงสถานะสำเร็จ");
                        } else {
                            DialogWarning(data.message);
                        }
                    }, 'json');
                });
            } else {
                DialogWarning("โปรดเลือกอย่างน้อยหนึ่งรายการ");
            }
            $('#chkAll').prop('checked',false);
        });

		$('#btnCopy').click(function(){
            var ids = [];
            $.each($('#tblData input[type=checkbox]:not([name=chkAll]):checked'), function(i, e){
                ids.push($(e).val());
            });
            if (ids.length > 0) {
                DialogConfirm("คุณแน่ใจหรือไม่?", "แจ้งเตือนการคัดลอกข้อมูล", function() {
                    $.post("<?php echo $this->url(array("module" => 'license', "controller" => 'item', 'action' => 'listcopy'), null, true); ?>", {"ids" : ids}, function(data){
                        if (data.result) {
                            tblData.ajax.reload();
                            DialogComplete("คัดลอกข้อมูลสำเร็จ");
                        } else {
                            DialogWarning(data.message);
                        }
                    }, 'json');
                });
            } else {
                DialogWarning("โปรดเลือกอย่างน้อยหนึ่งรายการ");
            }
            $('#chkAll').prop('checked',false);
        });
            
        $('#btnDelete').click(function(){
            var ids = [];
            $.each($('#tblData input[type=checkbox]:not([name=chkAll]):checked'), function(i, e){
                ids.push($(e).val());
            });
            if (ids.length > 0) {
                DialogConfirm("คุณแน่ใจหรือไม่?", "แจ้งเตือนการลบ", function() {
                    $.post("<?php echo $this->url(array("module" => 'license', "controller" => 'item', 'action' => 'listdelete'), null, true); ?>", {"ids" : ids}, function(data){
                        if (data.result) {
                            tblData.ajax.reload();
                            DialogComplete("ลบสำเร็จ");
                        } else {
                            DialogWarning(data.message);
                        }
                    }, 'json');
                });
            } else {
                DialogWarning("โปรดเลือกอย่างน้อยหนึ่งรายการ");
            }
            $('#chkAll').prop('checked',false);
        });
        <?php endif; ?>

        $('#chkAll').click(function(){
            var val = $(this).is(":checked");
            if(val){
                $('input[name="ids[]"]').prop('checked',true);
            }else{
                $('input[name="ids[]"]').prop('checked',false);
            }
        });   

        // Import Excel
    	$("#btnImportExcel").click(function(){
    		var dialogImportLicense = BootstrapDialog.show({
    			title: 'นำเข้าใบอนุญาต',
    			message: $('<div id="dialogImportLicense"></div>').load("<?php echo $this->url(array('module' => 'license', 'controller' => 'item', 'action' => 'importform'), null, true); ?>", {}),
    			closable: true,
                closeByBackdrop: false,
                closeByKeyboard: false,
                autodestroy: true,
    			buttons : [{
    				label: ' ยืนยัน',
    				icon: 'fa fa-check',
    				cssClass: 'btn-primary btn-dialog-import',
    				action: function(dialog) {
                        $('.btn-dialog-import').prop('disabled',true);
                        $.post("<?php echo $this->url(array('module' => 'license', 'controller' => 'item', 'action' => 'import'), null, true); ?>", $("#formImportLicense").serializeArray(), function(data){
                            if (data.result) {
                                DialogComplete("นำเข้าใบอนุญาตสำเร็จ");
                                tblData.ajax.reload();
                                dialog.close();
                            } else {
                                $('.btn-dialog-import').prop('disabled',false);
                                DialogWarning(data.message);
                            }
                        }, 'json');
    				}
    			},{
    				label: ' ปิด',
    				icon: 'fa fa-times',
    				action: function(dialog) {
    					dialog.close();
    				}
    			}]
    		});
    		dialogImportLicense.open();
    	});   
                        
    });
</script>