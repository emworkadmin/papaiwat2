<script type="text/javascript">
$(function () {

	$.fn.alphabetonly = function(options) {
		var opts = $.extend( {}, $.fn.alphabetonly.defaults, options );
		msg = opts.message;
		color = opts.color;
		size = opts.size;
		fontstyle = opts.fontstyle;
		var letters = /^[A-Za-z]+$/;
		$.each($(this), function(i,e) {
			var id = $(e).attr("id");
			$(e).parent().append("<span class='pattern-validate-txt' id='"+id+"' style='display:none;color:"+color+";font-size:"+size+";font-style:"+fontstyle+";'>" + msg + "</span>");
			$(this).keyup(function() {
				if($(this).val().length>0) {
					if( letters.test($(this).val()) ) {
						$("span#"+id).css({"display":"none"});
                        alphabetcheck = true;
					} else {
						$("span#"+id).css({"display":"block"});
                        alphabetcheck = false;
					}
				} else {
					$("span#"+id).css({"display":"none"});
                    alphabetcheck = true;
				}
			});
		});
	}
	$.fn.alphabetonly.defaults = {
		message: "โปรดระบุเฉพาะตัวอักษรภาษาอังกฤษ",
		color: "red",
		size: '12px',
        fontstyle: 'italic'
	};

	$('.alpha').alphabetonly();


    $("#formDialog input[type=checkbox], #formDialog input[type=radio]").iCheck({checkboxClass: 'icheckbox_minimal-blue',radioClass: 'iradio_minimal-blue'});

	$("#formDialog").validate({
		errorElement: "em",
		errorPlacement: function(error, element) {
			error.addClass( "help-block" );
	        error.appendTo( element.parents("div.divControl"));
        }
    });

    /* Check && Radio */
    $("#lnkAddOption").click(function() {
        var index =  $("#divOption div.row").length ; 
        
        var html = "";
        html += '<div class="row">' + '\n';
        html += '    <div class="col-md-12 divControl" style="margin-bottom: 10px;">' + '\n';
        html += '        <label class="optionNo col-md-1 control-label">' + (index+1) + '.</label>' + '\n';
        html += '        <label class="col-md-2 control-label">หัวข้อ </label>' + '\n';
        html += '        <div class="col-md-5 divControl">' + '\n';
        html += '            <input type="text" name="Option[' + index + '][value]" id="Option-' + index + '-value" value="" alt="value" class=" form-control" maxlength="50" >' + '\n';
        html += '        </div>' + '\n';
        html += '        <label class="col-md-2 control-label">รายการที่เลือก </label>' + '\n';
        html += '        <div class="col-md-1 divControl">' + '\n';
        html += '            <div class="checkbox with-icheck">' + '\n';
        html += '            <input type="checkbox" name="Option[' + index + '][check]" id="Option-' + index + '-check">' + '\n';
        html += '            </div>' + '\n';
        html += '        </div>' + '\n';
        html += '        <em class="col-md-1 fa fa-trash-o lnkDeleteOption"></em>' + '\n';
        html += '    </div>' + '\n';
        html += '</div>' + '\n';
        $("#divOption").append(html); 
        $("#formDialog input[type=checkbox], #formDialog input[type=radio]").iCheck({checkboxClass: 'icheckbox_minimal-blue',radioClass: 'iradio_minimal-blue'});
    });
    $("#divOption").bind('click', function(e) {
        var target = $(e.target);
        if (target.hasClass("lnkDeleteOption")) { 
            target.parent("div.divControl").parent("div.row").fadeOut('fast', function(){
                $(this).remove();
                // reindex
                $("#divOption div.row").each(function(i, e){ 
                    $(e).find('label.optionNo').html((i+1) + '.');   
                    $(e).find('input[alt=value]').attr("name", "Option[" + i + "][value]").attr("id", "Option-" + i + "-value"); 
                    $(e).find('input[alt=check]').attr("name", "Option[" + i + "][check]").attr("id", "Option-" + i + "-check"); 
                });  
            });  
        } 
    });

    /* Dropdown */
    $("#lnkAddDropdown").click(function() {
        var index =  $("#divDropdown div.row").length ; 
        
        var html = "";
        html += '<div class="row">' + '\n';
        html += '    <div class="col-md-12 divControl" style="margin-bottom: 10px;">' + '\n';
        html += '        <label class="dropdownNo col-md-1 control-label">' + (index+1) + '.</label>' + '\n';
        html += '        <label class="col-md-2 control-label">หัวข้อ </label>' + '\n';
        html += '        <div class="col-md-5 divControl">' + '\n';
        html += '            <input type="text" name="Dropdown[' + index + '][value]" id="Dropdown-' + index + '-value" value="" alt="value" class=" form-control" maxlength="50" >' + '\n';
        html += '        </div>' + '\n';
        html += '        <label class="col-md-2 control-label"> รายการที่เลือก</label>' + '\n';
        html += '        <div class="col-md-1 divControl">' + '\n';
        html += '            <div class="checkbox with-icheck">' + '\n';
        html += '            <input type="checkbox" name="Dropdown[' + index + '][check]" id="Dropdown-' + index + '-check">' + '\n';
        html += '            </div>' + '\n';
        html += '        </div>' + '\n';
        html += '        <em class="col-md-1 fa fa-trash-o lnkDeleteDropdown"></em>' + '\n';
        html += '    </div>' + '\n';
        html += '</div>' + '\n';
        $("#divDropdown").append(html); 
        $("#formDialog input[type=checkbox], #formDialog input[type=radio]").iCheck({checkboxClass: 'icheckbox_minimal-blue',radioClass: 'iradio_minimal-blue'});
    });
    $("#divDropdown").bind('click', function(e) {
        var target = $(e.target);
        if (target.hasClass("lnkDeleteDropdown")) { 
            target.parent("div.divControl").parent("div.row").fadeOut('fast', function(){
                $(this).remove();
                // reindex
                $("#divDropdown div.row").each(function(i, e){ 
                    $(e).find('label.dropdownNo').html((i+1) + '.');   
                    $(e).find('input[alt=value]').attr("name", "Dropdown[" + i + "][value]").attr("id", "Dropdown-" + i + "-value"); 
                    $(e).find('input[alt=check]').attr("name", "Dropdown[" + i + "][check]").attr("id", "Dropdown-" + i + "-check"); 
                });  
            });  
        } 
    });

});
</script>