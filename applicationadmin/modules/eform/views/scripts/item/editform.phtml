<script type="text/javascript">
var dialogParamsList;
var tmp_array = [];
var alphabetcheck = true;
$(function () {
	
	<?php
	if (count($this->dataType) > 0) {
		foreach ($this->dataType as $key => $item) {
	?>
			tmp_array[<?php echo $key + 1; ?>] = "<?php echo $item['NAME_']; ?>";
	<?php
		}
	}
	?>

    $( "#ControlParams" ).sortable({
        handle: '.handle',
        cursor: 'move',
        update: function( event, ui ){
            reindex();
        }
    }).disableSelection();

    $("#ControlAdd").click(function() {
        dialogParamsList = BootstrapDialog.show({
            title: 'รายการแบบกรอก',
            message: $('<div id="dialogParamsList"></div>').load("<?php echo $this->url(array('module' => 'eform', 'controller' => 'controltype', 'action' => 'dialog'), null, true); ?>/itemid/" + <?php echo $this->ID; ?>),
            closable: true,
            closeByBackdrop: false,
            closeByKeyboard: false,
            autodestroy: true,
			cssClass: "eformdialoglist",
            buttons : [{
                label: ' ปิด',
                icon: 'fa fa-times',
                action: function(dialog) {
                    dialogParamsList.close();
                }
            }]
        });       
        dialogParamsList.open();
    });


	$("#ControlParams").bind('click', function(e) {
		var target = $(e.target);		

        if (target.hasClass("edit")) {
            var data = target.parent("div").find('input[type=hidden]').val();
            var name = target.parent("div").find('input[type=hidden]').attr('data-name');
            var obj = JSON.parse(data);
            var id = obj.EformControlTypeID;
            var dataId = target.parent('div').parent('div').attr('data-id');

            var dialogParamsForm = BootstrapDialog.show({
            title: name,
            message: $('<div id="dialogParamsForm"></div>').load("<?php echo $this->url(array('module' => 'eform', 'controller' => 'controltype', 'action' => 'dialogform'), null, true); ?>", {"id" : id, "data" : data}),
            closable: true,
            closeByBackdrop: false,
            closeByKeyboard: false,
            autodestroy: true,
			cssClass: "eformdialog",
            buttons : [
                {
                    label: 'บันทึก',
                    icon: 'fa fa-save',
                    cssClass: 'btn-primary',
                    action: function(dialog) {
                        var isValid = $("#dialogParamsForm form").valid();
                        if (isValid && alphabetcheck) {
							var dataObj = $("#dialogParamsForm form").serializeObject();
							if(tmp_array[dataId] != dataObj.Name) {
								if(tmp_array.includes(dataObj.Name)) {
									DialogWarning('โปรดใส่ชื่อคีย์ที่ไม่ซ้ำกัน !','แจ้งเตือน');
									return;
								}
							}
							saveParams(dataId, dataObj);
							reindex();
							dialog.close();							
                        }                            
                    }
                },
                {
                    label: 'ปิด',
                    icon: 'fa fa-times',
                    action: function(dialog) {
                        dialog.close();
                    }
                }]
            });
        }

		if (target.hasClass("remove")) {
			DialogConfirm("คุณแน่ใจหรือไม่?", "แจ้งเตือนการลบ", function() {
				target.parent("div").parent("div").fadeOut('fast', function() {
					$(this).remove();
					reindex();
					tmp_array = $.grep(tmp_array, function(value) {
						return value != target[0].id;
					});				
				});
			});            
        }
    });    

	function saveParams(dataId, dataObj) {
			
        var obj = {};

        obj.EformControlTypeID = dataObj.hdfFormID;
        obj.NAME = dataObj.Name;
        obj.LABEL = dataObj.Label;
        obj.PLACEHOLDER = dataObj.Placeholder;
        obj.DESCRIPTION = dataObj.Description;
        obj.REQUIRED = dataObj.Required;
        obj.VALIDATIONRULE = dataObj.Validationrule;
        obj.SIZE = dataObj.Size;
        obj.MAXLENGTH = dataObj.Maxlength;
        obj.VALIDATE = dataObj.Validate
        obj.COLS = dataObj.Cols;
        obj.ROWS = dataObj.Rows;
        obj.DROPDOWN = dataObj.Dropdown;
        obj.OPTION = dataObj.Option;
        obj.FLOW = dataObj.Flow;
        obj.FILESIZE = dataObj.Filesize;
        obj.FILETYPE = dataObj.Filetype;
        obj.MULTIPLE = dataObj.Multiple;
        obj.RESETBUTTON = dataObj.Resetbutton;
        obj.RESETLABEL = dataObj.Resetlabel;
        obj.MESSAGE = dataObj.Message;
        
        var labelClassRequired = '';
        if(dataObj.Required == 'Y') {
            labelClassRequired = ' labelRequest'; 
        }

        var dataStr = JSON.stringify(obj);

        var tempId = (new Date()).getTime();

        var html = '';
        html += '<div class="line" data-id="' + (dataId == "" ? tempId : dataId) + '">';
        html +=     '<div class="icon">';
        html +=         '<em class="fa fa-bars handle"></em>';
        html +=         '<em class="fa fa-trash remove" id="' + obj.NAME + '"></em>';
        html +=         '<em class="fa fa-cog edit"></em>';
        html +=         '<input type="hidden" id="params[ControlParams][' + (dataId == "" ? tempId : dataId) + ']" name="params[ControlParams][' + (dataId == "" ? tempId : dataId) + ']" value="' + '' + '">';        
        html +=     '</div>';
        html +=     '<div class="num" style="display: none;">';
        html +=         '<span alt="dataIndex"></span>';
        html +=     '</div>';

        if(obj.EformControlTypeID == 8) {
            html +=     '<div class="form-group has-feedback">';
        } else {
            html +=     '<div class="form-group">';
        }

        if(obj.EformControlTypeID == 11 || obj.EformControlTypeID == 9) {
            html +=         '<label class="col-md-3 control-label"></label>';
            html +=         '<div class="col-md-9 divControl">';
        } else {
            html +=         '<label class="col-md-3 control-label ' + labelClassRequired + '">' + obj.LABEL +'</label>';
            html +=         '<div class="col-md-9 divControl">';
        }
        
        if(obj.EformControlTypeID == 1) {

            html += '<input type="text" name="' + obj.NAME + '" id="' + obj.NAME + '" class="form-control ' + obj.VALIDATIONRULE + '" placeholder="' + obj.PLACEHOLDER + '" size="' + obj.SIZE + '" maxlength="' + obj.MAXLENGTH + '"> ';
            if(obj.DESCRIPTION) {
                html += "<div class=\"help-block\">" + obj.DESCRIPTION + "</div>";
            }

        } else if(obj.EformControlTypeID == 2) {

            html += '<textarea name="' + obj.NAME + '" id="' + obj.NAME + '" placeholder="' + obj.PLACEHOLDER + '" class="form-control ' + obj.VALIDATIONRULE + '" style="max-width:100%;" rows="' + obj.ROWS + '" cols="' + obj.COLS + '" maxlength="1000"></textarea>';
            if(obj.DESCRIPTION) {
                html += "<div class=\"help-block\">" + obj.DESCRIPTION + "</div>";
            }

        } else if(obj.EformControlTypeID == 3) {

            if(obj.MULTIPLE == 'Y') {
                html += '<select name="' + obj.NAME + '" id="' + obj.NAME + '" class="form-control" size="' + obj.SIZE + '" Multiple>';
            } else {
                html += '<select name="' + obj.NAME + '" id="' + obj.NAME + '" class="form-control" size="' + obj.SIZE + '" >';
            }

            var loop_3 = 0;
            var loop_3_length = obj.DROPDOWN.length;
            $.each(obj.DROPDOWN, function (i, e) {
                if(obj.MULTIPLE == 'Y') {
					if(e.check) {
                    html += '<option value="' + e.value + '" Selected>' + e.value + '</option>';
					} else {
					html += '<option value="' + e.value + '">' + e.value + '</option>';
					}
                } else {
                    loop_3++;
                    if(e.check && loop_3_length == loop_3) {
                        html += '<option value="' + e.value + '" Selected>' + e.value + '</option>';
                    } else {
                        html += '<option value="' + e.value + '">' + e.value + '</option>';
                    }
                }
            });
            
            html += '</select>';

            if(obj.DESCRIPTION) {
                html += "<div class=\"help-block\">" + obj.DESCRIPTION + "</div>";
            }           

        } else if(obj.EformControlTypeID == 4) {

            if(obj.FLOW == 'H') {
                html += '<div class="checkbox with-icheck">';
            }
            $.each(obj.OPTION, function (i, e) {
                if(obj.FLOW == 'V') {
                    html += '<div class="checkbox with-icheck">';
                }
                html += '<label class="form-inline" for="">';
                if(e.check) {
                    html += '<input type="checkbox" checked value="' + e.value + '" id="' + obj.NAME + '-' + e.value + '" name="' + obj.NAME + '-' + e.value + '">' + e.value;
                } else {
                    html += '<input type="checkbox" value="' + e.value + '" id="' + obj.NAME + '-' + e.value + '" name="' + obj.NAME + '-' + e.value + '">' + e.value;
                }
                html += '</label>';
                if(obj.FLOW == 'V') {
                    html += '</div>';
                }
            });
            if(obj.FLOW == 'H') {
                html += '</div>';
            }
            if(obj.DESCRIPTION) {
                html += "<div class=\"help-block\">" + obj.DESCRIPTION + "</div>";
            }
            
        } else if(obj.EformControlTypeID == 5) {

            if(obj.FLOW == 'H') {
                html += '<div class="checkbox with-icheck">';
            }
            $.each(obj.OPTION, function (i, e) {
                if(obj.FLOW == 'V') {
                    html += '<div class="checkbox with-icheck">';
                }
