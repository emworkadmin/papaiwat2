<script src="<?php echo $this->baseUrl('plugins/jQueryValidation/jquery.validate.min.js'); ?>"></script>
<script src="<?php echo $this->baseUrl('plugins/jQueryValidation/localization/messages_th.min.js'); ?>"></script>
<script>
$(function () {
	
	$("#formSetting").validate({
		errorElement: "em",
		errorPlacement: function(error, element) {
			error.addClass( "help-block" );
	        error.appendTo( element.parents("div.divControl"));
        }
    });

	$("#formSetting input[type=checkbox], #formSetting input[type=radio]").iCheck({checkboxClass: 'icheckbox_minimal-blue',radioClass: 'iradio_minimal-blue'});


	<?php if($this->canEdit): ?>
		// Save
		$("#btnSave").click(function(){
			var valid = $("#formSetting").valid();
			console.log(valid);
			if (valid) {
				$.post("<?php echo $this->url(array('module' => 'eform', 'controller' => 'item', 'action' => 'settingsave'), null, true);?>", $("#formSetting").serializeArray(), function(data){
					if (data.result) {
						DialogComplete();
						setTimeout(function(){
							window.location = "<?php echo $this->url(array('module' => 'eform', 'controller' => 'item', 'action' => 'setting', "itemid" => $this->itemID), null, true); ?>" ;
						}, 500);
					} else {
						DialogWarning(data.message);
					}
				}, 'json');
			}
		});
	<?php endif; ?>
});
</script>