<div class="row">
	<div class="col-md-12">
		<table class="table">
		<tr>
			<td><canvas id="myChart"></canvas></td>
		</tr>
		</table>
	</div>
</div>
 <script type="text/javascript">
    jQuery(function(){
		var ctx = document.getElementById('myChart').getContext('2d');
		var chart = new Chart(ctx, {
		    type: 'line',
		    data: {
		        labels: [
						<?php 
							$i = '';
							$l = count($this->data);
							if($l>0) {
								foreach($this->data as $item) {
									echo '"'. $item['SubmitDate'] .'"';
									if($i != $l){
										echo ',';
									}
									$i++;
								} 
							}
						?>
					],
		        datasets: [{
		            label: "สถิติการตอบกลับ",
		            backgroundColor: '#007bb5',
                    borderColor: '#007bb5',
		            data: [
						<?php 
							$i = '';
							$l = count($this->data);
							if($l>0) {
								foreach($this->data as $item) {
									echo '"'. $item['ID'] .'"';
									if($i != $l){
										echo ',';
									}
									$i++;
								} 
							}
						?>
					],
		            fill : false,
				}]
		    },
		    // Configuration options go here
			options: {
				elements: {
					line : { 
						tension : 0 
					}
				},
				legend: {
					display: false,
				}				 
			}
		});
	});
</script> 