        foreach($this->dataType as $k => $v) :
            ?>

            <table id="tblData" class="table table-bordered table-hover">
                <caption><?php echo $v['Label'];?></caption>
                <thead>
                    <tr>
                        <th>ลำดับ</th>
                        <th>รายการข้อมูล</th>
                        <th>จำนวน</th>
                    </tr>
                </thead>
                <tbody>
