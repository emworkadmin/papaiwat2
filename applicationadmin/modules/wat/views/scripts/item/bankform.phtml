<script type="text/javascript">
$(function () {
	$("#formDialog").validate({
		errorElement: "em",
		errorPlacement: function(error, element) {
			error.addClass( "help-block" );
	        error.appendTo( element.parents("div.divControl"));
        }
    });

	$("#AccountNo").keypress(function(e){
		var value  = e.currentTarget.value;
		var pattern=new String("___-_-_____-_");
		var pattern_ex=new String("-");
		var returnText=new String("");
		var obj_l=value.length;
		var obj_l2=obj_l-1;
		for(i=0;i<pattern.length;i++){           
			if(obj_l2==i && pattern.charAt(i+1)==pattern_ex){
				returnText+=value+pattern_ex;
				value=returnText;
			}
		}
		if(obj_l>=pattern.length){
			value=value.substr(0,pattern.length);           
		}
		$(this).val(value);
	});
});
</script>