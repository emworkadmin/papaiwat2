	function savePromptPay(dataId) {
		var dataObj = $("#dialogPromptPay form").serializeObject();

		var promptpayName = dataObj.PromptPayName;
		var promptpayNo = dataObj.PromptPayNo;

		var obj = {};
		obj.ID = dataObj.hdfDialogID;
		obj.PromptPayName = dataObj.PromptPayName;
		obj.PromptPayNo = dataObj.PromptPayNo;

		var tempId = uuidv4();
		if (obj.ID == '') {
			obj.ID = tempId;
		}
		var dataStr = JSON.stringify(obj);

		var html = '';
		html += '<tr data-id="' + (dataId == "" ? tempId : dataId) + '">';
		html += '<td class="">';
		html += '	<em class="fa fa-bars handle"></em> &nbsp;&nbsp;';
		html += '	<span alt="dataIndex" ></span>';
		html += '</td>';
		html += '<td class="">' + promptpayName + '</td>';
		html += '<td class="">' + promptpayNo + '</td>';
		html += '<td class="">';
		html += '	<button type="button" class="btn btn-primary edit"><em class="fa fa-pencil-square-o edit"></em></button>';
		html += '	<button type="button" class="btn btn-danger remove"><em class="fa fa-trash remove"></em></button>';
		html += '	<input type="hidden" id="params-<?php echo $this->defaultLanguage;?>-PromptPay-' + (dataId == "" ? tempId : dataId) + '" name="params[<?php echo $this->defaultLanguage;?>][PromptPay][' + (dataId == "" ? tempId : dataId) + ']" value="' + '' + '">';
		html += '</td>';
		html += '</tr>';

		if (dataId == "") {
			dataId = tempId;
			$("#tblPromptPay tbody").append(html); 
		} else {
			$("#tblPromptPay tbody tr[data-id=" + dataId + "]").replaceWith(html); 
		}
		$("#tblPromptPay tbody tr[data-id=" + dataId + "] input[type=hidden]").val(dataStr);
	}
	function reindexPromptPay() {
		var idx = 0;
		$("#tblPromptPay tbody tr").each(function(i, e){ 
			idx ++;
			$(e).find('span[alt=dataIndex]').text(idx);
		});  
	}
	$('#tblPromptPay tbody').sortable({
		handle: '.handle',
		cursor: 'move',
		update: function ( event, ui ){ reindexPromptPay(); }, 
		start: function ( event, ui ){ 
		}, 
		stop: function ( event, ui ){ 
		}
	}).disableSelection();

