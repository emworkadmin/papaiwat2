	function saveActivity(dataId) {
		var dataObj = $("#dialogActivity form").serializeObject();
		var detail = ''
		var obj = {};
		obj.ID = dataObj.hdfDialogID;
		obj.TypeID = '';
		obj.Lang = {};
		$.each(dataObj.dialogParams, function(i, e){ 
			obj.Lang[i] = {};
			obj.Lang[i].Detail = e.Detail;
			if (i == dataObj.hdfDialogDefaultLanguage) {
				obj.TypeID = e.Type;
				obj.Detail = e.Detail;
				detail = e.Detail;
				detail = detail.replace(/(?:\r\n|\r|\n)/g, '<br>');
			}
		});
		var typeName = $("#dialogActivity").find("#lstDialogType option[value=" + obj.TypeID + "]").text();
		var tempId = uuidv4();
		if (obj.ID == '') {
			obj.ID = tempId;
		}
		var dataStr = JSON.stringify(obj);

		var html = '';
		html += '<tr data-id="' + (dataId == "" ? tempId : dataId) + '">';
		html += '<td class="">';
		html += '	<em class="fa fa-bars handle"></em> &nbsp;&nbsp;';
		html += '	<span alt="dataIndex" ></span>';
		html += '</td>';
		html += '<td class="">' + typeName + '</td>';
		html += '<td class="">' + detail + '</td>';
		html += '<td class="">';
		html += '	<button type="button" class="btn btn-primary edit"><em class="fa fa-pencil-square-o edit"></em></button>';
		html += '	<button type="button" class="btn btn-danger remove"><em class="fa fa-trash remove"></em></button>';
		html += '	<input type="hidden" id="params-<?php echo $this->defaultLanguage;?>-Activity-' + (dataId == "" ? tempId : dataId) + '" name="params[<?php echo $this->defaultLanguage;?>][Activity][' + (dataId == "" ? tempId : dataId) + ']" value="' + '' + '">';
		html += '</td>';
		html += '</tr>';

		if (dataId == "") {
			dataId = tempId;
			$("#tblActivity tbody").append(html); 
		} else {
			$("#tblActivity tbody tr[data-id=" + dataId + "]").replaceWith(html); 
		}
		$("#tblActivity tbody tr[data-id=" + dataId + "] input[type=hidden]").val(dataStr);
	}
	function reindexActivity() {
		var idx = 0;
		$("#tblActivity tbody tr").each(function(i, e){ 
			idx ++;
			$(e).find('span[alt=dataIndex]').text(idx);
		});  
	}
