	// --------------------------- Tag Zone -------------------------- //
	$(".btnAddTag").click(function(){
		var langCode = $(this).data("lang");
		var txtTag = $("#txtTag-" + langCode).val();
		if (txtTag == "") {
			DialogWarning("<?php echo "กรุณากรอกข้อมูล"; ?>");
		} else {
			var isDup = false;
			$.each($('input[name^="hdfTag[' + langCode + ']"]'), function(i, e){
				var hiddenVal = $(e).val();
				if (hiddenVal == txtTag) {
					isDup = true;
				}
			});
			if (isDup) {
				DialogWarning("<?php echo "กำหนด Tag นี้ให้วัดนี้แล้ว"; ?>");
			} else {
				var html = '<div class="tagbox"><input type="hidden" name="hdfTag[' + langCode + '][]" value="' + txtTag + '" /><span class="taglabel">' + txtTag + '</span> <em class="fa fa-times tagclose"></em></div>';
				$("#tagszone-" + langCode).append(html);
				$("#txtTag-" + langCode).val('');
			}
		}
	});
	$(".tagszone").on('click', ".tagclose", function(){
		$(this).parent().remove();
	});
