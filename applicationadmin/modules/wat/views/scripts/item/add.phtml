	// OpenHour
	$("#btnOpenHourAdd").click(function() {
		var day = $("#lstDay").val();
		var startHour = $("#txtStartHour").val();
		var startMinute = $("#txtStartMinute").val();
		var endHour = $("#txtEndHour").val();
		var endMinute = $("#txtEndMinute").val();

		if (startHour == '') {DialogWarning('กรุณากรอกชั่วโมงเริ่ม'); return false;}
		if (startMinute == '') {DialogWarning('กรุณากรอกนาทีเริ่ม'); return false;}
		if (endHour == '') {DialogWarning('กรุณากรอกชั่วโมงสิ้นสุด'); return false;}
		if (endMinute == '') {DialogWarning('กรุณากรอกนาทีสิ้นสุด'); return false;}
		if (!isInt(startHour)) {DialogWarning('กรุณากรอกชั่วโมงเริ่มเป็นตัวเลข'); return false;}
		if (!isInt(startMinute)) {DialogWarning('กรุณากรอกนาทีเริ่มเป็นตัวเลข'); return false;}
		if (!isInt(endHour)) {DialogWarning('กรุณากรอกชั่วโมงสิ้นสุดเป็นตัวเลข'); return false;}
		if (!isInt(endMinute)) {DialogWarning('กรุณากรอกนาทีสิ้นสุดเป็นตัวเลข'); return false;}
		startHour = parseInt(startHour);
		startMinute = parseInt(startMinute);
		endHour = parseInt(endHour);
		endMinute = parseInt(endMinute);
		if (startHour >= 24) {DialogWarning('กรุณากรอกชั่วโมงเริ่มน้อยกว่า 24'); return false;}
		if (startMinute >= 60) {DialogWarning('กรุณากรอกนาทีเริ่มน้อยกว่า 60'); return false;}
		if (endHour > 24) {DialogWarning('กรุณากรอกชั่วโมงสิ้นสุดน้อยกว่าหรือเท่ากับ 24'); return false;}
		if (endHour == 24 && endMinute > 0) {DialogWarning('กรุณากรอกนาทีสิ้นสุดเป็น ศูนย์'); return false;}
		if (endMinute >= 60) {DialogWarning('กรุณากรอกนาทีสิ้นสุดน้อยกว่า 60'); return false;}
		if (startHour > endHour) {DialogWarning('กรุณากรอกเวลาเริ่มน้อยกว่าเวลาสิ้นสุด'); return false;}
		else if (startHour == endHour && startMinute > endMinute) {DialogWarning('กรุณากรอกเวลาเริ่มน้อยกว่าเวลาสิ้นสุด'); return false;}
		if (startMinute.toString().length == 1) {startMinute = '' + '0' + startMinute;} 
		if (endMinute.toString().length == 1) {endMinute = '' + '0' + endMinute;} 

		var days = [];
		if (day == "-1") {
			$.each($("#lstDay").find("option[value!='-1']"), function(i, e){
				days.push($(e).val());
			});
		} else {
			days.push(day);
		}
		$.each(days, function(i, d){
    		var dayName = $("#lstDay").find("option[value=" + d + "]").text();
    		var html = '';
    		html += '<p class="form-control-static">';
    		html += '<span>' + dayName + '</span> <span>' + startHour + ':' + startMinute + ' น. - ' + endHour + ':' + endMinute + ' น.</span> <em class="fa fa-times remove"></em>';
    		html += '<input type="hidden" name="params[<?php echo $this->defaultLanguage; ?>][OpenHour][]" id="params-<?php echo $this->defaultLanguage; ?>-OpenHour" value="" />';
    		html += '</p>';
    		var obj = {};
    		obj.day = d;
    		obj.startHour = startHour;
    		obj.startMinute = startMinute;
    		obj.endHour = endHour;
    		obj.endMinute = endMinute;
    		var dataStr = JSON.stringify(obj);
    		var htmlObj = $(html);
    		htmlObj.find('input').val(dataStr);
    		$("#divOpenHour").append(htmlObj);
		});

		$("#txtStartHour").val('');
		$("#txtStartMinute").val('');
		$("#txtEndHour").val('');
		$("#txtEndMinute").val(''); 
	});
