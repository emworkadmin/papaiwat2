<script src="<?php echo $this->baseUrl('plugins/jQueryValidation/jquery.validate.min.js'); ?>"></script>
<script src="<?php echo $this->baseUrl('plugins/jQueryValidation/localization/messages_th.min.js'); ?>"></script>
<script type="text/javascript">
$(function () {
	$("#formDialogImportFile").validate({
		errorElement: "em",
		errorPlacement: function(error, element) {
			error.addClass( "help-block" );
	        error.appendTo( element.closest("div.divControl"));
        }, 
        ignore: []
    });

	$('#formDialogImportFile input[type=checkbox], #formDialogImportFile input[type=radio]:not([name=TemplateType])').iCheck({checkboxClass: 'icheckbox_minimal-blue',radioClass: 'iradio_minimal-blue'});

	$('#formDialogImportFile').on('ifClicked', 'input[name=Type]', function(){
		var val = $(this).val();
		if(val=='Line Chart'){
			$('#divPieColor').show();
			$('#Color').addClass("required");
		}else{
			$('#divPieColor').hide();
			$('#Color').removeClass("required");
		}
	});
});
</script>
