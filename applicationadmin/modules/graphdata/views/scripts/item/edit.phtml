	function saveGraphData(dataId) {
		var dataObj = $("#dialogGraphData #formDialog").serializeObject();

		var Type = '';
		var Title = '';

		var chkHasData = false;
		
		var obj = {};
		obj.ID = dataObj.hdfDialogID;
		obj.Header = {};
		$.each(dataObj.dialogParamsHeader, function(i, e) {
			if(i=='<?php echo $this->defaultLanguage;?>'){
				Type = e.Type;
				Title = e.Title;
				Color = e.Color;
			}
			obj.Header[i] = {};
			obj.Header[i].Type = e.Type
			obj.Header[i].Title = e.Title
			obj.Header[i].Color = e.Color
		});
		obj.Order = {};
		$.each(dataObj.dialogParams, function(i, e) { 
			if(i){
				obj.Order[i] = {};
				obj.Order[i].Lang = {};
			}
			$.each(e, function(i2, e2) { 
				if(e2.Title!=""){
					obj.Order[i].Lang[i2] = {};
					obj.Order[i].Lang[i2].Title = e2.Title;
					obj.Order[i].Lang[i2].Value = e2.Value;
					obj.Order[i].Lang[i2].Color = e2.Color;
					chkHasData = true;
				}
			});
		});

		if (!chkHasData) {
			DialogWarning("กรุณาเพิ่มข้อมูลอย่างน้อย 1 รายการ");
			return false;
		}

		var tempId = uuidv4();
		if (obj.ID == '') {
			obj.ID = tempId;
		}
		
		var dataStr = JSON.stringify(obj);

		var html = '';
		html += '<tr data-id="' + (dataId == "" ? tempId : dataId) + '">';
		html += '<td class="">';
		html += '	<em class="fa fa-bars handle"></em> &nbsp;&nbsp;';
		html += '	<span alt="dataIndex" ></span>';
		html += '</td>';
		html += '<td class="">' + Type + '</td>';
		html += '<td class="">' + Title + '</td>';
		html += '<td class="">';
		html += '	<button type="button" class="btn btn-primary edit"><em class="fa fa-pencil-square-o edit"></em></button>';
		html += '	<button type="button" class="btn btn-danger remove"><em class="fa fa-trash remove"></em></button>';
		html += '	<input type="hidden" id="params-<?php echo $this->defaultLanguage;?>-Graphdata-' + (dataId == "" ? tempId : dataId) + '" name="params[<?php echo $this->defaultLanguage;?>][Graphdata][' + (dataId == "" ? tempId : dataId) + ']" value="' + '' + '">';
		html += '</td>';
		html += '</tr>';

		if (dataId == "") {
			dataId = tempId;
			$("#tblGraphData tbody").append(html); 
		} else {
			$("#tblGraphData tbody tr[data-id=" + dataId + "]").replaceWith(html); 
		}
		$("#tblGraphData tbody tr[data-id=" + dataId + "] input[type=hidden]").val(dataStr);

		return true;
	}
	function reindexGraphData() {
		var idx = 0;
		$("#tblGraphData tbody tr").each(function(i, e) {
			idx ++;
			$(e).find('span[alt=dataIndex]').text(idx);
		});
	}
	$('#tblGraphData tbody').sortable({
		handle: '.handle',
		cursor: 'move',
		update: function ( event, ui ){ reindexGraphData(); }, 
		start: function ( event, ui ){ 
		}, 
		stop: function ( event, ui ){ 
		}
	}).disableSelection();

	// Import Excel
	$('#lnkImportExcel').click(function(e) {
		var uid = uuidv4();
		dialogImportFile = BootstrapDialog.show({
			title: "อัพโหลดไฟล์ Excel",
			message: $("<div id=\'dialogImportFile\'></div>").load("<?php echo $this->url(array("module" => "graphdata", "controller" => "item", "action" => "dialogimportexcel"), null, true); ?>", {"uid":uid}),
			closable: true,
			closeByBackdrop: false,
			closeByKeyboard: false,
			autodestroy: true,
			cssClass: "custom-dialog-import-file",
			buttons : [
				{
					label: "อัพโหลดข้อมูลเข้าสู่ระบบ",
					icon: "fa fa-cloud-upload",
					cssClass: "btn-primary",
					action: function(dialog) {
						var valid = $('#formDialogImportFile').valid();
						if(valid){
							$.post("<?php echo $this->url(array('module' => 'graphdata', 'controller' => 'item', 'action' => 'importexcel'), null, true);?>", $("#formDialogImportFile").serializeArray(), function(data){
								if (data.result) {
									DialogComplete("อัพโหลดไฟล์สำเร็จ");

									var html = '';
									html += '<tr data-id="' + data.id + '">';
									html += '<td class="">';
									html += '	<em class="fa fa-bars handle"></em> &nbsp;&nbsp;';
									html += '	<span alt="dataIndex" ></span>';
									html += '</td>';
									html += '<td class="">' + data.type + '</td>';
									html += '<td class="">' + data.title + '</td>';
									html += '<td class="">';
									html += '	<button type="button" class="btn btn-primary edit"><em class="fa fa-pencil-square-o edit"></em></button>';
									html += '	<button type="button" class="btn btn-danger remove"><em class="fa fa-trash remove"></em></button>';
									html += '	<input type="hidden" id="params-<?php echo $this->defaultLanguage;?>-Graphdata-' + data.id + '" name="params[<?php echo $this->defaultLanguage;?>][Graphdata][' + data.id + ']" value="' + '' + '">';
									html += '</td>';
									html += '</tr>';
									$("#tblGraphData tbody").append(html);
									$("#tblGraphData tbody tr[data-id=" + data.id + "] input[type=hidden]").val(data.data);
									reindexGraphData();
									
									dialog.close();
								} else {
									DialogWarning(data.message);
								}
							}, "json");
						}
					}
				},{
					label: "ยกเลิก",
					action: function(dialog) {
						dialog.close();
					}
				}]
		});
		dialogImportFile.open();
	});

});

