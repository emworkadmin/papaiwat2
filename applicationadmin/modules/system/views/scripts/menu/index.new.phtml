<script type="text/javascript">
    jQuery(function(){

    	<?php if ($this->canAdd) : ?>
    	$("#btnGoAdd").click(function(e) {
    		window.location = "<?php echo $this->url(array('module' => 'system', 'controller' => 'menu', 'action' => 'add'), null, true); ?>";
		});
		<?php endif ; ?>

    	// --------------- Begin: Table & Search Zone --------------------------
    	
    	function renderColumn ( data, type, row, meta ) {
    		return data;
    	}
    	function renderColumnLink ( data, type, row, meta ) {
    		return '<a href="<?php echo $this->url(array('module' => 'system', 'controller' => 'menu', 'action' => 'edit'), null, true);?>/itemid/' + row.DT_RowId + '">' + data + '</a>';
    	}
    	var rows_selected = [];
    	
    	var tblData = $('#tblData').DataTable({
    		processing: true,
    		//serverSide: true,
    		responsive: true,
    		//order: [[ 3, "asc" ]],
    		/*ajax: {
    	        url: '<?php echo $this->url(array('module' => 'system', 'controller' => 'menu', 'action' => 'getlist'), null, true); ?>',
    	        type: 'POST',
    	        data: function(d) {
        	        d.textstr = $("#formSearch #textsearch").val();
        	        d.isEnable = $("#formSearch #is_enable").val();
        	        d.menuGroupID = $("#formSearch #menuGroupID").val();
    	        }
    	    },*/
    	    language : {
				url : '<?php echo $this->baseUrl('plugins/datatables/localization/jquery.dataTables.thai.json'); ?>'
    	    },
    		"dom": '<"dataTable"rt<"bottom"ilp<"clear">>>',
    		"columns": [
    		            { "width": "10%", 'orderable': false, 'data' : 'NO', "class" : "text-center"},
    		            { "width": "20%", 'data' : 'nameMenu' , 'render' : renderColumnLink, "class" : "ratio"},
    		            { "width": "20%", 'data' : 'groupMenu' , 'render' : renderColumnLink, "class" : "ratio"},
    		            { "width": "10%", 'data' : 'ordering' , 'render' : renderColumnLink, "class" : "ratio"},
    		            { "width": "10%", 'data' : 'is_enable' , 'render' : renderColumnLink, "class" : "ratio"},
    		          ]
        });
        

		$('#btnSearch').click(function(){
			//tblData.ajax.reload();
			loadData();
		});

		$('#btnReset').click(function(){
			$(".searchPanel input[type=text]").val('');
			$(".searchPanel select").val('');
			//tblData.ajax.reload();
			loadData();
		});

		function loadData() {
			var textstr = $("#formSearch #textsearch").val();
			var isEnable = $("#formSearch #is_enable").val();
			var menuGroupID = $("#formSearch #menuGroupID").val();
			
			$.post('<?php echo $this->url(array('module' => 'system', 'controller' => 'menu', 'action' => 'getlist'), null, true); ?>', {'textstr' : textstr, 'isEnable' : isEnable, 'menuGroupID' : menuGroupID}, function(data){
				//tblData.fnClearTable( 0 );
				//tblData.fnAddData(data);
				tblData.clear().draw();
				tblData.rows.add(data.data); // Add new data
				tblData.columns.adjust().draw(); // Redraw the DataTable
			}, 'json');
		}
		loadData();
    	
    });
    
</script>
