<div id="components">
<?php
if ($this->components) : 
	foreach ($this->components as $component) : 
		echo "<div class='module-box'>";
		echo "<div class='module-header'><strong>" . $component["Name"] . "</strong></div>";
		echo "<div class='module-body'>";
			foreach ($component["Controllers"] as  $controller) : 
			echo "<div class='module-item'><a class='component-select' href='javascript:void(0);' data-module='" . $component["Module"] . "' data-controller='" . $controller["Controller"] . "' data-modulename='" . $component["Name"] . "' data-controllername='" . $controller["Name"] . "' >" . $controller["Name"] . "</a> <small>" . $controller["Description"] . "</small></div>";
			endforeach;
		echo "</div>";
		echo "</div>";
	endforeach;
endif;
?>
</div>
<script>
$(function () {
	$("#components .component-select").click(function(){
		componentSelect($(this).data("modulename"), $(this).data("controllername"), $(this).data("module"), $(this).data("controller"));
	});
});
</script>