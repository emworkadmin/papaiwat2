<style type="text/css">
.module-box {border: 1px solid #ccc; border-radius: 5px; margin-bottom: 15px;}
.module-box .module-header {border-bottom: 1px solid #ccc; padding: 10px 10px; } 
.module-box .module-body .module-item {border-bottom: 1px solid #ccc; padding: 5px 5px 5px 25px;}
