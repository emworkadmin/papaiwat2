<script src="<?php echo $this->baseUrl('plugins/jQueryValidation/jquery.validate.min.js'); ?>"></script>
<script src="<?php echo $this->baseUrl('plugins/jQueryValidation/localization/messages_th.min.js'); ?>"></script>
<script>
var dialogComponents = null;
function componentSelect(moduleName, controllerName, module, controller, id) {
	$("#lblMenuName").text(moduleName + " : " + controllerName);
	$("#mConfig").val(module);
	$("#cConfig").val(controller);
	$.post("<?php echo $this->url(array("module" => "system", "controller" => "menu", "action" => "component"), null, true); ?>", {"m": module, "c": controller, "id" : id}, function(data) {
		$("#menuConfig").empty();
		$("#menuConfig").append(data);
	}, "html")
	if (dialogComponents != null) {
		dialogComponents.close();
	}
}
$(function () {

	<?php if (($this->data->Type == 'component') && !empty($this->data->FrontModule) && !empty($this->data->FrontController)) : ?>
	componentSelect("<?php echo $this->data->ModuleName; ?>", "<?php echo $this->data->ControllerName; ?>", "<?php echo $this->data->FrontModule; ?>", "<?php echo $this->data->FrontController; ?>", "<?php echo $this->data->ID; ?>")
	<?php endif; ?>
	
	$("#formAdd").validate({
		errorElement: "em",
		errorPlacement: function(error, element) {
			error.addClass( "help-block" );
	        error.appendTo( element.parents("div.divControl"));
        }
    });

	getData("<?php echo $this->url(array('module' => 'system', 'controller' => 'menu', 'action' => 'ajaxlist'), null, true);?>" + "?id=" + "<?php echo $this->data->MenuGroupID; ?>", "#lstParent", "-- โปรดเลือก --", "name", "id", "<?php echo $this->data->ParentID; ?>");
	$("#lstmenuGroup").change(function(){
		var selectValue = $(this).val();
		getData("<?php echo $this->url(array('module' => 'system', 'controller' => 'menu', 'action' => 'ajaxlist'), null, true);?>" + "?id=" + selectValue, "#lstParent", "-- โปรดเลือก --", "name", "id", "");
	});
    
	$("#formAdd input[type=checkbox], #formAdd input[type=radio]").iCheck({checkboxClass: 'icheckbox_minimal-blue',radioClass: 'iradio_minimal-blue'});
	$("#formAdd input[type=radio][name=rdlMenuType]").on("ifClicked", function(event) {
		var val = $(this).val();
		if (val == 'component') {
			$("#divMenuTypeComponent").css("display", "");			
			$("#divMenuTypeUrl").css("display", "none");
			$("#txtExternelUrl").removeClass("required").val("");
		} else if (val == 'url') {
			$("#divMenuTypeComponent").css("display", "none");
			$("#lblMenuName").text("");
			$("#mConfig").val("");
			$("#cConfig").val("");
			$("#menuConfig").empty();
			$("#divMenuTypeUrl").css("display", "");
			$("#txtExternelUrl").addClass("required");
		} else {
			$("#divMenuTypeComponent").css("display", "none");
			$("#lblMenuName").text("");
			$("#mConfig").val("");
			$("#cConfig").val("");
			$("#menuConfig").empty();
			$("#divMenuTypeUrl").css("display", "none");
			$("#txtExternelUrl").removeClass("required").val("");
		}
	});
	
	function buttonZoneDisabled() {
		$(".button-panel-zone button").attr("disabled", "disabled");
		$(".button-panel-zone").append('<em class="fa fa-refresh fa-spin"></em>');
	}
	function buttonZoneActive() {
		$(".button-panel-zone button").removeAttr("disabled");
		$(".button-panel-zone > em").remove();
	}
	
	$("#btnSelectComponent").click(function(){
		var data = '';
		dialogComponents = BootstrapDialog.show({
			title: 'รายการข้อมูล',
			message: $('<div id="dialogComponents"></div>').load("<?php echo $this->url(array('module' => 'system', 'controller' => 'menu', 'action' => 'components'), null, true); ?>", {}),
			closable: true,
            closeByBackdrop: false,
            closeByKeyboard: false,
            autodestroy: true,
			buttons : [{
				label: ' ปิด',
				icon: 'fa fa-times',
				action: function(dialog) {
					dialog.close();
				}
			}]
		});
		dialogComponents.open();
	});

    <?php if ($this->canEdit) : ?>
	// Save
	$("#btnSave").click(function(){
		buttonZoneDisabled();
		var valid = $("#formAdd").valid();
		if (valid) {			
			$.post("<?php echo $this->url(array('module' => 'system', 'controller' => 'menu', 'action' => 'update'), null, true);?>", $("#formAdd").serializeArray(), function(data){
				if (data.result) {
					DialogComplete();
					setTimeout(function(){
						window.location = "<?php echo $this->url(array('module' => 'system', 'controller' => 'menu', 'action' => 'edit'), null, true); ?>/itemid/" + data.id;
					}, 500);
				} else {
					DialogWarning(data.message);
				}
				buttonZoneActive();
			}, 'json');
		} else {
			buttonZoneActive();
		}
	});
	<?php endif ; ?>

	// Cancel
	$("#btnCancel").click(function(){
		window.location = "<?php echo $this->url(array('module' => 'system', 'controller' => 'menu', 'action' => 'index'), null, true); ?>";
	});

	<?php if ($this->canDelete) : ?>
	$("#btnDelete").click(function(){
		DialogConfirm("คุณแน่ใจหรือไม่?", "แจ้งเตือนการลบ", function() {
			buttonZoneDisabled();
			$.post("<?php echo $this->url(array("module" => 'system', "controller" => 'menu', 'action' => 'delete'), null, true); ?>",  {'id' : '<?php echo  $this->data->ID; ?>'}, function(data){
				if (data.result) {
					DialogComplete('ลบสำเร็จ');
					setTimeout(function(){
						window.location = "<?php echo $this->url(array('module' => 'system', 'controller' => 'menu', 'action' => 'index'), null, true); ?>";
					}, 500);
				} else {
					DialogWarning(data.message);
				}
				buttonZoneActive();
			}, 'json');
		});
	});
	<?php endif ; ?>

});
</script>
