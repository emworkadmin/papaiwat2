			<label class="col-md-3 labelRequest control-label" for="txtTitle">ชื่อกลุ่มเมนู</label>
			<div class="col-md-9 divControl">
						<?php echo $this->formText('txtTitle', $this->data->Name, array('class' => 'form-control required ', 'placeholder' => 'ชื่อกลุ่มเมนู', 'maxlength' => '250')); ?>
					</div>
		</div>

		<div class="form-group">
			<label class="col-md-3 control-label labelRequest">สถานะ</label>
			<div class="col-md-9 divControl">
				<div class="radio with-icheck">
					<?php echo $this->formRadio('is_enable', $this->data->IsEnable, array('class' => 'required', 'label_class' => 'radio-inline'), $this->publishOption, " "); ?>
				</div>
			</div>
		</div>

		<br />

		<div class="form-group">
			<div class="col-md-9 col-md-offset-3 button-panel-zone">
				<?php if ($this->canEdit) : ?>
				<button type="button" class="btn btn-primary" id="btnSave">
					<em class="fa fa-save"></em> ปรับปรุงข้อมูล
