				<?php endif ; ?>
				<?php if ($this->canDelete) : ?>
				<button type="button" class="btn btn-danger" id="btnDelete">
					<em class="fa fa-trash"></em> ลบข้อมูล
				</button>
				<?php endif ; ?>
				<button type="button" class="btn btn-default" id="btnCancel">ยกเลิก</button>
			</div>
		</div>
	</form>
</div>
<script src="<?php echo $this->baseUrl('plugins/jQueryValidation/jquery.validate.min.js'); ?>"></script>
<script src="<?php echo $this->baseUrl('plugins/jQueryValidation/localization/messages_th.min.js'); ?>"></script>
<script src="<?php echo $this->baseUrl('plugins/ckeditor/ckeditor.js'); ?>"></script>
<script src="<?php echo $this->baseUrl('plugins/ckeditor/adapters/jquery.js'); ?>"></script>

<script>
$(function () {
	
	$("#formAdd").validate({
		errorElement: "em",
		errorPlacement: function(error, element) {
			error.addClass( "help-block" );
	        error.appendTo( element.parents("div.divControl"));
        }
    });
    
	$("#formAdd input[type=checkbox], #formAdd input[type=radio]").iCheck({checkboxClass: 'icheckbox_minimal-blue',radioClass: 'iradio_minimal-blue'});

	function buttonZoneDisabled() {
		$(".button-panel-zone button").attr("disabled", "disabled");
		$(".button-panel-zone").append('<em class="fa fa-refresh fa-spin"></em>');
	}
	function buttonZoneActive() {
		$(".button-panel-zone button").removeAttr("disabled");
		$(".button-panel-zone > em").remove();
	}
	
    <?php if ($this->canEdit) : ?>
	// Save
	$("#btnSave").click(function(){
		buttonZoneDisabled();
		var valid = $("#formAdd").valid();
		if (valid) {
			$.post("<?php echo $this->url(array('module' => 'system', 'controller' => 'menugroup', 'action' => 'update'), null, true);?>", $("#formAdd").serializeArray(), function(data){
				if (data.result) {
					DialogComplete();
					setTimeout(function(){
						window.location = "<?php echo $this->url(array('module' => 'system', 'controller' => 'menugroup', 'action' => 'edit'), null, true); ?>/itemid/" + data.id;
					}, 500);
				} else {
					DialogWarning(data.message);
				}
				buttonZoneActive();
			}, 'json');
		} else {
			buttonZoneActive(); 
		}
	});
	<?php endif ; ?>

	// Cancel
	$("#btnCancel").click(function(){
		window.location = "<?php echo $this->url(array('module' => 'system', 'controller' => 'menugroup', 'action' => 'index'), null, true); ?>";
	});

	<?php if ($this->canDelete) : ?>
	$("#btnDelete").click(function(){
		DialogConfirm("คุณแน่ใจหรือไม่?", "แจ้งเตือนการลบ", function() {
			buttonZoneDisabled();
			$.post("<?php echo $this->url(array("module" => 'system', "controller" => 'menugroup', 'action' => 'delete'), null, true); ?>",  {'id' : '<?php echo  $this->data->ID; ?>'}, function(data){
				if (data.result) {
					DialogComplete('ลบสำเร็จ');
					setTimeout(function(){
						window.location = "<?php echo $this->url(array('module' => 'system', 'controller' => 'menugroup', 'action' => 'index'), null, true); ?>";
					}, 500);
				} else {
					DialogWarning(data.message);
				}
				buttonZoneActive(); 
			}, 'json');
		});
	});
	<?php endif ; ?>

});
</script>
