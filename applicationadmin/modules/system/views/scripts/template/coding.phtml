<script src="<?php echo $this->baseUrl('plugins/ckeditor/adapters/jquery.js'); ?>"></script>

<script>
$(function () {
	
	$("#formData").validate({
		errorElement: "em",
		errorPlacement: function(error, element) {
			error.addClass( "help-block" );
	        error.appendTo( element.parents("div.divControl"));
        }
    });    
	$("#formData input[type=checkbox], #formData input[type=radio]").iCheck({checkboxClass: 'icheckbox_minimal-blue',radioClass: 'iradio_minimal-blue'});

	function buttonZoneDisabled() {
		$(".button-panel-zone button").attr("disabled", "disabled");
		$(".button-panel-zone").append('<em class="fa fa-refresh fa-spin"></em>');
	}
	function buttonZoneActive() {
		$(".button-panel-zone button").removeAttr("disabled");
		$(".button-panel-zone > em").remove();
	}

    <?php if ($this->canEdit) : ?>
	// Save
	$("#btnSave").click(function(){
		buttonZoneDisabled();
		var valid = $("#formData").valid();
		if (valid) {			
			$.post("<?php echo $this->url(array('module' => 'system', 'controller' => 'template', 'action' => 'updatecoding'), null, true);?>", $("#formData").serializeArray(), function(data){
				if (data.result) {
					DialogComplete();
					setTimeout(function(){
						window.location = "<?php echo $this->url(array('module' => 'system', 'controller' => 'template', 'action' => 'coding', 'itemid' => $this->data->ID), null, true); ?>";
					}, 500);
				} else {
					DialogWarning(data.message);
				}
				buttonZoneActive();
			}, 'json');
		} else {
			buttonZoneActive();
		}
	});
	<?php endif; ?>

	// Cancel
	$("#btnCancel").click(function(){
		window.location = "<?php echo $this->url(array('module' => 'system', 'controller' => 'template', 'action' => 'edit', 'itemid' => $this->data->ID), null, true); ?>";
	});

	$('#formData').on('ifClicked', 'input[name=is_use_google_analytic]', function(){
		disabledAnalytic($(this).val());
	});
	disabledAnalytic('<?php echo $this->data->IsUseGoogleAnalytic ?>');
	function disabledAnalytic(val){
		if(val == 'Y'){
			$('#google_ananlytic_script').prop('disabled', false);
		}else{
			$('#google_ananlytic_script').prop('disabled', true);
		}
	}

	// set Disabled textArea
	$('#formData').on('ifClicked', 'input[name=is_use_truehit]', function(){
		disabledtruehit($(this).val());
	});
	disabledtruehit('<?php echo $this->data->IsUseTruehit?>');
	function disabledtruehit(val){
		if(val == 'Y'){
			$('#truehit_script').prop('disabled', false);
		}else{
			$('#truehit_script').prop('disabled', true);
		}
	}

	$('#formData').on('ifClicked', 'input[name=is_use_custom_css]', function(){
		disabledCSS($(this).val());
	});
	disabledCSS('<?php echo $this->data->IsUseCustomCss?>');
	function disabledCSS(val){
		if(val == 'Y'){
			$('#custom_css').prop('disabled', false);
		}else{
			$('#custom_css').prop('disabled', true);
		}
	}

	$('#formData').on('ifClicked', 'input[name=is_use_custom_js]', function(){
		disabledJS($(this).val());
	});
	disabledJS('<?php echo $this->data->IsUseCustomJs?>');
	function disabledJS(val){
		if(val == 'Y'){
			$('#custom_js').prop('disabled', false);
		}else{
			$('#custom_js').prop('disabled', true);
		}
	}

});
</script>
