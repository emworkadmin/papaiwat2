<script src="<?php echo $this->baseUrl('plugins/ckeditor/adapters/jquery.js'); ?>"></script>
<script>
$(function () {
	
	$("#formData").validate({
		errorElement: "em",
		errorPlacement: function(error, element) {
			error.addClass( "help-block" );
	        error.appendTo( element.parents("div.divControl"));
        }
    });	
    
	$("#formData input[type=checkbox], #formData input[type=radio]").iCheck({checkboxClass: 'icheckbox_minimal-blue',radioClass: 'iradio_minimal-blue'});
	$('#formData .colorpicker-group').colorpicker({autoInputFallback: false, useAlpha: false, format: 'hex'});

	function buttonZoneDisabled() {
		$(".button-panel-zone button").attr("disabled", "disabled");
		$(".button-panel-zone").append('<em class="fa fa-refresh fa-spin"></em>');
	}
	function buttonZoneActive() {
		$(".button-panel-zone button").removeAttr("disabled");
		$(".button-panel-zone > em").remove();
	}
	
	// Save
	<?php if ($this->canAdd) : ?>
	$("#btnSave").click(function(){
		buttonZoneDisabled();
		var valid = $("#formData").valid();
		if (valid) {			
			$.post("<?php echo $this->url(array('module' => 'system', 'controller' => 'template', 'action' => 'save'), null, true);?>", $("#formData").serializeArray(), function(data){
				if (data.result) {
					DialogComplete();
					setTimeout(function(){
						window.location = "<?php echo $this->url(array('module' => 'system', 'controller' => 'template', 'action' => 'edit'), null, true); ?>/itemid/" + data.id;
					}, 500);
				} else {
					DialogWarning(data.message);
				}
				buttonZoneActive();
			}, 'json');
		} else {
			buttonZoneActive();
		}
	});
	<?php endif ; ?>
	// Cancel
	$("#btnCancel").click(function(){
		window.location = "<?php echo $this->url(array('module' => 'system', 'controller' => 'template', 'action' => 'index'), null, true); ?>";
	});
});
</script>
