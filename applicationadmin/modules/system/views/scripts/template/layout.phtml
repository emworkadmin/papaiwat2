<script>
function uuidv4() {
  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
    var r = Math.random() * 16 | 0, v = c == 'x' ? r : (r & 0x3 | 0x8);
    return v.toString(16);
  });
}
$(function () {
	
	$("#formData").validate({
		errorElement: "em",
		errorPlacement: function(error, element) {
			error.addClass( "help-block" );
	        error.appendTo( element.parents("div.divControl"));
        }
    });    
	$('#formData .colorpicker-group').colorpicker({autoInputFallback: false, useAlpha: false, format: 'hex'});
	
	function buttonZoneDisabled() {
		$(".button-panel-zone button").attr("disabled", "disabled");
		$(".button-panel-zone").append('<em class="fa fa-refresh fa-spin"></em>');
	}
	function buttonZoneActive() {
		$(".button-panel-zone button").removeAttr("disabled");
		$(".button-panel-zone > em").remove();
	}
	
    <?php if ($this->canEdit) : ?>
	// Save
	$("#btnSave").click(function(){
		buttonZoneDisabled();
		var valid = $("#formData").valid();
		if (valid) {			
			$.post("<?php echo $this->url(array('module' => 'system', 'controller' => 'template', 'action' => 'updatelayout'), null, true);?>", $("#formData").serializeArray(), function(data){
				if (data.result) {
					DialogComplete();
					setTimeout(function(){
						window.location = "<?php echo $this->url(array('module' => 'system', 'controller' => 'template', 'action' => 'layout', 'itemid' => $this->data->ID), null, true); ?>";
					}, 500);
				} else {
					DialogWarning(data.message);
				}
				buttonZoneActive();
			}, 'json');
		} else {
			buttonZoneActive();
		}
	});
	<?php endif; ?>

	// Cancel
	$("#btnCancel").click(function(){
		window.location = "<?php echo $this->url(array('module' => 'system', 'controller' => 'template', 'action' => 'edit', 'itemid' => $this->data->ID), null, true); ?>";
	});

	$( "#section-manage" ).sortable({handle: '.handle',cursor: 'move', update: function ( event, ui ){ }, start: function ( event, ui ){ $("#section-manage .section-body").css("display", "none"); ui.item.css("height", $(".section-header", ui.item).height()); ui.placeholder.height(ui.item.height()); $("#section-manage").sortable( "refreshPositions" ); }, stop: function ( event, ui ){ $("#section-manage .section-body").css("display", "");  }}).disableSelection();
	$( "#section-manage .section-box-part-list" ).sortable({handle: '.handle-box',cursor: 'move', update: function ( event, ui ){  }, start: function ( event, ui ){  }, start: function ( event, ui ){ $(ui.item).parents(".section-box-part-list").find(".section-box-body").css("display", "none"); ui.item.height($(".section-box-header", ui.item).height()); ui.placeholder.height(ui.item.height()); $(ui.item).parents(".section-box-part-list").sortable( "refreshPositions" ); }, stop: function ( event, ui ){ $(ui.item).parents(".section-box-part-list").find(".section-box-body").css("display", "");  }}).disableSelection();
	$.each($("#formData").find('input[type=file]'), function(i, e) {
		var gid = $(e).data('gid');
		var val = $(e).data('value');
		addBgImageUpload('section-' + gid + '-bgImage', 'section[' + gid + '][bgImage]', val);
	});

	$("#btnAddSection").click(function(){
		var gid = uuidv4();
		var html = $("#section-temp").html();
		html = html.replace(/guid/g , gid);
		var section = $("<div class='section'></div>").append(html);
		section.find(".section-box-part-list").sortable({handle: '.handle-box',cursor: 'move', update: function ( event, ui ){ }, start: function ( event, ui ){ $("#section-manage .section-body").css("display", "none"); ui.item.css("height", $(".section-header", ui.item).height()); ui.placeholder.height(ui.item.height()); $("#section-manage").sortable( "refreshPositions" ); }, stop: function ( event, ui ){ $("#section-manage .section-body").css("display", "");  }}).disableSelection();
		section.find('.colorpicker-group').colorpicker({autoInputFallback: false, useAlpha: false, format: 'hex'});
		$("#section-manage").append(section);
		$.each(section.find('input[type=file]'), function(i, e) {
			addBgImageUpload('section-' + gid + '-bgImage', 'section[' + gid + '][bgImage]');
		});
	});

	$("#section-manage")
	.on("click", ".btn-add-box", function(){
		var maingid = $(this).parents(".section-box-part").data('gid');
		var gid = uuidv4();
		var html = $("#section-box-temp").html();
		html = html.replace(/mainguid/g , maingid);
		html = html.replace(/guid/g , gid);
		var sectionBox = $("<div class='section-box'></div>").append(html);
		$(this).parents(".section-box-part").find(".section-box-part-list").append(sectionBox);
	})
	.on("click", ".remove", function(){
		$(this).parents(".section").remove();
	})
	.on("click", ".remove-box", function(){
		$(this).parents(".section-box").remove();
	})
	.on("change", ".section-name-ctrl", function(){
		$(this).parents(".section").find(".section-header-title").text(": " + $(this).val());
	})
	;

	function addBgImageUpload(controlID, controlName, controlFiles) {
		var files = [];
		if (controlFiles != null) {
			files[0] = {};
			files[0].name = controlFiles.fileName;
			files[0].fid = controlFiles.fileHashName;
			files[0].type = controlFiles.fileType;
		}
		$('#' + controlID).filer({
			showThumbs: true,
			limit: 1,
			maxSize: 10,
			extensions: ['png','jpg','gif'],
			templates: {
				box: '<div class="jFiler-items-list jFiler-items-grid"></div>',
				item: '<div class="jFiler-items">\
								<a  class="jFiler-item-title" style="color: #2c93c7;"><b title="{{fi-name}}">{{fi-name | limitTo: 25}}</b></a>\
								<a class="icon-jfi-trash jFiler-item-trash-action"></a>\
								<div class="jFiler-jProgressBar" style="width: 200px;"></div>\
						</div>',
				itemAppend: '<div class="jFiler-items">\
								<a  class="jFiler-item-title" style="color: #2c93c7;"  href="<?php echo $this->url(array("module" => 'default', 'controller' => 'file', 'action' => 'get'), null, true); ?>/file/{{fi-fid}}"><b title="{{fi-name}}">{{fi-name | limitTo: 25}}</b></a>\
