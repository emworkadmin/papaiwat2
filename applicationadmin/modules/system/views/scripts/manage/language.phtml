<script src="<?php echo $this->baseUrl('plugins/datatables/dataTables.bootstrap.min.js'); ?>"></script>
<script type="text/javascript">
jQuery(function(){

	// --------------- Begin: Table & Search Zone --------------------------
	
	function renderColumn ( data, type, row, meta ) {
		return data;
	}
	function renderNameColumn ( data, type, row, meta ) {
		return data + "<br />&lt;" + row.NameLocal + "&gt;";
	}
	function renderIsDefaultColumn ( data, type, row, meta ) {
		if (data == 'Y') {
			return "<em class='fa fa-dot-circle-o pointer' data-id='" + row.DT_RowId + "' data-value='Y' data-type='isDefault' title='ค่าเริ่มต้น'></em>";
		} else {
			return "<em class='fa fa-circle-o pointer' data-id='" + row.DT_RowId + "' data-value='N' data-type='isDefault' title='คลิกเพิ่มกำหนดเป็นค่าเริ่มต้น'></em>";
		}
	}
	function renderIsRequiredColumn ( data, type, row, meta ) {
		if (data == 'Y') {
			return "<em class='fa fa-check-square-o pointer' data-id='" + row.DT_RowId + "' data-value='Y' data-type='isRequired' title='คลิกเพื่อกำหนดเป็นไม่จำเป็น'></em>";
		} else {
			return "<em class='fa fa-square-o pointer' data-id='" + row.DT_RowId + "' data-value='N' data-type='isRequired' title='คลิกเพื่อกำหนดเป็นจำเป็น'></em>";
		}
	}
	function renderIsEnableColumn ( data, type, row, meta ) {
		if (data == 'Y') {
			return "<em class='fa fa-check-square-o pointer' data-id='" + row.DT_RowId + "' data-value='Y' data-type='isEnable' title='คลิกเพื่อกำหนดเป็นไม่ใช้งาน'></em>";
		} else {
			return "<em class='fa fa-square-o pointer' data-id='" + row.DT_RowId + "' data-value='N' data-type='isEnable' title='คลิกเพื่อกำหนดเป็นใช้งาน'></em>";
		}
	}
	var rows_selected = [];
	var tblData = $('#tblData').DataTable({
		processing: true,
		serverSide: true,
		responsive: true,
		order: [[ 4, "asc" ]],
		ajax: {
	        url: '<?php echo $this->url(array('module' => 'system', 'controller' => 'manage', 'action' => 'getlanguagelist'), null, true); ?>',
	        type: 'POST',
	        data: function(d) {
    	        d.textsearch = $("#formSearch #textsearch").val();
    	        d.enable = $("#formSearch #lstStatus").val();
	        }
	    },
	    language : {
			url : '<?php echo $this->baseUrl('plugins/datatables/localization/jquery.dataTables.thai.json'); ?>'
	    },
		"dom": '<"dataTable"rt<"bottom"ilp<"clear">>>',
		"columns": [
		            { "width": "40px", 'orderable': false, 'data' : 'NO', "class" : "text-center"},
		            {'data' : 'Name', 'render' : renderNameColumn},
		            { "width": "10%", 'data' : 'IsDefault' , 'render' : renderIsDefaultColumn, "class" : "ratio text-center"},
		            { "width": "10%", 'data' : 'IsRequired' , 'render' : renderIsRequiredColumn, "class" : "ratio text-center"},
		            { "width": "10%", 'data' : 'Ordering' , 'render' : renderColumn, "class" : "ratio text-center"},
		            { "width": "10%", 'data' : 'IsEnable' , 'render' : renderIsEnableColumn, "class" : "ratio text-center"}
		          ]
    });

	$('#btnSearch').click(function(){
		tblData.ajax.reload();
	});

	$('#btnReset').click(function(){
		$(".searchPanel input[type=text]").val('');
		$(".searchPanel select").val('');
		tblData.ajax.reload();
	});
	        
	//new $.fn.dataTable.Responsive( tblData );
	
	// --------------- End: Table & Search Zone --------------------------

	// --------------- Toogle Advance Search ---------------
	$("#btnAdvance").click(function(e) {
		var val = $('#hdfAdvanceSearch').val();
		if(val == 'H'){
			$("#AdvanceSearch").slideDown(600, "swing");
			$("#hdfAdvanceSearch").val('S');
		}else{
			$("#AdvanceSearch").slideUp(600, "swing");
			$("#hdfAdvanceSearch").val('H');
		}
	});

	$("#tblData").bind('click', function(e){
		var target = $(e.target);
		if (target.data('type') == 'isDefault') {
			var id = target.data("id");
			if (target.data('value') == 'N') {
				$.post("<?php echo $this->url(array("module" => "system", "controller" => "manage", "action" => "updatelanguage"), null, true); ?>", {"id" : id, "type" : "default", "value" : "Y"}, function(data){
					if (data.result) {
						DialogComplete();
						tblData.ajax.reload();
					} else {
						DialogWarning(data.message);
					}
				}, "json");
			} 
		} else if (target.data('type') == 'isRequired') {
			var id = target.data("id");
			var value = target.data('value') == "Y" ? "N" : "Y";
			$.post("<?php echo $this->url(array("module" => "system", "controller" => "manage", "action" => "updatelanguage"), null, true); ?>", {"id" : id, "type" : "required", "value" : value}, function(data){
				if (data.result) {
					DialogComplete();
					tblData.ajax.reload();
				} else {
					DialogWarning(data.message);
				}
			}, "json");
		} else if (target.data('type') == 'isEnable') {
			var id = target.data("id");
			var value = target.data('value') == "Y" ? "N" : "Y";
			$.post("<?php echo $this->url(array("module" => "system", "controller" => "manage", "action" => "updatelanguage"), null, true); ?>", {"id" : id, "type" : "enable", "value" : value}, function(data){
				if (data.result) {
					DialogComplete();
					tblData.ajax.reload();
				} else {
					DialogWarning(data.message);
				}
			}, "json");
		}
	});
	
});

</script> 
