<script src="<?php echo $this->baseUrl('plugins/jQueryValidation/jquery.validate.min.js'); ?>"></script>
<script src="<?php echo $this->baseUrl('plugins/jQueryValidation/localization/messages_th.min.js'); ?>"></script>
<script>
$(function () {
	
	$("#formEdit").validate({
		errorElement: "em",
		errorPlacement: function(error, element) {
			error.addClass( "help-block" );
	        error.appendTo( element.parents("div.divControl"));
        }
    });
	
	toggleFacebook('<?php  echo $this->data->is_facebook?>');
	$('#formEdit').on('ifClicked', 'input[name=isFacebook]', function(e){
		toggleFacebook($(this).val());
	}); 
	
	function toggleFacebook(val){
		if(val == 'Y'){
			$("div.hideFacebook input[type='text']").prop( "disabled", false );
			$('label[for=txtfacebookurl]').addClass('labelRequest');
			$('#txtfacebookurl').addClass('url required');
			
		}else{
			$("div.hideFacebook input[type='text']").prop( "disabled", true );
			$('label[for=txtfacebookurl]').removeClass('labelRequest');
			$('#txtfacebookurl').removeClass('url required');
		}
	}
	
	toggleYoutube('<?php  echo $this->data->is_youtube?>');
	$('#formEdit').on('ifClicked', 'input[name=isYoutube]', function(e){
		toggleYoutube($(this).val());
	}); 
	
	function toggleYoutube(val){
		if(val == 'Y'){
			$("div.hideYoutube input[type='text']").prop( "disabled", false );
			$('label[for=txtyoutubeurl]').addClass('labelRequest');
			$('#txtyoutubeurl').addClass('url required');
			
		}else{
			$("div.hideYoutube input[type='text']").prop( "disabled", true );
			$('label[for=txtyoutubeurl]').removeClass('labelRequest');
			$('#txtyoutubeurl').removeClass('url required');
		}
	}
	
	toggleTwitter('<?php  echo $this->data->is_twitter?>');
	$('#formEdit').on('ifClicked', 'input[name=isTwitter]', function(e){
		toggleTwitter($(this).val());
	}); 
	
	function toggleTwitter(val){
		if(val == 'Y'){
			$("div.hideTwitter input[type='text']").prop( "disabled", false );
			$('label[for=txttwitterurl]').addClass('labelRequest');
			$('#txttwitterurl').addClass('url required');

		}else{
			$("div.hideTwitter input[type='text']").prop( "disabled", true );
			$('label[for=txttwitterurl]').removeClass('labelRequest');
			$('#txttwitterurl').removeClass('url required');
		}
	}

	toggleInstagram('<?php  echo $this->data->is_instagram?>');
	$('#formEdit').on('ifClicked', 'input[name=isInstagram]', function(e){
		toggleInstagram($(this).val());
	}); 
	
	function toggleInstagram(val){
		if(val == 'Y'){
			$("div.hideInstagram input[type='text']").prop( "disabled", false );
			$('label[for=txtinstagramurl]').addClass('labelRequest');
			$('#txtinstagramurl').addClass('url required');

		}else{
			$("div.hideInstagram input[type='text']").prop( "disabled", true );
			$('label[for=txtinstagramurl]').removeClass('labelRequest');
			$('#txtinstagramurl').removeClass('url required');
		}
	}

	$("#formEdit input[type=checkbox], #formEdit input[type=radio]").iCheck({checkboxClass: 'icheckbox_minimal-green',radioClass: 'iradio_minimal-green'});

	function toggleSmtpSsl(val) {
		if (val == 'Y') {
			$('label[for=lstSmtpSslType]').addClass('labelRequest');
			$('#lstSmtpSslType').addClass('required');
		} else {
			$('label[for=lstSmtpSslType]').removeClass('labelRequest');
			$('#lstSmtpSslType').removeClass('required');
		}
	}
	$("#formEdit")
	.on('ifClicked', 'input[name=rdlSmtpUseSsl]', function(event){
		toggleSmtpSsl($(this).val());
	});
	toggleSmtpSsl($('input[name=rdlSmtpUseSsl]:checked').val());
	
	function toggleSmtpAuth(val) {
		if (val == 'Y') {
			$('label[for=lstSmtpAuthType]').addClass('labelRequest');
			$('#lstSmtpAuthType').addClass('required');
			$('label[for=txtSmtpAuthUsername]').addClass('labelRequest');
			$('#txtSmtpAuthUsername').addClass('required');
		} else {
			$('label[for=lstSmtpAuthType]').removeClass('labelRequest');
			$('#lstSmtpAuthType').removeClass('required');
			$('label[for=txtSmtpAuthUsername]').removeClass('labelRequest');
			$('#txtSmtpAuthUsername').removeClass('required');
		}
	}
	$("#formEdit")
	.on('ifClicked', 'input[name=rdlSmtpUseAuth]', function(event){
		toggleSmtpAuth($(this).val());
	});
	toggleSmtpAuth($('input[name=rdlSmtpUseAuth]:checked').val());

	// Save
	$("#btnSave").click(function(){
		var valid = $("#formEdit").valid();
		if (valid) {
			
			$.post("<?php echo $this->url(array('module' => 'system', 'controller' => 'manage', 'action' => 'save'), null, true);?>", $("#formEdit").serializeArray(), function(data){
				if (data.result) {
					DialogComplete();
					setTimeout(function(){
						window.location = "<?php echo $this->url(array('module' => 'system', 'controller' => 'manage', 'action' => 'index'), null, true); ?>" ;
					}, 500);
				} else {
					DialogWarning(data.message);
				}
			}, 'json');
		}
	});
});
</script>