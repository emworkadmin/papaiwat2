<script>
$(function () {

	<?php if($this->canEdit){ ?>
	// Edit
	$(".btnEdit").click(function(){
		window.location = "<?php echo $this->url(array('module' => 'system', 'controller' => 'user', 'action' => 'edit', 'itemid' => $this->data->id), null, true); ?>";
	});
	// Delete
	$(".btnDelete").click(function(){
		DialogConfirm("คุณแน่ใจหรือไม่?", "แจ้งเตือนการลบ", function() {
			$.post("<?php echo $this->url(array("module" => 'system', "controller" => 'user', 'action' => 'delete'), null, true); ?>", {'id' : '<?php echo $this->data->id?>'}, function(data){
				if (data.result) {
					DialogComplete('ลบสำเร็จ');
					setTimeout(function(){
						window.location = "<?php echo $this->url(array('module' => 'system', 'controller' => 'user', 'action' => 'index'), null, true); ?>";
					}, 500);
				} else {
					DialogWarning(data.message);
				}
			}, 'json');
		});
	});
	<?php } ?>

	// Back
	$(".btnBack").click(function(){
		window.location = "<?php echo $this->url(array('module' => 'system', 'controller' => 'user', 'action' => 'index'), null, true); ?>";
	});
	
});
</script>