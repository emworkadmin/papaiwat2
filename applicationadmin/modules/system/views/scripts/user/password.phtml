<div class="panel-detail">
	<form class="form-horizontal" id="formEdit" name="formEdit">
	
		<?php echo $this->formHidden('hdfID', $this->data->ID ,null, null); ?>
		
		<div class="title-label">เปลี่ยนรหัสผ่าน</div>
			
	
		<div class="form-group">
			<label class="col-md-3 labelRequest control-label" for="txtPassword">รหัสผ่าน </label> 
			<div class="col-md-9 divControl">
				<?php echo $this->formPassword('txtPassword', null, array('class' => 'form-control required', 'placeholder' => 'รหัสผ่าน', 'maxlength' => '100')); ?>
				<span class="help-block">รหัสผ่านความยาวอย่างน้อย 8 ตัว  </span>
			</div>
		</div>
		<div class="form-group">
			<label class="col-md-3 labelRequest control-label" for="txtConfirmPassword">ยืนยันรหัสผ่าน</label> 
			<div class="col-md-9 divControl">
				<?php echo $this->formPassword('txtConfirmPassword', null, array('class' => 'form-control required', 'placeholder' => 'ยืนยันรหัสผ่าน', 'maxlength' => '100')); ?>
				<span class="help-block">กรอกรหัสผ่านซ้ำอีกครั้ง </span>
			</div>
		</div>
		
		<div class="form-group">
			<div class="col-md-9 col-md-offset-3">
			<button type="button" class="btn btn-primary" id="btnSave"><em class="fa fa-key"></em> เปลี่ยนรหัสผ่าน</button>
				<button type="button" class="btn btn-default" id="btnCancel">ยกเลิก</button>
			</div>
		</div>
	</form>
</div>

<script src="<?php echo $this->baseUrl('plugins/jQueryValidation/jquery.validate.min.js'); ?>"></script>
<script src="<?php echo $this->baseUrl('plugins/jQueryValidation/localization/messages_th.min.js'); ?>"></script>
<script>
$(function () {
	
	$("#formEdit").validate({
		errorElement: "em",
		errorPlacement: function(error, element) {
			error.addClass( "help-block" );
	        error.appendTo( element.parents("div.divControl"));
        }
    });
    
	// Save
	$("#btnSave").click(function(){
		var valid = $("#formEdit").valid();
		if (valid) {
			var Password = $('#txtPassword').val();
			var ConfirmPassword = $('#txtConfirmPassword').val();
			if(Password.length < 8){
				DialogWarning('กรุณากรอกรหัสผ่านความยาวอย่างน้อย 8 ตัวอักษร');
				return;
			}
			if(Password != ConfirmPassword){
				DialogWarning('รหัสผ่านไม่ตรงกันกรุณาตรวจสอบ');
				return;
			}
			
			$.post("<?php echo $this->url(array('module' => 'system', 'controller' => 'user', 'action' => 'passwordsave'), null, true);?>", $("#formEdit").serializeArray(), function(data){
				if (data.result) {
					DialogComplete('เปลี่ยนรหัสผ่านสำเร็จ');
					setTimeout(function(){
						window.location = "<?php echo $this->url(array('module' => 'system', 'controller' => 'user', 'action' => 'password', 'itemid' => $this->data->ID), null, true); ?>";
					}, 1000);
				} else {
					DialogWarning(data.message);
				}
			}, 'json');
		}
	});

	// Cancel
	$("#btnCancel").click(function(){
		window.location = "<?php echo $this->url(array('module' => 'system', 'controller' => 'user', 'action' => 'edit', 'itemid' => $this->data->id), null, true); ?>";
	});
});
</script>
