<script src="<?php echo $this->baseUrl('plugins/jQueryValidation/jquery.validate.min.js'); ?>"></script>
<script src="<?php echo $this->baseUrl('plugins/jQueryValidation/localization/messages_th.min.js'); ?>"></script>
<script>
$(function () {
	
	$("#formAdd").validate({
		errorElement: "em",
		errorPlacement: function(error, element) {
			error.addClass( "help-block" );
	        error.appendTo( element.parents("div.divControl"));
        }
    });

	$('#txtBirthDate').datepicker({autoclose: true, format: 'dd/mm/yyyy'});
	$('#txtBirthDate').change(function(){
		if ($(this).val() != "") {
			$("#txtBirthDateClose").css("display", "block");
		}
	});
	$("#txtBirthDateClose").click(function(){
		$('#txtBirthDate').val('');
		$("#txtBirthDateClose").css("display", "none");
	});

	$("#formAdd input[type=checkbox], #formAdd input[type=radio]").iCheck({checkboxClass: 'icheckbox_minimal-blue',radioClass: 'iradio_minimal-blue'});
	$("input[type=radio][name=rdlUserType]").on('ifClicked', function(event){
		if (event.target.value == 'Y') {
			$("#lstUsergroup").removeAttr('disabled');
			$("label[for=lstUsergroup]").addClass("labelRequest");
			$("#lstUsergroup").addClass("required");
		} else {
			$("#lstUsergroup").attr('disabled', 'disabled').val('');
			$("label[for=lstUsergroup]").removeClass("labelRequest");
			$("#lstUsergroup").removeClass("required");
		}
	});
		
	// Save
	$("#btnSave").click(function(){
		var valid = $("#formAdd").valid();
		if (valid) {
			var Password = $('#txtPassword').val();
			var ConfirmPassword = $('#txtConfirmPassword').val();
			if(Password.length < 8){
				DialogWarning('กรุณากรอกรหัสผ่านความยาวอย่างน้อย 8 ตัวอักษร');
				return;
			}
			if(Password != ConfirmPassword){
				DialogWarning('รหัสผ่านไม่ตรงกันกรุณาตรวจสอบ');
				return;
			}
			$.post("<?php echo $this->url(array('module' => 'system', 'controller' => 'user', 'action' => 'save'), null, true);?>", $("#formAdd").serializeArray(), function(data){
				if (data.result) {
					DialogComplete();
					setTimeout(function(){
						window.location = "<?php echo $this->url(array('module' => 'system', 'controller' => 'user', 'action' => 'edit'), null, true); ?>" + "/itemid/" + data.id;
					}, 500);
				} else {
					DialogWarning(data.message);
				}
			}, 'json');
		}
	});

	// Cancel
	$("#btnCancel").click(function(){
		window.location = "<?php echo $this->url(array('module' => 'system', 'controller' => 'user', 'action' => 'index'), null, true); ?>";
	});

});
</script>
