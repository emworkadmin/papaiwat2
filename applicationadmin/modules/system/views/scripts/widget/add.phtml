<script src="<?php echo $this->baseUrl('plugins/jQueryValidation/jquery.validate.min.js'); ?>"></script>
<script src="<?php echo $this->baseUrl('plugins/jQueryValidation/localization/messages_th.min.js'); ?>"></script>
<script>
$(function () {
	
	$("#formData").validate({
		errorElement: "em",
		errorPlacement: function(error, element) {
			error.addClass( "help-block" );
	        error.appendTo( element.parents("div.divControl"));
        }
    });

	$("#formData input[type=checkbox], #formData input[type=radio]").iCheck({checkboxClass: 'icheckbox_minimal-blue',radioClass: 'iradio_minimal-blue'});
	
	$("input[name=ShowInMenu]").on('ifClicked', function(event){
		var val = $(this).val();
		if (val == '0' || val == '-') {
			$("#divMenuList").css("display", "none");
		} else {
			$("#divMenuList").css("display", "");
		}
	});
	
	// Save
	$("#btnSave").click(function(){
		var valid = $("#formData").valid();
		if (valid) {
			$.post("<?php echo $this->url(array('module' => 'system', 'controller' => 'widget', 'action' => 'save'), null, true);?>", $("#formData").serializeArray(), function(data){
				if (data.result) {
					DialogComplete();
					setTimeout(function(){
						window.location = "<?php echo $this->url(array('module' => 'system', 'controller' => 'widget', 'action' => 'edit'), null, true); ?>" + "/itemid/" + data.id;
					}, 500);
				} else {
					DialogWarning(data.message);
				}
			}, 'json');
		}
	});

	// Cancel
	$("#btnCancel").click(function(){
		window.location = "<?php echo $this->url(array('module' => 'system', 'controller' => 'widget', 'action' => 'index'), null, true); ?>";
	});

});
</script>
