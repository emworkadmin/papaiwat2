<script>
$(function () {

	$(".menugroups")
	.on("click", "a.lnkMenuGroup", function(){
		var dataID = $(this).data('id');
		$(".menugroups a.lnkMenuGroup").removeClass("active");
		$(".menugroups a.lnkMenuGroup[data-id=" + dataID + "]").addClass("active");
		$(".formAction").removeClass("active");
		$("#formAction" + dataID + "").addClass("active");		
	});

	$(".formAction")
	.on("click change", "input[type=checkbox]", function(){
		var qTarget = $(this);
        var ul = qTarget.next("ul");
        if (qTarget.is(':checked')) {
            ul.children("li").children("input").removeAttr("disabled");
        } else {
            ul.find("input").each(function(){
                this.checked = false;
                jQuery(this).attr("disabled", "disabled");
            });
        }
	});

	$(".btnSave").click(function(){
		var form = $(this).parents("form");
		$.post("<?php echo $this->url(array('module' => 'system', 'controller' => 'usergroup', 'action' => 'rightssaveaction'), null, true);?>", form.serializeArray(), function(data){
			if (data.result) {
				DialogComplete();
			} else {
				DialogWarning(data.message);
			}
		}, 'json');
	});
	// Cancel
	$("#btnCancel").click(function(){
		window.location = "<?php echo $this->url(array('module' => 'system', 'controller' => 'usergroup', 'action' => 'index'), null, true); ?>";
	});
});
</script>
