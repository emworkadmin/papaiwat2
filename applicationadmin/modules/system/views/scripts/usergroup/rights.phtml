function displayAction($data, $actionGroupID, $parentID, $values, $isDisabled = false) {
	$actions = $data[$parentID];
	if (count($actions) > 0) :
		echo "<ul>";
		foreach ($actions as $action) : 
			echo "<li>";
			echo "<input type='checkbox' value='" . $action["ID"] . "' id='chkAction=" . $action["ID"] . "' name='chkAction[]' " . (in_array($action["ID"], $values) ? "checked='checked'" : "") . " " . ($isDisabled ? "disabled='disabled'" : "") . " /> " . $action["Name"];
			displayAction($data, $actionGroupID, $action["ID"], $values, ($isDisabled || !in_array($action["ID"], $values)));
			echo "</li>";
		endforeach;
		echo "</ul>";
	endif;
}
