<script src="<?php echo $this->baseUrl('plugins/jQueryValidation/jquery.validate.min.js'); ?>"></script>
<script src="<?php echo $this->baseUrl('plugins/jQueryValidation/localization/messages_th.min.js'); ?>"></script>
<script>
$(function () {

	$("#formAdd").validate({
		errorElement: "em",
		errorPlacement: function(error, element) {
			error.addClass( "help-block" );
	        error.appendTo( element.parents("div.divControl"));
        }
    });

	$("#formAdd input[type=checkbox], #formAdd input[type=radio]").iCheck({checkboxClass: 'icheckbox_minimal-blue',radioClass: 'iradio_minimal-blue'});

	<?php if ($this->canEdit) : ?>
	// Save
	$("#btnSave").click(function(){
		var valid = $("#formAdd").valid();
		if (valid) {
			$.post("<?php echo $this->url(array('module' => 'system', 'controller' => 'usergroup', 'action' => 'update'), null, true);?>", $("#formAdd").serializeArray(), function(data){
				if (data.result) {
					DialogComplete();
					setTimeout(function(){
						window.location = "<?php echo $this->url(array('module' => 'system', 'controller' => 'usergroup', 'action' => 'edit', 'itemid' => $this->data->ID), null, true); ?>";
					}, 1000);
				} else {
					DialogWarning(data.message);
				}
			}, 'json');
		}
	});
	<?php endif; ?>

	// Cancel
	$("#btnCancel").click(function(){
		window.location = "<?php echo $this->url(array('module' => 'system', 'controller' => 'usergroup', 'action' => 'index'), null, true); ?>";
	});
	
	<?php if($this->canDelete){ ?>
	$("#btnDelete").click(function(){
		DialogConfirm("คุณแน่ใจหรือไม่?", "แจ้งเตือนการลบ", function() {
			$.post("<?php echo $this->url(array("module" => 'system', "controller" => 'usergroup', 'action' => 'delete'), null, true); ?>", {'id' : '<?php echo $this->data->ID; ?>'}, function(data){
				if (data.result) {
					DialogComplete('ลบสำเร็จ');
					setTimeout(function(){
						window.location = "<?php echo $this->url(array('module' => 'system', 'controller' => 'usergroup', 'action' => 'index'), null, true); ?>";
					}, 1000);
				} else {
					DialogWarning(data.message);
				}
			}, 'json');
		});
	});
	<?php }?>
});
</script>
