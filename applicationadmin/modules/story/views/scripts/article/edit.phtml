        ignore: []
    });

	// Cover
	$("#btnCoverAdd").click(function(){
		var data = '';
		var dialogCoverImage = BootstrapDialog.show({
			title: 'ข้อมูลภาพ Cover',
			message: $('<div id="dialogCoverImage"></div>').load("<?php echo $this->url(array('module' => 'story', 'controller' => 'article', 'action' => 'coverform'), null, true); ?>", {"data" : data}),
			closable: true,
            closeByBackdrop: false,
            closeByKeyboard: false,
            autodestroy: true,
			buttons : [{
				label: ' ยืนยัน',
				icon: 'fa fa-check',
				cssClass: 'btn-primary',
				action: function(dialog) {
					var isValid = $("#dialogCoverImage form").valid();
					if (isValid) {
						var saveResult = saveCoverImage("");
						if (saveResult) {
							reindexCoverImage();
							dialog.close();
						}
					}
				}
			},{
				label: ' ปิด',
				icon: 'fa fa-times',
				action: function(dialog) {
					dialog.close();
				}
			}]
		});
		dialogCoverImage.open();
	});
	$("#tblCoverImage").bind('click', function(e) {
		var target = $(e.target);		
		// Edit
		if (target.hasClass("edit")) {
			var data = target.parent('td').find('input[type=hidden]').val();
			var dataId = target.parent('td').parent('tr').attr('data-id');
			if(dataId == undefined){
				var data = target.parent('button').parent('td').find('input[type=hidden]').val();
				var dataId = target.parent('button').parent('td').parent('tr').attr('data-id');
			}
			var dialogCoverImage = BootstrapDialog.show({
				title: 'ข้อมูลรูปภาพ Cover',
				message: $('<div id="dialogCoverImage"></div>').load("<?php echo $this->url(array('module' => 'story', 'controller' => 'article', 'action' => 'coverform'), null, true); ?>", {"data" : data }),
				closable: true,
	            closeByBackdrop: false,
	            closeByKeyboard: false,
	            autodestroy: true,
				buttons : [{
					label: ' ยืนยัน',
					icon: 'fa fa-check',
					cssClass: 'btn-primary',
					action: function(dialog) {
						var isValid = $("#dialogCoverImage form").valid();
						if (isValid) {
							var saveResult = saveCoverImage(dataId);
							if (saveResult) {
								reindexCoverImage();
								dialog.close();
							}
						}
					}
				},{
					label: ' ปิด',
					icon: 'fa fa-times',
					action: function(dialog) {
						dialog.close();
					}
				}]
			});
			dialogCoverImage.open();
		}
		// Remove
		if (target.hasClass("remove")) {
			DialogConfirm("คุณแน่ใจหรือไม่?", "แจ้งเตือนการลบ", function() {
				target.parent("td").parent("tr").fadeOut('fast', function(){
					$(this).remove();
					reindexCoverImage();
				});
			});
		}
	});
	function saveCoverImage(dataId) {
		var dataObj = $("#dialogCoverImage form").serializeObject();
		
		var title = '';
		var introText = '';
		var obj = {};
		var coverImage = null;
		obj.ID = dataObj.hdfDialogID;
		obj.Lang = {};
		$.each(dataObj.dialogParams, function(i, e) { 
			obj.Lang[i] = {};
			if(dataObj.hdfCoverImage) {
				coverImage = dataObj.hdfCoverImage[0];
			}
			obj.Lang[i].Title = e.Title;
			obj.Lang[i].IntroText = e.IntroText;
			obj.CoverImage = coverImage;
			if (i == dataObj.hdfDialogDefaultLanguage) {
				title = e.Title;
				introText = e.IntroText;
			}
		});

		if (!coverImage) {
			DialogWarning("กรุณากรอกภาพ Cover");
			return false;
		}

		var tempId = uuidv4();
		if (obj.ID == '') {
			obj.ID = tempId;
		}
		
		var dataStr = JSON.stringify(obj);

		var html = '';
		html += '<tr data-id="' + (dataId == "" ? tempId : dataId) + '">';
		html += '<td class="">';
		html += '	<em class="fa fa-bars handle"></em> &nbsp;&nbsp;';
		html += '	<span alt="dataIndex" ></span>';
		html += '</td>';
		if(!coverImage) {
			html += '<td class=""><img src="<?php echo $this->baseUrl('images/icons/no-image.jpg'); ?>">' + '</td>';
		} else {
			html += '<td class=""><img src="<?php echo $this->baseUrl('/file/get/file/'); ?>' + coverImage + '"></td>';
		}
		html += '<td class="">' + title + '</td>';
		html += '<td class="">' + introText.replace(/(?:\r\n|\r|\n)/g, '<br />') + '</td>';
		html += '<td class="">';
		html += '	<button type="button" class="btn btn-primary edit"><em class="fa fa-pencil-square-o edit"></em></button>';
		html += '	<button type="button" class="btn btn-danger remove"><em class="fa fa-trash remove"></em></button>';
		html += '	<input type="hidden" id="params-<?php echo $this->defaultLanguage;?>-Cover-' + (dataId == "" ? tempId : dataId) + '" name="params[<?php echo $this->defaultLanguage;?>][Cover][' + (dataId == "" ? tempId : dataId) + ']" value="' + '' + '">';
		html += '</td>';
		html += '</tr>';

		if (dataId == "") {
			dataId = tempId;
			$("#tblCoverImage tbody").append(html); 
		} else {
			$("#tblCoverImage tbody tr[data-id=" + dataId + "]").replaceWith(html); 
		}
		$("#tblCoverImage tbody tr[data-id=" + dataId + "] input[type=hidden]").val(dataStr);

		return true;
	}
	function reindexCoverImage() {
		var idx = 0;
		$("#tblCoverImage tbody tr").each(function(i, e) {
			idx ++;
			$(e).find('span[alt=dataIndex]').text(idx);
		});
	}
	$('#tblCoverImage tbody').sortable({
		handle: '.handle',
		cursor: 'move',
		update: function ( event, ui ){ reindexCoverImage(); }, 
		start: function ( event, ui ){ 
		}, 
		stop: function ( event, ui ){ 
		}
	}).disableSelection();

    
