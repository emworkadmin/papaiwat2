		var abbrName = '';
		if(type=='D'){
			var textVal = $('#'+id).find('textarea').val();
			cleanText = textVal.replace(/<\/?[^>]+(>|$)/g, "");
			if(cleanText.length>100){
				cleanText = cleanText.substring(0, 100);
				cleanText = cleanText + '...';
			}
			cleanText = ' : ' + cleanText;
			abbrName = cleanText;
		}
		if(type=='G'){
			var imgBoxLists = $('#'+id).find('.jFiler-item-title');
			var textVal = '';
			var index = 1;
			$.each( imgBoxLists, function( i1, e1 ) {
				if(index!=1){
					textVal += ', '
				}
				textVal += $(e1).find('b').attr('title');
				index++;
			});
			textVal = ' : ' + textVal;
			if(textVal.length>100){
				textVal = textVal.substring(0, 100);
				textVal = textVal + '...';
			}
			abbrName = textVal;
		}
		if(type=='M'){
			var uploadType = $('#'+id).find('input[type=radio]:checked').val();
			if(uploadType=='U'){
				var txtMultimedia = ' : ประเภท Upload ชื่อไฟล์ : ' + $('#'+id).find('.jFiler-item-title').find('b').attr('title');
			}
			if(uploadType=='Y'){
				var txtMultimedia = ' : ประเภท Youtube Url : ' + $('#'+id).find('input[type=text]').val();
			}
			if(txtMultimedia.length>100){
				txtMultimedia = txtMultimedia.substring(0, 100);
				txtMultimedia = txtMultimedia + '...';
			}
			abbrName = txtMultimedia;
		}
		return abbrName;
	}

	function openDialogSortContent(id) {
		var sendData = [];
		var contentList = $('#'+id).find('.panel');
		$.each(contentList, function( i, e ) {
			var obj = {
				id: $(e).attr('id'),
				type: $(e).data('type'),
				name: getContentAbbrName($(e).attr('id'),$(e).data('type'))
			};
			sendData.push(obj);
		});
		var dialogSortContent = BootstrapDialog.show({
			title: 'เรียงลำดับเรื่องราว',
			message: $('<div id="dialogSortContent"></div>').load("<?php echo $this->url(array('module' => 'story', 'controller' => 'article', 'action' => 'dialogsorting'), null, true); ?>", {"data" : sendData}),
			closable: true,
            closeByBackdrop: false,
            closeByKeyboard: false,
            autodestroy: true,
			buttons : [{
				label: ' ยืนยัน',
				icon: 'fa fa-check',
				cssClass: 'btn-primary',
				action: function(dialog) {
					var newSortable = $('#dialogSortContent input[name="newSortable[]"]');
					$.each(newSortable, function( i, e ) {
						var newsortid = $(e).val();
						var type = $('#'+newsortid).data('type');
						if(type=='D'){
							var el = $('#'+newsortid).find('textarea');

							var tagId = $(el).attr('id');
							var ckeClone = $(el).next('.cke').clone().addClass('cloned');
							ckeConfigs[tagId] = CKEDITOR.instances[tagId].config;
							CKEDITOR.instances[tagId].destroy();
							$(el).hide().after(ckeClone);

							$('#'+newsortid).appendTo($('#'+id));

							CKEDITOR.replace(tagId, ckeConfigs[tagId]);
							$(el).next('.cloned').remove();
						}else{
							$('#'+newsortid).appendTo($('#'+id));
						}
					});
					dialog.close();
				}
			},{
				label: ' ปิด',
				icon: 'fa fa-times',
				action: function(dialog) {
					dialog.close();
				}
			}]
		});
		dialogSortContent.open();
	}

});
