	function startMouseMove() {
		$(window).bind('mousemove', scrollWindow);
	}
	function stopMouseMove() {
		$(window).unbind('mousemove', scrollWindow);
	}
	function scrollWindow(e) {
		var screen = $(window).height();
		var top = e.clientY;
		if( e.clientY < 50 ){
			$("html, body").stop().animate({scrollTop:top+200}, 2000);
		}if( (e.clientY > ($(window).height()-50)) ){
			$("html, body").stop().animate({scrollTop:top+screen}, 2000);
		}
	}

	function reloadPreviewHeader(id){
		var panelLists = $('#'+id+' .panel');
		$('#'+id+' .preview-desc').show();
		$.each( panelLists, function( i, e ) {
			var inputId = $(e).attr('id');
			var type = $(e).data('type');
			var name = getContentAbbrName(inputId, type);
			$(this).find('.preview-desc').html(name);
		});
	}

