<script type="text/javascript">
jQuery(function() {

	var ctx = document.getElementById("myChart");
	var myChart = new Chart(ctx, {
		type: 'line',
		data: {
			labels: [<?php 
							$date = count($this->datatoday);
							$indexdate = 0;
							foreach($this->datatoday as $itemDate) {
								$indexdate++;
								echo '"';
								echo $itemDate['Country'];            
								if($indexdate != $date) {
									echo '",';
								}
							}
							echo '"';
						?>],
			datasets: [{
				label: 'ข้อมูลผู้ใช้รายวัน',
				data: [	<?php 
							$amount = count($this->datatoday);
							$indexcount = 0;
							foreach($this->datatoday as $itemValue) {
								$indexcount++;
								echo empty($itemValue['CountPage']) ? 0:$itemValue['CountPage'];            
								if($indexcount != $amount) {
									echo ',';
								}
							}
						?>	],
				backgroundColor: 
					'rgba(60, 179, 113, 0.2)'
				,
				borderColor: 
					'rgba(60, 179, 113)'
				,
				borderWidth: 1
			}]
		},
		options: {
			legend: {
                display: false
            }
		}
	});
});
</script> 