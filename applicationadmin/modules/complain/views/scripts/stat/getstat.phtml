<div class="col-md-12">
	<table id="tblData" class="table table-bordered table-hover"
		style="width: 100%;">
		<caption>รายการข้อมูลเรื่องร้องเรียน ณ เดือน <?php echo $this->month; ?> ปี <?php echo $this->year; ?> </caption>
		<thead>
			<tr>
				<th>ลำดับ</th>
