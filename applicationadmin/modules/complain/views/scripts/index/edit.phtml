<script type="text/javascript">
	$(function () {

		$("#formEdit").validate({
			errorElement: "em",
			errorPlacement: function(error, element) {
				error.addClass( "help-block" );
				error.appendTo( element.parents("div.divControl"));
			}
    	});

		function buttonZoneDisabled() {
			$(".button-panel-zone button").attr("disabled", "disabled");
			$(".button-panel-zone").append('<em class="fa fa-refresh fa-spin"></em>');
		}
		function buttonZoneActive() {
			$(".button-panel-zone button").removeAttr("disabled");
			$(".button-panel-zone > em").remove();
		}

		<?php if($this->canEdit): ?>
			// Save
			$("#btnSave").click(function() {
				buttonZoneDisabled();
				var valid = $("#formEdit").valid();
				if (valid) {
					$.post("<?php echo $this->url(array('module' => 'complain', 'controller' => 'index', 'action' => 'update'), null, true);?>", $("#formEdit").serializeArray(), function(data){
						console.log(data);
						if (data.result) {
							DialogComplete();
							setTimeout(function(){
								window.location = "<?php echo $this->url(array('module' => 'complain', 'controller' => 'index', 'action' => 'edit'), null, true); ?>" + "/itemid/" + data.id;
							}, 500);
						} else {
							buttonZoneActive();
							DialogWarning(data.message);
						}
					}, 'json');
				} else {
					buttonZoneActive();
				}
			});
		<?php endif; ?>

		// Back
		$("#btnBack").click(function(){
			window.location = "<?php echo $this->url(array('module' => 'complain', 'controller' => 'index', 'action' => 'index'), null, true); ?>";
		})

	});
</script>