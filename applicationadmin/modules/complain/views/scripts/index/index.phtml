<!-- DataTables -->
<script
	src="<?php echo $this->baseUrl('plugins/datatables/jquery.dataTables.min.js'); ?>"></script>
<script
	src="<?php echo $this->baseUrl('plugins/datatables/dataTables.bootstrap.min.js'); ?>"></script>
<script type="text/javascript">
jQuery(function(){

    $('#txtSendDateFrom').datepicker({autoclose: true, format: 'dd/mm/yyyy'});
    $('#txtSendDateTo').datepicker({autoclose: true, format: 'dd/mm/yyyy'});

	// --------------- Begin: Table & Search Zone --------------------------
	
	function renderColumn ( data, type, row, meta ) {
		return data;
	}
	function renderColumnLink ( data, type, row, meta ) {
		return '<a href="<?php echo $this->url(array('module' => 'complain', 'controller' => 'index', 'action' => 'edit'), null, true);?>/itemid/' + row.ID + '">' + data + '</a>';
	}
	var rows_selected = [];
	var tblData = $('#tblData').DataTable({
		processing: true,
		serverSide: true,
		responsive: true,
		pageLength: 10,
		<?php
		if ($this->InfoSearch->tblPage) {
			echo 'displayStart: ' . $this->InfoSearch->tblPage . ',';
		}
		if ($this->InfoSearch->tblRow) {
			echo 'pageLength: ' . $this->InfoSearch->tblRow . ',';
		}
		if ($this->InfoSearch->tblOrderCol && $this->InfoSearch->tblOrderDir) {
			echo 'order: [[ ' . $this->InfoSearch->tblOrderCol . ', "' . $this->InfoSearch->tblOrderDir . '" ]],';
		} else {
			echo 'order: [[ 1, "desc" ]],';
		}
		?>
		ajax: {
	        url: '<?php echo $this->url(array('module' => 'complain', 'controller' => 'index', 'action' => 'getlist'), null, true); ?>',
	        type: 'POST',
	        data: function(d) {
    	        d.textsearch = $("#formSearch #textsearch").val();
    	        d.status = $("#formSearch #lstStatus").val();
                d.sendto = $("#formSearch #txtSendDateTo").val();
    	        d.sendfrom = $("#formSearch #txtSendDateFrom").val();
	        }
	    },
	    language : {
			url : '<?php echo $this->baseUrl('plugins/datatables/localization/jquery.dataTables.thai.json'); ?>'
	    },
		"dom": '<"dataTable"rt<"bottom"ilp<"clear">>>',
		"columns": [
		            { "width": "40px", 'orderable': false, 'data' : 'NO', "class" : "text-center"},
		            { 'data' : 'DateComplain' , 'render' : renderColumnLink, "class" : "ratio"},
                    { 'data' : 'Topic' , 'render' : renderColumnLink, "class" : "ratio"},
                    { 'data' : 'FullName' , 'render' : renderColumnLink, "class" : "ratio"},
		            { "width": "15%", 'data' : 'Status' , 'render' : renderColumnLink, "class" : "ratio"}
		          ]
    });

	$('#btnSearch').click(function(){
		tblData.ajax.reload();
	});

	$('#btnReset').click(function(){
		$(".searchPanel input[type=text]").val('');
		$(".searchPanel select").val('');
		tblData.ajax.reload();
	});
	        
	//new $.fn.dataTable.Responsive( tblData );
	
	// --------------- End: Table & Search Zone --------------------------

	// --------------- Toogle Advance Search ---------------
	$("#btnAdvance").click(function(e) {
		var val = $('#hdfAdvanceSearch').val();
		if(val == 'H'){
			$("#AdvanceSearch").slideDown(600, "swing");
			$("#hdfAdvanceSearch").val('S');
		}else{
			$("#AdvanceSearch").slideUp(600, "swing");
			$("#hdfAdvanceSearch").val('H');
		}
	});
});

</script>
