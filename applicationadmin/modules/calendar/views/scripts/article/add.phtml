//--------------------------- Google Map -------------------------- //
var state = 'view';
var tempLat = null;
var tempLng = null;
var map = null;
var placeService = null;
var mapMarker = null; 

// Manage Map
$("#btnMapManage").click(function(){
	tempLat = $("#txtLatitude").val();
	tempLng = $("#txtLongitude").val();
	$("#btnMapManage").css('display', 'none');
	$("#btnMapManagePlace").css('display', 'none');
	$("#btnMapConfirm").css('display', '');
	$("#btnMapCurrent").css('display', '');
	$("#btnMapCancel").css('display', '');
	$("#txtLatitude").attr('disabled', 'disabled');
	$("#txtLongitude").attr('disabled', 'disabled');
	mapMarker.setOptions({draggable: true});
	map.setOptions({draggable: true});
	if (tempLat != null && tempLat != "" && tempLng != null && tempLng != '') {
		mapMarker.setPosition(new google.maps.LatLng(tempLat, tempLng));
		map.setCenter(mapMarker.position);
	}
	state = 'edit';
});
// Manage Place
$("#btnMapManagePlace").click(function(){
	var dialogPreview = BootstrapDialog.show({
		title: 'ค้นหาตำแหน่งจากชื่อสถานที่',
		message: "<div id='divSearchPlace' class='form-horizontal' ><div class='form-group'><label class='col-md-3 control-label'>ชื่อสถานที่</label><div class='col-md-9 divControl'><input type='text' id='txtSearchPlace' class='form-control' /><div class='help-block'>เมื่อค้นหาพบแล้ว โปรดตรวจสอบตำแหน่งบนแผนที่ว่าถูกต้องหรือไม่</div></div></div></div>",
		closable: true,
        closeByBackdrop: false,
        closeByKeyboard: false,
        autodestroy: true,
        cssClass: "divPreview",
		buttons : [{
			label: ' ค้นหา',
			icon: 'fa fa-search',
			cssClass: 'btn-primary',
			action: function(dialog) {
				var address = $("#txtSearchPlace").val();
				if (address != '') {
					var request = {query:address};
					placeService.textSearch(request, function(results, status){
						if (status == google.maps.places.PlacesServiceStatus.OK) {
							var placeResult = results[0];
							var lat = placeResult.geometry.location.lat();
							var lng = placeResult.geometry.location.lng();
							mapMarker.setPosition(new google.maps.LatLng(lat, lng));
							map.setCenter(mapMarker.position);
							map.setZoom(16);
							$("#txtLatitude").val(lat);
							$("#txtLongitude").val(lng);
							dialog.close();
						} else {
							DialogWarning("ไม่พบข้อมูล โปรดกรอกชื่อสถานที่ใหม่ <br />หรือกำหนดตำแหน่งจากแผนที");
						}
					});
				} else {
					DialogWarning("โปรดกรอกชื่อสถานที่");
				}
			}
		},{
			label: ' ปิด',
			icon: 'fa fa-times',
			action: function(dialog) {
				dialog.close();
			}
		}]
	});
	dialogPreview.open();
});
$("#btnMapConfirm").click(function(){
	$("#btnMapManage").css('display', '');
	$("#btnMapManagePlace").css('display', '');
	$("#btnMapConfirm").css('display', 'none');
	$("#btnMapCurrent").css('display', 'none');
	$("#btnMapCancel").css('display', 'none');
	$("#txtLatitude").removeAttr('disabled');
	$("#txtLongitude").removeAttr('disabled');
	mapMarker.setOptions({draggable: false});
	map.setOptions({draggable: false});
	var lat = $("#txtLatitude").val();
	var lng = $("#txtLongitude").val();
	if (lat != null && lat != "" && lng != null && lng != '') {
		mapMarker.setPosition(new google.maps.LatLng(lat, lng));
		map.setCenter(mapMarker.position);
	}
	state = 'view';
});
$("#btnMapCurrent").click(function(){
	if (navigator.geolocation) {
		navigator.geolocation.getCurrentPosition(function(position) {
			var pos = {
					lat: position.coords.latitude,
					lng: position.coords.longitude
			};
			map.setCenter(pos);
			mapMarker.setPosition(pos);
			$('#txtLatitude').val(position.coords.latitude);
			$('#txtLongitude').val(position.coords.longitude);
		}, function(error) {
		});
	} 
});
$("#btnMapCancel").click(function(){
	$("#txtLatitude").val(tempLat);
	$("#txtLongitude").val(tempLng);
	$("#btnMapManage").css('display', '');
	$("#btnMapManagePlace").css('display', '');
	$("#btnMapConfirm").css('display', 'none');
	$("#btnMapCurrent").css('display', 'none');
	$("#btnMapCancel").css('display', 'none');
	$("#txtLatitude").removeAttr('disabled');
	$("#txtLongitude").removeAttr('disabled');
	mapMarker.setOptions({draggable: false});
	map.setOptions({draggable: false});
	if (tempLat != null && tempLat != "" && tempLng != null && tempLng != '') {
		mapMarker.setPosition(new google.maps.LatLng(tempLat, tempLng));
		map.setCenter(mapMarker.position);
	}
	state = 'view';
});


function initMap() {	
	// Set Map
	map = new google.maps.Map(document.getElementById('mapCanvas'), {
	    zoom: 16,
	    center: new google.maps.LatLng(13.736717, 100.523186), // Bangkok Position
	    mapTypeId: google.maps.MapTypeId.ROADMAP,
	    draggable: false
	});
	google.maps.event.addListener(map, 'click', function(event){
		if (state == 'edit') {
			var pos = {lat: event.latLng.lat(), lng: event.latLng.lng()};
			mapMarker.setPosition(pos);
			$('#txtLatitude').val(event.latLng.lat());
			$('#txtLongitude').val(event.latLng.lng());
		}
	});

	// Set Marker
	mapMarker = new google.maps.Marker({draggable: false, map: map});	
	google.maps.event.addListener(mapMarker, 'dragend', function (event) {
		if (state == 'edit') {
			$('#txtLatitude').val(event.latLng.lat());
			$('#txtLongitude').val(event.latLng.lng());
		}
	});
	google.maps.event.addListener(mapMarker, 'dragstart', function (event) {
		if (state == 'edit') {
			$('#txtLatitude').val(event.latLng.lat());
			$('#txtLongitude').val(event.latLng.lng());
		}
	});

	// Set PlaceService
	placeService = new google.maps.places.PlacesService(map);
}
</script>
<script async defer src="https://maps.googleapis.com/maps/api/js?key=AIzaSyAcmeHFxJo70hGineJoUp-gFaXEzcSjQnY&callback=initMap&libraries=places"></script>
