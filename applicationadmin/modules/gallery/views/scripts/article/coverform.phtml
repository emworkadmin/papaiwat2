<?php 
$defaultDataDetail = new stdClass();
?>
<div class="panel-detail">
	<form class="form-horizontal" id="formDialog" name="formDialog">
		<?php echo $this->formHidden("hdfDialogID", $this->ID); ?>
		<?php echo $this->formHidden("hdfDialogDefaultLanguage", $this->defaultLanguage); ?>
		<div class="nav-tabs-custom">
			<ul class="nav nav-tabs">
				<?php 
				if (count($this->languages) > 0) :
					$i = 0;
					foreach ($this->languages as $lang) :
						$i ++;
				?>
				<li class="<?php echo $i == 1 ? 'active' : ''; ?>">
					<a data-toggle="tab" href="#detail-dialog-<?php echo $lang['Code']; ?>" title="<?php echo $lang['Name']; ?>"><?php echo $lang['NameLocal']; ?></a>
				</li>
				<?php 
					endforeach;
				endif;
				?>
			</ul>
			<div class="tab-content">
				<?php 
				if (count($this->languages) > 0) :
					$i = 0;
					foreach ($this->languages as $lang) :
						$langCode = $lang['Code'];
						$isRequired = $lang["IsRequired"] == "Y";
						$isDefault = $lang["IsDefault"] == "Y";
						$requiredLabel = '';
						$requiredClass = '';
						if ($isRequired) :
							$requiredLabel = 'labelRequest';
							$requiredClass = 'required';
						endif;
						$dataDetail = $this->dataDetails[$langCode];
						if ($isDefault) : 
							$defaultDataDetail = $dataDetail;
						endif;
						$i ++;							
				?>
				<div id="detail-dialog-<?php echo $lang['Code']; ?>" class="tab-pane fade <?php echo $i == 1 ? 'in active' : ''; ?>">					
					<div class="form-group" >
						<label class="col-md-3 control-label" for="">ชื่อ</label>		
						<div class="col-md-9 divControl">
							<?php echo $this->formText("dialogParams[{$langCode}][Title]", $dataDetail->Title, array('class' => 'form-control', 'placeholder' => '', 'maxlength' => '250')); ?>
						</div>
					</div>
					
					<div class="form-group" >
						<label class="col-md-3 control-label" for="">คำอธิบาย</label>		
						<div class="col-md-9 divControl">
							<?php echo $this->formTextarea("dialogParams[{$langCode}][IntroText]", $dataDetail->IntroText, array('class' => 'form-control', 'placeholder' => '', 'maxlength' => '1000', 'rows' => "5")); ?>
						</div>
					</div>
					
					<?php if($isDefault) : ?>
					<div class="form-group" >
						<label class="col-md-3 control-label <?php echo $requiredLabel;?>" for="">รูปภาพ</label>
						<div class="col-md-9 divControl">
							<?php echo $this->UploadHtmlControl("CoverImage", "CoverImage", $this->dataDetails['CoverImage'], array('maxsize'=>$this->dataDefault->SizeUploadFile,'multi' => false, 'exts' => array('png', 'jpg', 'jpeg', 'gif'))); ?>
							<div class="help-block">ขนาดไฟล์ไม่เกิน <?php  echo $this->dataDefault->SizeUploadFile; ?> MB, เฉพาะไฟล์นามสกุล: .jpg, .jpeg, .gif, .png </div>
						</div>
					</div>				
					<?php endif; ?>
				</div>
				<?php 
					endforeach;
				endif;
				?>
			</div>
		</div>	
	</form>
</div>

<script type="text/javascript">
$(function () {

	$("#formDialog").validate({
		errorElement: "em",
		errorPlacement: function(error, element) {
			error.addClass( "help-block" );
	        error.appendTo( element.parents("div.divControl"));
        }
    });

});
</script>