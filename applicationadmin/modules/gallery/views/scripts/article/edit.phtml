		<?php endforeach;?>
		var valid = $("#formData").valid();
		if (valid) {
			$.post("<?php echo $this->url(array('module' => 'gallery', 'controller' => 'article', 'action' => 'update'), null, true);?>", $("#formData").serializeArray(), function(data){
