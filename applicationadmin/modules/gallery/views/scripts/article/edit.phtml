					setTimeout(function(){
						window.location = "<?php echo $this->url(array('module' => 'gallery', 'controller' => 'article', 'action' => 'index'), null, true); ?>";
					}, 500);
				} else {
					DialogWarning(data.message);
				}
			}, 'json');
		});
	});
	<?php endif ; ?>

	// Back
	$("#btnBack").click(function(){
		window.location = "<?php echo $this->url(array('module' => 'gallery', 'controller' => 'article', 'action' => 'index'), null, true); ?>";
