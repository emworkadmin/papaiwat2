<!-- Chart -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.4.0/Chart.min.js"></script>
<script type="text/javascript">
jQuery(function(){
	$("#formData").validate({
		errorElement: "em",
		errorPlacement: function(error, element) {
			error.addClass( "help-block" );
	        error.appendTo( element.parents("div.divControl"));
        }
    });

	$('#txtStartDate').datepicker({autoclose: true, format: 'dd/mm/yyyy'});
	$('#txtEndDate').datepicker({autoclose: true, format: 'dd/mm/yyyy'});

	$('#btcalculate').click(function(){
		var valid = $("#formData").valid();
		if (valid) {
			var startdate=$('#txtStartDate').val();
			var enddate=$('#txtEndDate').val();

			window.location = "<?php echo $this->url(array('module' => 'Graph', 'controller' => 'overview', 'action' => 'index', 'type' => 'search'), null, true); ?>/startdate/"+btoa(startdate) + "/enddate/"+btoa(enddate);
		}else{
			DialogWarning("กรุณากรอกวันที่");
		}
	});
	var ctx = document.getElementById("OverviewChart").getContext('2d');
	var myChart = new Chart(ctx, {
		type: 'line',
		data: {
			labels: [<?php 
							$loopUserPerDay = count($this->UserPerDay);
							$indexUserPerDay = 0;
							foreach($this->UserPerDay as $itemDate) {
								$indexUserPerDay++;
								echo '"';
								echo date('Y-m-d',strtotime($itemDate[0]));            
								if($indexUserPerDay != $loopUserPerDay) {
									echo '",';
								}
							}
							echo '"';
						?>],
			datasets: [{
				label: 'ข้อมูลผู้ใช้รายวัน',
				data: [	<?php 
							$loopUserPerDay = count($this->UserPerDay);
							$indexUserPerDay = 0;
							foreach($this->UserPerDay as $itemValue) {
								$indexUserPerDay++;
								echo $itemValue[1];            
								if($indexUserPerDay != $loopUserPerDay) {
									echo ',';
								}
							}
						?>	],
				backgroundColor: [
					'rgba(60, 179, 113, 0.2)'
				],
				borderColor: [
					'rgba(60, 179, 113)'
				],
				borderWidth: 1
			}]
		}
	});
	$('#btnCancel').click(function(){
		var valid = $("#formData").valid();
		if (valid) {
			window.location = "<?php echo $this->url(array('module' => 'Graph', 'controller' => 'overview', 'action' => 'index'), null, true); ?>";
		}else{
			DialogWarning("กรุณากรอกวันที่");
		}
	});
});
</script>
