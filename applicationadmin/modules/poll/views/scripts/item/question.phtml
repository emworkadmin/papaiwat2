<script>
function uuidv4() {
  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
    var r = Math.random() * 16 | 0, v = c == 'x' ? r : (r & 0x3 | 0x8);
    return v.toString(16);
  });
}
$(function () {
	
	$("#formData").validate({
		errorElement: "em",
		errorPlacement: function(error, element) {
			error.addClass( "help-block" );
	        error.appendTo( element.parents("div.divControl"));
        }
    });    

	$( "#section-manage" ).sortable({handle: '.handle',cursor: 'move', update: function ( event, ui ){ }, start: function ( event, ui ){ $("#section-manage .section-body").css("display", "none"); ui.item.css("height", $(".section-header", ui.item).height()); ui.placeholder.height(ui.item.height()); $("#section-manage").sortable( "refreshPositions" ); }, stop: function ( event, ui ){ $("#section-manage .section-body").css("display", "");  }}).disableSelection();
	$( "#section-manage .section-box-part-list" ).sortable({handle: '.handle-box',cursor: 'move', update: function ( event, ui ){  }, start: function ( event, ui ){  }, start: function ( event, ui ){ $(ui.item).parents(".section-box-part-list").find(".section-box-body").css("display", "none"); ui.item.height($(".section-box-header", ui.item).height()); ui.placeholder.height(ui.item.height()); $(ui.item).parents(".section-box-part-list").sortable( "refreshPositions" ); }, stop: function ( event, ui ){ $(ui.item).parents(".section-box-part-list").find(".section-box-body").css("display", "");  }}).disableSelection();
	
	$("#btnAddSection").click(function(){
		var rguid = uuidv4();
		var html = $("#section-temp").html();
		html = html.replace(/row_guid/g , rguid);
		var section = $("<div class='section'></div>").append(html);
		section.find(".section-box-part-list").sortable({handle: '.handle-box',cursor: 'move', update: function ( event, ui ){ }, start: function ( event, ui ){ $("#section-manage .section-body").css("display", "none"); ui.item.css("height", $(".section-header", ui.item).height()); ui.placeholder.height(ui.item.height()); $("#section-manage").sortable( "refreshPositions" ); }, stop: function ( event, ui ){ $("#section-manage .section-body").css("display", "");  }}).disableSelection();
		$("#section-manage").append(section);
	});

	$("#section-manage")
	.on("click", ".btn-add-box", function(){
		var rguid = $(this).parents(".section-box-part").data('rguid');
		var cguid = uuidv4();
		var html = $("#section-box-temp").html();
		html = html.replace(/row_guid/g , rguid);
		html = html.replace(/col_guid/g , cguid);
		var sectionBox = $("<div class='section-box'></div>").append(html);
		$(this).parents(".section-box-part").find(".section-box-part-list").append(sectionBox);
	})
	.on("click", ".setting", function(){
		var rguid = $(this).data('rguid');
		// parse json 
		var data = $("#row-" + rguid + "-setting").val();
		var dataObj = JSON.parse(data);
		var form = $("#section-dialog").clone();
		$("#params-th-Question", form).val(dataObj.th.Question);
		$("#params-th-Description", form).val(dataObj.th.Description);
		$("#params-en-Question", form).val(dataObj.en.Question);
		$("#params-en-Description", form).val(dataObj.en.Description);
		$("#params-zh-Question", form).val(dataObj.zh.Question);
		$("#params-zh-Description", form).val(dataObj.zh.Description);
		var dialogRowSetting = BootstrapDialog.show({
			title: 'ตั้งค่าคำถาม',
			message: form,
			closable: true,
            closeByBackdrop: false,
            closeByKeyboard: false,
            autodestroy: true,
			onshown: resetNav(),
            size: BootstrapDialog.SIZE_WIDE,
            cssClass: "divRowSetting",
			buttons : [{
				label: ' บันทึก',
				icon: 'fa fa-save',
				cssClass: 'btn-primary',
				action: function(dialog) {
					var obj = {th:{},en:{},zh:{}};
					obj.th.Question = $("#params-th-Question", ".divRowSetting").val();
					obj.th.Description = $("#params-th-Description", ".divRowSetting").val();
					obj.en.Question = $("#params-en-Question", ".divRowSetting").val();
					obj.en.Description = $("#params-en-Description", ".divRowSetting").val();
					obj.zh.Question = $("#params-zh-Question", ".divRowSetting").val();
					obj.zh.Description = $("#params-zh-Description", ".divRowSetting").val();
					$("#question-" + rguid + "-title").html(obj.th.Question);
					$("#row-" + rguid + "-setting").val(JSON.stringify(obj));
					resetNav();
					dialog.close();
				}
			}, {
				label: ' ปิด',
				icon: 'fa fa-times',
				action: function(dialog) {
					resetNav();
					dialog.close();
				}
			}]
		});
		dialogRowSetting.open();
	})
	.on("click", ".remove", function(){
		$(this).parents(".section").remove();
	})
	.on("click", ".setting-box", function(){
		var rguid = $(this).data('rguid');
		var cguid = $(this).data('cguid');
		// parse json 
		var data = $("#row-" + rguid + "-cols-" + cguid + "-setting").val();
		var dataObj = JSON.parse(data);
		var form = $("#section-box-dialog").clone();
		$("#params-th-Name", form).val(dataObj.th.Name);
		$("#params-en-Name", form).val(dataObj.en.Name);
		$("#params-zh-Name", form).val(dataObj.zh.Name);
		var dialogColSetting = BootstrapDialog.show({
			title: 'ตั้งค่าคำตอบ',
			message: form,
			closable: true,
            closeByBackdrop: false,
            closeByKeyboard: false,
            autodestroy: true,
			onshown: resetNav(),
            size: BootstrapDialog.SIZE_WIDE,
            cssClass: "divColSetting",
			buttons : [{
				label: ' บันทึก',
				icon: 'fa fa-save',
				cssClass: 'btn-primary',
				action: function(dialog) {
					var obj = {th:{},en:{},zh:{}};
					obj.th.Name = $("#params-th-Name", ".divColSetting").val();
					obj.en.Name = $("#params-en-Name", ".divColSetting").val();
					obj.zh.Name = $("#params-zh-Name", ".divColSetting").val();
					$("#option-" + cguid + "-title").html(obj.th.Name);
					$("#row-" + rguid + "-cols-" + cguid + "-setting").val(JSON.stringify(obj));
					resetNav();
					dialog.close();
				}
			}, {
				label: ' ปิด',
				icon: 'fa fa-times',
				action: function(dialog) {
					resetNav();
					dialog.close();
				}
			}]
		});
		dialogColSetting.open();
	})
	.on("click", ".remove-box", function(){
		$(this).parents(".section-box").remove();
	})
	.on("change", ".section-name-ctrl", function(){
		$(this).parents(".section").find(".section-header-title").text(": " + $(this).val());
	})
	;

	function resetNav(){
		$(".tab-pane").removeClass('in');
		$(".tab-pane").removeClass('active');
		$(".tab-pane.detail-th").addClass('in')
		$(".tab-pane.detail-th").addClass('active');
	}

    <?php if ($this->canAdd) : ?>
	// Save
	$("#btnSave").click(function(){
		var valid = $("#formData").valid();
		if (valid) {
			
			$.post("<?php echo $this->url(array('module' => 'poll', 'controller' => 'item', 'action' => 'savequestion'), null, true);?>", $("#formData").serializeArray(), function(data){
				if (data.result) {
					DialogComplete();
					setTimeout(function(){
						window.location = "<?php echo $this->url(array('module' => 'poll', 'controller' => 'item', 'action' => 'question', 'itemid' => $this->data->ID), null, true); ?>";
					}, 500);
				} else {
					DialogWarning(data.message);
				}
			}, 'json');
		}
	});
	<?php endif; ?>

	// Cancel
	$("#btnCancel").click(function(){
		window.location = "<?php echo $this->url(array('module' => 'poll', 'controller' => 'item', 'action' => 'edit', 'itemid' => $this->data->ID), null, true); ?>";
	});

});

</script>