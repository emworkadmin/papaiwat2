<script src="<?php echo $this->baseUrl('plugins/ckeditor/adapters/jquery.js'); ?>"></script>
<script>
$(function () {
	
	$("#formData").validate({
		errorElement: "em",
		errorPlacement: function(error, element) {
			error.addClass( "help-block" );
	        error.appendTo( element.closest("div.divControl"));
        }, 
        ignore: []
    });
    
	<?php if($this->isiOS) : ?>
	$("input[type=text][id$=StartDate],input[type=text][id$=EndDate]").removeAttr("readonly");
	<?php endif; ?>
	$("input[type=text][id$=StartDateTime]").wickedpicker({twentyFour: true, title : 'เวลา', now : '<?php echo $this->data->StartDate != null ? $this->data->StartDate->format("H:i") : "0:00"; ?>'});
	$("input[type=text][id$=EndDateTime]").wickedpicker({twentyFour: true, title : 'เวลา', now : '<?php echo $this->data->EndDate != null ? $this->data->EndDate->format("H:i") : "0:00"; ?>'});

	$("#formData input[type=checkbox], #formData input[type=radio]").iCheck({checkboxClass: 'icheckbox_minimal-blue',radioClass: 'iradio_minimal-blue'});

	var roxyFileman = '<?php echo $this->baseUrl('/fileman/index.html'); ?>';	
	$( '.txtDetail' ).ckeditor({
		language: 'th',
		height: 400,
		toolbar: [
		          {name : 'basicstyles', items : ['Bold', 'Italic', 'Strike', '-', 'RemoveFormat']},
		          {name : 'colors', items : [ 'FontSize', 'TextColor', 'BGColor' ] },
		          {name : 'paragraph', items : ['NumberedList', 'BulletedList', '-', 'Outdent', 'Indent', '-', 'Blockquote', '-', 'JustifyLeft', 'JustifyCenter', 'JustifyRight', 'JustifyBlock']},
		          {name : 'links', items : ['Link', 'Unlink', 'Anchor']},
		          {name : 'inserts', items : ['Image', 'Table', 'HorizontalRule']},
		          {name : 'document', items : ['Source']},
		          {name : 'video', items : ['Video']}
		],
		extraPlugins : 'uploadimage,justify,video,font,panelbutton,colorbutton',
		filebrowserBrowseUrl: roxyFileman+'?integration=ckeditor',
		filebrowserImageBrowseUrl:roxyFileman+'?integration=ckeditor&type=image',
		filebrowserVideoBrowseUrl:roxyFileman+'?integration=ckeditor&type=video',
		extraAllowedContent : 'video [*]{*}(*);source [*]{*}(*);iframe [*]{*}(*);'
	});

	<?php if ($this->canEdit) : ?> 
	// Save
	$("#btnSave").click(function(){
		<?php foreach ($this->languages as $lang) :?>
		$("li[data-tab-lang=<?php echo $lang["Code"]; ?>]").removeClass("warning");
		<?php endforeach;?>
		var valid = $("#formData").valid();
		if (valid) {
			$.post("<?php echo $this->url(array('module' => 'poll', 'controller' => 'item', 'action' => 'update'), null, true);?>", $("#formData").serializeArray(), function(data){
				if (data.result) {
					DialogComplete();
					setTimeout(function(){
						window.location = "<?php echo $this->url(array('module' => 'poll', 'controller' => 'item', 'action' => 'edit', "itemid" => $this->data->ID), null, true); ?>";
					}, 500);
				} else {
					DialogWarning(data.message);
				}
			}, 'json');
		} else {
			<?php foreach ($this->languages as $lang) :?>
			if ($("#detail-<?php echo $lang["Code"]; ?>").find("input.error,select.error,textarea.error").length > 0) {$("li[data-tab-lang=<?php echo $lang["Code"]; ?>]").addClass("warning");}
			<?php endforeach;?>
		}
	});
	<?php endif; ?>

	<?php if ($this->canDelete) : ?>
	// Delete
	$("#btnDelete").click(function(){
		DialogConfirm("คุณแน่ใจหรือไม่?", "แจ้งเตือนการลบ", function() {
			var title = $("#params-<?php echo $this->defaultLanguage; ?>-Title").val();
			$.post("<?php echo $this->url(array("module" => 'poll', "controller" => 'item', 'action' => 'delete'), null, true); ?>", {'id' : '<?php echo $this->data->ID?>', 'title' : title}, function(data){
				if (data.result) {
					DialogComplete('ลบสำเร็จ');
					setTimeout(function(){
						window.location = "<?php echo $this->url(array('module' => 'poll', 'controller' => 'item', 'action' => 'index'), null, true); ?>";
					}, 500);
				} else {
					DialogWarning(data.message);
				}
			}, 'json');
		});
	});
	<?php endif ; ?>

	// Back
	$("#btnBack").click(function(){
		window.location = "<?php echo $this->url(array('module' => 'poll', 'controller' => 'item', 'action' => 'index'), null, true); ?>";
	});

});

