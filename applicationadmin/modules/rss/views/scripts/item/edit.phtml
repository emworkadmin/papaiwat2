<script src="<?php echo $this->baseUrl('plugins/jQueryValidation/jquery.validate.min.js'); ?>"></script>
<script src="<?php echo $this->baseUrl('plugins/jQueryValidation/localization/messages_th.min.js'); ?>"></script>
<script>
$(function () {
	
	$("#formData").validate({
		errorElement: "em",
		errorPlacement: function(error, element) {
			error.addClass( "help-block" );
	        error.appendTo( element.closest("div.divControl"));
        }, 
        ignore: []
    });

	$("#formData input[type=checkbox], #formData input[type=radio]").iCheck({checkboxClass: 'icheckbox_minimal-blue',radioClass: 'iradio_minimal-blue'});
	
	<?php if ($this->canEdit) : ?> 
	// Save
	$("#btnSave").click(function(){
		<?php foreach ($this->languages as $lang) :?>
		$("li[data-tab-lang=<?php echo $lang["Code"]; ?>]").removeClass("warning");
		<?php endforeach;?>
		var valid = $("#formData").valid();
		if (valid) {
			$.post("<?php echo $this->url(array('module' => 'rss', 'controller' => 'item', 'action' => 'update'), null, true);?>", $("#formData").serializeArray(), function(data){
				if (data.result) {
					DialogComplete();
					setTimeout(function(){
						window.location = "<?php echo $this->url(array('module' => 'rss', 'controller' => 'item', 'action' => 'edit', "itemid" => $this->data->ID), null, true); ?>";
					}, 500);
				} else {
					DialogWarning(data.message);
				}
			}, 'json');
		} else {
			<?php foreach ($this->languages as $lang) :?>
			if ($("#detail-<?php echo $lang["Code"]; ?>").find("input.error,select.error,textarea.error").length > 0) {$("li[data-tab-lang=<?php echo $lang["Code"]; ?>]").addClass("warning");}
			<?php endforeach;?>
		}
	});
	<?php endif; ?>

	<?php if ($this->canDelete) : ?>
	// Delete
	$("#btnDelete").click(function(){
		var title = $("#params-<?php echo $this->defaultLanguage; ?>-Title").val();
		DialogConfirm("คุณแน่ใจหรือไม่?", "แจ้งเตือนการลบ", function() {
			$.post("<?php echo $this->url(array("module" => 'rss', "controller" => 'item', 'action' => 'delete'), null, true); ?>", {'id' : '<?php echo $this->data->ID?>','title' : title}, function(data){
				if (data.result) {
					DialogComplete('ลบสำเร็จ');
					setTimeout(function(){
						window.location = "<?php echo $this->url(array('module' => 'rss', 'controller' => 'item', 'action' => 'index'), null, true); ?>";
					}, 500);
				} else {
					DialogWarning(data.message);
				}
			}, 'json');
		});
	});
	<?php endif ; ?>

	// Back
	$("#btnBack").click(function(){
		window.location = "<?php echo $this->url(array('module' => 'rss', 'controller' => 'item', 'action' => 'index'), null, true); ?>";
	});

});
</script>
