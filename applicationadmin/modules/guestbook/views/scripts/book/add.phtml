<script src="<?php echo $this->baseUrl('plugins/jQueryValidation/jquery.validate.min.js'); ?>"></script>
<script src="<?php echo $this->baseUrl('plugins/jQueryValidation/localization/messages_th.min.js'); ?>"></script>
<script src="<?php echo $this->baseUrl('plugins/ckeditor/ckeditor.js'); ?>"></script>
<script src="<?php echo $this->baseUrl('plugins/ckeditor/adapters/jquery.js'); ?>"></script>
<script>
$(function () {
	
	$("#formData").validate({
		errorElement: "em",
		errorPlacement: function(error, element) {
			error.addClass( "help-block" );
	        error.appendTo( element.closest("div.divControl"));
        }, 
        ignore: []
    });

	$('select[name^=CategoryIds]').select2();
	$("#formData input[type=checkbox], #formData input[type=radio]:not([name=TemplateType])").iCheck({checkboxClass: 'icheckbox_minimal-blue',radioClass: 'iradio_minimal-blue'});
	
	// Save
	$("#btnSave").click(function(){
		<?php foreach ($this->languages as $lang) :?>
		$("li[data-tab-lang=<?php echo $lang["Code"]; ?>]").removeClass("warning");
		<?php endforeach;?>
		var valid = $("#formData").valid();
		if (valid) {
			$.post("<?php echo $this->url(array('module' => 'guestbook', 'controller' => 'book', 'action' => 'save'), null, true);?>", $("#formData").serializeArray(), function(data){
				if (data.result) {
					DialogComplete();
					setTimeout(function(){
						window.location = "<?php echo $this->url(array('module' => 'guestbook', 'controller' => 'book', 'action' => 'edit'), null, true); ?>" + "/itemid/" + data.id;
					}, 500);
				} else {
					DialogWarning(data.message);
				}
			}, 'json');
		} else {
			<?php foreach ($this->languages as $lang) :?>
			if ($("#detail-<?php echo $lang["Code"]; ?>").find("input.error,select.error,textarea.error").length > 0) {$("li[data-tab-lang=<?php echo $lang["Code"]; ?>]").addClass("warning");}
			<?php endforeach;?>
		}
	});

	// Cancel
	$("#btnCancel").click(function(){
		window.location = "<?php echo $this->url(array('module' => 'guestbook', 'controller' => 'book', 'action' => 'index'), null, true); ?>";
	});

});


</script>