	// Save
	$("#btnSave").click(function(){
		var valid = $("#formData").valid();
		if (valid) {
			
			$.post("<?php echo $this->url(array('module' => 'page', 'controller' => 'item', 'action' => 'updatelayout'), null, true);?>", $("#formData").serializeArray(), function(data){
				if (data.result) {
					DialogComplete();
					setTimeout(function(){
						window.location = "<?php echo $this->url(array('module' => 'page', 'controller' => 'item', 'action' => 'layout', 'itemid' => $this->data->ID), null, true); ?>";
					}, 500);
				} else {
					DialogWarning(data.message);
				}
			}, 'json');
		}
	});
	<?php endif; ?>

