<script type="text/javascript">
jQuery(function(){
	if (emsaDialog != null) {
		emsaDialog.setTitle("<?php echo $this->title; ?>");
		emsaDialog.setButtons(
				[{
                    label: 'ส่ง',
					action: function(dialog) {
						var $button = this; // 'this' here is a jQuery object that wrapping the <button> DOM element.
						dialog.enableButtons(false);
	                    dialog.setClosable(false);

	                    var type = $('input[name=emsaContentServiceType]:checked', '#emsa-form').val();
						var canSend1 = <?php echo empty($this->data->canSendService01) ? 'false' : 'true'; ?>;
						var canSend2 = <?php echo empty($this->data->canSendService02) ? 'false' : 'true'; ?>;
						var canSend3 = <?php echo empty($this->data->canSendService03) ? 'false' : 'true'; ?>;
						var canSend = true;
						if(type == 1 && !canSend1){ canSend = false; }
						if(type == 2 && !canSend2){ canSend = false; }
						if(type == 3 && !canSend3){ canSend = false; }
						if(!canSend){
							dialog.enableButtons(true);
							$('#warningMessage').html('ขออภัย ท่านไม่มีเครดิตในการขอรับบริการนี้');
							$('#warningMessage').show();
							return;
						}
						
	                    $.post("<?php echo $this->url(array("module" => "emsa", "controller" => "contentservice", "action" => "send"), null, true);?>", $("#emsa-form").serializeArray(), function(data){
							if (data.result) {
								dialog.enableButtons(true);
								emsaDialog.setMessage($('<div id="EMSADialogContent"></div>').load("<?php echo $this->url(array('module' => 'emsa', 'controller' => 'contentservice', 'action' => 'result'), null, true); ?>"));
							} else {
								dialog.enableButtons(true);
								$('#warningMessage').html(data.message);
								$('#warningMessage').show();
							}
		                }, "json");
					}
                }, {
                    label: 'ยกเลิก',
					action: function(dialog) {
						dialog.close();
					}
                }]
		);

		$("#emsa-form input[type=radio]").click(function(){
			var id = $(this).val();
			$("#emsa-form .emsa-contentservice-detail-form").css("display", "none");
			$("#emsa-form #emsa-contentservice-detail-form-" + id).css("display", "");
		});

		//Date picker
	    $('#emsaPublicStartDate').datepicker({autoclose: true, format: 'dd/mm/yyyy', todayHighlight: true});
	    $('#emsaPublicEndDate').datepicker({autoclose: true, format: 'dd/mm/yyyy', todayHighlight: true});
	}
});    
</script>
