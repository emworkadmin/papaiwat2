
<style type="text/css">
#btnMoreData { margin-top: 15px; background: #444; color: #fff;}
#btnMoreData:hover { background: #3d3d3d; }
#tableTitle { position: relative; }
#totalList { position: absolute; right: 15px; top: 3px; font-size: 12px; color: #6d6d6d; }
</style>

<div class="emsa-title">
	สถานะรหัสโครงการ <span class="emsa-label-blue"><?php echo $this->data->ProjectCode; ?></span>
</div>
<div id="emsa-tracking-project">
	<div class="row emsa-mb15">
		<div class="col-xs-6"><strong>ชื่อลูกค้า: </strong><?php echo $this->data->DepartmentName; ?></div>
		<div class="col-xs-6"><strong>ชื่อโครงการ: </strong><?php echo $this->data->ProjectName; ?></div>
	</div>
	
	<hr class="emsa-hr" />
	
	<div class="row emsa-mb15">
		<div class="col-xs-12 text-center" id="tableTitle">
			มีรายการทั้งหมด ดังนี้
			<span id="totalList">
				<span id="dataEnd"></span>&#47;<span id="dataTotal"></span>&nbsp;รายการ
			</span>
		</div>
	</div>
	
	<table class="emsa-tbl">
		<col width="100" />
		<col  />
		<col width="120" />
		<thead>
			<tr>
				<th>เลขที่</th>
				<th>ชื่อเรื่อง</th>
				<th>สถานะ</th>
			</tr>
		</thead>
		<tbody id="dataList">
		
		</tbody>
	</table>
	
	<div class="btn btn-default btn-block" id="btnMoreData">ดูเพิ่มเติม</div>
</div>

<script type="text/javascript">
jQuery(function(){
	if (emsaDialog != null) {
		emsaDialog.setTitle("<?php echo $this->title?>");
		emsaDialog.setButtons(
				[{
                    label: 'ปิด',
					action: function(dialog) {
						dialog.close();
					}
                }]
		);

		var pageIndex = 1;
		dataList();
		function dataList(){
			$('#btnMoreData').attr('disabled',true);
			$.post("<?php echo $this->url(array('module' => 'emsa', 'controller' => 'tracking', 'action' => 'getlist'), null, true);?>", {"pageIndex": pageIndex}, function(data){
				if (data.result) {
					if(data.data.data.length){
						$(data.data.data).each(function(i,e) {
							var html = '';
							html += '<tr>' + '\n';
							html += '	<td class="text-center">' + '\n';
							html += '		<a class="emsa-label-blue emsa-tracking-link lnk-'+ e.CustomerCode +'" href="javascript:void(0);" data-id="'+ e.CustomerCode +'">' + '\n';
							html += '			' + e.CustomerCode + '\n';
							html += '		</a>' + '\n';
							html += '	</td>' + '\n';
							html += '	<td>' + '\n';
							html += '		' + e.Title + '\n';
							html += '	</td>' + '\n';
							html += '	<td class="text-center">' + '\n';
							if(e.StatusID == 1){
								html += '		<span class="emsa-label-red">' + '\n';
							}else if(e.StatusID == 2){
								html += '		<span class="emsa-label-blue">' + '\n';
							}else if(e.StatusID == 3){
								html += '		<span class="emsa-label-yellow">' + '\n';
							}else if(e.StatusID == 4){
								html += '		<span class="emsa-label-green">' + '\n';
							}
							html += '			' + e.StatusName + '\n';
							html += '		</span>' + '\n';
							html += '	</td>' + '\n';
							html += '</tr>' + '\n';
							html += '<script type="text/javascript">' + '\n';
							html += 'jQuery(function(){' + '\n';
							html += '	$("a.lnk-' + e.CustomerCode + '").click(function(){' + '\n';
							html += '		emsaDialog.setMessage($(\'<div id="EMSADialogContent"></div>\').load("<?php echo $this->url(array('module' => 'emsa', 'controller' => 'tracking', 'action' => 'detail'), null, true); ?>/id/' + e.CustomerCode + '"));' + '\n';
							html += '	});' + '\n';
							html += '});' + '\n';
							html += '<\/script>' + '\n';
							$('#dataList').append(html);
						});
						if(data.data.end!=data.data.total){
							pageIndex++;
							$('#btnMoreData').attr('disabled',false);
						}else{
							$('#btnMoreData').hide();
						}
						$('#dataEnd').html(data.data.end);
						$('#dataTotal').html(data.data.total);
					}
				}
			}, 'json');
		}
	}

	$('#btnMoreData').click(function(){
		dataList();
	});
});    
</script>
