<div class="alert alert-danger" id="warningMessage" style="display: none; margin-bottom: 0px;"></div>
    	
<script type="text/javascript">
jQuery(function(){
	
	if (emsaDialog != null) {

		$("#emsaScreen").attr("src", emsaParams.screenCanvas.toDataURL("image/png"));
		$("#emsaScreenData").val(emsaParams.screenCanvas.toDataURL("image/png"));
		$("#emsaUrl").val(emsaParams.currentUrl);	
		$("#emsaScreenCode").val(emsaParams.screenCode);		
		$("#emsaScreenCodeLabel").text(emsaParams.screenCode);
		
		emsaDialog.setTitle("<?php echo $this->title; ?>");
		emsaDialog.setButtons(
				[{
                    label: 'ส่ง',
					action: function(dialog) {
						var $button = this; // 'this' here is a jQuery object that wrapping the <button> DOM element.
						dialog.enableButtons(false);
	                    dialog.setClosable(false);
	                    $.post("<?php echo $this->url(array("module" => "emsa", "controller" => "request", "action" => "send"), null, true);?>", $("#emsa-form").serializeArray(), function(data){
							if (data.result) {
								dialog.enableButtons(true);
								emsaDialog.setMessage($('<div id="EMSADialogContent"></div>').load("<?php echo $this->url(array('module' => 'emsa', 'controller' => 'request', 'action' => 'result'), null, true); ?>/receiveNo/"+data.receiveNo));
							} else {
								dialog.enableButtons(true);
								$('#warningMessage').html(data.message);
								$('#warningMessage').show();
							}
		                }, "json");
					}
                }, {
                    label: 'ยกเลิก',
					action: function(dialog) {
						dialog.close();
					}
                }]
		);
	}

	// Get browser name and version
    navigator.sayswho = (function () {
        var ua = navigator.userAgent, tem, M = ua.match(/(opera|chrome|safari|firefox|msie|trident(?=\/))\/?\s*(\d+)/i) || [];
        if (/trident/i.test(M[1])) {
            tem = /\brv[ :]+(\d+)/g.exec(ua) || [];
            return { name: 'IE ', version: (tem[1] || '') };
        }
        if (M[1] === 'Chrome') {
            tem = ua.match(/\bOPR\/(\d+)/);
            if (tem != null) { return { name: 'Opera', version: tem[1] }; }
        }
        M = M[2] ? [M[1], M[2]] : [navigator.appName, navigator.appVersion, '-?'];
        if ((tem = ua.match(/version\/(\d+)/i)) != null) {
            M.splice(1, 1, tem[1]);
        }
        $('#emsaSystemBrowser').val(M[0]);
	    $('#emsaSystemVersion').val(M[1]);
    })();
    
});    
</script>
