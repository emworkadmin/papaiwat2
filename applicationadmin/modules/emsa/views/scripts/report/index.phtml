<script type="text/javascript">
jQuery(function(){
	if (emsaDialog != null) {
		emsaDialog.setTitle("<?php echo $this->title; ?>");
		//emsaDialog.setButtons([]);
	}
	function emsaGetList() {
		$(".emsa-result").html('<div class="emsa-loading"><em class="fa fa-refresh fa-spin"></em></div>');
		setTimeout(function(){ 
			var year = $("#emsaLstYear").val();
			var month = $("#emsaLstMonth").val();
			$.post("<?php echo $this->url(array("module" => "emsa", "controller" => "report", "action" => "getlist"), null, true); ?>", {"year" : year, "month" : month}, function(data){
				$(".emsa-result").html(data.html);
			}, "json");
		 }, 500);
	}
	emsaGetList();
	$("#emsaLstYear, #emsaLstMonth").change(function(){
		emsaGetList();
	});
});    
</script>
