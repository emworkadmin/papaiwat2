    $('#btnPublish').click(function(){
        var ids = [];
        $.each($('#divCategoryList input[type=checkbox]:not([name=chkAll]):checked'), function(i, e){
            ids.push($(e).val());
        });
        if (ids.length > 0) {
            DialogConfirm("คุณแน่ใจหรือไม่?", "แจ้งเตือนการเผยแพร่", function() {
                $.post("<?php echo $this->url(array("module" => 'vrv', "controller" => 'category', 'action' => 'listpublish'), null, true); ?>", {"ids" : ids, "status": "Y"}, function(data){
                    if (data.result) {
                        DialogComplete("ปรับปรุงสถานะสำเร็จ");
                        setTimeout(function(){
                            window.location = "<?php echo $this->url(array('module' => 'vrv', 'controller' => 'category', 'action' => 'index'), null, true); ?>";
                        }, 500);
                    } else {
                        DialogWarning(data.message);
                    }
                }, 'json');
            });
        } else {
            DialogWarning("โปรดเลือกอย่างน้อยหนึ่งรายการ");
        }
        $('#chkAll').prop('checked',false);
    });

