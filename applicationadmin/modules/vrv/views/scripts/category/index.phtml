<script>
jQuery(function(){

    var options = {
        ignoreClass: 'sort-clickable',
        onDragStart: function( e, cEl ) {
            $('.sort-title').css({
                'padding': '10px 5px',
            });
            $('.sort-title').parent('li').css({
                'display': 'block',
                'position': 'relative',
                'margin-bottom': '5px',
                'border-top': 'solid 1px #ccc',
                'margin-left': '20px',
            });
            $('.sort-title .lnkEdit').css({
                'color':'#3c8dbc',
                'cursor': 'pointer',
            });
            $('span.detail-1, span.detail-2, span.detail-3').css({'display':'none'});
            return true;
        },
        isAllowed: function(cEl, hint, target){
            hint.css({'border':'dashed 1px #ccc'});
            return true;
        },
        onChange: function( cEl ) {
            // Update Parent
            var id = $(cEl).data('id');
            var parent_id = $(cEl).parent('ul').parent('li').data('id');
            $.post("<?php echo $this->url(array('module' => 'vrv', 'controller' => 'category', 'action' => 'updateparent'), null, true);?>", {"id": id, "parent_id": parent_id}, function(data){
                if(data.result){
                   DialogComplete("จัดเรียงหมวดหมู่สำเร็จ"); 
                }
            }, 'json');
            return true;
        },
        complete: function( cEl ) {
            $('span.detail-1, span.detail-2, span.detail-3').css({'display':''});
            return true;
        }
    };
    $('#categoryList').sortableLists(options);

    $('.lnkEdit').click(function(){
        var id = $(this).parent('div').parent('li').data('id');
        window.location = "<?php echo $this->url(array('module' => 'vrv', 'controller' => 'category', 'action' => 'edit'), null, true); ?>/itemid/"+id;
    });

    <?php if($this->canAdd) : ?>
    $("#btnGoAdd").click(function(e) {
