<script src="<?php echo $this->baseUrl('plugins/ckeditor/ckeditor.js'); ?>"></script>
<script src="<?php echo $this->baseUrl('plugins/ckeditor/adapters/jquery.js'); ?>"></script>
<script>
$(function () {
	
	$("#formData").validate({
		errorElement: "em",
		errorPlacement: function(error, element) {
			error.addClass( "help-block" );
	        error.appendTo( element.parents("div.divControl"));
        }
    });

	<?php if($this->isiOS) : ?>
	$("input[type=text][id$=PublishDate],input[type=text][id$=PublishDown]").removeAttr("readonly");
	<?php endif; ?>
	$("input[type=text][id$=PublishDateTime]").wickedpicker({twentyFour: true, title : 'เวลา', now : '<?php echo $this->data->PublishDate != null ? $this->data->PublishDate->format("H:i") : "0:00"; ?>'});
	$("input[type=text][id$=PublishDownTime]").wickedpicker({twentyFour: true, title : 'เวลา', now : '<?php echo $this->data->PublishDown != null ? $this->data->PublishDown->format("H:i") : "0:00"; ?>'});
    
	// iCheck
	$("#formData input[type=checkbox], #formData input[type=radio]").iCheck({checkboxClass: 'icheckbox_minimal-blue',radioClass: 'iradio_minimal-blue'});
	<?php if($dataDetail->IsPin == 'Y'){ ?>
	$('#IsPin').prop('checked', true);
	$("#IsPin").iCheck('update');
	<?php } ?>
	
	// Get Ajax Option
	getData("<?php echo $this->url(array("module" => "faq", "controller" => "subcategory", "action" => "ajaxlist"), null, true); ?>" + "?id=" + "<?php echo $dataDetail->FaqCategoryID; ?>", "#FaqSubCategory", "-- โปรดเลือก --", "Name", "ID", "<?php echo $dataDetail->FaqSubCategoryID; ?>"); 
	$("#FaqCategory").change(function(){
		var selectValue = $(this).val();
		getData("<?php echo $this->url(array("module" => "faq", "controller" => "subcategory", "action" => "ajaxlist"), null, true); ?>" + "?id=" + selectValue, "#FaqSubCategory", "-- โปรดเลือก --", "Name", "ID", "");
	});

	// CKEditor
	var roxyFileman = '<?php echo $this->baseUrl('/fileman/index.html'); ?>';	
	$( '.Detail' ).ckeditor({
		language: 'th',
		height: 400,
		toolbar: [
		          {name : 'basicstyles', items : ['Bold', 'Italic', 'Strike', '-', 'RemoveFormat']},
		          {name : 'colors', items: [ 'FontSize', 'TextColor', 'BGColor' ] },
		          {name : 'paragraph', items : ['NumberedList', 'BulletedList', '-', 'Outdent', 'Indent', '-', 'Blockquote', '-', 'JustifyLeft', 'JustifyCenter', 'JustifyRight', 'JustifyBlock']},
		          {name : 'links', items : ['Link', 'Unlink', 'Anchor']},
		          {name : 'inserts', items : ['Image', 'Table', 'HorizontalRule']},
		          {name : 'document', items: ['Source']},
		          {name : 'video', items: ['Video']}
		],
		extraPlugins : 'uploadimage,justify,video,font,panelbutton,colorbutton',
		filebrowserBrowseUrl: roxyFileman+'?integration=ckeditor',
		filebrowserImageBrowseUrl:roxyFileman+'?integration=ckeditor&type=image',
		filebrowserVideoBrowseUrl:roxyFileman+'?integration=ckeditor&type=video',
		extraAllowedContent : 'video [*]{*}(*);source [*]{*}(*);iframe [*]{*}(*);'
	});

	<?php if ($this->canEdit) : ?>
	// Save
	$("#btnSave").click(function(){
		var valid = $("#formData").valid();
		if (valid) {
			
			$.post("<?php echo $this->url(array('module' => 'faq', 'controller' => 'item', 'action' => 'update'), null, true);?>", $("#formData").serializeArray(), function(data){
				if (data.result) {
					DialogComplete();
					setTimeout(function(){
						window.location = "<?php echo $this->url(array('module' => 'faq', 'controller' => 'item', 'action' => 'edit'), null, true); ?>/itemid/" + data.id;
					}, 500);
				} else {
					DialogWarning(data.message);
				}
			}, 'json');
		}
	});
	<?php endif; ?>

	<?php if ($this->canDelete) : ?>
	// Delete
	$("#btnDelete").click(function(){
		DialogConfirm("คุณแน่ใจหรือไม่?", "แจ้งเตือนการลบ", function() {
			$.post("<?php echo $this->url(array('module' => 'faq', 'controller' => 'item', 'action' => 'delete'), null, true); ?>", {'id' : '<?php echo $this->data->ID?>' }, function(data) {
				if (data.result) {
					DialogComplete('ลบสำเร็จ');
					setTimeout(function(){
						window.location = "<?php echo $this->url(array('module' => 'faq', 'controller' => 'item', 'action' => 'index'), null, true); ?>";
					}, 500);
				} else {
					DialogWarning(data.message);
				}
			}, 'json');
		});
	});
	<?php endif ; ?>

	// Cancel
	$("#btnCancel").click(function(){
		window.location = "<?php echo $this->url(array('module' => 'faq', 'controller' => 'item', 'action' => 'index'), null, true); ?>";
	});
});
</script>