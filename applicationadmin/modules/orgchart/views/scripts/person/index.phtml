	</div>
</div>
<table id="tblData" class="table table-bordered table-hover">
	<caption>รายการสมาชิก</caption>
	<thead>
		<tr>
			<th style="padding:0;">
                <input type="checkbox" name="chkAll" id="chkAll">
            </th>
			<th>ลำดับ</th>
            <th>ชื่อ - นามสกุล</th>
            <th>ชื่อกลุ่ม</th>
			<th>สถานะ</th>
		</tr>
	</thead>
	<tbody>
	</tbody>
</table>


<!-- DataTables -->
<script src="<?php echo $this->baseUrl('plugins/datatables/jquery.dataTables.min.js'); ?>"></script>
<script src="<?php echo $this->baseUrl('plugins/datatables/dataTables.bootstrap.min.js'); ?>"></script>
<script type="text/javascript">
    jQuery(function(){
		<?php if($this->canAdd) : ?>
    	$("#btnGoAdd").click(function(e) {
    		window.location = "<?php echo $this->url(array('module' => 'orgchart', 'controller' => 'person', 'action' => 'add'), null, true); ?>";
		});
		<?php endif; ?>

		// --------------- Begin: Table & Search Zone -------------------------    	
    	function renderColumn ( data, type, row, meta ) {
    		return data;
    	}
    	function renderColumnLink ( data, type, row, meta ) {
    		return '<a href="<?php echo $this->url(array('module' => 'orgchart', 'controller' => 'person', 'action' => 'edit'), null, true);?>/itemid/' + row.DT_RowId + '">' + data + '</a>';
    	}
    	function renderColumnStatus ( data, type, row, meta ) {
        	if (row.IsEnableCode == 'Y') {
				return '<span class="label label-success">' + data + '</span>';
        	} else {
				return '<span class="label label-danger">' + data + '</span>';
        	}
    	}
		function renderColumnCheckbox ( data, type, row, meta ) {
        	return '<input type="checkbox" name="ids[]" value="' + row.DT_RowId + '" />';
    	}
    	var rows_selected = [];
    	
    	var tblData = $('#tblData').DataTable({
    		processing: true,
    		serverSide: true,
    		responsive: true,
    		<?php
			if ($this->InfoSearch->tblPage) {
				echo 'displayStart: ' . $this->InfoSearch->tblPage . ',';
			}
			if ($this->InfoSearch->tblRow) {
				echo 'pageLength: ' . $this->InfoSearch->tblRow . ',';
			}
			if ($this->InfoSearch->tblOrderCol && $this->InfoSearch->tblOrderDir) {
				echo 'order: [[ ' . $this->InfoSearch->tblOrderCol . ', "' . $this->InfoSearch->tblOrderDir . '" ]],';
			} else {
				echo 'order: [[ 3, "asc" ]],';
			}
			?>
    		ajax: {
    	        url: '<?php echo $this->url(array('module' => 'orgchart', 'controller' => 'person', 'action' => 'getlist'), null, true); ?>',
    	        type: 'POST',
    	        data: function(d) {
        	        d.textstr = $("#formSearch #textsearch").val();
                    d.isEnable = $("#formSearch #is_enable").val();
                    d.isWorkgroupId = $("#formSearch #is_workgroup").val();
    	        }
    	    },
    	    language : {
				url : '<?php echo $this->baseUrl('plugins/datatables/localization/jquery.dataTables.thai.json'); ?>'
    	    },
    		"dom": '<"dataTable"rt<"bottom"ilp<"clear">>>',
    		"columns": [
						{ "width": "10px", 'orderable': false, 'data' : 'NO', 'render' : renderColumnCheckbox, "class" : "text-center"},
    		            { "width": "40px", 'orderable': false, 'data' : 'NO', "class" : "text-center"},
    		            { 'data' : 'Title' , 'render' : renderColumnLink, "class" : "ratio"},
    		            { "width": "17%", 'data' : 'GroupName' , 'render' : renderColumnLink, "class" : "ratio"},
    		            { "width": "15%", 'data' : 'IsEnable' , 'render' : renderColumnStatus, "class" : "ratio"},
    		          ]
        });
        

		$('#btnSearch').click(function(){
			tblData.ajax.reload();
		});

		$('#btnReset').click(function(){
			$(".searchPanel input[type=text]").val('');
			$(".searchPanel select").val('');
			tblData.ajax.reload();
		});
		
		// --------------- Toogle Advance Search ---------------
		$("#btnAdvance").click(function(e) {
			var val = $('#hdfAdvanceSearch').val();
			if(val == 'H'){
				$("#AdvanceSearch").slideDown(600, "swing");
				$("#hdfAdvanceSearch").val('S');
			}else{
				$("#AdvanceSearch").slideUp(600, "swing");
				$("#hdfAdvanceSearch").val('H');
			}
		});

		$('#btnPublish').click(function(){
            var ids = [];
            $.each($('#tblData input[type=checkbox]:not([name=chkAll]):checked'), function(i, e){
                ids.push($(e).val());
            });
            if (ids.length > 0) {
                DialogConfirm("คุณแน่ใจหรือไม่?", "แจ้งเตือนการเผยแพร่", function() {
                    $.post("<?php echo $this->url(array("module" => 'orgchart', "controller" => 'person', 'action' => 'listpublish'), null, true); ?>", {"ids" : ids, "status": "Y"}, function(data){
                        if (data.result) {
                            tblData.ajax.reload();
                            DialogComplete("ปรับปรุงสถานะสำเร็จ");
                        } else {
                            DialogWarning(data.message);
                        }
                    }, 'json');
                });
            } else {
                DialogWarning("โปรดเลือกอย่างน้อยหนึ่งรายการ");
            }
            $('#chkAll').prop('checked',false);
        });
    
        $('#btnUnpublish').click(function(){
            var ids = [];
            $.each($('#tblData input[type=checkbox]:not([name=chkAll]):checked'), function(i, e){
                ids.push($(e).val());
            });
            if (ids.length > 0) {
                DialogConfirm("คุณแน่ใจหรือไม่?", "แจ้งเตือนการไม่เผยแพร่", function() {
                    $.post("<?php echo $this->url(array("module" => 'orgchart', "controller" => 'person', 'action' => 'listpublish'), null, true); ?>", {"ids" : ids, "status": "N"}, function(data){
                        if (data.result) {
                            tblData.ajax.reload();
                            DialogComplete("ปรับปรุงสถานะสำเร็จ");
                        } else {
                            DialogWarning(data.message);
                        }
                    }, 'json');
                });
            } else {
                DialogWarning("โปรดเลือกอย่างน้อยหนึ่งรายการ");
            }
            $('#chkAll').prop('checked',false);
        });

		$('#btnCopy').click(function(){
            var ids = [];
            $.each($('#tblData input[type=checkbox]:not([name=chkAll]):checked'), function(i, e){
                ids.push($(e).val());
            });
            if (ids.length > 0) {
                DialogConfirm("คุณแน่ใจหรือไม่?", "แจ้งเตือนการคัดลอกข้อมูล", function() {
                    $.post("<?php echo $this->url(array("module" => 'orgchart', "controller" => 'person', 'action' => 'listcopy'), null, true); ?>", {"ids" : ids}, function(data){
                        if (data.result) {
                            tblData.ajax.reload();
                            DialogComplete("คัดลอกข้อมูลสำเร็จ");
                        } else {
                            DialogWarning(data.message);
                        }
                    }, 'json');
                });
            } else {
                DialogWarning("โปรดเลือกอย่างน้อยหนึ่งรายการ");
            }
			$('#chkAll').prop('checked',false);
        });
            
        $('#btnDelete').click(function(){
            var ids = [];
            $.each($('#tblData input[type=checkbox]:not([name=chkAll]):checked'), function(i, e){
                ids.push($(e).val());
            });
            if (ids.length > 0) {
                DialogConfirm("คุณแน่ใจหรือไม่?", "แจ้งเตือนการลบ", function() {
                    $.post("<?php echo $this->url(array("module" => 'orgchart', "controller" => 'person', 'action' => 'listdelete'), null, true); ?>", {"ids" : ids}, function(data){
                        if (data.result) {
                            tblData.ajax.reload();
                            DialogComplete("ลบสำเร็จ");
                        } else {
                            DialogWarning(data.message);
                        }
                    }, 'json');
                });
            } else {
                DialogWarning("โปรดเลือกอย่างน้อยหนึ่งรายการ");
            }
			$('#chkAll').prop('checked',false);
        });

		$('#chkAll').click(function(){
            var val = $(this).is(":checked");
            if(val){
                $('input[name="ids[]"]').prop('checked',true);
            }else{
                $('input[name="ids[]"]').prop('checked',false);
            }
        });
    	
    });
    
</script>
