<script src="<?php echo $this->baseUrl('plugins/jQueryValidation/jquery.validate.min.js'); ?>"></script>
<script src="<?php echo $this->baseUrl('plugins/jQueryValidation/localization/messages_th.min.js'); ?>"></script>
<script src="<?php echo $this->baseUrl('plugins/ckeditor/ckeditor.js'); ?>"></script>
<script src="<?php echo $this->baseUrl('plugins/ckeditor/adapters/jquery.js'); ?>"></script>
<script>
$(function () {
	
	$("#formAdd").validate({
		errorElement: "em",
		errorPlacement: function(error, element) {
			error.addClass( "help-block" );
	        error.appendTo( element.parents("div.divControl"));
        }
    });
    
	$("#formAdd input[type=checkbox], #formAdd input[type=radio]").iCheck({checkboxClass: 'icheckbox_minimal-blue',radioClass: 'iradio_minimal-blue'});

	var roxyFileman = '<?php echo $this->baseUrl('/fileman/index.html'); ?>';	
	$( '.Detail' ).ckeditor({
		language: 'th',
		height: 400,
		toolbar: [
		          {name : 'basicstyles', items : ['Bold', 'Italic', 'Strike', '-', 'RemoveFormat']},
		          {name: 'colors', items: [ 'FontSize', 'TextColor', 'BGColor' ] },
		          {name : 'paragraph', items : ['NumberedList', 'BulletedList', '-', 'Outdent', 'Indent', '-', 'Blockquote', '-', 'JustifyLeft', 'JustifyCenter', 'JustifyRight', 'JustifyBlock']},
		          {name : 'links', items : ['Link', 'Unlink', 'Anchor']},
		          {name : 'inserts', items : ['Image', 'Table', 'HorizontalRule']},
		          {name: 'document', items: ['Source']},
		          {name: 'video', items: ['Video']}
		],
		extraPlugins : 'uploadimage,justify,video,font,panelbutton,colorbutton',
		filebrowserBrowseUrl: roxyFileman+'?integration=ckeditor',
		filebrowserImageBrowseUrl:roxyFileman+'?integration=ckeditor&type=image',
		filebrowserVideoBrowseUrl:roxyFileman+'?integration=ckeditor&type=video',
		extraAllowedContent : 'video [*]{*}(*);source [*]{*}(*);iframe [*]{*}(*);'
	});
    
	// Save
	$("#btnSave").click(function(){
		var valid = $("#formAdd").valid();
		if (valid) {
			
			$.post("<?php echo $this->url(array('module' => 'newsletter', 'controller' => 'category', 'action' => 'save'), null, true);?>", $("#formAdd").serializeArray(), function(data){
				if (data.result) {
					DialogComplete();
					setTimeout(function(){
						window.location = "<?php echo $this->url(array('module' => 'newsletter', 'controller' => 'category', 'action' => 'edit'), null, true); ?>/itemid/" + data.id;
					}, 500);
				} else {
					DialogWarning(data.message);
				}
			}, 'json');
		}
	});

	// Cancel
	$("#btnCancel").click(function(){
		window.location = "<?php echo $this->url(array('module' => 'newsletter', 'controller' => 'category', 'action' => 'index'), null, true); ?>";
	});
});
</script>