<script>
$(function () {
	
	$("#formEdit").validate({
		errorElement: "em",
		errorPlacement: function(error, element) {
			error.addClass( "help-block" );
	        error.appendTo( element.parents("div.divControl"));
        }
    });

	<?php if($this->isiOS) : ?>
	$("input[type=text][id$=CaseSiteOpenDate],input[type=text][id$=CaseSiteModifiedDate]").removeAttr("readonly");
	<?php endif; ?>
	$("input[type=text][id$=CaseSiteOpenDateTime]").wickedpicker({twentyFour: true, title : 'เวลา', now : '<?php echo date('H:i');?>'});
	$("input[type=text][id$=CaseSiteModifiedDateTime]").wickedpicker({twentyFour: true, title : 'เวลา', now : '0:00'});

	$("#formEdit input[type=checkbox], #formEdit input[type=radio]").iCheck({checkboxClass: 'icheckbox_minimal-blue',radioClass: 'iradio_minimal-blue'});


	// Save
	$("#btnSave").click(function(){
		var valid = $("#formEdit").valid();
		if (valid) {
			
			$.post("<?php echo $this->url(array('module' => 'case', 'controller' => 'setting', 'action' => 'save'), null, true);?>", $("#formEdit").serializeArray(), function(data){
				if (data.result) {
					DialogComplete();
					setTimeout(function(){
						window.location = "<?php echo $this->url(array('module' => 'case', 'controller' => 'setting', 'action' => 'index'), null, true); ?>" ;
					}, 500);
				} else {
					DialogWarning(data.message);
				}
			}, 'json');
		}
	});
});
	// --------------------------- Date picker -------------------------- //
	    $('#<?php echo  "CaseSiteOpenDate" ?>').datepicker({autoclose: true, format: 'dd/mm/yyyy'});
	    $('#<?php echo  "CaseSiteModifiedDate" ?>').datepicker({autoclose: true, format: 'dd/mm/yyyy'});

