	function toggleCanComment(val) {
		if (val == 'C') {
			$("#canComment").css("display", "");
		} else {
			$("#canComment").css("display", "none");
		}
	}
	$("input[id^=canCommentType]").on('ifChecked' , function(event){
		toggleCanComment($(this).val());
	});
	
	<?php if ($this->canEdit) : ?> 
	// Save
	$("#btnSave").click(function(){
		<?php foreach ($this->languages as $lang) :?>
		$("li[data-tab-lang=<?php echo $lang["Code"]; ?>]").removeClass("warning");
		<?php endforeach;?>
		var valid = $("#formData").valid();
		if (valid) {
			$.post("<?php echo $this->url(array('module' => 'event', 'controller' => 'event', 'action' => 'update'), null, true);?>", $("#formData").serializeArray(), function(data){
				if (data.result) {
					DialogComplete();
					setTimeout(function(){
						window.location = "<?php echo $this->url(array('module' => 'event', 'controller' => 'event', 'action' => 'edit', "itemid" => $this->data->ID), null, true); ?>";
					}, 500);
				} else {
					DialogWarning(data.message);
				}
			}, 'json');
		} else {
			<?php foreach ($this->languages as $lang) :?>
			if ($("#detail-<?php echo $lang["Code"]; ?>").find("input.error,select.error,textarea.error").length > 0) {$("li[data-tab-lang=<?php echo $lang["Code"]; ?>]").addClass("warning");}
			<?php endforeach;?>
		}
	});
	// Preview
	$("#btnPreview").click(function(){
		<?php foreach ($this->languages as $lang) :?>
		$("li[data-tab-lang=<?php echo $lang["Code"]; ?>]").removeClass("warning");
		<?php endforeach;?>
		var valid = $("#formData").valid();
		if (valid) {
			var dialogPreview = BootstrapDialog.show({
				title: 'ตัวอย่างข้อมูล',
				message: $('<div id="dialogdialogPreview"></div>').load("<?php echo $this->url(array('module' => 'event', 'controller' => 'event', 'action' => 'preview'), null, true); ?>", $("#formData").serializeArray()),
				closable: true,
	            closeByBackdrop: false,
	            closeByKeyboard: false,
	            autodestroy: true,
	            size: BootstrapDialog.SIZE_WIDE,
	            cssClass: "divPreview",
				buttons : [{
					label: ' ปิด',
					icon: 'fa fa-times',
					action: function(dialog) {
						dialog.close();
					}
				}]
			});
			dialogPreview.open();
		} else {
			<?php foreach ($this->languages as $lang) :?>
			if ($("#detail-<?php echo $lang["Code"]; ?>").find("input.error,select.error,textarea.error").length > 0) {$("li[data-tab-lang=<?php echo $lang["Code"]; ?>]").addClass("warning");}
			<?php endforeach;?>
		}
	});
	<?php endif; ?>
	<?php if ($this->canDelete) : ?>
	// Delete
	$("#btnDelete").click(function(){
		var title = $("#params-<?php echo $this->defaultLanguage; ?>-Title").val();
		DialogConfirm("คุณแน่ใจหรือไม่?", "แจ้งเตือนการลบ", function() {
			$.post("<?php echo $this->url(array("module" => 'event', "controller" => 'event', 'action' => 'delete'), null, true); ?>", {'id' : '<?php echo $this->data->ID?>','title' : title}, function(data){
				if (data.result) {
					DialogComplete('ลบสำเร็จ');
					setTimeout(function(){
						window.location = "<?php echo $this->url(array('module' => 'event', 'controller' => 'event', 'action' => 'index'), null, true); ?>";
					}, 500);
				} else {
					DialogWarning(data.message);
				}
			}, 'json');
		});
	});
	<?php endif ; ?>

	// Back
	$("#btnBack").click(function(){
		window.location = "<?php echo $this->url(array('module' => 'event', 'controller' => 'event', 'action' => 'index'), null, true); ?>";
	});

});

