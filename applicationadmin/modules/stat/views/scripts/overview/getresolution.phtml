<?php 
    $i=1;
    if(count($this->resolution)>0){
        foreach($this->resolution as $item){
        	$percent= empty($this->userMobile) ? 0 : number_format(($item[1]*100)/$this->userMobile,2);
            ?>
            <tr>
            <td style="text-align: center;"> <?php echo $i;?> </td>
            <td> <?php echo $item[0];?> </td>
            <td style="text-align: center;"> <?php echo $item[1];?> </td>
            <td>
                <div class="rateBarTitle">
                    <div class="meter blue bar">
                        <span style="width :<?php echo $percent; ?>%;" title ="<?php echo $percent; ?>%"></span>
                    </div>
                    <div class="rate">
                        <span><?php echo $percent; ?>%</span>
                    </div>
                </div>
            </td>
            </tr>
            <?php
            $i++;
        }
    } else {
		?>
		<tr>
			<td colspan="4">ไม่พบข้อมูล</td>
		</tr>
		<?php
	}
?>