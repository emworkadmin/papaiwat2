<script src="<?php echo $this->baseUrl('plugins/jQueryValidation/jquery.validate.min.js'); ?>"></script>
<script src="<?php echo $this->baseUrl('plugins/jQueryValidation/localization/messages_th.min.js'); ?>"></script>
<script>
$(function () {

	$("#formData").validate({
		errorElement: "em",
		errorPlacement: function(error, element) {
			error.addClass( "help-block" );
	        error.appendTo( element.closest("div.divControl"));
        }, 
        ignore: []
    });

	$("#divContent").sortable({
		handle: '.handle-box',
		cursor: 'move', 
		update: function ( event, ui ){  }, 
		start: function ( event, ui ){ 
			$(".form-group-content").css("display", "none");
			$(".content-title-herder").css("display", "");
			$(".content-herder").css("margin-bottom", "0px");
			ui.item.height(55); 
			ui.placeholder.height(ui.item.height()); 
			$(ui.item).parents("#divContent").sortable( "refreshPositions" );
		}, 
		stop: function ( event, ui ){ 
			$(".form-group-content").css("display", ""); 
			$(".content-title-herder").css("display", "none");
			$(".content-herder").css("margin-bottom", "20px"); 
		}
	}).disableSelection();
    
	$("#formData input[type=checkbox], #formData input[type=radio]:not([name=TemplateType])").iCheck({checkboxClass: 'icheckbox_minimal-blue',radioClass: 'iradio_minimal-blue'});

	<?php if ($this->canAdd) : ?> 
	// Save
	$("#btnSave").click(function(){
		var valid = $("#formData").valid();
		if (valid) {
			$.post("<?php echo $this->url(array('module' => 'widgetmanage', 'controller' => 'item', 'action' => 'savecustom'), null, true);?>", $("#formData").serializeArray(), function(data){
				if (data.result) {
					DialogComplete();
					setTimeout(function(){
						window.location = "<?php echo $this->url(array('module' => 'widgetmanage', 'controller' => 'item', 'action' => 'edit'), null, true); ?>" + "/itemid/" + data.id;
					}, 500);
				} else {
					DialogWarning(data.message);
				}
			}, 'json');
		}
	});
	<?php endif ; ?>

	// Back
	$("#btnBack").click(function(){
		window.location = "<?php echo $this->url(array('module' => 'widgetmanage', 'controller' => 'item', 'action' => 'index'), null, true); ?>";
	});

	$("#lnkAddContent").click(function(){	
		var index = $("#divContent .panel").length + 1;
		var html = '';
		html += '<div class="panel panel-default">' + '\n';
		html += '	<div class="panel-body">' + '\n';
		html += '		<div class="content-herder">' + '\n';
		html += '			<em class="fa fa-bars handle-box ui-sortable-handle"></em>' + '\n';
		html += '			<em class="fa fa-trash pull-right lnkRemove"></em>' + '\n';
		html += '			<label id="ContentList-'+index+'-Title-Herder" class="content-title-herder" style="display: none;"></label>' + '\n';
		html += '		</div>' + '\n';
		html += '		<div class="form-group form-group-content">' + '\n';
		html += '			<label class="col-md-3 control-label" for="ContentList-'+index+'-Title">ชื่อ</label>' + '\n';
		html += '			<div class="col-md-9 divControl">' + '\n';
		html += '				<input type="text" name="ContentList['+index+'][Title]" id="ContentList-'+index+'-Title" alt=Title value="" class="form-control" maxlength="500">' + '\n';
		html += '			</div>' + '\n';
		html += '		</div>' + '\n';
		html += '		<div class="form-group form-group-content">' + '\n';
		html += '			<label class="col-md-3 control-label" for="ContentList-'+index+'-IntroText">ข้อความเกริ่นนำ</label>' + '\n';
		html += '			<div class="col-md-9 divControl">' + '\n';
		html += '			<textarea name="ContentList['+index+'][IntroText]" id="ContentList-'+index+'-IntroText" alt=IntroText class="form-control" maxlength="2000" rows="3" cols="80"></textarea>' + '\n';
		html += '			</div>' + '\n';
		html += '		</div>' + '\n';
		html += '		<div class="form-group form-group-content">' + '\n';
		html += '			<label class="col-md-3 control-label" for="ContentList-'+index+'-ImageUrl">URL รูปภาพหน้าปก</label>' + '\n';
		html += '			<div class="col-md-9 divControl">' + '\n';
		html += '				<input type="text" name="ContentList['+index+'][ImageUrl]" id="ContentList-'+index+'-ImageUrl" alt=ImageUrl value="" class="form-control" maxlength="500" placeholder="http://www.emworkgroup.com/image/logo.png">' + '\n';
		html += '			</div>' + '\n';
		html += '		</div>' + '\n';
		html += '		<div class="form-group form-group-content">' + '\n';
		html += '			<label class="col-md-3 control-label" for="ContentList-'+index+'-URL">Link URL</label>' + '\n';
		html += '			<div class="col-md-9 divControl">' + '\n';
		html += '				<input type="text" name="ContentList['+index+'][Url]" id="ContentList-'+index+'-Url" alt=Url value="" class="form-control" maxlength="500" placeholder="http://www.emworkgroup.com/">' + '\n';
		html += '			</div>' + '\n';
		html += '		</div>' + '\n';
		html += '	</div>' + '\n';
		html += '</div>' + '\n';
		html += '<script>' + '\n';
		html += '$(function () {' + '\n';
		html += '	$("#ContentList-'+index+'-Title").keyup(function(){' + '\n';
		html += '		var str = $(this).val();' + '\n';
		html += '		if(str.length>100){' + '\n';
		html += '			str = str.substring(0, 100)+"...";' + '\n';
		html += '		}' + '\n';
		html += '		$("#ContentList-'+index+'-Title-Herder").html(str);' + '\n';
		html += '	});' + '\n';
		html += '	$(".lnkRemove").click(function(){' + '\n';
		html += '		$(this).parent(".content-herder").parent(".panel-body").parent(".panel").remove();' + '\n';
		html += '		reindexContent();' + '\n';
		html += '	});' + '\n';
		html += '});' + '\n';
		html += '<\/script>' + '\n';
		$('#divContent').append(html);
	});

	$(".lnkRemove").click(function(){
		$(this).parent(".content-herder").parent(".panel-body").parent(".panel").remove();
		reindexContent();
	});

	$("#lnkAddContent").click();

});

function reindexContent() {
	var idx = 1;
	$("#divContent .panel").each(function(i, e){ 
		$(e).find('input[alt=Title]').attr("name", "ContentList[" + idx + "][Title]") ; 			 
		$(e).find('textarea[alt=IntroText]').attr("name", "ContentList[" + idx + "][IntroText]");   
		$(e).find('input[alt=ImageUrl]').attr("name", "ContentList[" + idx + "][ImageUrl]") ; 			 
		$(e).find('input[alt=Url]').attr("name", "ContentList[" + idx + "][Url]") ; 
		$(e).find('input[alt=Title]').attr("id", "ContentList-" + idx + "-Title") ; 			 
		$(e).find('textarea[alt=IntroText]').attr("id", "ContentList-" + idx + "-IntroText");   
		$(e).find('input[alt=ImageUrl]').attr("id", "ContentList-" + idx + "-ImageUrl") ; 			 
		$(e).find('input[alt=Url]').attr("id", "ContentList-" + idx + "-Url") ; 
		idx++;			 
	});
}
</script>
