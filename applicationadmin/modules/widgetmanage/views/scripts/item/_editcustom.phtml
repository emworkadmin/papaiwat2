		html += '	<div class="panel-body">' + '\n';
		html += '		<div class="content-herder">' + '\n';
		html += '			<em class="fa fa-bars handle-box ui-sortable-handle"></em>' + '\n';
		html += '			<em class="fa fa-trash pull-right lnkRemove"></em>' + '\n';
		html += '			<label id="ContentList-'+index+'-Title-Herder" class="content-title-herder" style="display: none;"></label>' + '\n';
		html += '		</div>' + '\n';
		html += '		<div class="form-group form-group-content">' + '\n';
		html += '			<label class="col-md-3 control-label" for="ContentList-'+index+'-Title">ชื่อ</label>' + '\n';
		html += '			<div class="col-md-9 divControl">' + '\n';
		html += '				<input type="text" name="ContentList['+index+'][Title]" id="ContentList-'+index+'-Title" alt=Title value="" class="form-control" maxlength="500">' + '\n';
		html += '			</div>' + '\n';
		html += '		</div>' + '\n';
		html += '		<div class="form-group form-group-content">' + '\n';
		html += '			<label class="col-md-3 control-label" for="ContentList-'+index+'-IntroText">ข้อความเกริ่นนำ</label>' + '\n';
		html += '			<div class="col-md-9 divControl">' + '\n';
		html += '			<textarea name="ContentList['+index+'][IntroText]" id="ContentList-'+index+'-IntroText" alt=IntroText class="form-control" maxlength="2000" rows="3" cols="80"></textarea>' + '\n';
		html += '			</div>' + '\n';
		html += '		</div>' + '\n';
		html += '		<div class="form-group form-group-content">' + '\n';
		html += '			<label class="col-md-3 control-label" for="ContentList-'+index+'-ImageUrl">URL รูปภาพหน้าปก</label>' + '\n';
		html += '			<div class="col-md-9 divControl">' + '\n';
		html += '				<input type="text" name="ContentList['+index+'][ImageUrl]" id="ContentList-'+index+'-ImageUrl" alt=ImageUrl value="" class="form-control" maxlength="500" placeholder="http://www.emworkgroup.com/image/logo.png">' + '\n';
		html += '			</div>' + '\n';
		html += '		</div>' + '\n';
		html += '		<div class="form-group form-group-content">' + '\n';
		html += '			<label class="col-md-3 control-label" for="ContentList-'+index+'-URL">Link URL</label>' + '\n';
		html += '			<div class="col-md-9 divControl">' + '\n';
		html += '				<input type="text" name="ContentList['+index+'][Url]" id="ContentList-'+index+'-Url" alt=Url value="" class="form-control" maxlength="500" placeholder="http://www.emworkgroup.com/">' + '\n';
		html += '			</div>' + '\n';
		html += '		</div>' + '\n';
		html += '	</div>' + '\n';
		html += '</div>' + '\n';
		html += '<script>' + '\n';
		html += '$(function () {' + '\n';
		html += '	$("#ContentList-'+index+'-Title").keyup(function(){' + '\n';
		html += '		var str = $(this).val();' + '\n';
		html += '		if(str.length>100){' + '\n';
		html += '			str = str.substring(0, 100)+"...";' + '\n';
		html += '		}' + '\n';
		html += '		$("#ContentList-'+index+'-Title-Herder").html(str);' + '\n';
		html += '	});' + '\n';
		html += '	$(".lnkRemove").click(function(){' + '\n';
		html += '		$(this).parent(".content-herder").parent(".panel-body").parent(".panel").remove();' + '\n';
		html += '		reindexContent();' + '\n';
		html += '	});' + '\n';
		html += '});' + '\n';
		html += '<\/script>' + '\n';
