function reindexContent() {
	var idx = 1;
	$("#divContent .panel").each(function(i, e){ 
		$(e).find('input[alt=Title]').attr("name", "ContentList[" + idx + "][Title]") ; 
		$(e).find('input[alt=DataTypeText]').attr("name", "ContentList[" + idx + "][DataType]");  			 
		$(e).find('input[alt=DataTypeWidget]').attr("name", "ContentList[" + idx + "][DataType]");  			 
		$(e).find('input[alt=DataTypeWidgetTool]').attr("name", "ContentList[" + idx + "][DataType]");  			 
		$(e).find('textarea[alt=IntroText]').attr("name", "ContentList[" + idx + "][IntroText]");
		$(e).find('select[alt=Widget]').attr("name", "ContentList[" + idx + "][Widget]");
		$(e).find('select[alt=WidgetTool]').attr("name", "ContentList[" + idx + "][WidgetTool]");
		$(e).find('input[alt=ImageUrl]').attr("name", "ContentList[" + idx + "][ImageUrl]") ; 			 
		$(e).find('input[alt=Url]').attr("name", "ContentList[" + idx + "][Url]") ; 

		$(e).find('input[alt=Title]').attr("id", "ContentList-" + idx + "-Title") ; 	
		$(e).find('input[alt=DataTypeText]').attr("id", "ContentList-" + idx + "-DataType-text");  			 
		$(e).find('input[alt=DataTypeWidget]').attr("id", "ContentList-" + idx + "-DataType-widget");  			 
		$(e).find('input[alt=DataTypeWidgetTool]').attr("id", "ContentList-" + idx + "-DataType-widgettool"); 		 
		$(e).find('textarea[alt=IntroText]').attr("id", "ContentList-" + idx + "-IntroText"); 
		$(e).find('select[alt=Widget]').attr("id", "ContentList-" + idx + "-Widget");
		$(e).find('select[alt=WidgetTool]').attr("id", "ContentList-" + idx + "-WidgetTool");  
		$(e).find('input[alt=ImageUrl]').attr("id", "ContentList-" + idx + "-ImageUrl") ; 			 
		$(e).find('input[alt=Url]').attr("id", "ContentList-" + idx + "-Url") ;

		$(e).find('textarea[alt=IntroText]').parent('div.divControl').parent('div.form-group').attr("id", "divDataTypeText-" + idx + "");
		$(e).find('select[alt=Widget]').parent('div.divControl').parent('div.form-group').attr("id", "divDataTypeWidget-" + idx + "");
		$(e).find('select[alt=WidgetTool]').parent('div.divControl').parent('div.form-group').attr("id", "divDataTypeWidgetTool-" + idx + "");

		idx++;			 
	});
}
