<script src="<?php echo $this->baseUrl('plugins/jQueryValidation/jquery.validate.min.js'); ?>"></script>
<script src="<?php echo $this->baseUrl('plugins/jQueryValidation/localization/messages_th.min.js'); ?>"></script>
<script>
$(function () {
	
	$("#formData").validate({
		errorElement: "em",
		errorPlacement: function(error, element) {
			error.addClass( "help-block" );
	        error.appendTo( element.closest("div.divControl"));
        }, 
        ignore: []
    });

	$("#formData input[type=checkbox], #formData input[type=radio]:not([name=TemplateType])").iCheck({checkboxClass: 'icheckbox_minimal-blue',radioClass: 'iradio_minimal-blue'});

	<?php if ($this->canEdit) : ?> 
	// Save
	$("#btnSave").click(function(){
		var valid = $("#formData").valid();
		if (valid) {
			$.post("<?php echo $this->url(array('module' => 'widgetmanage', 'controller' => 'item', 'action' => 'update'), null, true);?>", $("#formData").serializeArray(), function(data){
				if (data.result) {
					DialogComplete();
					setTimeout(function(){
						window.location = "<?php echo $this->url(array('module' => 'widgetmanage', 'controller' => 'item', 'action' => 'displaysetting', "itemid" => $this->data->ID), null, true); ?>";
					}, 500);
				} else {
					DialogWarning(data.message);
				}
			}, 'json');
		}
	});
	<?php endif ; ?>

	// Datapicker
	$('#settingStartDate').datepicker({autoclose: true, format: 'dd/mm/yyyy'});
	$('#settingEndDate').datepicker({autoclose: true, format: 'dd/mm/yyyy'});
	$('#settingStartDate').change(function(){
		if ($(this).val() != "") {
			$("#settingStartClose").css("display", "block");
		}
	});
	$('#settingEndDate').change(function(){
		if ($(this).val() != "") {
			$("#settingEndClose").css("display", "block");
		}
	});
	$("#settingStartClose").click(function(){
    	$('#settingStartDate').val('');
    	$("#settingStartClose").css("display", "none");
    });
    $("#settingEndClose").click(function(){
    	$('#settingEndDate').val('');
    	$("#settingEndClose").css("display", "none");
    });


	<?php if($this->dataDisplay->settingTemplate=='L'){ ?>
		$('.divDateRange').css("display","");
	<?php }else{ ?>
		$('.divDateRange').css("display","none");
	<?php } ?>
	$('input[name="settingTemplate"]').on('ifClicked', function (event) {
		if(this.value=='C'){
			$('.divDateRange').css("display","none");
		}else{
			$('.divDateRange').css("display","");
		}
    });


});
</script>
