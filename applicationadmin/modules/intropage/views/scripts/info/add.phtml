	$("input[type=text][id$=PublishDownTime]").wickedpicker({twentyFour: true, title : 'เวลา', now : '0:00'});

	$('select[name^=CategoryIds]').select2();
	$("#formData input[type=checkbox], #formData input[type=radio]:not([name=TemplateType])").iCheck({checkboxClass: 'icheckbox_minimal-blue',radioClass: 'iradio_minimal-blue'});

	var roxyFileman = '<?php echo $this->baseUrl('/fileman/index.html'); ?>';	
	$( '.txtDetail' ).ckeditor({
		language: 'th',
		height: 400,
		toolbar: [
		          {name : 'basicstyles', items : ['Bold', 'Italic', 'Strike', '-', 'RemoveFormat']},
		          {name: 'colors', items: [ 'FontSize', 'TextColor', 'BGColor' ] },
		          {name : 'paragraph', items : ['NumberedList', 'BulletedList', '-', 'Outdent', 'Indent', '-', 'Blockquote', '-', 'JustifyLeft', 'JustifyCenter', 'JustifyRight', 'JustifyBlock']},
		          {name : 'links', items : ['Link', 'Unlink', 'Anchor']},
		          {name : 'inserts', items : ['Image', 'Table', 'HorizontalRule']},
		          {name: 'document', items: ['Source']},
		          {name: 'video', items: ['Video']}
		],
		extraPlugins : 'uploadimage,justify,video,font,panelbutton,colorbutton',
		filebrowserBrowseUrl: roxyFileman+'?integration=ckeditor',
		filebrowserImageBrowseUrl:roxyFileman+'?integration=ckeditor&type=image',
		filebrowserVideoBrowseUrl:roxyFileman+'?integration=ckeditor&type=video',
		extraAllowedContent : 'video [*]{*}(*);source [*]{*}(*);iframe [*]{*}(*);'
	});

	function toggleCanComment(val) {
		if (val == 'C') {
			$("#canComment").css("display", "");
		} else {
			$("#canComment").css("display", "none");
		}
	}
	$("input[id^=canCommentType]").on('ifChecked' , function(event){
		toggleCanComment($(this).val());
	});

	// Cancel
	$("#btnCancel").click(function(){
		window.location = "<?php echo $this->url(array('module' => 'intropage', 'controller' => 'info', 'action' => 'index'), null, true); ?>";
	});
	
	// Save
	$("#btnSave").click(function(){
		<?php foreach ($this->languages as $lang) :?>
		$("li[data-tab-lang=<?php echo $lang["Code"]; ?>]").removeClass("warning");
		<?php endforeach;?>
		var valid = $("#formData").valid();
		if (valid) {
			$.post("<?php echo $this->url(array('module' => 'intropage', 'controller' => 'info', 'action' => 'save'), null, true);?>", $("#formData").serializeArray(), function(data){
				if (data.result) {
					DialogComplete();
					setTimeout(function(){
						window.location = "<?php echo $this->url(array('module' => 'intropage', 'controller' => 'info', 'action' => 'edit'), null, true); ?>" + "/itemid/" + data.id;
					}, 500);
				} else {
					DialogWarning(data.message);
				}
			}, 'json');
		} else {
			<?php foreach ($this->languages as $lang) :?>
			if ($("#detail-<?php echo $lang["Code"]; ?>").find("input.error,select.error,textarea.error").length > 0) {$("li[data-tab-lang=<?php echo $lang["Code"]; ?>]").addClass("warning");}
			<?php endforeach;?>
		}
	});

	// Preview
	$("#btnPreview").click(function(){
		<?php foreach ($this->languages as $lang) :?>
