<script src="<?php echo $this->baseUrl('plugins/ckeditor/ckeditor.js'); ?>"></script>
<script src="<?php echo $this->baseUrl('plugins/ckeditor/adapters/jquery.js'); ?>"></script>
<script>
$(function () {

	$('.colorpicker-group').colorpicker({autoInputFallback: false, useAlpha: false});
	
	$("#formData").validate({
		errorElement: "em",
		errorPlacement: function(error, element) {
			error.addClass( "help-block" );
	        error.appendTo( element.parents("div.divControl"));
        }
    });
    
	$("#formData input[type=checkbox], #formData input[type=radio]").iCheck({checkboxClass: 'icheckbox_minimal-blue',radioClass: 'iradio_minimal-blue'});
	<?php if($this->isiOS) : ?>
	$("input[type=text][id$=PublishDate],input[type=text][id$=PublishDown]").removeAttr("readonly");
	<?php endif; ?>
	$("input[type=text][id$=PublishDateTime]").wickedpicker({twentyFour: true, title : 'เวลา', now : '<?php echo empty($dataDetail->PublishDate) ? '0:00':$dataDetail->PublishDate->format('H:i');?>'});
	$("input[type=text][id$=PublishDownTime]").wickedpicker({twentyFour: true, title : 'เวลา', now : '<?php echo empty($dataDetail->PublishDown) ? '0:00': $dataDetail->PublishDown->format('H:i');?>'});
	
	var roxyFileman = '<?php echo $this->baseUrl('/fileman/index.html'); ?>';	
	$( '.Detail' ).ckeditor({
		language: 'th',
		height: 400,
		toolbar: [
		          {name : 'basicstyles', items : ['Bold', 'Italic', 'Strike', '-', 'RemoveFormat']},
		          {name: 'colors', items: [ 'FontSize', 'TextColor', 'BGColor' ] },
		          {name : 'paragraph', items : ['NumberedList', 'BulletedList', '-', 'Outdent', 'Indent', '-', 'Blockquote', '-', 'JustifyLeft', 'JustifyCenter', 'JustifyRight', 'JustifyBlock']},
		          {name : 'links', items : ['Link', 'Unlink', 'Anchor']},
		          {name : 'inserts', items : ['Image', 'Table', 'HorizontalRule']},
		          {name: 'document', items: ['Source']},
		          {name: 'video', items: ['Video']}
		],
		extraPlugins : 'uploadimage,justify,video,font,panelbutton,colorbutton',
		filebrowserBrowseUrl: roxyFileman+'?integration=ckeditor',
		filebrowserImageBrowseUrl:roxyFileman+'?integration=ckeditor&type=image',
		filebrowserVideoBrowseUrl:roxyFileman+'?integration=ckeditor&type=video',
		extraAllowedContent : 'video [*]{*}(*);source [*]{*}(*);iframe [*]{*}(*);'
	});

	<?php if ($this->canEdit) : ?>
	// Save
	$("#btnSave").click(function(){
		var valid = $("#formData").valid();
		if (valid) {
			
			$.post("<?php echo $this->url(array('module' => 'intropage', 'controller' => 'info', 'action' => 'update'), null, true);?>", $("#formData").serializeArray(), function(data){
				if (data.result) {
					DialogComplete();
					setTimeout(function(){
						window.location = "<?php echo $this->url(array('module' => 'intropage', 'controller' => 'info', 'action' => 'edit'), null, true); ?>/itemid/" + data.id;
					}, 500);
				} else {
					DialogWarning(data.message);
				}
			}, 'json');
		}
	});
	<?php endif; ?>
	<?php if ($this->canDelete) : ?>
	// Delete
	$("#btnDelete").click(function(){
		var title = $("#params-<?php echo $this->defaultLanguage; ?>-Name").val();
		DialogConfirm("คุณแน่ใจหรือไม่?", "แจ้งเตือนการลบ", function() {
			$.post("<?php echo $this->url(array("module" => 'intropage', "controller" => 'info', 'action' => 'delete'), null, true); ?>", {'id' : '<?php echo $this->data->ID?>','Name' : title}, function(data){
				if (data.result) {
					DialogComplete('ลบสำเร็จ');
					setTimeout(function(){
						window.location = "<?php echo $this->url(array('module' => 'intropage', 'controller' => 'info', 'action' => 'index'), null, true); ?>";
					}, 500);
				} else {
					DialogWarning(data.message);
				}
			}, 'json');
		});
	});
	<?php endif ; ?>

	// Cancel
	$("#btnCancel").click(function(){
		window.location = "<?php echo $this->url(array('module' => 'intropage', 'controller' => 'info', 'action' => 'index'), null, true); ?>";
	});

	// --------------------------- Date picker -------------------------- //
    <?php 
    if (count($this->languages) > 0) :
    $i = 0;
    foreach ($this->languages as $lang) :
    $langCode = $lang['Code'];
    ?>
	    $('#<?php echo  "params-{$langCode}-PublishDate" ?>').datepicker({autoclose: true, format: 'dd/mm/yyyy'});
	    $('#<?php echo  "params-{$langCode}-PublishDown" ?>').datepicker({autoclose: true, format: 'dd/mm/yyyy'});
	    $('#<?php echo  "params-{$langCode}-PublishDown" ?>').change(function(){
			if ($(this).val() != "") {
				$("#<?php  echo "params-{$langCode}-PublishDownClose"; ?>").css("display", "block");
			}
		});
	    $("#<?php  echo "params-{$langCode}-PublishDownClose"; ?>").click(function(){
	    	$('#<?php echo  "params-{$langCode}-PublishDown" ?>').val('');
	    	$("#<?php  echo "params-{$langCode}-PublishDownClose"; ?>").css("display", "none");
	    });
    <?php 
    	endforeach;
    endif;
    ?>

});
</script>