<script>
$(function () {
	$('.colorpicker-group').colorpicker({autoInputFallback: false, useAlpha: false});
    $("#formData").validate({
		errorElement: "em",
		errorPlacement: function(error, element) {
			error.addClass( "help-block" );
	        error.appendTo( element.closest("div.divControl"));
        }, 
        ignore: []
    });

	var roxyFileman = '<?php echo $this->baseUrl('/fileman/index.html'); ?>';	
	$( '.Detail' ).ckeditor({
		language: 'th',
		height: 400,
		toolbar: [
		          {name : 'basicstyles', items : ['Bold', 'Italic', 'Strike', '-', 'RemoveFormat']},
		          {name: 'colors', items: [ 'FontSize', 'TextColor', 'BGColor' ] },
		          {name : 'paragraph', items : ['NumberedList', 'BulletedList', '-', 'Outdent', 'Indent', '-', 'Blockquote', '-', 'JustifyLeft', 'JustifyCenter', 'JustifyRight', 'JustifyBlock']},
		          {name : 'links', items : ['Link', 'Unlink', 'Anchor']},
		          {name : 'inserts', items : ['Image', 'Table', 'HorizontalRule']},
		          {name: 'document', items: ['Source']},
		          {name: 'video', items: ['Video']}
		],
		extraPlugins : 'uploadimage,justify,video,font,panelbutton,colorbutton',
		filebrowserBrowseUrl: roxyFileman+'?integration=ckeditor',
		filebrowserImageBrowseUrl:roxyFileman+'?integration=ckeditor&type=image',
		filebrowserVideoBrowseUrl:roxyFileman+'?integration=ckeditor&type=video',
		extraAllowedContent : 'video [*]{*}(*);source [*]{*}(*);iframe [*]{*}(*);'
	});

    $("#formData input[type=checkbox], #formData input[type=radio]:not([name=TemplateType])").iCheck({checkboxClass: 'icheckbox_minimal-blue',radioClass: 'iradio_minimal-blue'});

    function reindexRoute() {
		var idx = 0;
		$("#divRoute .line").each(function(i, e){ 
			idx ++;
			$(e).find('div.num').html(idx + '.');
		});
	}

    $("#btnSave").click(function() {
        <?php foreach ($this->languages as $lang) :?>
                $("li[data-tab-lang=<?php echo $lang["Code"]; ?>]").removeClass("warning");
        <?php endforeach;?>
        var valid = $("#formData").valid();
        if(valid) {
            $.post("<?php echo $this->url(array('module' => 'popup', 'controller' => 'index', 'action' => 'update'), null, true);?>", $("#formData").serializeArray(), function(data){
				if (data.result) {
					DialogComplete();
					setTimeout(function(){
						window.location = "<?php echo $this->url(array('module' => 'popup', 'controller' => 'index', 'action' => 'edit'), null, true); ?>" + "/itemid/" + data.id;
					}, 500);
				} else {
					DialogWarning('บันทึกไม่สำเร็จ');
				}
			}, 'json');
        } else {
        <?php foreach ($this->languages as $lang) :?>
                if ($("#detail-<?php echo $lang["Code"]; ?>").find("input.error,select.error,textarea.error").length > 0) {$("li[data-tab-lang=<?php echo $lang["Code"]; ?>]").addClass("warning");}
        <?php endforeach;?>
        }
    });

    $("#btnCancel").click(function() {
        window.location = "<?php echo $this->url(array('module' => 'popup', 'controller' => 'index', 'action' => 'index'), null, true); ?>";
    });    

	$( "#divRoute" ).sortable({handle: '.handle',cursor: 'move', update: function( event, ui ){ reindexRoute(); }}).disableSelection();
	function reindexRoute() {
		var idx = 0;
		$("#divRoute .line").each(function(i, e){ 
			idx ++;
			$(e).find('div.num').html(idx + '.');
		});
	}

	// Delete
	$("#btnDelete").click(function(){
		var title = $("#params-<?php echo $this->defaultLanguage; ?>-Title").val();
		DialogConfirm("คุณแน่ใจหรือไม่?", "แจ้งเตือนการลบ", function() {
			$.post("<?php echo $this->url(array("module" => 'popup', "controller" => 'index', 'action' => 'delete'), null, true); ?>", {'itemid' : '<?php echo $this->data->ID?>','Title' : title}, function(data) {
				if (data.result) {
					DialogComplete('ลบสำเร็จ');
					setTimeout(function(){
						window.location = "<?php echo $this->url(array('module' => 'popup', 'controller' => 'index', 'action' => 'index'), null, true); ?>";
					}, 500);
				} else {
					DialogWarning(data.message);
				}
			}, 'json');
		});
	});


});
</script>