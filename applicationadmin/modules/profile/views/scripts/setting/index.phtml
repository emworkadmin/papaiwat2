	<div class="panel-detail">
		<div class="title-label">
			ตั้งค่าบัญชี
		</div>
		<form id="formEdit" name="formEdit" class="form-horizontal">
			<div class="form-group">
				<label class="col-md-4 control-label" >ประเภท</label>
				<div class="col-md-8 divControl">
					<div class="checkbox row">
						<?php 
						if (count($this->notificationTypeOption)) :
							foreach ($this->notificationTypeOption as $key => $val) :									
						?>
							<div class="col-md-12 checkbox with-icheck">
								<label for="chkNotificationType-<?php echo $key;?>">
									<input type="checkbox" id="chkNotificationType-<?php echo $key;?>" name="chkNotificationType[]" value="<?php echo $key;?>" <?php echo in_array($key, $this->userNotificationTypeDatas) ? 'checked="checked"' : ''; ?>/> 
									<?php echo $val; ?>
								</label>
							</div>
						<?php 
							endforeach;
						endif;
						?>
					</div>
				</div>
			</div>
			<div class="form-group">
				<div class="col-md-8 col-md-offset-4">
					<button type="button" class="btn btn-primary" id="btnSave"><em class="fa fa-save"></em> บันทึก</button>
				</div>
			</div>
		</form>
	</div>
	
	<script src="<?php echo $this->baseUrl('plugins/jQueryValidation/jquery.validate.min.js'); ?>"></script>
	<script src="<?php echo $this->baseUrl('plugins/jQueryValidation/localization/messages_th.min.js'); ?>"></script>
	<script>
	jQuery(function(){

		$("#formEdit").validate({
			errorElement: "em",
			errorPlacement: function(error, element) {
				error.addClass( "help-block" );
		        error.appendTo( element.parents("div.divControl"));
	        }
	    });

		$("#formEdit input[type=checkbox]").iCheck({checkboxClass: 'icheckbox_minimal-green',radioClass: 'iradio_square'});

		$("#btnSave").click(function(){
			var valid = $("#formEdit").valid();
			if (valid) {				
				$.post("<?php echo $this->url(array('module' => 'profile', 'controller' => 'setting', 'action' => 'save'), null, true);?>", $("#formEdit").serializeArray(), function(data){
					if (data.result) {
						window.location = "<?php echo $this->url(array('module' => 'profile', 'controller' => 'setting', 'action' => 'index'), null, true); ?>";
					} else {
						DialogWarning(data.message);
					}
				}, 'json');
			}
		});
	});
	</script>