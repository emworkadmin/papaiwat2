	<div class="panel-detail">
		<div class="title-label">
			เปลี่ยนรหัสผ่าน
		</div>
		<form id="formEdit" name="formEdit" class="form-horizontal">
			<div class="form-group">
				<label class="col-md-3 labelRequest control-label" for="txtOldPassword">รหัสผ่านเดิม</label>
				<div class="col-md-9 divControl">
					<?php echo $this->formPassword('txtOldPassword', null, array('class' => 'form-control required', 'placeholder' => '')); ?>
				</div>
			</div>
			<div class="form-group">
				<label class="col-md-3 labelRequest control-label" for="txtNewPassword">รหัสผ่านใหม่</label>
				<div class="col-md-9 divControl">
					<?php echo $this->formPassword('txtNewPassword', null, array('class' => 'form-control required', 'placeholder' => '')); ?>
				</div>
			</div>
			<div class="form-group">
				<label class="col-md-3 labelRequest control-label" for="txtConfirmPassword">ยืนยันรหัสผ่านใหม่</label>
				<div class="col-md-9 divControl">
					<?php echo $this->formPassword('txtConfirmPassword', null, array('class' => 'form-control required', 'placeholder' => '')); ?>
				</div>
			</div>
			<div class="form-group">
				<div class="col-md-9 col-md-offset-3">
					<button type="button" class="btn btn-primary" id="btnSave"><em class="fa fa-key"></em> เปลี่ยนรหัสผ่าน</button>
				</div>
			</div>
