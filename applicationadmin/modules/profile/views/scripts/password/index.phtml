	</div>
	
	<script src="<?php echo $this->baseUrl('plugins/jQueryValidation/jquery.validate.min.js'); ?>"></script>
	<script src="<?php echo $this->baseUrl('plugins/jQueryValidation/localization/messages_th.min.js'); ?>"></script>
	<script>
	jQuery(function(){

		$("#formEdit").validate({
			errorElement: "em",
			errorPlacement: function(error, element) {
				error.addClass( "help-block" );
		        error.appendTo( element.parents("div.divControl"));
	        }
	    });

		$("#btnSave").click(function(){
			var valid = $("#formEdit").valid();
			if (valid) {
				var NewPassword = $('#txtNewPassword').val();
				if(NewPassword.length < 8){
					DialogWarning('กรุณากรอกรหัสผ่านอย่าน้อย 8 ตัวอักษร');
					return;
				}
				
				$.post("<?php echo $this->url(array('module' => 'profile', 'controller' => 'password', 'action' => 'save'), null, true);?>", $("#formEdit").serializeArray(), function(data){
					if (data.result) {
						DialogComplete();
						setTimeout(function(){
							window.location = "<?php echo $this->url(array('module' => 'profile', 'controller' => 'password', 'action' => 'index'), null, true); ?>";
						}, 500);
					} else {
						DialogWarning(data.message);
					}
				}, 'json');
			}
		});
	});
	</script>
