			<label class="col-md-3 labelRequest control-label" for="txtFirstName">ชื่อหัวข้อ</label>
			<div class="col-md-9 divControl">
				<?php echo $this->formText('txtTitle', $this->data->Title, array('class' => 'form-control required', 'placeholder' => '')); ?>
			</div>
		</div>
		
		<div class="title-label">รายละเอียด</div>
		<div class="form-group" >
			<div class="col-md-12 divControl">
				<?php echo $this->formTextarea("MoreDetail", $this->data->Detail, array('class' => 'form-control MoreDetail')); ?>
			</div>
		</div>

		<?php if($this->canAdd): ?>
			<div class="form-group">
				<div class="col-md-9 col-md-offset-3 button-panel-zone">
					<button type="button" class="btn btn-primary" id="btnSave"><em class="fa fa-save"></em> บันทึก</button>
				</div>
			</div>
		<?php endif; ?>
</form>
</div>

<script src="<?php echo $this->baseUrl('plugins/jQueryValidation/jquery.validate.min.js'); ?>"></script>
<script src="<?php echo $this->baseUrl('plugins/jQueryValidation/localization/messages_th.min.js'); ?>"></script>
<script src="<?php echo $this->baseUrl('plugins/ckeditor/ckeditor.js'); ?>"></script>
<script src="<?php echo $this->baseUrl('plugins/ckeditor/adapters/jquery.js'); ?>"></script>
<script type="text/javascript">
$(function () {
	
	$("#formEdit").validate({
		errorElement: "em",
		errorPlacement: function(error, element) {
			error.addClass( "help-block" );
	        error.appendTo( element.parents("div.divControl"));
        }
    });

	function buttonZoneDisabled() {
		$(".button-panel-zone button").attr("disabled", "disabled");
		$(".button-panel-zone").append('<em class="fa fa-refresh fa-spin"></em>');
	}
	function buttonZoneActive() {
		$(".button-panel-zone button").removeAttr("disabled");
		$(".button-panel-zone > em").remove();
	}
	
	<?php if($this->canAdd): ?>
		// Save
		$("#btnSave").click(function() {
			buttonZoneDisabled();
			var valid = $("#formEdit").valid();
			if(<?php echo $this->data->check ?> == 0 ) {
			if (valid) {
				$.post("<?php echo $this->url(array('module' => 'webboard', 'controller' => 'requirement', 'action' => 'save'), null, true);?>", $("#formEdit").serializeArray(), function(data){
					if (data.result) {
						DialogComplete();
						setTimeout(function(){
							window.location = "<?php echo $this->url(array('module' => 'webboard', 'controller' => 'requirement', 'action' => 'index'), null, true); ?>" ;
						}, 500);
					} else {
						buttonZoneActive();
						DialogWarning(data.message);
					}
				}, 'json');
			} else {
				buttonZoneActive();
			}

			}else{

			if (valid) {
				$.post("<?php echo $this->url(array('module' => 'webboard', 'controller' => 'requirement', 'action' => 'update'), null, true);?>", $("#formEdit").serializeArray(), function(data){
					if (data.result) {
						DialogComplete();
						setTimeout(function(){
							window.location = "<?php echo $this->url(array('module' => 'webboard', 'controller' => 'requirement', 'action' => 'index'), null, true); ?>" ;
						}, 500);
					} else {
						buttonZoneActive();
						DialogWarning(data.message);
					}
				}, 'json');
			} else {
				buttonZoneActive();
			}

			}
		});
	<?php endif; ?>
	
	var roxyFileman = '<?php echo $this->baseUrl('/fileman/index.html'); ?>';	
	$( '.MoreDetail' ).ckeditor({
		language: 'th',
		height: 400,
		toolbar: [
		          {name : 'basicstyles', items : ['Bold', 'Italic', 'Strike', '-', 'RemoveFormat']},
		          {name: 'colors', items: [ 'FontSize', 'TextColor', 'BGColor' ] },
		          {name : 'paragraph', items : ['NumberedList', 'BulletedList', '-', 'Outdent', 'Indent', '-', 'Blockquote', '-', 'JustifyLeft', 'JustifyCenter', 'JustifyRight', 'JustifyBlock']},
		          {name : 'links', items : ['Link', 'Unlink', 'Anchor']},
		          {name : 'inserts', items : ['Image', 'Table', 'HorizontalRule']},
		          {name: 'document', items: ['Source']},
		          {name: 'video', items: ['Video']}
		],
		extraPlugins : 'uploadimage,justify,video,font,panelbutton,colorbutton',
		filebrowserBrowseUrl: roxyFileman+'?integration=ckeditor',
		filebrowserImageBrowseUrl:roxyFileman+'?integration=ckeditor&type=image',
		filebrowserVideoBrowseUrl:roxyFileman+'?integration=ckeditor&type=video',
		extraAllowedContent : 'video [*]{*}(*);source [*]{*}(*);iframe [*]{*}(*);'
	});

	
});
</script>