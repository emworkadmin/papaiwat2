<script type="text/javascript">

jQuery(function(){

	// --------------- Begin: Table & Search Zone --------------------------
	
	function renderColumn ( data, type, row, meta ) {
		return data;
	}
	function renderColumnLink ( data, type, row, meta ) {
		return '<a href="<?php echo $this->url(array('module' => 'webboard', 'controller' => 'user', 'action' => 'edit'), null, true);?>/itemid/' + row.ID + '">' + data + '</a>';
	}

	function renderColumnStatus ( data, type, row, meta ) {
		if (row.IsEnableCode == 'Y') {
			return '<span class="label label-success">' + data + '</span>';
		} else {
			return '<span class="label label-danger">' + data + '</span>';
		}
	}

	function renderColumnStatusPost ( data, type, row, meta ) {
		if (row.StatusCode == 'Y') {
			return '<span class="label label-success">' + data + '</span>';
		} else if (row.StatusCode == 'N'){
			return '<span class="label label-danger">' + data + '</span>';
		} else if (row.StatusCode == 'W'){
			return '<span class="label label-warning">' + data + '</span>';
		}
	}

	function renderColumnCheckbox ( data, type, row, meta ) {
		return '<input type="checkbox" name="ids[]" value="' + row.DT_RowId + '" />';
	}

	var rows_selected = [];
	var tblData = $('#tblData').DataTable({
		processing: true,
		serverSide: true,
		responsive: true,
		pageLength: 10,

		// hold search
		<?php
		if ($this->InfoSearch->tblPage) {
			echo 'displayStart: ' . $this->InfoSearch->tblPage . ',';
		}
		if ($this->InfoSearch->tblRow) {
			echo 'pageLength: ' . $this->InfoSearch->tblRow . ',';
		}
		if ($this->InfoSearch->tblOrderCol && $this->InfoSearch->tblOrderDir) {
			echo 'order: [[ ' . $this->InfoSearch->tblOrderCol . ', "' . $this->InfoSearch->tblOrderDir . '" ]],';
		} else {
			echo 'order: [[ 2, "desc" ]],';
		}
		?>

		ajax: {
	        url: '<?php echo $this->url(array('module' => 'webboard', 'controller' => 'user', 'action' => 'getlist'), null, true); ?>',
	        type: 'POST',
	        data: function(d) {
    	        d.textsearch = $("#formSearch #textsearch").val();
				d.status = $("#formSearch #lstStatus").val();
    	        d.sendtoLogin = $("#formSearch #txtSendDateToLogin").val();
    	        d.sendfromLogin = $("#formSearch #txtSendDateFromLogin").val();
				d.sendtoRegister = $("#formSearch #txtSendDateToRegister").val();
    	        d.sendfromRegister = $("#formSearch #txtSendDateFromRegister").val();
	        }
	    },
	    language : {
			url : '<?php echo $this->baseUrl('plugins/datatables/localization/jquery.dataTables.thai.json'); ?>'
	    },
		"dom": '<"dataTable"rt<"bottom"ilp<"clear">>>',
		"columns": [
					{ "width": "10px", 'orderable': false, 'data' : 'NO', 'render' : renderColumnCheckbox, "class" : "text-center"},
		            { "width": "40px", 'orderable': false, 'data' : 'NO', "class" : "text-center"},
		            {'data' : 'Username', 'render' : renderColumnLink},
	            	{ "width": "25%", 'data' : 'FullName' , 'render' : renderColumnLink, "class" : "ratio"},
	            	{ "width": "20%", 'data' : 'Email' , 'render' : renderColumnLink, "class" : "ratio"},
		            { "width": "13%", 'data' : 'Created' , 'render' : renderColumnLink, "class" : "ratio"},
                    { "width": "13%", 'data' : 'LastLoginDate' , 'render' : renderColumnLink, "class" : "ratio"},
		            { "width": "10%", 'data' : 'IsEnable' , 'render' : renderColumnStatus, "class" : "ratio"}
		          ]
    });

	$('#btnSearch').click(function(){
		tblData.ajax.reload();
	});


	$('#btnReset').click(function(){
		$(".searchPanel input[type=text]").val('');
		$(".searchPanel select").val('');
		tblData.ajax.reload();
	});

	
	$("#btnExcel").click(function() {
		var d = {};

		if('<?php echo $this->windowOS ?>' == 'N'){
			d.textsearch == ' ';
		}else{
			d.textsearch == d.textsearch;
		}
	
		d.textsearch = encodeURI($("#formSearch #textsearch").val());
		d.status = $("#formSearch #lstStatus").val();
		d.sendtoLogin = btoa($("#formSearch #txtSendDateToLogin").val());
		d.sendfromLogin = btoa($("#formSearch #txtSendDateFromLogin").val());
		d.sendtoRegister = btoa($("#formSearch #txtSendDateToRegister").val());
		d.sendfromRegister = btoa($("#formSearch #txtSendDateFromRegister").val());
		
		window.open("<?php echo $this->url(array('module' => 'webboard', 'controller' => 'user', 'action' => 'excel'), null, true);?>/textsearch/" + d.textsearch + "/status/" + d.status + "/sendtoLogin/" + d.sendtoLogin +"/sendfromLogin/" + d.sendfromLogin +"/sendtoRegister/" + d.sendtoRegister +"/sendfromRegister/" + d.sendfromRegister  );
	});

	$("#btnCSV").click(function() {
	var d = {};

		if('<?php echo $this->windowOS ?>' == 'N'){
			d.textsearch == ' ';
		}else{
			d.textsearch == d.textsearch;
		}
	
		d.textsearch = encodeURI($("#formSearch #textsearch").val());
		d.status = $("#formSearch #lstStatus").val();
		d.sendtoLogin = btoa($("#formSearch #txtSendDateToLogin").val());
		d.sendfromLogin = btoa($("#formSearch #txtSendDateFromLogin").val());
		d.sendtoRegister = btoa($("#formSearch #txtSendDateToRegister").val());
		d.sendfromRegister = btoa($("#formSearch #txtSendDateFromRegister").val());


		
		window.open("<?php echo $this->url(array('module' => 'webboard', 'controller' => 'user', 'action' => 'csv'), null, true);?>/textsearch/" + d.textsearch + "/status/" + d.status + "/sendtoLogin/" + d.sendtoLogin +"/sendfromLogin/" + d.sendfromLogin +"/sendtoRegister/" + d.sendtoRegister +"/sendfromRegister/" + d.sendfromRegister  );
	});
	//new $.fn.dataTable.Responsive( tblData );
	
	// --------------- End: Table & Search Zone --------------------------

	// --------------- Toogle Advance Search ---------------
	$("#btnAdvance").click(function(e) {
		var val = $('#hdfAdvanceSearch').val();
		if(val == 'H'){
			$("#AdvanceSearch").slideDown(600, "swing");
			$("#hdfAdvanceSearch").val('S');
		}else{
			$("#AdvanceSearch").slideUp(600, "swing");
			$("#hdfAdvanceSearch").val('H');
		}
	});

	$('#txtSendDateFromLogin').datepicker({autoclose: true, format: 'dd/mm/yyyy'});
	$('#txtSendDateToLogin').datepicker({autoclose: true, format: 'dd/mm/yyyy'});
	$('#txtSendDateFromRegister').datepicker({autoclose: true, format: 'dd/mm/yyyy'});
	$('#txtSendDateToRegister').datepicker({autoclose: true, format: 'dd/mm/yyyy'});

	$('#btnPublish').click(function(){
		var ids = [];
		$.each($('#tblData input[type=checkbox]:not([name=chkAll]):checked'), function(i, e){
			ids.push($(e).val());
		});
		if (ids.length > 0) {
			DialogConfirm("คุณแน่ใจหรือไม่?", "แจ้งเตือนการเผยแพร่", function() {
				$.post("<?php echo $this->url(array("module" => 'webboard', "controller" => 'user', 'action' => 'listpublish'), null, true); ?>", {"ids" : ids, "status": "Y"}, function(data){
					if (data.result) {
						tblData.ajax.reload();
						DialogComplete("ปรับปรุงสถานะสำเร็จ");
					} else {
						DialogWarning(data.message);
					}
				}, 'json');
			});
		} else {
			DialogWarning("โปรดเลือกอย่างน้อยหนึ่งรายการ");
		}
		$('#chkAll').prop('checked',false);
	});

	$('#btnUnpublish').click(function(){
		var ids = [];
		$.each($('#tblData input[type=checkbox]:not([name=chkAll]):checked'), function(i, e){
			ids.push($(e).val());
		});
		if (ids.length > 0) {
			DialogConfirm("คุณแน่ใจหรือไม่?", "แจ้งเตือนการไม่เผยแพร่", function() {
				$.post("<?php echo $this->url(array("module" => 'webboard', "controller" => 'user', 'action' => 'listpublish'), null, true); ?>", {"ids" : ids, "status": "N"}, function(data){
					if (data.result) {
						tblData.ajax.reload();
						DialogComplete("ปรับปรุงสถานะสำเร็จ");
					} else {
						DialogWarning(data.message);
					}
				}, 'json');
			});
		} else {
			DialogWarning("โปรดเลือกอย่างน้อยหนึ่งรายการ");
		}
		$('#chkAll').prop('checked',false);
	});

	<?php if(false){ ?>
