<script type="text/javascript">
$(function () {
	
	$("#formAdd").validate({
		errorElement: "em",
		errorPlacement: function(error, element) {
			error.addClass( "help-block" );
	        error.appendTo( element.parents("div.divControl"));
        }
    });

	$("#formAdd input[type=checkbox], #formAdd input[type=radio]").iCheck({checkboxClass: 'icheckbox_minimal-blue',radioClass: 'iradio_minimal-blue'});

	function buttonZoneDisabled() {
		$(".button-panel-zone button").attr("disabled", "disabled");
		$(".button-panel-zone").append('<em class="fa fa-refresh fa-spin"></em>');
	}
	function buttonZoneActive() {
		$(".button-panel-zone button").removeAttr("disabled");
		$(".button-panel-zone > em").remove();
	}
		
	// Save
	$("#btnSave").click(function(){
		var valid = $("#formAdd").valid();
		if (valid && alphabetcheck) {
			$.post("<?php echo $this->url(array('module' => 'webboard', 'controller' => 'user', 'action' => 'save'), null, true);?>", $("#formAdd").serializeArray(), function(data){
				if (data.result) {
					DialogComplete();
					setTimeout(function(){
						window.location = "<?php echo $this->url(array('module' => 'webboard', 'controller' => 'user', 'action' => 'edit'), null, true); ?>" + "/itemid/" + data.id;
					}, 500);
				} else {
					DialogWarning(data.message);
				}
			}, 'json');
		}
	});

	$("#btnDelete").click(function(){
		DialogConfirm("คุณแน่ใจหรือไม่?", "แจ้งเตือนการลบ", function() {
			$.post("<?php echo $this->url(array("module" => 'webboard', "controller" => 'user', 'action' => 'delete'), null, true); ?>", {'id' : '<?php echo $this->data->ID?>'}, function(data){
				if (data.result) {
					DialogComplete('ลบสำเร็จ');
					setTimeout(function(){
						window.location = "<?php echo $this->url(array('module' => 'webboard', 'controller' => 'user', 'action' => 'index'), null, true); ?>";
					}, 500);
				} else {
					DialogWarning(data.message);
				}
			}, 'json');
		});
	});
	
	// Cancel
	$("#btnCancel").click(function(){
		window.location = "<?php echo $this->url(array('module' => 'webboard', 'controller' => 'user', 'action' => 'index'), null, true); ?>";
	});

	var alphabetcheck = true;
	$.fn.alphabetonly = function(options) {
		var opts = $.extend( {}, $.fn.alphabetonly.defaults, options );
		msg = opts.message;
		color = opts.color;
		size = opts.size;
		fontstyle = opts.fontstyle;
		
		var letters = /^[A-Za-z]+$/;

		$.each($(this), function(i,e) {
			var id = $(e).attr("id");
			$(e).parent().append("<span class='pattern-validate-txt' id='"+id+"' style='display:none;color:"+color+";font-size:"+size+";font-style:"+fontstyle+";'>" + msg + "</span>");
			$(this).keyup(function() {
				if($(this).val().length>0) {
					if( letters.test($(this).val()) ) {
						$("span#"+id).css({"display":"none"});
                        alphabetcheck = true;
					} else {
						$("span#"+id).css({"display":"block"});
                        alphabetcheck = false;
					}
				} else {
					$("span#"+id).css({"display":"none"});
                    alphabetcheck = true;
				}
			});
		});
	}
	$.fn.alphabetonly.defaults = {
		message: "โปรดระบุเฉพาะตัวอักษรภาษาอังกฤษ",
		color: "red",
		size: '12px',
        fontstyle: 'italic'
	};

	$('.alpha').alphabetonly();

});
</script>