  <?php
    $i = 1 ;
    if(count($this->data)>0):
      foreach ($this->data as $datatable) :
        $id = $i;
        $username = $datatable["Username"];
        $fullName = $datatable["FullName"];
        $email = $datatable["Email"];
        $identityCardID = $datatable["IdentityCardID"];
        $telephone = $datatable["Telephone"];
        $address = $datatable["Address"];
        $gender = $datatable["Gender"];

        if($datatable['Created']){
          $created = $datatable['Created']->format("Y-m-d H:i");
        }else{
          $created = null;
        }

        if($datatable['LastLoginDate']){
          $lastLoginDate = $datatable['LastLoginDate']->format("Y-m-d H:i");
        }else{
          $lastLoginDate = null;
        }
        
        $status = $datatable['IsEnable'];
        ?>
        <tr>
