        <td><?php echo $telephone?></td>
        <td><?php echo $address?></td>
        <td><?php echo $gender =='M' ? 'ชาย' : 'หญิง' ?></td>
        <td><?php echo $created?></td>
        <td><?php echo $lastLoginDate?></td>
        <td><?php echo $status =='Y' ? 'เป็นสมาชิก' : 'ยกเลิกการเป็นสมาชิก' ?></td>
        </tr>
