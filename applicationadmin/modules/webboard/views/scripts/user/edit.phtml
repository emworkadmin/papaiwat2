<script src="<?php echo $this->baseUrl('plugins/ckeditor/adapters/jquery.js'); ?>"></script>

<script type="text/javascript">
$(function () {
	
	$("#formEdit").validate({
		errorElement: "em",
		errorPlacement: function(error, element) {
			error.addClass( "help-block" );
	        error.appendTo( element.parents("div.divControl"));
        }
    });

	$("#formEdit input[type=checkbox], #formEdit input[type=radio]").iCheck({checkboxClass: 'icheckbox_minimal-blue',radioClass: 'iradio_minimal-blue'});

	function buttonZoneDisabled() {
		$(".button-panel-zone button").attr("disabled", "disabled");
		$(".button-panel-zone").append('<em class="fa fa-refresh fa-spin"></em>');
	}
	function buttonZoneActive() {
		$(".button-panel-zone button").removeAttr("disabled");
		$(".button-panel-zone > em").remove();
	}
		
	<?php if($this->canEdit): ?>
		// Save
		$("#btnSave").click(function() {
			if($("#Passwordone").val().length>1) {
				if($("#Passwordone").val().length<8) {
					DialogWarning("กรุณากรอกรหัสผ่านอย่างน้อย 8 ตัวอักษร");
					return;
				}
				if($("#Passwordone").val() != $("#Passwordtwo").val()) {
					DialogWarning("รหัสผ่านไม่ตรงกัน กรุณาตรวจสอบ");
					return;
				}
			}

			var valid = $("#formEdit").valid();
			if (valid) {
				$.post("<?php echo $this->url(array('module' => 'webboard', 'controller' => 'user', 'action' => 'update'), null, true);?>", $("#formEdit").serializeArray(), function(data){
					if (data.result) {
						DialogComplete();
						setTimeout(function(){
							window.location = "<?php echo $this->url(array('module' => 'webboard', 'controller' => 'user', 'action' => 'edit'), null, true); ?>" + "/itemid/" + data.id;
						}, 500);
					} else {
						DialogWarning(data.message);
					}
				}, 'json');
			}
		});
	<?php endif; ?>

	<?php if($this->canDelete): ?>
		$("#btnDelete").click(function(){
			DialogConfirm("คุณแน่ใจหรือไม่?", "แจ้งเตือนการลบ", function() {
				$.post("<?php echo $this->url(array("module" => 'webboard', "controller" => 'user', 'action' => 'delete'), null, true); ?>", {'id' : '<?php echo $this->data->ID?>'}, function(data){
					if (data.result) {
						DialogComplete('ลบสำเร็จ');
						setTimeout(function(){
							window.location = "<?php echo $this->url(array('module' => 'webboard', 'controller' => 'user', 'action' => 'index'), null, true); ?>";
						}, 500);
					} else {
						DialogWarning(data.message);
					}
				}, 'json');
			});
		});
	<?php endif; ?>
	
	// Cancel
	$("#btnCancel").click(function(){
		window.location = "<?php echo $this->url(array('module' => 'webboard', 'controller' => 'user', 'action' => 'index'), null, true); ?>";
	});

});
</script>