<script src="<?php echo $this->baseUrl('plugins/ckeditor/ckeditor.js'); ?>"></script>
<script src="<?php echo $this->baseUrl('plugins/ckeditor/adapters/jquery.js'); ?>"></script>

<script type="text/javascript">
$(function () {
	
	$("#formEdit").validate({
		errorElement: "em",
		errorPlacement: function(error, element) {
			error.addClass( "help-block" );
	        error.appendTo( element.parents("div.divControl"));
        }
    });
    $('#Date').datepicker({autoclose: true, format: 'dd/mm/yyyy'});
    $("input[type=text][id$=PublishDateTime]").wickedpicker({twentyFour: true, title : 'เวลา', now : '<?php echo $this->data->Created != null ? $this->data->Created->format("H:i") : "0:00"; ?>'});

	$("#formEdit input[type=checkbox], #formEdit input[type=radio]").iCheck({checkboxClass: 'icheckbox_minimal-blue',radioClass: 'iradio_minimal-blue'});

	function buttonZoneDisabled() {
		$(".button-panel-zone button").attr("disabled", "disabled");
		$(".button-panel-zone").append('<em class="fa fa-refresh fa-spin"></em>');
	}
	function buttonZoneActive() {
		$(".button-panel-zone button").removeAttr("disabled");
		$(".button-panel-zone > em").remove();
	}
		
	<?php if($this->canEdit): ?>
		// Save
		$("#btnSave").click(function(){
			var valid = $("#formEdit").valid();
			if (valid) {
				$.post("<?php echo $this->url(array('module' => 'webboard', 'controller' => 'answer', 'action' => 'update'), null, true);?>", $("#formEdit").serializeArray(), function(data){
					if (data.result) {
						DialogComplete();
						setTimeout(function(){
							window.location = "<?php echo $this->url(array('module' => 'webboard', 'controller' => 'answer', 'action' => 'edit'), null, true); ?>" + "/itemid/" + data.id;
						}, 500);
					} else {
						DialogWarning(data.message);
					}
				}, 'json');
			}
		});
	<?php endif; ?>

	<?php if($this->canDelete): ?>
		$("#btnDelete").click(function(){
			DialogConfirm("คุณแน่ใจหรือไม่?", "แจ้งเตือนการลบ", function() {
				$.post("<?php echo $this->url(array("module" => 'webboard', "controller" => 'answer', 'action' => 'delete'), null, true); ?>", {'id' : '<?php echo $this->data->ID?>'}, function(data){
					if (data.result) {
						DialogComplete('ลบสำเร็จ');
						setTimeout(function(){
							window.location = "<?php echo $this->url(array('module' => 'webboard', 'controller' => 'answer', 'action' => 'index'), null, true); ?>";
						}, 500);
					} else {
						DialogWarning(data.message);
					}
				}, 'json');
			});
		});
	<?php endif; ?>
	
	// Cancel
	$("#btnCancel").click(function(){
		window.location = "<?php echo $this->url(array('module' => 'webboard', 'controller' => 'answer', 'action' => 'index'), null, true); ?>";
	});

});
</script>